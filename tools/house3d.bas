10 ' HOUSE3D - the 3D version of the family houses of HOUSEGEN (tools/housegen.bas) on the mesh renderer (M3D): a house you can walk round and into. It is the study for the ruins of the
20 ' static world (docs/world-subsystem.md "Ruins"). Five house types (1 the plain gable house, 2 the same with a garage annex at the east gable, 3 a hip roof, 4 a steep roof with a dormer and a porch, 5 with a bay window and a flat roofed extension at the back) at five stages of damage by a directed
30 ' energy weapon (1 intact, 2 scorched, 3 roof burnt, 4 the floors fallen, 5 a shell), all from one seed: the same house burns the same way at every stage (a piece that is gone
40 ' at a stage stays gone). Run it in the window version: LOAD "tools/house3d", RUN. Keys: W A S D / arrows walk, R F or Page Up / Down look, 1 .. 5 the stage, T the type,
50 ' N the next seed, H back to the start, Q quit (T cycles the five types). The environment variables H3_TYPE, H3_STAGE, H3_SEED start with another house, H3_CAM="x,y,z,yaw,pitch" (dm, degrees) with another viewpoint, H3_VILLAGE=1 starts in the village (V toggles), H3_C=1 and the keys C / L show the house of the C generator beside it (far / middle level), H3_SOFT=1 the software renderer (the hardware one has no occlusion test), H3_NEAR / H3_MID the distances in units of its levels of detail.
60 ' Units: the builder works in dm (10 cm), the game in units of 3.2 cm (U = 3.125 a dm). The generator part (rooms, doors, windows, furniture) is that of HOUSEGEN.
70 LOAD LIBRARY "w3dkit"
80 DIM RM(2,8,6),RMN(2),DOR(2,16,4),DON(2),WIN(40,7),FU(2,64,5),FUC(2,64),FUN(2),CL(2,24,4),CLN(2),FLZ(2),DS(5),OA1(70),OA2(70),OZ1(70),OZ2(70),OTY(70),ZB(160),LA1(70),LA2(70),RA1(40),RA2(40),CV(40),CT(40),CZ(40),QX(4),QY(4),QZ(4),LKW(25),LKD(25),HLK(40),HLV(40),HPX(40),HPY(40),HCX(40),HCY(40),PM(10),XBK(40),YBK(40)
90 ON ERROR GOTO FAILED
100 U=3.125:TW=4:FLZ(0)=3:FLZ(1)=32:RC=0:SD=1:WN=0:PW=0:OKP=0
110 GOTO MAIN
120 ' ------------------------------------------------------------------------------------------------ random numbers (from the seed and a counter: the same house every time)
130 FUNC RN()
140   RC=RC+1
150   RETURN HASH(SD*7919,RC,17)
160 END FUNC
170 FUNC RI(A,B)
180   RETURN A+INT(FN RN()*(B-A+1))
190 END FUNC
200 ' the pixel column of the horizontal house coordinate A (dm) in the view being drawn (EVM 0 front, 1 the gable side seen from the west: y runs to the left), and the pixel row of a height Z
210 ' the plan's pixel column / row (the street side, y = 0, is at the bottom)
220 ' is the box free of furniture and of the door and stair clearances of floor F? (-1 yes, 0 no)
230 FUNC FREEBOX(F,X1,Y1,X2,Y2)
240   LOCAL I
250   FOR I=0 TO FUN(F)-1
260     IF X1<FU(F,I,2) AND FU(F,I,0)<X2 AND Y1<FU(F,I,3) AND FU(F,I,1)<Y2 THEN RETURN 0
270   NEXT I
280   FOR I=0 TO CLN(F)-1
290     IF X1<CL(F,I,2) AND CL(F,I,0)<X2 AND Y1<CL(F,I,3) AND CL(F,I,1)<Y2 THEN RETURN 0
300   NEXT I
310   RETURN -1
320 END FUNC
330 ' ------------------------------------------------------------------------------------------------ the house: parts
340 PROC ADDROOM(F,X1,Y1,X2,Y2,T)
350   LOCAL N
360   N=RMN(F)
370   RM(F,N,0)=X1:RM(F,N,1)=Y1:RM(F,N,2)=X2:RM(F,N,3)=Y2:RM(F,N,4)=T:RM(F,N,5)=20+FN RI(0,5)
380   RMN(F)=N+1
390 END PROC
400 ' a door in a partition: AX 0 a wall at x = X (1 dm thick) with the door centred at y = Y, AX 1 a wall at y = Y with the door centred at x = X; W wide
410 PROC ADDDOOR(F,AX,X,Y,W)
420   LOCAL N,C
430   N=DON(F):DOR(F,N,0)=AX:DOR(F,N,1)=X:DOR(F,N,2)=Y:DOR(F,N,3)=W:DON(F)=N+1
440   C=CLN(F)
450   IF AX=0 THEN
460     CL(F,C,0)=X-9:CL(F,C,1)=Y-W/2:CL(F,C,2)=X+10:CL(F,C,3)=Y+W/2
470   ELSE
480     CL(F,C,0)=X-W/2:CL(F,C,1)=Y-9:CL(F,C,2)=X+W/2:CL(F,C,3)=Y+10
490   END IF
500   CLN(F)=C+1
510 END PROC
520 ' a window or door in an outer wall: SIDE 0 front (y = 0), 1 back, 2 west (x = 0), 3 east; POS along the wall; kind 0 window, 1 terrace door, 2 front door
530 PROC ADDWIN(F,SIDE,PP,W,SL,HD,K)
540   IF WN>=40 THEN EXIT PROC
550   WIN(WN,0)=F:WIN(WN,1)=SIDE:WIN(WN,2)=PP:WIN(WN,3)=W:WIN(WN,4)=SL:WIN(WN,5)=HD:WIN(WN,6)=K
560   WN=WN+1
570 END PROC
580 ' windows along one wall of a room from A1 to A2 (a terrace door instead when K = 1 and the wall is wide enough)
590 PROC WALLWIN(F,SIDE,A1,A2,W,SL,HD,K)
600   LOCAL N,P,W2,S2,H2,K2
610   N=INT((A2-A1)/32):IF N<1 THEN N=1
620   W2=W:S2=SL:H2=HD:K2=K
630   IF K2=1 THEN
640     IF A2-A1<28 THEN
650       K2=0
660     ELSE
670       N=1:W2=20:S2=0:H2=22
680     END IF
690   END IF
700   FOR P=0 TO N-1
710     CALL ADDWIN(F,SIDE,A1+(A2-A1)*(P+0.5)/N,W2,S2,H2,K2)
720   NEXT P
730 END PROC
740 PROC ROOMWIN(F,I)
750   LOCAL X1,Y1,X2,Y2,T,W,SL,HD,K
760   X1=RM(F,I,0):Y1=RM(F,I,1):X2=RM(F,I,2):Y2=RM(F,I,3):T=RM(F,I,4)
770   W=12:SL=9:HD=21
780   IF T=2 OR T=9 THEN W=6:SL=14:HD=22
790   IF Y1=TW THEN CALL WALLWIN(F,0,X1,X2,W,SL,HD,0)
800   IF Y2=DY-TW THEN
810     K=0:IF T=3 THEN K=1
820     CALL WALLWIN(F,1,X1,X2,W,SL,HD,K)
830   END IF
840   IF X1=TW THEN CALL WALLWIN(F,2,Y1,Y2,W,SL,HD,0)
850   IF X2=LX-TW THEN CALL WALLWIN(F,3,Y1,Y2,W,SL,HD,0)
860 END PROC
870 PROC ADDFU(F,X1,Y1,X2,Y2,C)
880   LOCAL N
890   N=FUN(F)
900   IF N>=64 THEN EXIT PROC
910   FU(F,N,0)=X1:FU(F,N,1)=Y1:FU(F,N,2)=X2:FU(F,N,3)=Y2:FUC(F,N)=C:FUN(F)=N+1
920 END PROC
930 ' a piece of furniture against a wall of room I: W along the wall, H deep; WALL 0 south (y1 side), 1 north, 2 west, 3 east, tried from WALL on; PF 0 .. 1 where along the wall
940 ' (the next walls and places are tried when it does not fit); sets OKP and PW (the wall used) and LQ1 .. LQ4 (the box)
950 PROC SETF(F,I,W,H,WALL,PF,C)
960   LOCAL T,WL,RX1,RY1,RX2,RY2,LNG,Q,A,X1,Y1,X2,Y2
970   RX1=RM(F,I,0):RY1=RM(F,I,1):RX2=RM(F,I,2):RY2=RM(F,I,3)
980   OKP=0
990   FOR T=0 TO 7
1000     WL=(WALL+T) MOD 4
1010     IF WL<2 THEN LNG=RX2-RX1-W ELSE LNG=RY2-RY1-W
1020     IF LNG>=0 THEN
1030       Q=PF+T*0.37:Q=Q-INT(Q)
1040       A=Q*LNG
1050       IF WL=0 THEN X1=RX1+A:Y1=RY1:X2=X1+W:Y2=Y1+H
1060       IF WL=1 THEN X1=RX1+A:Y2=RY2:X2=X1+W:Y1=Y2-H
1070       IF WL=2 THEN Y1=RY1+A:X1=RX1:Y2=Y1+W:X2=X1+H
1080       IF WL=3 THEN Y1=RY1+A:X2=RX2:Y2=Y1+W:X1=X2-H
1090       IF X1>=RX1 AND X2<=RX2 AND Y1>=RY1 AND Y2<=RY2 THEN
1100         IF FN FREEBOX(F,X1,Y1,X2,Y2) THEN
1110           CALL ADDFU(F,X1,Y1,X2,Y2,C)
1120           LQ1=X1:LQ2=Y1:LQ3=X2:LQ4=Y2:PW=WL:OKP=-1
1130           EXIT PROC
1140         END IF
1150       END IF
1160     END IF
1170   NEXT T
1180 END PROC
1190 ' a piece of furniture in the open (the middle of the room, 5 dm from the walls)
1200 PROC SETC(F,I,W,H,C)
1210   LOCAL T,RX1,RY1,RX2,RY2,X1,Y1,X2,Y2,AX,AY
1220   RX1=RM(F,I,0)+5:RY1=RM(F,I,1)+5:RX2=RM(F,I,2)-5:RY2=RM(F,I,3)-5
1230   OKP=0
1240   IF RX2-RX1<W OR RY2-RY1<H THEN EXIT PROC
1250   AX=RX2-RX1-W:AY=RY2-RY1-H
1260   FOR T=0 TO 7
1270     X1=RX1+AX*(0.5+(FN RN()-0.5)*0.5):Y1=RY1+AY*(0.5+(FN RN()-0.5)*0.5):X2=X1+W:Y2=Y1+H
1280     IF FN FREEBOX(F,X1,Y1,X2,Y2) THEN
1290       CALL ADDFU(F,X1,Y1,X2,Y2,C)
1300       LQ1=X1:LQ2=Y1:LQ3=X2:LQ4=Y2:OKP=-1
1310       EXIT PROC
1320     END IF
1330   NEXT T
1340 END PROC
1350 ' the furniture of room I of floor F by its kind: 1 hall, 2 WC, 3 living room, 4 dining room, 5 kitchen, 6 study, 7 bedroom, 8 children's room, 9 bathroom
1360 PROC FITROOM(F,I)
1370   LOCAL T,K,W,WL,OP,C,TX1,TY1,TX2,TY2,N
1380   T=RM(F,I,4)
1390   IF T=1 THEN
1400     CALL SETF(F,I,10,3.5,FN RI(0,3),FN RN(),41)
1410     CALL SETF(F,I,6,2,FN RI(0,3),FN RN(),39)
1420   END IF
1430   IF T=2 THEN
1440     CALL SETF(F,I,4.5,7,1,0.5,54)
1450     CALL SETF(F,I,4,3.5,FN RI(0,3),FN RN(),54)
1460   END IF
1470   IF T=3 THEN
1480     C=42:IF FN RN()<0.4 THEN C=53
1490     IF FN RN()<0.25 THEN C=58
1500     CALL SETF(F,I,20,9,FN RI(0,3),FN RN(),C)
1510     IF OKP THEN
1520       OP=PW+1-2*(PW MOD 2)
1530       CALL SETF(F,I,15,4.5,OP,0.5,40)
1540       CALL SETC(F,I,10,6,41)
1550     END IF
1560     CALL SETF(F,I,12,3.5,FN RI(0,3),FN RN(),40)
1570     CALL SETF(F,I,8,8,FN RI(0,3),FN RN(),C)
1580   END IF
1590   IF T=4 THEN
1600     CALL SETC(F,I,16,9,40)
1610     IF OKP THEN
1620       TX1=LQ1:TY1=LQ2:TX2=LQ3:TY2=LQ4
1630       FOR N=0 TO 1
1640         CALL ADDFU(F,TX1+3+N*7,TY1-3.5,TX1+6+N*7,TY1-0.5,41)
1650         CALL ADDFU(F,TX1+3+N*7,TY2+0.5,TX1+6+N*7,TY2+3.5,41)
1660       NEXT N
1670       IF FN RN()<0.5 THEN CALL ADDFU(F,TX1-3.5,TY1+3,TX1-0.5,TY1+6,41)
1680       IF FN RN()<0.5 THEN CALL ADDFU(F,TX2+0.5,TY1+3,TX2+3.5,TY1+6,41)
1690     END IF
1700     CALL SETF(F,I,14,4,FN RI(0,3),FN RN(),41)
1710   END IF
1720   IF T=5 THEN
1730     CALL SETF(F,I,RM(F,I,2)-RM(F,I,0)-8,6,FN RI(0,3),0.5,54)
1740     WL=PW
1750     IF OKP THEN
1760       IF WL<2 THEN
1770         CALL SETF(F,I,18,6,2+FN RI(0,1),0.5,54)
1780       ELSE
1790         CALL SETF(F,I,18,6,FN RI(0,1),0.5,54)
1800       END IF
1810     END IF
1820     CALL SETF(F,I,6,6,FN RI(0,3),FN RN(),54)
1830     CALL SETC(F,I,10,8,40)
1840     IF OKP THEN
1850       TX1=LQ1:TY1=LQ2:TX2=LQ3:TY2=LQ4
1860       CALL ADDFU(F,TX1+1,TY1-3.5,TX1+4,TY1-0.5,41):CALL ADDFU(F,TX2-4,TY2+0.5,TX2-1,TY2+3.5,41)
1870     END IF
1880   END IF
1890   IF T=6 THEN
1900     CALL SETF(F,I,14,7,FN RI(0,3),FN RN(),40)
1910     CALL SETF(F,I,12,3.5,FN RI(0,3),FN RN(),41)
1920     CALL SETF(F,I,12,3.5,FN RI(0,3),FN RN(),41)
1930     CALL SETF(F,I,16,8,FN RI(0,3),FN RN(),42)
1940   END IF
1950   IF T=7 THEN
1960     CALL SETF(F,I,18,21,FN RI(0,3),FN RN(),53)
1970     CALL SETF(F,I,4.5,4.5,FN RI(0,3),FN RN(),40)
1980     CALL SETF(F,I,4.5,4.5,FN RI(0,3),FN RN(),40)
1990     CALL SETF(F,I,20,6.5,FN RI(0,3),FN RN(),39)
2000     CALL SETF(F,I,12,4.5,FN RI(0,3),FN RN(),41)
2010   END IF
2020   IF T=8 THEN
2030     CALL SETF(F,I,9,20,FN RI(0,3),FN RN(),42)
2040     CALL SETF(F,I,12,6,FN RI(0,3),FN RN(),39)
2050     CALL SETF(F,I,12,6,FN RI(0,3),FN RN(),40)
2060     IF RM(F,I,3)-RM(F,I,1)>50 THEN CALL SETF(F,I,9,20,FN RI(0,3),FN RN(),58):CALL SETF(F,I,16,3.5,FN RI(0,3),FN RN(),41)
2070   END IF
2080   IF T=9 THEN
2090     CALL SETF(F,I,17,7.5,FN RI(0,1),0.5,54)
2100     CALL SETF(F,I,6,5,FN RI(0,3),FN RN(),54)
2110     CALL SETF(F,I,4.5,7,FN RI(0,3),FN RN(),54)
2120   END IF
2130   IF T=11 THEN
2140     CALL SETC(F,I,16,8,40)
2150     IF OKP THEN
2160       TX1=LQ1:TY1=LQ2:TX2=LQ3:TY2=LQ4
2170       CALL ADDFU(F,TX1+2,TY1-3.5,TX1+5,TY1-0.5,41):CALL ADDFU(F,TX2-5,TY2+0.5,TX2-2,TY2+3.5,41)
2180     END IF
2190     CALL SETF(F,I,14,3.5,FN RI(0,3),FN RN(),41)
2200     CALL SETF(F,I,10,6,FN RI(0,3),FN RN(),42)
2210   END IF
2220   IF T=10 THEN
2230     CALL SETF(F,I,24,6,FN RI(0,3),FN RN(),41)
2240     CALL SETF(F,I,16,3.5,FN RI(0,3),FN RN(),40)
2250     CALL SETF(F,I,8,8,FN RI(0,3),FN RN(),39)
2260     CALL SETC(F,I,6,6,40)
2270   END IF
2280 END PROC
2290 ' ------------------------------------------------------------------------------------------------ making a house from the seed SD
2300 PROC GENHOUSE
2310   LOCAL I,IW,LW,RW,ZLO,ZHI,YE,XE,C,C2,Q,XC,XD,XA1,XA2,XB1,XB2,YF1,YF2,YC,J,EXD,EXC
2320   RC=0:WN=0
2330   FOR I=0 TO 1:RMN(I)=0:DON(I)=0:FUN(I)=0:CLN(I)=0:NEXT I
2340   LX=FN RI(100,120):DY=FN RI(80,100)
2350   HX=FN RI(26,30):IW=LX-2*TW
2360   LW=INT((IW-HX-2)*(0.45+FN RN()*0.1)):RW=IW-HX-2-LW
2370   FD=FN RI(28,36):IF FD>DY-50 THEN FD=DY-50
2380   WCD=FN RI(20,26)
2390   XA1=TW+LW:XA2=XA1+1:XB1=XA2+HX:XB2=XB1+1:XE=LX-TW:YE=DY-TW
2400   YF1=TW+FD:YF2=YF1+1:WY=YE-WCD-1
2410   SS=FN RI(0,1)
2420   ' the stairs: 10 dm wide, 31 long, along the hall wall of the living side, ending at the WC / bathroom wall
2430   IF SS=0 THEN SX1=XA2:SX2=XA2+10 ELSE SX1=XB1-10:SX2=XB1
2440   SY1=WY-31:SY2=WY
2450   FOR I=0 TO 1:C=CLN(I):CL(I,C,0)=SX1-1:CL(I,C,1)=SY1-1:CL(I,C,2)=SX2+1:CL(I,C,3)=SY2:CLN(I)=C+1:NEXT I
2460   XC=(XA2+XB1)/2:XD=XC+4:IF SS=1 THEN XD=XC-4
2470   ' ground floor rooms: 0 hall, 1 WC, 2 west front, 3 west back, 4 east front, 5 east back
2480   CALL ADDROOM(0,XA2,TW,XB1,WY,1):CALL ADDROOM(0,XA2,WY+1,XB1,YE,2)
2490   IF SS=0 THEN
2500     CALL ADDROOM(0,TW,TW,XA1,YF1,4):CALL ADDROOM(0,TW,YF2,XA1,YE,3)
2510     CALL ADDROOM(0,XB2,TW,XE,YF1,6):CALL ADDROOM(0,XB2,YF2,XE,YE,5)
2520   ELSE
2530     CALL ADDROOM(0,TW,TW,XA1,YF1,6):CALL ADDROOM(0,TW,YF2,XA1,YE,5)
2540     CALL ADDROOM(0,XB2,TW,XE,YF1,4):CALL ADDROOM(0,XB2,YF2,XE,YE,3)
2550   END IF
2560   ' doors of the ground floor: the front door, the WC, the dining room (to the hall), living and dining room open to each other, the kitchen and the study to the hall
2570   CALL ADDWIN(0,0,XD,10,0,21,2)
2580   CALL ADDDOOR(0,1,XD,WY,8)
2590   IF SS=0 THEN
2600     CALL ADDDOOR(0,0,XA1,FN RI(TW+5,YF1-5),9)
2610     CALL ADDDOOR(0,1,(TW+XA1)/2,YF1,16)
2620     CALL ADDDOOR(0,0,XB1,FN RI(TW+5,YF1-5),9)
2630     CALL ADDDOOR(0,0,XB1,FN RI(YF2+5,WY-5),9)
2640   ELSE
2650     CALL ADDDOOR(0,0,XB1,FN RI(TW+5,YF1-5),9)
2660     CALL ADDDOOR(0,1,(XB2+XE)/2,YF1,16)
2670     CALL ADDDOOR(0,0,XA1,FN RI(TW+5,YF1-5),9)
2680     CALL ADDDOOR(0,0,XA1,FN RI(YF2+5,WY-5),9)
2690   END IF
2700   ' upper floor: 0 landing, 1 bathroom, 2 the long room over the living side, 3 service side front, 4 service side back
2710   CALL ADDROOM(1,XA2,TW,XB1,WY,1):CALL ADDROOM(1,XA2,WY+1,XB1,YE,9)
2720   IF SS=0 THEN
2730     CALL ADDROOM(1,TW,TW,XA1,YE,8)
2740     CALL ADDROOM(1,XB2,TW,XE,YF1,8):CALL ADDROOM(1,XB2,YF2,XE,YE,7)
2750   ELSE
2760     CALL ADDROOM(1,XB2,TW,XE,YE,8)
2770     CALL ADDROOM(1,TW,TW,XA1,YF1,8):CALL ADDROOM(1,TW,YF2,XA1,YE,7)
2780   END IF
2790   CALL ADDWIN(1,0,XC,10,9,21,0)
2800   CALL ADDDOOR(1,1,XD,WY,8)
2810   IF SS=0 THEN
2820     CALL ADDDOOR(1,0,XA1,FN RI(TW+5,SY1-5),9)
2830     CALL ADDDOOR(1,0,XB1,FN RI(TW+5,YF1-5),9)
2840     CALL ADDDOOR(1,0,XB1,FN RI(YF2+5,WY-5),9)
2850   ELSE
2860     CALL ADDDOOR(1,0,XB1,FN RI(TW+5,SY1-5),9)
2870     CALL ADDDOOR(1,0,XA1,FN RI(TW+5,YF1-5),9)
2880     CALL ADDDOOR(1,0,XA1,FN RI(YF2+5,WY-5),9)
2890   END IF
2900   ' windows (the hall of the ground floor has the door instead)
2910   FOR C=0 TO 1
2920     FOR I=0 TO RMN(C)-1
2930       IF I>0 THEN CALL ROOMWIN(C,I)
2940     NEXT I
2950   NEXT C
2960   ' type 2: a single storey annex (the garage) at the east gable, with a door from the east room at the front
2970   IF HT=2 THEN
2980     AI=FN RI(45,55):AY=FN RI(50,65)
2990     CALL ADDROOM(0,LX,TW,LX+AI,AY,10)
3000     J=0
3010     FOR I=0 TO WN-1
3020       IF NOT ( WIN(I,0)=0 AND WIN(I,1)=3 AND WIN(I,2)-WIN(I,3)/2<AY+TW ) THEN
3030         FOR C=0 TO 6:WIN(J,C)=WIN(I,C):NEXT C
3040         J=J+1
3050       END IF
3060     NEXT I
3070     WN=J
3080     CALL ADDWIN(0,3,(TW+YF1)/2,9,0,21,3)
3090     CALL ADDWIN(0,4,LX+AI/2,24,0,22,4)
3100     CALL ADDWIN(0,5,AY/2+2,10,10,20,0)
3110   END IF
3120   ' type 5: a bay window (two storeys) in the front of the west front room and a flat roofed extension at the back, at the widest back room that is not the WC
3130   IF HT=5 THEN
3140     BC=LX/4:BW=16
3150     FOR I=0 TO RMN(0)-1
3160       IF RM(0,I,0)=TW AND RM(0,I,1)=TW THEN BC=(RM(0,I,0)+RM(0,I,2))/2:BW=MIN(18,RM(0,I,2)-RM(0,I,0)-8)
3170     NEXT I
3180     BX1=BC-BW/2:BX2=BC+BW/2
3190     J=0
3200     FOR I=0 TO WN-1
3210       IF NOT ( WIN(I,1)=0 AND WIN(I,2)+WIN(I,3)/2>BX1-1 AND WIN(I,2)-WIN(I,3)/2<BX2+1 ) THEN
3220         FOR C=0 TO 6:WIN(J,C)=WIN(I,C):NEXT C
3230         J=J+1
3240       END IF
3250     NEXT I
3260     WN=J
3270     CALL ADDWIN(0,0,BC,BW,0,21,5):CALL ADDWIN(1,0,BC,BW,0,21,5)
3280     EXD=0:EXC=LX/2
3290     FOR I=0 TO RMN(0)-1
3300       IF RM(0,I,3)=YE AND RM(0,I,4)<>2 AND RM(0,I,2)-RM(0,I,0)>EXD THEN EXD=RM(0,I,2)-RM(0,I,0):EXC=(RM(0,I,0)+RM(0,I,2))/2
3310     NEXT I
3320     EXW=FN RI(34,46):EXY=FN RI(28,38)
3330     EXX1=EXC-EXW/2:EXX2=EXX1+EXW
3340     IF EXX1<TW+4 THEN EXX1=TW+4:EXX2=EXX1+EXW
3350     IF EXX2>LX-TW-4 THEN EXX2=LX-TW-4:EXX1=EXX2-EXW
3360     IF EXC<EXX1+6 THEN EXC=EXX1+6
3370     IF EXC>EXX2-6 THEN EXC=EXX2-6
3380     CALL ADDROOM(0,EXX1,DY,EXX2,DY+EXY,11)
3390     J=0
3400     FOR I=0 TO WN-1
3410       IF NOT ( WIN(I,0)=0 AND WIN(I,1)=1 AND WIN(I,2)+WIN(I,3)/2>EXX1-4 AND WIN(I,2)-WIN(I,3)/2<EXX2+4 ) THEN
3420         FOR C=0 TO 6:WIN(J,C)=WIN(I,C):NEXT C
3430         J=J+1
3440       END IF
3450     NEXT I
3460     WN=J
3470     CALL ADDWIN(0,1,EXC,9,0,21,3)
3480     CALL ADDWIN(0,9,(EXX1+EXX2)/2,20,0,22,1)
3490     CALL ADDWIN(0,7,DY+EXY/2,12,9,21,0):CALL ADDWIN(0,8,DY+EXY/2,12,9,21,0)
3500   END IF
3510   ' the roof: the eaves, the ridge 8.5 .. 10 m high with a pitch of 27 .. 43 degrees
3520   KN=FN RI(0,6):EZ=FLZ(1)+28+KN
3530   ZLO=MAX(85,INT(EZ+0.52*DY/2)):ZHI=MIN(100,INT(EZ+0.95*DY/2)):IF ZHI<ZLO THEN ZHI=ZLO
3540   ZR=FN RI(ZLO,ZHI):CHX=FN RI(INT(LX*0.25),INT(LX*0.65))
3550   PLC=8+FN RI(0,5):RFC=26+FN RI(0,2):ATT=FN RI(0,1)
3560   ' the furniture
3570   FOR C=0 TO 1
3580     FOR I=0 TO RMN(C)-1
3590       CALL FITROOM(C,I)
3600     NEXT I
3610   NEXT C
3620 END PROC
3630 ' ------------------------------------------------------------------------------------------------ the 3D house (units: dm in the builder, U = 3.125 game units a dm)
3640 FUNC HR(A,B)
3650   RETURN HASH(SD*7919+5,A,B)
3660 END FUNC
3670 FUNC CLP(V,A,B)
3680   IF V<A THEN RETURN A
3690   IF V>B THEN RETURN B
3700   RETURN V
3710 END FUNC
3720 ' a box in dm; FC = the faces (M3D BOX mask), 0 = all
3730 PROC BXD(O,X1,Y1,Z1,X2,Y2,Z2,TX)
3740   LOCAL T,FC
3750   IF X2<X1 THEN T=X1:X1=X2:X2=T
3760   IF Y2<Y1 THEN T=Y1:Y1=Y2:Y2=T
3770   IF Z2<Z1 THEN T=Z1:Z1=Z2:Z2=T
3780   FC=BFC:BFC=63
3790   IF X2-X1<0.05 OR Y2-Y1<0.05 OR Z2-Z1<0.05 THEN EXIT PROC
3800   M3D BOX O+OB,X1*U,Y1*U,Z1*U,X2*U,Y2*U,Z2*U,TX,FC
3810 END PROC
3820 ' ---- walls: a wall runs along the axis AX (0: x, 1: y) over A1 .. A2, its thickness is C1 .. C2 across, from Z1 to Z2. PWID names it for the hash, PF is the floor, WTOP the top
3830 ' of the whole wall. The wall is cut into columns of 10 dm (a column's height after the damage and its picture come from the hash), openings are cut out by WALLSEG.
3840 PROC PIECE(O,AX,C1,C2,A1,A2,Z1,Z2)
3850   LOCAL K,K1,K2,NC,KK,RR,RR2,RR3,ZT,KP,FR,BP,T,FC,JAG,FST,LST,J,CA1,CA2
3860   K1=INT(A1/10):K2=INT((A2-0.001)/10)
3870   NC=K2-K1+1:IF D<0.01 THEN NC=1
3880   JAG=(PF=1 AND D>0.6) OR (PF=0 AND D>0.9)
3890   ' pass 1: the picture and the height of every column of 10 dm (the hash), pass 2: neighbours of the same picture and height become one box
3900   FOR KK=0 TO NC-1
3910     K=K1+KK
3920     CT(KK)=0:CZ(KK)=0
3930     RR=FN HR(PWID*64+K,3):RR2=FN HR(PWID*64+K,4+INT(Z1/9)*3):RR3=FN HR(PWID*64+K,5+INT(Z1/9)*3)
3940     ZT=Z2
3950     IF PF=1 AND D>0.6 THEN
3960       KP=(0.97-D)*2.6:IF KP<0 THEN KP=0
3970       FR=KP*(0.4+0.6*RR):IF FR>1 THEN FR=1
3980       ZT=FLZ(1)+(WTOP-FLZ(1))*FR
3990     END IF
4000     IF PF=0 AND D>0.9 THEN ZT=MIN(ZT,FLZ(1)*(0.74+0.26*RR))
4010     ZT=MIN(ZT,Z2)
4020     IF ZT<Z2 THEN ZT=INT(ZT/6)*6:IF ZT<Z1 THEN ZT=Z1
4030     IF ZT-Z1>0.3 THEN
4040       BP=D*0.6:IF PF=1 THEN BP=D*1.4
4050       T=PTX
4060       IF RR2<BP THEN
4070         T=PTXC
4080       ELSE
4090         IF PCAT=0 AND RR3<D*0.6 THEN T=303
4100       END IF
4110       CT(KK)=T:CZ(KK)=ZT
4120     END IF
4130   NEXT KK
4140   KK=0
4150   WHILE KK<NC
4160     IF CT(KK)=0 THEN
4170       KK=KK+1
4180     ELSE
4190       J=KK
4200       WHILE J+1<NC
4210         IF CT(J+1)=CT(KK) AND CZ(J+1)=CZ(KK) THEN J=J+1 ELSE EXIT
4220       WEND
4230       ' the box of the columns KK .. J
4240       ZT=CZ(KK):T=CT(KK)
4250       IF D<0.01 THEN
4260         CA1=A1:CA2=A2
4270       ELSE
4280         CA1=MAX(A1,(K1+KK)*10):CA2=MIN(A2,(K1+J)*10+10)
4290       END IF
4300       FC=63
4310       IF NOT PFULL THEN
4320         FC=OSF
4330         IF D>INFD THEN FC=FC OR INF
4340         IF D>0.3 OR TOPO THEN FC=FC OR 16
4350         IF BOTO THEN FC=FC OR 32
4360         FST=0:LST=0
4370         IF KK=0 THEN
4380           FST=EDS
4390         ELSE
4400           IF CT(KK-1)=0 THEN FST=-1 ELSE IF CZ(KK-1)<CZ(KK) THEN FST=-1
4410         END IF
4420         IF J=NC-1 THEN
4430           LST=EDE
4440         ELSE
4450           IF CT(J+1)=0 THEN LST=-1 ELSE IF CZ(J+1)<CZ(KK) THEN LST=-1
4460         END IF
4470         IF AX=0 THEN
4480           IF FST THEN FC=FC OR 2
4490           IF LST THEN FC=FC OR 1
4500         ELSE
4510           IF FST THEN FC=FC OR 8
4520           IF LST THEN FC=FC OR 4
4530         END IF
4540       END IF
4550       BFC=FC
4560       IF AX=0 THEN CALL BXD(O,CA1,C1,Z1,CA2,C2,ZT,T) ELSE CALL BXD(O,C1,CA1,Z1,C2,CA2,ZT,T)
4570       KK=J+1
4580     END IF
4590   WEND
4600 END PROC
4610 PROC SORTL
4620   LOCAL I,J,T
4630   FOR I=0 TO NL-2
4640     FOR J=0 TO NL-2-I
4650       IF LA1(J)>LA1(J+1) THEN
4660         T=LA1(J):LA1(J)=LA1(J+1):LA1(J+1)=T
4670         T=LA2(J):LA2(J)=LA2(J+1):LA2(J+1)=T
4680       END IF
4690     NEXT J
4700   NEXT I
4710 END PROC
4720 ' the parts of A1 .. A2 that the sorted list LA1 / LA2 (NL entries) does not cover, as wall pieces of the band B1 .. B2
4730 PROC FREEIV(O,AX,C1,C2,A1,A2,B1,B2)
4740   LOCAL J,P,Q
4750   P=A1
4760   FOR J=0 TO NL-1
4770     Q=MIN(LA1(J),A2)
4780     IF Q>P THEN EDS=(P>A1+0.001):EDE=(Q<A2-0.001):CALL PIECE(O,AX,C1,C2,P,Q,B1,B2)
4790     P=MAX(P,LA2(J))
4800   NEXT J
4810   IF A2>P THEN EDS=(P>A1+0.001):EDE=0:CALL PIECE(O,AX,C1,C2,P,A2,B1,B2)
4820 END PROC
4830 ' a wall with the openings OPN (OA1 .. OA2 along, OZ1 .. OZ2 high; type 0 opening, 1 hole of the beam, 2 its glassy rim: drawn with the picture RTX when RTX > 0)
4840 PROC WALLSEG(O,AX,C1,C2,A1,A2,Z1,Z2)
4850   LOCAL I,J,K,NZ,B1,B2,V,T1,T2,NR
4860   NZ=2:ZB(0)=Z1:ZB(1)=Z2
4870   FOR I=0 TO OPN-1
4880     FOR J=0 TO 1
4890       IF J=0 THEN V=OZ1(I) ELSE V=OZ2(I)
4900       IF V>Z1+0.05 AND V<Z2-0.05 AND NZ<158 THEN ZB(NZ)=V:NZ=NZ+1
4910     NEXT J
4920   NEXT I
4930   FOR I=0 TO NZ-2
4940     FOR J=0 TO NZ-2-I
4950       IF ZB(J)>ZB(J+1) THEN V=ZB(J):ZB(J)=ZB(J+1):ZB(J+1)=V
4960     NEXT J
4970   NEXT I
4980   FOR K=0 TO NZ-2
4990     B1=ZB(K):B2=ZB(K+1)
5000     IF B2-B1>0.05 THEN
5010       NL=0:NR=0
5020       FOR I=0 TO OPN-1
5030         IF OZ1(I)<=B1+0.01 AND OZ2(I)>=B2-0.01 THEN
5040           T1=MAX(A1,OA1(I)):T2=MIN(A2,OA2(I))
5050           IF T2>T1 THEN
5060             LA1(NL)=T1:LA2(NL)=T2:NL=NL+1
5070             IF OTY(I)=2 THEN RA1(NR)=T1:RA2(NR)=T2:NR=NR+1
5080           END IF
5090         END IF
5100       NEXT I
5110       CALL SORTL
5120       TOPO=0:BOTO=0
5130       FOR I=0 TO OPN-1
5140         IF ABS(OZ1(I)-B2)<0.02 THEN TOPO=-1
5150         IF ABS(OZ2(I)-B1)<0.02 THEN BOTO=-1
5160       NEXT I
5170       CALL FREEIV(O,AX,C1,C2,A1,A2,B1,B2)
5180       IF RTX>0 AND NR>0 THEN
5190         NL=0
5200         FOR I=0 TO OPN-1
5210           IF OTY(I)<2 AND OZ1(I)<=B1+0.01 AND OZ2(I)>=B2-0.01 THEN
5220             T1=MAX(A1,OA1(I)):T2=MIN(A2,OA2(I))
5230             IF T2>T1 THEN LA1(NL)=T1:LA2(NL)=T2:NL=NL+1
5240           END IF
5250         NEXT I
5260         CALL SORTL
5270         SV1=PTX:SV2=PTXC:SV3=PCAT:PTX=RTX:PTXC=RTX:PCAT=1:PFULL=-1
5280         FOR I=0 TO NR-1
5290           PTX=RTX:PTXC=RTX:PCAT=1:CALL FREEIV(O,AX,C1,C2,RA1(I),RA2(I),B1,B2)
5300         NEXT I
5310         PTX=SV1:PTXC=SV2:PCAT=SV3:PFULL=0
5320       END IF
5330     END IF
5340   NEXT K
5350 END PROC
5360 ' the openings of the outer wall SIDE (0 south, 1 north, 2 west, 3 east, 4 / 6 / 5 the garage's south / north / east wall) of floor F: windows, doors and the hole of the beam
5370 PROC OPWALL(F,SIDE)
5380   LOCAL I,J,ZC,R,YB,W,W2,BH
5390   OPN=0
5400   FOR I=0 TO WN-1
5410     IF WIN(I,0)=F AND WIN(I,1)=SIDE AND NOT (F=1 AND D>0.6 AND WIN(I,6)=0) THEN
5420       OA1(OPN)=WIN(I,2)-WIN(I,3)/2:OA2(OPN)=WIN(I,2)+WIN(I,3)/2:OZ1(OPN)=FLZ(F)+WIN(I,4):OZ2(OPN)=FLZ(F)+WIN(I,5):OTY(OPN)=0:OPN=OPN+1
5430     END IF
5440   NEXT I
5450   IF HOLE AND F=0 AND SIDE=HS THEN
5460     R=HRAD:BH=2*R/9
5470     FOR J=0 TO 8
5480       YB=(J+0.5)*BH-R
5490       W=SQR(MAX(0,R*R-YB*YB)):W2=SQR(MAX(0,(R+1.2)*(R+1.2)-YB*YB))
5500       OA1(OPN)=HC-W:OA2(OPN)=HC+W:OZ1(OPN)=HZC-R+J*BH:OZ2(OPN)=HZC-R+(J+1)*BH:OTY(OPN)=1:OPN=OPN+1
5510       OA1(OPN)=HC-W2:OA2(OPN)=HC+W2:OZ1(OPN)=HZC-R+J*BH:OZ2(OPN)=HZC-R+(J+1)*BH:OTY(OPN)=2:OPN=OPN+1
5520     NEXT J
5530     OA1(OPN)=HC-5.4:OA2(OPN)=HC+5.4:OZ1(OPN)=HZC+R:OZ2(OPN)=HZC+R+1.2:OTY(OPN)=2:OPN=OPN+1
5540     OA1(OPN)=HC-5.4:OA2(OPN)=HC+5.4:OZ1(OPN)=HZC-R-1.2:OZ2(OPN)=HZC-R:OTY(OPN)=2:OPN=OPN+1
5550   END IF
5560 END PROC
5570 ' the doors of a partition: AX 0 a wall at x = CC, AX 1 a wall at y = CC (its low side)
5580 PROC OPDOOR(F,AX,CC)
5590   LOCAL I,P,Q
5600   OPN=0
5610   FOR I=0 TO DON(F)-1
5620     IF DOR(F,I,0)=AX THEN
5630       IF AX=0 THEN P=DOR(F,I,1):Q=DOR(F,I,2) ELSE P=DOR(F,I,2):Q=DOR(F,I,1)
5640       IF ABS(P-CC)<0.01 THEN
5650         OA1(OPN)=Q-DOR(F,I,3)/2:OA2(OPN)=Q+DOR(F,I,3)/2:OZ1(OPN)=FLZ(F):OZ2(OPN)=FLZ(F)+21:OTY(OPN)=0:OPN=OPN+1
5660       END IF
5670     END IF
5680   NEXT I
5690 END PROC
5700 ' ---- the outer walls (3.5 dm of plaster over brick; the rooms add their own 0.5 dm of colour inside), floor by floor
5710 PROC SHELLS
5720   LOCAL F,Z1,Z2,S
5730   FOR F=0 TO 1
5740     PF=F
5750     IF F=0 THEN Z1=0:Z2=FLZ(1) ELSE Z1=FLZ(1):Z2=EZ
5760     WTOP=Z2
5770     FOR S=0 TO 3
5780       CALL OPWALL(F,S):PWID=100+F*10+S:INFD=0.3
5790       IF S=0 THEN OSF=8:INF=4
5800       IF S=1 THEN OSF=4:INF=8
5810       IF S=2 THEN OSF=2:INF=1
5820       IF S=3 THEN OSF=1:INF=2
5830       IF S=0 THEN PTX=TXO:PTXC=302:PCAT=0:RTX=330:CALL WALLSEG(2,0,0,3.5,0,LX,Z1,Z2)
5840       IF S=1 THEN PTX=TXO:PTXC=302:PCAT=0:RTX=330:CALL WALLSEG(2,0,DY-3.5,DY,0,LX,Z1,Z2)
5850       IF S=2 THEN PTX=TXO:PTXC=302:PCAT=0:RTX=330:CALL WALLSEG(2,1,0,3.5,0,DY,Z1,Z2)
5860       IF S=3 THEN PTX=TXO:PTXC=302:PCAT=0:RTX=330:CALL WALLSEG(2,1,LX-3.5,LX,0,DY,Z1,Z2)
5870     NEXT S
5880   NEXT F
5890   IF HT=2 THEN
5900     PF=0:WTOP=FLZ(1)-3
5910     CALL OPWALL(0,4):PWID=150:OSF=8:INF=4:INFD=0.3:PTX=TXO:PTXC=302:PCAT=0:RTX=0:CALL WALLSEG(2,0,0,3.5,LX,LX+AI+4,0,FLZ(1)-3)
5920     CALL OPWALL(0,6):PWID=151:OSF=4:INF=8:INFD=0.3:PTX=TXO:PTXC=302:PCAT=0:RTX=0:CALL WALLSEG(2,0,AY+0.5,AY+4,LX,LX+AI+4,0,FLZ(1)-3)
5930     CALL OPWALL(0,5):PWID=152:OSF=1:INF=2:INFD=0.3:PTX=TXO:PTXC=302:PCAT=0:RTX=0:CALL WALLSEG(2,1,LX+AI+0.5,LX+AI+4,0,AY+4,0,FLZ(1)-3)
5940   END IF
5950   IF HT=5 THEN
5960     PF=0:WTOP=FLZ(1)-3
5970     CALL OPWALL(0,7):PWID=153:OSF=2:INF=1:INFD=0.3:PTX=TXO:PTXC=302:PCAT=0:RTX=0:CALL WALLSEG(2,1,EXX1-4,EXX1-0.5,DY,DY+EXY+4,0,FLZ(1)-3)
5980     CALL OPWALL(0,8):PWID=154:OSF=1:INF=2:INFD=0.3:PTX=TXO:PTXC=302:PCAT=0:RTX=0:CALL WALLSEG(2,1,EXX2+0.5,EXX2+4,DY,DY+EXY+4,0,FLZ(1)-3)
5990     CALL OPWALL(0,9):PWID=155:OSF=4:INF=8:INFD=0.3:PTX=TXO:PTXC=302:PCAT=0:RTX=0:CALL WALLSEG(2,0,DY+EXY+0.5,DY+EXY+4,EXX1-4,EXX2+4,0,FLZ(1)-3)
6000   END IF
6010 END PROC
6020 ' the gable triangles (both sides drawn) over the end walls: they stand while the upper floor's walls do
6030 PROC GABLE(X1,X2,TX)
6040   LOCAL B
6050   B=M3D("VERTS",2+OB)
6060   M3D VERTEX 2+OB,X1*U,0,EZ*U:M3D VERTEX 2+OB,X1*U,DY*U,EZ*U:M3D VERTEX 2+OB,X1*U,DY/2*U,ZR*U
6070   M3D VERTEX 2+OB,X2*U,0,EZ*U:M3D VERTEX 2+OB,X2*U,DY*U,EZ*U:M3D VERTEX 2+OB,X2*U,DY/2*U,ZR*U
6080   M3D FACE 2+OB,B,B+1,B+2,TX:M3D FACE 2+OB,B,B+2,B+1,TX
6090   M3D FACE 2+OB,B+3,B+4,B+5,TX:M3D FACE 2+OB,B+3,B+5,B+4,TX
6100 END PROC
6110 PROC GABLES
6120   LOCAL T
6130   IF D>0.6 OR HT=3 THEN EXIT PROC
6140   T=TXO:IF FN HR(300,1)<D*1.4 THEN T=302
6150   CALL GABLE(0,3.5,T)
6160   T=TXO:IF FN HR(300,2)<D*1.4 THEN T=302
6170   CALL GABLE(LX-3.5,LX,T)
6180 END PROC
6190 ' ---- the rooms: 0.5 dm of colour on every wall of a room, openings cut, the floor
6200 PROC ROOMLAYERS(F,I)
6210   LOCAL X1,Y1,X2,Y2,T,TX,Z1,Z2,AN,ET
6220   X1=RM(F,I,0):Y1=RM(F,I,1):X2=RM(F,I,2):Y2=RM(F,I,3):T=RM(F,I,4)
6230   TX=TXI+RM(F,I,5)-20
6240   AN=(T=10):ET=(T=11)
6250   Z1=FLZ(F):Z2=FLZ(F)+26
6260   PF=F:WTOP=Z2
6270   PWID=200+F*40+I*4
6280   IF NOT ET THEN
6290     IF Y1=TW THEN
6300       IF AN THEN CALL OPWALL(F,4) ELSE CALL OPWALL(F,0)
6310     ELSE
6320       CALL OPDOOR(F,1,Y1-1)
6330     END IF
6340     OSF=4:INF=8:INFD=0.6:PTX=TX:PTXC=302:PCAT=1:RTX=0:CALL WALLSEG(3,0,Y1-0.5,Y1,X1,X2,Z1,Z2)
6350   END IF
6360   PWID=PWID+1
6370   IF AN THEN
6380     CALL OPWALL(F,6)
6390   ELSE
6400     IF ET THEN
6410       CALL OPWALL(F,9)
6420     ELSE
6430       IF Y2=DY-TW THEN CALL OPWALL(F,1) ELSE CALL OPDOOR(F,1,Y2)
6440     END IF
6450   END IF
6460   OSF=8:INF=4:INFD=0.6:PTX=TX:PTXC=302:PCAT=1:RTX=0:CALL WALLSEG(3,0,Y2,Y2+0.5,X1,X2,Z1,Z2)
6470   PWID=PWID+1
6480   IF NOT AN THEN
6490     IF ET THEN
6500       CALL OPWALL(F,7)
6510     ELSE
6520       IF X1=TW THEN CALL OPWALL(F,2) ELSE CALL OPDOOR(F,0,X1-1)
6530     END IF
6540     OSF=1:INF=2:INFD=0.6:PTX=TX:PTXC=302:PCAT=1:RTX=0:CALL WALLSEG(3,1,X1-0.5,X1,Y1,Y2,Z1,Z2)
6550   END IF
6560   PWID=PWID+1
6570   IF AN THEN
6580     CALL OPWALL(F,5)
6590   ELSE
6600     IF ET THEN
6610       CALL OPWALL(F,8)
6620     ELSE
6630       IF X2=LX-TW THEN CALL OPWALL(F,3) ELSE CALL OPDOOR(F,0,X2)
6640     END IF
6650   END IF
6660   OSF=2:INF=1:INFD=0.6:PTX=TX:PTXC=302:PCAT=1:RTX=0:CALL WALLSEG(3,1,X2,X2+0.5,Y1,Y2,Z1,Z2)
6670 END PROC
6680 ' the picture of a room's floor
6690 FUNC FLOORTEX(T)
6700   IF T=1 OR T=2 OR T=5 OR T=9 OR T=11 THEN RETURN 313
6710   IF T=10 THEN RETURN 304
6720   RETURN 312
6730 END FUNC
6740 ' the plate of the upper floor in a rectangle (cell present by the hash of the 12 dm grid)
6750 PROC SLABRECT(X1,Y1,X2,Y2,TX)
6760   LOCAL GX,GY,P1,Q1,P2,Q2,SM
6770   IF X2-X1<0.05 OR Y2-Y1<0.05 THEN EXIT PROC
6780   SM=32 OR OPM:IF D>=0.5 THEN SM=SM OR 15
6790   IF D<=0.5 THEN
6800     BFC=16:CALL BXD(10,X1,Y1,FLZ(1)-0.4,X2,Y2,FLZ(1),TX)
6810     BFC=SM:CALL BXD(10,X1,Y1,FLZ(1)-3,X2,Y2,FLZ(1)-0.4,TXI+5)
6820     EXIT PROC
6830   END IF
6840   FOR GX=INT(X1/12) TO INT((X2-0.001)/12)
6850     FOR GY=INT(Y1/12) TO INT((Y2-0.001)/12)
6860       IF D<0.55+0.4*FN HR(1000+GX,GY) THEN
6870         P1=MAX(X1,GX*12):P2=MIN(X2,GX*12+12):Q1=MAX(Y1,GY*12):Q2=MIN(Y2,GY*12+12)
6880         BFC=16:CALL BXD(10,P1,Q1,FLZ(1)-0.4,P2,Q2,FLZ(1),TX)
6890         BFC=SM:CALL BXD(10,P1,Q1,FLZ(1)-3,P2,Q2,FLZ(1)-0.4,TXI+5)
6900       END IF
6910     NEXT GY
6920   NEXT GX
6930 END PROC
6940 PROC FLOORPIECE(X1,Y1,X2,Y2,TX)
6950   OPM=0
6960   IF X2<=SX1 OR X1>=SX2 OR Y2<=SY1 OR Y1>=SY2 THEN
6970     CALL SLABRECT(X1,Y1,X2,Y2,TX)
6980     EXIT PROC
6990   END IF
7000   OPM=1:IF SX1>X1 THEN CALL SLABRECT(X1,Y1,SX1,Y2,TX)
7010   OPM=2:IF X2>SX2 THEN CALL SLABRECT(SX2,Y1,X2,Y2,TX)
7020   OPM=4:IF SY1>Y1 THEN CALL SLABRECT(MAX(X1,SX1),Y1,MIN(X2,SX2),SY1,TX)
7030   OPM=8:IF Y2>SY2 THEN CALL SLABRECT(MAX(X1,SX1),SY2,MIN(X2,SX2),Y2,TX)
7040   OPM=0
7050 END PROC
7060 ' ground floor, upper floor with its stairwell, the ceiling over it, the flat roof of the garage
7070 PROC SLABS
7080   LOCAL I,GX,GY,P1,Q1,P2,Q2,T,CM
7090   BFC=16:CALL BXD(4,0,0,0,LX,DY,FLZ(0)-0.4,304)
7100   IF HT=2 THEN BFC=16:CALL BXD(4,LX,0,0,LX+AI+4,AY+4,FLZ(0)-0.4,304)
7110   IF HT=5 THEN BFC=16:CALL BXD(4,EXX1-4,DY,0,EXX2+4,DY+EXY+4,FLZ(0)-0.4,304)
7120   FOR I=0 TO RMN(0)-1
7130     BFC=16:CALL BXD(10,RM(0,I,0),RM(0,I,1),FLZ(0)-0.4,RM(0,I,2),RM(0,I,3),FLZ(0),FN FLOORTEX(RM(0,I,4)))
7140   NEXT I
7150   FOR I=0 TO RMN(1)-1
7160     CALL FLOORPIECE(RM(1,I,0),RM(1,I,1),RM(1,I,2),RM(1,I,3),FN FLOORTEX(RM(1,I,4)))
7170   NEXT I
7180   ' the ceiling over the upper floor: one slab while none of its cells can be missing (D < 0.35)
7190   IF D<0.35 THEN
7200     CM=32:IF D>0.2 THEN CM=48
7210     BFC=CM:CALL BXD(10,0,0,FLZ(1)+26,LX,DY,FLZ(1)+28,TXI+4)
7220   ELSE
7230     FOR GX=0 TO INT((LX-0.001)/12)
7240       FOR GY=0 TO INT((DY-0.001)/12)
7250         IF D<0.35+0.4*FN HR(2000+GX,GY) THEN
7260           P1=GX*12:P2=MIN(LX,GX*12+12):Q1=GY*12:Q2=MIN(DY,GY*12+12)
7270           BFC=63:CALL BXD(10,P1,Q1,FLZ(1)+26,P2,Q2,FLZ(1)+28,TXI+4)
7280         END IF
7290       NEXT GY
7300     NEXT GX
7310   END IF
7320   ' the flat roofs of the garage and the extension: one slab while all cells stand (D < 0.3), top and underside only
7330   IF HT=2 THEN CALL FLATROOF(LX,0,LX+AI+4,AY+4)
7340   IF HT=5 THEN CALL FLATROOF(EXX1-4,DY,EXX2+4,DY+EXY+4)
7350 END PROC
7360 PROC FLATROOF(X1,Y1,X2,Y2)
7370   LOCAL GX,GY,P1,Q1,P2,Q2,T
7380   IF D<0.3 THEN
7390     BFC=48:CALL BXD(4,X1,Y1,FLZ(1)-3,X2,Y2,FLZ(1),304)
7400     EXIT PROC
7410   END IF
7420   FOR GX=INT(X1/12) TO INT((X2-0.001)/12)
7430     FOR GY=INT(Y1/12) TO INT((Y2-0.001)/12)
7440       IF D<0.3+0.5*FN HR(3000+GX,GY) AND D<0.7 THEN
7450         P1=MAX(X1,GX*12):P2=MIN(X2,GX*12+12):Q1=MAX(Y1,GY*12):Q2=MIN(Y2,GY*12+12)
7460         T=304:IF FN HR(3500+GX,GY)<D*1.5 THEN T=302
7470         BFC=63:CALL BXD(4,P1,Q1,FLZ(1)-3,P2,Q2,FLZ(1),T)
7480       END IF
7490     NEXT GY
7500   NEXT GX
7510 END PROC
7520 ' the stairs: 16 steps along the stairwell, solid
7530 PROC STAIRS
7540   LOCAL I,T,Y1,Y2
7550   T=312:IF D>0.25 THEN T=302
7560   FOR I=0 TO 15
7570     Y1=SY1+I*(SY2-SY1)/16:Y2=SY1+(I+1)*(SY2-SY1)/16
7580     BFC=27:CALL BXD(9,SX1,Y1,FLZ(0)-0.4,SX2,Y2,FLZ(0)+(I+1)*(FLZ(1)-FLZ(0))/16,T)
7590   NEXT I
7600 END PROC
7610 ' ---- the roof: a gable roof over the long side, cells of about 10 dm that burn away, rafters under them
7620 FUNC HZ(X,Y,SL)
7630   RETURN EZ+SL*MIN(MIN(X,LX-X),MIN(Y,DY-Y))
7640 END FUNC
7650 PROC ROOFGABLE
7660   LOCAL NX,WX,SL,OV,ZE,I,J,S,X1,X2,T1,T2,Y1,Y2,Z1,Z2,B,TX,R,IX
7670   OV=5:SL=(ZR-EZ)/(DY/2):ZE=EZ-OV*SL
7680   NX=INT((LX+6)/10)+1:WX=(LX+6)/NX
7690   FOR S=0 TO 1
7700     FOR I=0 TO NX-1
7710       FOR J=0 TO 3
7720         IX=S*1000+I*10+J
7730         R=FN HR(500,IX)
7740         IF D<0.3+0.5*R AND D<0.7 THEN
7750           X1=-3+I*WX:X2=X1+WX
7760           T1=J/4:T2=(J+1)/4
7770           Y1=-OV+(DY/2+OV)*T1:Y2=-OV+(DY/2+OV)*T2:Z1=ZE+(ZR-ZE)*T1:Z2=ZE+(ZR-ZE)*T2
7780           IF S=1 THEN Y1=DY-Y1:Y2=DY-Y2
7790           TX=TXR:IF FN HR(501,IX)<D*1.5 THEN TX=302
7800           B=M3D("VERTS",5+OB)
7810           M3D VERTEX 5+OB,X1*U,Y1*U,Z1*U:M3D VERTEX 5+OB,X2*U,Y1*U,Z1*U:M3D VERTEX 5+OB,X2*U,Y2*U,Z2*U:M3D VERTEX 5+OB,X1*U,Y2*U,Z2*U
7820           M3D QUAD 5+OB,B,B+1,B+2,B+3,TX
7830         END IF
7840       NEXT J
7850     NEXT I
7860   NEXT S
7870 END PROC
7880 FUNC FRONTX()
7890   LOCAL I,X
7900   X=LX/2
7910   FOR I=0 TO WN-1
7920     IF WIN(I,0)=0 AND WIN(I,1)=0 AND WIN(I,6)=2 THEN X=WIN(I,2)
7930   NEXT I
7940   RETURN X
7950 END FUNC
7960 ' rafters (ribbons under the roof, from X RX1 to RX2) and the ridge beam (RB1 to RB2): they burn with the roof
7970 PROC RAFTERS(RX1,RX2,RB1,RB2)
7980   LOCAL OV,SL,ZE,I,S,X1,Y1,Y2,Z1,Z2,B
7990   IF D>0.6 THEN EXIT PROC
8000   OV=5:SL=(ZR-EZ)/(DY/2):ZE=EZ-OV*SL
8010   FOR S=0 TO 1
8020     FOR I=0 TO INT((RX2-RX1)/8)
8030       X1=RX1+I*8
8040       Y1=-OV:Y2=DY/2:Z1=ZE-0.3:Z2=ZR-0.3
8050       IF S=1 THEN Y1=DY-Y1:Y2=DY-Y2
8060       B=M3D("VERTS",5+OB)
8070       M3D VERTEX 5+OB,(X1-0.6)*U,Y1*U,Z1*U:M3D VERTEX 5+OB,(X1+0.6)*U,Y1*U,Z1*U:M3D VERTEX 5+OB,(X1+0.6)*U,Y2*U,Z2*U:M3D VERTEX 5+OB,(X1-0.6)*U,Y2*U,Z2*U
8080       M3D QUAD 5+OB,B,B+1,B+2,B+3,302
8090     NEXT I
8100   NEXT S
8110   B=M3D("VERTS",5+OB)
8120   M3D VERTEX 5+OB,RB1*U,(DY/2-0.8)*U,(ZR-0.8)*U:M3D VERTEX 5+OB,RB2*U,(DY/2-0.8)*U,(ZR-0.8)*U:M3D VERTEX 5+OB,RB2*U,(DY/2+0.8)*U,(ZR-0.8)*U:M3D VERTEX 5+OB,RB1*U,(DY/2+0.8)*U,(ZR-0.8)*U
8130   M3D QUAD 5+OB,B,B+1,B+2,B+3,302
8140 END PROC
8150 ' the hip roof (type 3): four planes of one pitch, z = EZ + slope * the distance to the nearest wall, cells of the grid XBK / YBK (the creases run along its diagonals), two triangles a cell
8160 PROC ROOFHIP
8170   LOCAL OV,SL,NX,NY,I,J,K,N,X1,X2,Y1,Y2,CX,CY,IX,TX,R,B
8180   OV=5:SL=(ZR-EZ)/(DY/2)
8190   NX=0:XBK(0)=-OV:XBK(1)=0:NX=2
8200   K=10
8210   WHILE K<DY/2-1
8220     XBK(NX)=K:NX=NX+1:K=K+10
8230   WEND
8240   XBK(NX)=DY/2:NX=NX+1
8250   N=INT((LX-DY)/12)+1
8260   FOR I=1 TO N-1
8270     XBK(NX)=DY/2+(LX-DY)*I/N:NX=NX+1
8280   NEXT I
8290   XBK(NX)=LX-DY/2:NX=NX+1
8300   K=10:WHILE K<DY/2-1:K=K+10:WEND
8310   K=K-10
8320   WHILE K>=10
8330     XBK(NX)=LX-K:NX=NX+1:K=K-10
8340   WEND
8350   XBK(NX)=LX:XBK(NX+1)=LX+OV:NX=NX+2
8360   NY=0:YBK(0)=-OV:YBK(1)=0:NY=2
8370   K=10
8380   WHILE K<DY/2-1
8390     YBK(NY)=K:NY=NY+1:K=K+10
8400   WEND
8410   YBK(NY)=DY/2:NY=NY+1
8420   K=10:WHILE K<DY/2-1:K=K+10:WEND
8430   K=K-10
8440   WHILE K>=10
8450     YBK(NY)=DY-K:NY=NY+1:K=K-10
8460   WEND
8470   YBK(NY)=DY:YBK(NY+1)=DY+OV:NY=NY+2
8480   FOR I=0 TO NX-2
8490     FOR J=0 TO NY-2
8500       X1=XBK(I):X2=XBK(I+1):Y1=YBK(J):Y2=YBK(J+1)
8510       IX=I*40+J:R=FN HR(500,IX)
8520       IF D<0.3+0.5*R AND D<0.7 THEN
8530         TX=TXR:IF FN HR(501,IX)<D*1.5 THEN TX=302
8540         CX=(X1+X2)/2:CY=(Y1+Y2)/2
8550         B=M3D("VERTS",5+OB)
8560         IF (CX<LX/2)=(CY<DY/2) THEN
8570           M3D VERTEX 5+OB,X1*U,Y1*U,FN HZ(X1,Y1,SL)*U:M3D VERTEX 5+OB,X2*U,Y1*U,FN HZ(X2,Y1,SL)*U:M3D VERTEX 5+OB,X2*U,Y2*U,FN HZ(X2,Y2,SL)*U
8580           M3D FACE 5+OB,B,B+1,B+2,TX
8590           M3D VERTEX 5+OB,X1*U,Y1*U,FN HZ(X1,Y1,SL)*U:M3D VERTEX 5+OB,X2*U,Y2*U,FN HZ(X2,Y2,SL)*U:M3D VERTEX 5+OB,X1*U,Y2*U,FN HZ(X1,Y2,SL)*U
8600           M3D FACE 5+OB,B+3,B+4,B+5,TX
8610         ELSE
8620           M3D VERTEX 5+OB,X1*U,Y1*U,FN HZ(X1,Y1,SL)*U:M3D VERTEX 5+OB,X2*U,Y1*U,FN HZ(X2,Y1,SL)*U:M3D VERTEX 5+OB,X1*U,Y2*U,FN HZ(X1,Y2,SL)*U
8630           M3D FACE 5+OB,B,B+1,B+2,TX
8640           M3D VERTEX 5+OB,X2*U,Y1*U,FN HZ(X2,Y1,SL)*U:M3D VERTEX 5+OB,X2*U,Y2*U,FN HZ(X2,Y2,SL)*U:M3D VERTEX 5+OB,X1*U,Y2*U,FN HZ(X1,Y2,SL)*U
8650           M3D FACE 5+OB,B+3,B+4,B+5,TX
8660         END IF
8670       END IF
8680     NEXT J
8690   NEXT I
8700 END PROC
8710 PROC ROOF
8720   IF HT=3 THEN
8730     CALL ROOFHIP
8740     CALL RAFTERS(DY/2,LX-DY/2,DY/2,LX-DY/2)
8750   ELSE
8760     CALL ROOFGABLE
8770     CALL RAFTERS(2,LX-2,-3,LX+3)
8780   END IF
8790   ' the chimney stack on the west wall: brick, it stands at every stage
8800   BFC=31:CALL BXD(2,-6,DY/2-4,0,0,DY/2+4,ZR+5,303)
8810   IF HT=4 THEN CALL DORMER
8820 END PROC
8830 ' ---- furniture
8840 FUNC FUH(W,H,C)
8850   LOCAL L,S
8860   L=MAX(W,H):S=MIN(W,H)
8870   IF C=54 THEN
8880     IF L>=15 THEN RETURN 5
8890     RETURN 8
8900   END IF
8910   IF C=53 OR C=42 OR C=58 THEN
8920     IF L>1.6*S THEN RETURN 8
8930     RETURN 5
8940   END IF
8950   IF L<=4 THEN RETURN 9
8960   IF S<=4.5 THEN RETURN 17
8970   IF S<=7.5 AND L>=12 THEN RETURN 9
8980   RETURN 7.5
8990 END FUNC
9000 FUNC FUTEX(C)
9010   IF C=39 THEN RETURN 320
9020   IF C=40 THEN RETURN 321
9030   IF C=41 THEN RETURN 322
9040   IF C=42 THEN RETURN 323
9050   IF C=53 THEN RETURN 324
9060   IF C=54 THEN RETURN 325
9070   IF C=58 THEN RETURN 326
9080   RETURN 321
9090 END FUNC
9100 PROC FURNITURE
9110   LOCAL F,I,X1,Y1,X2,Y2,C,H,T,R,OK,CX,CY
9120   FOR F=0 TO 1
9130     FOR I=0 TO FUN(F)-1
9140       X1=FU(F,I,0):Y1=FU(F,I,1):X2=FU(F,I,2):Y2=FU(F,I,3):C=FUC(F,I)
9150       OK=-1
9160       CX=(X1+X2)/2:CY=(Y1+Y2)/2
9170       IF F=1 THEN
9180         IF NOT (D<0.55+0.4*FN HR(1000+INT(CX/12),INT(CY/12))) THEN OK=0
9190       END IF
9200       IF D>0.4 THEN
9210         IF FN HR(700+F,I)>1.25-D*0.9 THEN OK=0
9220       END IF
9230       IF OK THEN
9240         H=FN FUH(X2-X1,Y2-Y1,C)
9250         T=FN FUTEX(C):IF FN HR(710+F,I)<D*1.3 THEN T=302
9260         BFC=31:CALL BXD(6,X1,Y1,FLZ(F),X2,Y2,FLZ(F)+H,T)
9270       END IF
9280     NEXT I
9290   NEXT F
9300 END PROC
9310 ' ---- debris on the ground floor where the ceilings fell
9320 PROC RUBBLE
9330   LOCAL I,N,R,X,Y,W,H,L,K,F
9340   IF D<0.7 THEN EXIT PROC
9350   N=INT((D-0.5)*70)
9360   FOR I=0 TO N-1
9370     R=INT(FN HR(800,I)*RMN(0)):IF R>=RMN(0) THEN R=RMN(0)-1
9380     IF RM(0,R,4)<>10 OR FN HR(801,I)<0.4 THEN
9390       X=RM(0,R,0)+2+FN HR(802,I)*(RM(0,R,2)-RM(0,R,0)-4):Y=RM(0,R,1)+2+FN HR(803,I)*(RM(0,R,3)-RM(0,R,1)-4)
9400       IF FN HR(804,I)<0.35 THEN
9410         L=15+FN HR(805,I)*15
9420         IF FN HR(806,I)<0.5 THEN BFC=31:CALL BXD(8,X,Y,FLZ(0),X+L,Y+1.3,FLZ(0)+1.3,302) ELSE BFC=31:CALL BXD(8,X,Y,FLZ(0),X+1.3,Y+L,FLZ(0)+1.3,302)
9430       ELSE
9440         W=3+FN HR(807,I)*6:H=3+FN HR(808,I)*6:K=1+FN HR(809,I)*3
9450         IF FN HR(810,I)<0.5 THEN F=302 ELSE F=337
9460         BFC=31:CALL BXD(8,X,Y,FLZ(0),X+W,Y+H,FLZ(0)+K,F)
9470       END IF
9480     END IF
9490   NEXT I
9500 END PROC
9510 ' ---- windows and doors: flat quads in the openings (frames with see-through panes, doors ajar); present while the fire has not taken them
9520 ' the dormer of type 4 on the south slope, with a window, and the porch over the front door (posts and a canopy)
9530 PROC DORMER
9540   LOCAL SL,DX,DW,YF,ZR0,ZT,YB,R,T,B
9550   IF D>0.6 THEN EXIT PROC
9560   SL=(ZR-EZ)/(DY/2)
9570   DX=LX*(0.4+0.2*FN HR(190,1)):DW=18:YF=9
9580   ZR0=EZ+SL*YF:ZT=MIN(ZR0+14,ZR-6):YB=(ZT-EZ)/SL
9590   T=TXO:IF FN HR(191,1)<D*1.4 THEN T=302
9600   BFC=63:CALL BXD(2,DX-DW/2,YF,ZR0-1,DX+DW/2,YF+1.5,ZR0+3,T)
9610   BFC=63:CALL BXD(2,DX-DW/2,YF,ZT-3,DX+DW/2,YF+1.5,ZT,T)
9620   BFC=63:CALL BXD(2,DX-DW/2,YF,ZR0+3,DX-DW/2+2,YF+1.5,ZT-3,T)
9630   BFC=63:CALL BXD(2,DX+DW/2-2,YF,ZR0+3,DX+DW/2,YF+1.5,ZT-3,T)
9640   BFC=63:CALL BXD(2,DX-DW/2,YF,ZR0-1,DX-DW/2+1.2,YB+1,ZT,T)
9650   BFC=63:CALL BXD(2,DX+DW/2-1.2,YF,ZR0-1,DX+DW/2,YB+1,ZT,T)
9660   T=TXR:IF FN HR(192,1)<D*1.5 THEN T=302
9670   IF D<0.5+0.3*FN HR(193,1) THEN BFC=63:CALL BXD(2,DX-DW/2-1.5,YF-1.5,ZT,DX+DW/2+1.5,YB+1.5,ZT+1.2,T)
9680   IF D<0.3+0.5*FN HR(194,1) THEN
9690     B=M3D("VERTS",7+OB)
9700     M3D VERTEX 7+OB,(DX-DW/2+2)*U,(YF+0.75)*U,(ZT-3)*U,0,0:M3D VERTEX 7+OB,(DX+DW/2-2)*U,(YF+0.75)*U,(ZT-3)*U,64,0:M3D VERTEX 7+OB,(DX+DW/2-2)*U,(YF+0.75)*U,(ZR0+3)*U,64,96:M3D VERTEX 7+OB,(DX-DW/2+2)*U,(YF+0.75)*U,(ZR0+3)*U,0,96
9710     M3D QUAD 7+OB,B,B+1,B+2,B+3,331
9720   END IF
9730 END PROC
9740 PROC PORCH
9750   LOCAL P0,I,T,X
9760   P0=FN FRONTX()
9770   BFC=63:CALL BXD(4,P0-14,-14,0,P0+14,0.5,FLZ(0)-0.4,304)
9780   FOR I=0 TO 1
9790     IF FN HR(195,I)>D*0.5 THEN
9800       T=TXO:IF FN HR(196,I)<D*1.4 THEN T=302
9810       X=P0-13+I*24
9820       BFC=63:CALL BXD(2,X,-13,FLZ(0)-0.4,X+2,-11,FLZ(0)+22.5,T)
9830     END IF
9840   NEXT I
9850   IF D<0.5+0.3*FN HR(197,1) AND D<0.7 THEN
9860     T=TXR:IF FN HR(198,1)<D*1.5 THEN T=302
9870     BFC=63:CALL BXD(2,P0-15,-15,FLZ(0)+22.5,P0+15,1,FLZ(0)+24.3,T)
9880   END IF
9890 END PROC
9900 ' the bay window of type 5 on the front: two storeys, cheeks and a front with a window, a flat roof
9910 PROC BAY
9920   LOCAL F,Z1,Z2,B,T
9930   FOR F=0 TO 1
9940     PF=F:Z1=FLZ(F):Z2=FLZ(F)+26
9950     IF F=0 THEN Z1=0:Z2=FLZ(1)
9960     WTOP=FLZ(F)+26:PWID=170+F*5
9970     PTX=TXO:PTXC=302:PCAT=0:PFULL=-1
9980     CALL PIECE(2,1,BX1-1.5,BX1,-9,0,Z1,Z2)
9990     PWID=PWID+1:CALL PIECE(2,1,BX2,BX2+1.5,-9,0,Z1,Z2)
10000     PWID=PWID+1:CALL PIECE(2,0,-9,-7.5,BX1-1.5,BX2+1.5,Z1,FLZ(F)+3)
10010     PWID=PWID+1:CALL PIECE(2,0,-9,-7.5,BX1-1.5,BX2+1.5,FLZ(F)+22,Z2)
10020     PFULL=0
10030     BFC=63:CALL BXD(4,BX1-1.5,-9,FLZ(F)-3,BX2+1.5,0,FLZ(F)-0.4,304)
10040     BFC=16:CALL BXD(4,BX1,-7.5,FLZ(F)-0.4,BX2,0,FLZ(F),312)
10050     IF D<0.3+0.5*FN HR(180,F) AND D<0.7 THEN
10060       B=M3D("VERTS",7+OB)
10070       M3D VERTEX 7+OB,BX1*U,-8*U,(FLZ(F)+22)*U,0,0:M3D VERTEX 7+OB,BX2*U,-8*U,(FLZ(F)+22)*U,64,0:M3D VERTEX 7+OB,BX2*U,-8*U,(FLZ(F)+3)*U,64,96:M3D VERTEX 7+OB,BX1*U,-8*U,(FLZ(F)+3)*U,0,96
10080       M3D QUAD 7+OB,B,B+1,B+2,B+3,331
10090     END IF
10100   NEXT F
10110   IF D<0.5+0.3*FN HR(181,0) AND D<0.7 THEN
10120     T=TXR:IF FN HR(182,0)<D*1.5 THEN T=302
10130     BFC=63:CALL BXD(4,BX1-2.5,-10.5,FLZ(1)+26,BX2+2.5,0.5,FLZ(1)+28.6,T)
10140   END IF
10150 END PROC
10160 PROC LEAF(S,PP,W,Z1,Z2,TX)
10170   LOCAL B,X1,X2,Y1,Y2,PLN
10180   PLN=2
10190   IF S=0 OR S=4 THEN
10200     B=M3D("VERTS",7+OB)
10210     M3D VERTEX 7+OB,(PP-W/2)*U,PLN*U,Z2*U,0,0:M3D VERTEX 7+OB,(PP+W/2)*U,PLN*U,Z2*U,64,0:M3D VERTEX 7+OB,(PP+W/2)*U,PLN*U,Z1*U,64,96:M3D VERTEX 7+OB,(PP-W/2)*U,PLN*U,Z1*U,0,96
10220   END IF
10230   IF S=1 OR S=6 OR S=9 THEN
10240     IF S=1 THEN PLN=DY-2
10250     IF S=6 THEN PLN=AY+2
10260     IF S=9 THEN PLN=DY+EXY+2
10270     B=M3D("VERTS",7+OB)
10280     M3D VERTEX 7+OB,(PP-W/2)*U,PLN*U,Z2*U,0,0:M3D VERTEX 7+OB,(PP+W/2)*U,PLN*U,Z2*U,64,0:M3D VERTEX 7+OB,(PP+W/2)*U,PLN*U,Z1*U,64,96:M3D VERTEX 7+OB,(PP-W/2)*U,PLN*U,Z1*U,0,96
10290   END IF
10300   IF S=2 OR S=3 OR S=5 OR S=7 OR S=8 THEN
10310     IF S=3 THEN PLN=LX-2
10320     IF S=5 THEN PLN=LX+AI+2
10330     IF S=7 THEN PLN=EXX1-2
10340     IF S=8 THEN PLN=EXX2+2
10350     B=M3D("VERTS",7+OB)
10360     M3D VERTEX 7+OB,PLN*U,(PP-W/2)*U,Z2*U,0,0:M3D VERTEX 7+OB,PLN*U,(PP+W/2)*U,Z2*U,64,0:M3D VERTEX 7+OB,PLN*U,(PP+W/2)*U,Z1*U,64,96:M3D VERTEX 7+OB,PLN*U,(PP-W/2)*U,Z1*U,0,96
10370   END IF
10380   M3D QUAD 7+OB,B,B+1,B+2,B+3,TX
10390 END PROC
10400 ' a door leaf hinged at (HX0, HY0), W wide, TH degrees open from the closed position along the wall (AX 0: the wall runs along y, 1: along x)
10410 PROC DOORLEAF(AX,HX0,HY0,W,TH,Z1,Z2,TX)
10420   LOCAL B,DX,DYY,A
10430   A=TH*PI/180
10440   IF AX=0 THEN DX=W*SIN(A):DYY=W*COS(A) ELSE DX=W*COS(A):DYY=W*SIN(A)
10450   B=M3D("VERTS",7+OB)
10460   M3D VERTEX 7+OB,HX0*U,HY0*U,Z2*U,0,0:M3D VERTEX 7+OB,(HX0+DX)*U,(HY0+DYY)*U,Z2*U,64,0:M3D VERTEX 7+OB,(HX0+DX)*U,(HY0+DYY)*U,Z1*U,64,128:M3D VERTEX 7+OB,HX0*U,HY0*U,Z1*U,0,128
10470   M3D QUAD 7+OB,B,B+1,B+2,B+3,TX
10480 END PROC
10490 PROC LEAVES
10500   LOCAL I,F,S,PP,W,Z1,Z2,K,R,TH
10510   FOR I=0 TO WN-1
10520     F=WIN(I,0):S=WIN(I,1):PP=WIN(I,2):W=WIN(I,3):K=WIN(I,6)
10530     Z1=FLZ(F)+WIN(I,4):Z2=FLZ(F)+WIN(I,5)
10540     R=FN HR(600,I)
10550     IF D<0.3+0.5*R AND D<0.7 THEN
10560       IF K=0 OR K=1 THEN CALL LEAF(S,PP,W,Z1,Z2,331)
10570       IF K=4 THEN CALL LEAF(S,PP,W,Z1,Z2,333)
10580       IF K=2 OR K=3 THEN
10590         TH=80+FN HR(601,I)*12
10600         IF S=0 THEN CALL DOORLEAF(1,PP-W/2,2,W,TH,Z1,Z2,332)
10610         IF S=3 THEN CALL DOORLEAF(0,LX-2,PP-W/2,W,TH,Z1,Z2,332)
10620         IF S=1 THEN CALL DOORLEAF(1,PP-W/2,DY-2,W,TH,Z1,Z2,332)
10630       END IF
10640     END IF
10650   NEXT I
10660   FOR F=0 TO 1
10670     FOR I=0 TO DON(F)-1
10680       IF D<0.45+0.5*FN HR(620+F,I) AND D<0.75 THEN
10690         TH=60+FN HR(630+F,I)*35
10700         IF DOR(F,I,0)=0 THEN CALL DOORLEAF(0,DOR(F,I,1)+0.5,DOR(F,I,2)-DOR(F,I,3)/2,DOR(F,I,3),TH,FLZ(F),FLZ(F)+21,332)
10710         IF DOR(F,I,0)=1 THEN CALL DOORLEAF(1,DOR(F,I,1)-DOR(F,I,3)/2,DOR(F,I,2)+0.5,DOR(F,I,3),TH,FLZ(F),FLZ(F)+21,332)
10720       END IF
10730     NEXT I
10740   NEXT F
10750 END PROC
10760 ' ---- the pictures
10770 PROC MKFLAT(N,H,S)
10780   LOCAL I
10790   GFX CLEAR FN W3K_C(H,S)
10800   FOR I=1 TO 140
10810     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H,FN CLP(S-2+FN W3K_R(5),1,15))
10820   NEXT I
10830   CALL W3K_GRAB(N,64,64)
10840 END PROC
10850 PROC MKCHAR(N)
10860   LOCAL I
10870   GFX CLEAR FN W3K_C(0,1)
10880   FOR I=1 TO 260
10890     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(0,FN W3K_R(5))
10900   NEXT I
10910   FOR I=1 TO 30
10920     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(12,2+FN W3K_R(3))
10930   NEXT I
10940   CALL W3K_GRAB(N,64,64)
10950 END PROC
10960 PROC MKGLASS(N)
10970   LOCAL I
10980   GFX CLEAR FN W3K_C(9,4)
10990   FOR I=1 TO 60
11000     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(7,9+FN W3K_R(6))
11010   NEXT I
11020   CALL W3K_GRAB(N,64,64)
11030 END PROC
11040 PROC MKTEX
11050   LOCAL I,H
11060   RANDOMIZE 1987
11070   CALL W3K_GRASS(334):CALL W3K_SKY(335)
11080   CALL W3K_BRICK(303,0):CALL W3K_STONE(304,0)
11090   CALL MKCHAR(302):CALL MKGLASS(330):CALL W3K_STONE(337,0)
11100   CALL W3K_PLANKS(312):CALL W3K_TILES(313,8,0)
11110   CALL W3K_WINDOW(331):CALL W3K_DOORTEX(332,12):CALL W3K_DOORTEX(333,0)
11120   CALL MKFLAT(320,12,12):CALL MKFLAT(321,12,9):CALL MKFLAT(322,12,6):CALL MKFLAT(323,8,8):CALL MKFLAT(324,1,8):CALL MKFLAT(325,0,15):CALL MKFLAT(326,5,7)
11130 END PROC
11140 ' the pictures that depend on the house: the outer plaster, the six room colours, the roof
11150 PROC MKHOUSETEX
11160   LOCAL I,H,S
11170   RANDOMIZE SD
11180   I=INT(FN HR(40,1)*6):IF I>5 THEN I=5
11190   RESTORE OUTERHUES
11200   FOR H=0 TO I:READ OHU,OSH:NEXT H
11210   CALL MKFLAT(TXO,OHU,OSH)
11220   RESTORE INNERHUES
11230   FOR H=0 TO 5
11240     READ IHU,ISH
11250     CALL MKFLAT(TXI+H,IHU,ISH)
11260   NEXT H
11270   I=INT(FN HR(40,2)*3):IF I>2 THEN I=2
11280   H=1:IF I=1 THEN H=12
11290   IF I=2 THEN H=0
11300   RHU=H
11310   CALL W3K_TILES(TXR,H,H)
11320 END PROC
11330 ' ---- the whole house
11340 PROC MAKEHOUSE
11350   LOCAL I,T0
11360   T0=TI
11370   CALL GENHOUSE
11380   D=DS(STG)
11390   CALL MKHOUSETEX
11400   HOLE=(D>=0.5):HS=INT(FN HR(9,1)*4):IF HS>3 THEN HS=3
11410   IF HT=2 AND HS=3 THEN HS=1
11420   IF HT=4 AND HS=0 THEN HS=1
11430   IF HT=5 THEN HS=2+(HS AND 1)
11440   IF HS<2 THEN HC=LX*(0.3+0.4*FN HR(9,2)) ELSE HC=DY*(0.3+0.4*FN HR(9,2))
11450   HRAD=8+2*FN HR(9,3):HZC=FLZ(0)+13
11460   FOR I=1 TO 10:M3D OBJECT I+OB,0,235:NEXT I
11470   M3D OBJECT 5+OB,16,235:M3D OBJECT 7+OB,21,235:M3D OBJECT 3+OB,0,235
11480   IF NOT VIL THEN M3D BOX 1,-2400,-2400,-30,2400,2400,0,334,16
11490   CALL SHELLS
11500   FOR I=0 TO RMN(0)-1:CALL ROOMLAYERS(0,I):NEXT I
11510   FOR I=0 TO RMN(1)-1:CALL ROOMLAYERS(1,I):NEXT I
11520   CALL GABLES
11530   CALL SLABS
11540   CALL STAIRS
11550   CALL ROOF
11560   IF HT=4 THEN CALL PORCH
11570   IF HT=5 THEN CALL BAY
11580   CALL FURNITURE
11590   CALL RUBBLE
11600   CALL LEAVES
11610   BMS=INT((TI-T0)*1000/60)
11620   BVT=0
11630   FOR I=1 TO 10:BVT=BVT+M3D("VERTS",I+OB):NEXT I
11640   IF VIL THEN CALL BUILDFAR
11650   INTON=-2
11660   CALL CHOUSE
11670 END PROC
11680 ' the interior (the room walls, floors and ceilings, furniture, stairs, debris: the objects 3, 6, 8, 9, 10) is only there when the viewer is within NEARD dm of the house or inside (a house seen from afar needs only its outside); IMODE 1 always, 2 never
11690 PROC INTVIS
11700   LOCAL X,Y,DX,DYY,VS,X1,Y1
11710   X=M3D("X")/U:Y=M3D("Y")/U
11720   X1=LX:Y1=DY
11730   IF HT=2 THEN X1=LX+AI+4
11740   IF HT=5 THEN Y1=DY+EXY+4
11750   DX=MAX(MAX(-6-X,X-X1),0):DYY=MAX(MAX(-15-Y,Y-Y1),0)
11760   VS=(SQR(DX*DX+DYY*DYY)<NEARD)
11770   IF IMODE=1 THEN VS=-1
11780   IF IMODE=2 THEN VS=0
11790   IF VS<>INTON THEN
11800     M3D OBJSHOW 3+OB,-VS:M3D OBJSHOW 6+OB,-VS:M3D OBJSHOW 8+OB,-VS:M3D OBJSHOW 9+OB,-VS:M3D OBJSHOW 10+OB,-VS
11810     INTON=VS
11820   END IF
11830 END PROC
11840 ' ---- the village: the 25 looks (5 types x 5 stages) are built once as prototypes (the objects 100 + 20 K ...; hidden), a far version (a box with a painted facade and a roof,
11850 ' about 40 triangles) is added to each, and the houses are INSTANCES of them (M3D INSTANCE: the mesh is shared): far = the far version, middle = the outside (outer walls, plinth,
11860 ' roof, windows and doors), near = everything. The level of a house comes from its distance (NEARU, MIDU units).
11870 ' the facade of the main house as a picture of 128 x 64 (the wall's length LEN dm over 128 pixels, the height to the eaves over 64): windows and doors from the list, soot by the damage
11880 PROC FACADE(N,SC0,WL)
11890   LOCAL I,F,X1,X2,Y1,Y2,SX,SY,K
11900   SX=128/WL:SY=64/EZ
11910   RANDOMIZE SD
11920   GFX CLEAR FN W3K_C(OHU,OSH)
11930   FOR I=1 TO 70
11940     GFX PSET FN W3K_R(128),FN W3K_R(64),FN W3K_C(OHU,FN CLP(OSH-2+FN W3K_R(4),1,15))
11950   NEXT I
11960   FOR I=0 TO WN-1
11970     IF WIN(I,1)=SC0 AND WIN(I,6)<5 THEN
11980       F=WIN(I,0)
11990       X1=INT((WIN(I,2)-WIN(I,3)/2)*SX):X2=INT((WIN(I,2)+WIN(I,3)/2)*SX)
12000       Y1=64-INT((FLZ(F)+WIN(I,5))*SY):Y2=64-INT((FLZ(F)+WIN(I,4))*SY)
12010       K=WIN(I,6)
12020       IF K=4 THEN
12030         GFX LINE X1,Y1,X2,Y2,FN W3K_C(0,8),BF
12040       ELSE
12050         IF K=2 OR K=3 THEN
12060           GFX LINE X1,Y1,X2,Y2,FN W3K_C(12,6),BF
12070         ELSE
12080           IF D>=0.5 THEN GFX LINE X1,Y1,X2,Y2,FN W3K_C(0,1),BF ELSE GFX LINE X1,Y1,X2,Y2,FN W3K_C(9,4),BF
12090           GFX LINE X1,Y1,X2,Y2,FN W3K_C(12,8),B
12100         END IF
12110       END IF
12120       IF FN HR(60,I)<D*1.4 AND K<>4 THEN GFX LINE X1-2,Y1-9,X2+2,Y1-1,FN W3K_C(0,2),BF
12130     END IF
12140   NEXT I
12150   FOR I=1 TO INT(D*300)
12160     GFX PSET FN W3K_R(128),FN W3K_R(64),FN W3K_C(0,FN W3K_R(4))
12170   NEXT I
12180   CALL W3K_GRAB(N,128,64)
12190 END PROC
12200 ' a vertical quad of the far version from (X1,Y1) to (X2,Y2), up to the height HW, with the facade TX (OF the object, VT the picture row of the top)
12210 PROC FQUAD(X1,Y1,X2,Y2,HW,TX)
12220   LOCAL B
12230   B=M3D("VERTS",OF)
12240   M3D VERTEX OF,X1*U,Y1*U,HW*U,0,VT:M3D VERTEX OF,X2*U,Y2*U,HW*U,128,VT:M3D VERTEX OF,X2*U,Y2*U,0,128,64:M3D VERTEX OF,X1*U,Y1*U,0,0,64
12250   M3D QUAD OF,B,B+1,B+2,B+3,TX
12260 END PROC
12270 ' a roof piece of the far version: the corners are set with FP, then a triangle (N = 3) or a quad (N = 4)
12280 PROC FP(I,X,Y,Z)
12290   QX(I)=X:QY(I)=Y:QZ(I)=Z
12300 END PROC
12310 PROC FRQ(TX,N)
12320   LOCAL B,I
12330   B=M3D("VERTS",OF)
12340   FOR I=0 TO N-1:M3D VERTEX OF,QX(I)*U,QY(I)*U,QZ(I)*U:NEXT I
12350   IF N=3 THEN M3D FACE OF,B,B+1,B+2,TX ELSE M3D QUAD OF,B,B+1,B+2,B+3,TX
12360 END PROC
12370 PROC BUILDFAR
12380   LOCAL HW,OV,SL,ZE,T1,T2,HA
12390   OF=11+OB
12400   M3D OBJECT OF,16,235
12410   TXF=TXO+8
12420   CALL FACADE(TXF,0,LX):CALL FACADE(TXF+1,2,DY)
12430   HW=EZ
12440   IF STG=3 THEN HW=FLZ(1)+(EZ-FLZ(1))*0.35
12450   IF STG=4 THEN HW=FLZ(1)*0.82
12460   VT=64-INT(64*HW/EZ)
12470   CALL FQUAD(0,0,LX,0,HW,TXF):CALL FQUAD(LX,DY,0,DY,HW,TXF):CALL FQUAD(0,DY,0,0,HW,TXF+1):CALL FQUAD(LX,0,LX,DY,HW,TXF+1)
12480   IF STG<=2 THEN
12490     OV=5:SL=(ZR-EZ)/(DY/2):ZE=EZ-OV*SL
12500     T1=TXR:T2=TXR:IF STG=2 THEN T1=302
12510     IF HT=3 THEN
12520       CALL FP(0,-OV,-OV,ZE):CALL FP(1,LX+OV,-OV,ZE):CALL FP(2,LX-DY/2,DY/2,ZR):CALL FP(3,DY/2,DY/2,ZR):CALL FRQ(TXR,4)
12530       IF STG<2 THEN CALL FP(0,LX+OV,DY+OV,ZE):CALL FP(1,-OV,DY+OV,ZE):CALL FP(2,DY/2,DY/2,ZR):CALL FP(3,LX-DY/2,DY/2,ZR):CALL FRQ(TXR,4)
12540       CALL FP(0,-OV,DY+OV,ZE):CALL FP(1,-OV,-OV,ZE):CALL FP(2,DY/2,DY/2,ZR):CALL FRQ(T1,3)
12550       IF STG<2 THEN CALL FP(0,LX+OV,-OV,ZE):CALL FP(1,LX+OV,DY+OV,ZE):CALL FP(2,LX-DY/2,DY/2,ZR):CALL FRQ(TXR,3)
12560     ELSE
12570       CALL FP(0,-3,-OV,ZE):CALL FP(1,LX+3,-OV,ZE):CALL FP(2,LX+3,DY/2,ZR):CALL FP(3,-3,DY/2,ZR):CALL FRQ(TXR,4)
12580       IF STG<2 THEN CALL FP(0,LX+3,DY+OV,ZE):CALL FP(1,-3,DY+OV,ZE):CALL FP(2,-3,DY/2,ZR):CALL FP(3,LX+3,DY/2,ZR):CALL FRQ(TXR,4)
12590       CALL FP(0,0,0,EZ):CALL FP(1,0,DY,EZ):CALL FP(2,0,DY/2,ZR):CALL FRQ(TXO,3)
12600       CALL FP(0,LX,DY,EZ):CALL FP(1,LX,0,EZ):CALL FP(2,LX,DY/2,ZR):CALL FRQ(TXO,3)
12610     END IF
12620   END IF
12630   M3D BOX OF,-6*U,(DY/2-4)*U,0,0,(DY/2+4)*U,(ZR+5)*U,303,31
12640   HA=MIN(FLZ(1),HW)
12650   IF HT=2 THEN M3D BOX OF,LX*U,0,0,(LX+AI+4)*U,(AY+4)*U,HA*U,TXO,61
12660   IF HT=5 THEN M3D BOX OF,(EXX1-4)*U,DY*U,0,(EXX2+4)*U,(DY+EXY+4)*U,HA*U,TXO,55
12670 END PROC
12680 ' one look K (0 .. 24): type K\5+1, stage K MOD 5, a seed of its own; the prototypes are hidden
12690 PROC BUILDLOOK(K)
12700   LOCAL I
12710   HT=K\5+1:STG=K MOD 5:SD=11+K*7
12720   OB=100+K*20
12730   TXO=600+K*10:TXI=TXO+1:TXR=TXO+7
12740   CALL MAKEHOUSE
12750   FOR I=1 TO 11:M3D OBJSHOW OB+I,0:NEXT I
12760   LKW(K)=LX:IF HT=2 THEN LKW(K)=LX+AI+4
12770   LKD(K)=DY:IF HT=5 THEN LKD(K)=DY+EXY+4
12780 END PROC
12790 PROC VILLAGE
12800   LOCAL K,H,I,J,P,IB,OK
12810   M3D OBJFREE 1,9000
12820   M3D OBJECT 1,0,235:M3D BOX 1,-3000,-3000,-30,8000,7000,0,334,16
12830   VIL=-1
12840   FOR K=0 TO 24:CALL BUILDLOOK(K):NEXT K
12850   NHV=0
12860   FOR J=0 TO 4
12870     FOR I=0 TO 6
12880       H=NHV:NHV=NHV+1
12890       K=INT(HASH(77,I,J)*25):IF K>24 THEN K=24
12900       HLK(H)=K:HPX(H)=I*700:HPY(H)=J*900
12910       HCX(H)=HPX(H)+LKW(K)*U/2:HCY(H)=HPY(H)+LKD(K)*U/2
12920       OK=100+K*20
12930       IB=4000+H*12
12940       PM(0)=OK+11:PM(1)=OK+2:PM(2)=OK+4:PM(3)=OK+5:PM(4)=OK+7:PM(5)=OK+3:PM(6)=OK+6:PM(7)=OK+8:PM(8)=OK+9:PM(9)=OK+10
12950       FOR P=0 TO 9
12960         M3D INSTANCE IB+P,PM(P),HPX(H),HPY(H),0
12970         M3D OBJSHOW IB+P,0
12980       NEXT P
12990       HLV(H)=-1
13000     NEXT I
13010   NEXT J
13020   OB=0
13030   M3D CAMERA 1500,-500,0,90
13040 END PROC
13050 ' the level of every house by its distance to the viewer: 0 far version, 1 the outside, 2 everything
13060 PROC LODUPD
13070   LOCAL H,DX,DYY,DD,L,IB,P,N0,N1,N2
13080   N0=0:N1=0:N2=0
13090   FOR H=0 TO NHV-1
13100     DX=M3D("X")-HCX(H):DYY=M3D("Y")-HCY(H)
13110     DD=SQR(DX*DX+DYY*DYY)
13120     L=0:IF DD<MIDU THEN L=1
13130     IF DD<NEARU THEN L=2
13140     IF L<>HLV(H) THEN
13150       IB=4000+H*12
13160       M3D OBJSHOW IB,-(L=0)
13170       FOR P=1 TO 4:M3D OBJSHOW IB+P,-(L>=1):NEXT P
13180       FOR P=5 TO 9:M3D OBJSHOW IB+P,-(L=2):NEXT P
13190       HLV(H)=L
13200     END IF
13210     IF L=0 THEN N0=N0+1
13220     IF L=1 THEN N1=N1+1
13230     IF L=2 THEN N2=N2+1
13240   NEXT H
13250   LF=N0:LM=N1:LN=N2
13260 END PROC
13270 ' the same house made by the C generator (house.c, M3D HOUSE), 60 dm east of the BASIC one, to compare them (key C; key L: the far / the middle level of detail)
13280 PROC CHOUSE
13290   IF CMODE THEN
13300     M3D HOUSE 900,HT,STG,SD,CLV
13310     M3D OBJPOS 900,(LX+60)*U,0,0
13320   ELSE
13330     M3D OBJFREE 900,900
13340   END IF
13350 END PROC
13360 PROC STAGENAME
13370   SN$="INTACT"
13380   IF STG=1 THEN SN$="SCORCHED"
13390   IF STG=2 THEN SN$="ROOF BURNT"
13400   IF STG=3 THEN SN$="FLOORS FELL"
13410   IF STG=4 THEN SN$="SHELL"
13420 END PROC
13430 ' put the viewer in front of the house (CX, CY in dm), looking at it
13440 PROC CAMENV
13450   LOCAL A$,P,I
13460   A$=ENV$("H3_CAM")+","
13470   FOR I=0 TO 4
13480     P=INSTR(A$,",")
13490     CV(I)=VAL(LEFT$(A$,P-1)):A$=MID$(A$,P+1)
13500   NEXT I
13510   M3D CAMERA CV(0)*U,CV(1)*U,CV(2)*U,CV(3),CV(4)
13520 END PROC
13530 PROC STARTPOS
13540   M3D CAMERA FN FRONTX()*U,-60*U,0,90
13550 END PROC
13560 ' the self test (H3_TEST=1, no graphics, run by engine1999c): the invariants of 100 houses of each of the five types (the generator part: ridge height, rooms, the garage annex of type 2 and the bay window and extension of type 5 with their doors and windows, windows on their walls, furniture inside the rooms); exit status = the number of failures
13570 PROC SELFTEST3
13580   LOCAL T,S,I,F,J,NH,NF,BAD,N0,K3,K4,K5,OKF,KT
13590   NH=0:NF=0
13600   FOR T=1 TO 5
13610     HT=T
13620     FOR S=1 TO 100
13630       SD=S:CALL GENHOUSE:NH=NH+1:BAD=0
13640       IF ZR>100 OR ZR<EZ+8 OR EZ>FLZ(1)+34 OR ZR<85 THEN BAD=1
13650       N0=6:IF HT=2 OR HT=5 THEN N0=7
13660       IF RMN(0)<>N0 OR RMN(1)<>5 THEN BAD=2
13670       K3=0:K4=0:K5=0:KT=0
13680       FOR I=0 TO WN-1
13690         IF WIN(I,6)=3 THEN K3=K3+1
13700         IF WIN(I,6)=4 THEN K4=K4+1
13710         IF WIN(I,6)=5 THEN K5=K5+1
13720         IF WIN(I,6)=1 AND WIN(I,1)=9 THEN KT=KT+1
13730         IF WIN(I,1)>3 AND HT<>2 AND HT<>5 THEN BAD=8
13740       NEXT I
13750       IF HT=2 THEN
13760         IF RM(0,6,0)<>LX OR RM(0,6,2)<>LX+AI OR RM(0,6,1)<>TW OR RM(0,6,3)<>AY OR AY+4>DY THEN BAD=3
13770         FOR I=0 TO WN-1
13780           IF WIN(I,6)=3 THEN
13790             IF WIN(I,1)<>3 OR WIN(I,2)<TW+5 OR WIN(I,2)>AY-5 THEN BAD=4
13800           END IF
13810           IF WIN(I,6)=4 THEN
13820             IF WIN(I,1)<>4 OR WIN(I,2)-WIN(I,3)/2<LX OR WIN(I,2)+WIN(I,3)/2>LX+AI THEN BAD=5
13830           END IF
13840           IF WIN(I,0)=0 AND WIN(I,1)=3 AND WIN(I,6)<>3 AND WIN(I,2)-WIN(I,3)/2<AY+TW THEN BAD=6
13850         NEXT I
13860         IF K3<>1 OR K4<>1 THEN BAD=7
13870       END IF
13880       IF HT=5 THEN
13890         IF RM(0,6,1)<>DY OR RM(0,6,3)<>DY+EXY OR RM(0,6,0)<>EXX1 OR RM(0,6,2)<>EXX2 OR EXX1<TW+4 OR EXX2>LX-TW-4 THEN BAD=3
13900         IF K3<>1 OR K5<>2 OR KT<>1 THEN BAD=7
13910         FOR I=0 TO WN-1
13920           IF WIN(I,6)=3 THEN
13930             IF WIN(I,1)<>1 OR WIN(I,2)<EXX1+5 OR WIN(I,2)>EXX2-5 THEN BAD=4
13940           END IF
13950           IF WIN(I,6)=5 THEN
13960             IF WIN(I,1)<>0 OR WIN(I,2)-WIN(I,3)/2<TW OR WIN(I,3)<8 THEN BAD=5
13970           END IF
13980           IF WIN(I,6)<>5 AND WIN(I,1)=0 AND WIN(I,2)+WIN(I,3)/2>BX1-1 AND WIN(I,2)-WIN(I,3)/2<BX2+1 THEN BAD=6
13990           IF WIN(I,6)<>3 AND WIN(I,0)=0 AND WIN(I,1)=1 AND WIN(I,2)+WIN(I,3)/2>EXX1-4 AND WIN(I,2)-WIN(I,3)/2<EXX2+4 THEN BAD=6
14000         NEXT I
14010       END IF
14020       FOR F=0 TO 1
14030         FOR I=0 TO FUN(F)-1
14040           OKF=0
14050           FOR J=0 TO RMN(F)-1
14060             IF FU(F,I,0)>=RM(F,J,0)-0.01 AND FU(F,I,2)<=RM(F,J,2)+0.01 AND FU(F,I,1)>=RM(F,J,1)-0.01 AND FU(F,I,3)<=RM(F,J,3)+0.01 THEN OKF=-1
14070           NEXT J
14080           IF NOT OKF THEN BAD=9
14090         NEXT I
14100       NEXT F
14110       IF BAD>0 THEN PRINT "house";S;" type";T;" fails check";BAD:NF=NF+1
14120     NEXT S
14130   NEXT T
14140   PRINT "house3d selftest: ";NH;" houses, ";NF;" failures"
14150   IF NF>0 THEN BYE 1
14160   BYE 0
14170 END PROC
