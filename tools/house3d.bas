10 ' HOUSE3D - the 3D version of the family houses of HOUSEGEN (tools/housegen.bas) on the mesh renderer (M3D): a house you can walk round and into. It is the study for the ruins of the
20 ' static world (docs/world-subsystem.md "Ruins"). Five house types (1 the plain gable house, 2 the same with a garage annex at the east gable, 3 a hip roof, 4 a steep roof with a dormer and a porch, 5 with a bay window and a flat roofed extension at the back) at five stages of damage by a directed
30 ' energy weapon (1 intact, 2 scorched, 3 roof burnt, 4 the floors fallen, 5 a shell), all from one seed: the same house burns the same way at every stage (a piece that is gone
40 ' at a stage stays gone). Run it in the window version: LOAD "tools/house3d", RUN. Keys: W A S D / arrows walk, R F or Page Up / Down look, 1 .. 5 the stage, T the type,
50 ' N the next seed, H back to the start, Q quit (T cycles the five types). The environment variables H3_TYPE, H3_STAGE, H3_SEED start with another house, H3_CAM="x,y,z,yaw,pitch" (dm, degrees) with another viewpoint.
60 ' Units: the builder works in dm (10 cm), the game in units of 3.2 cm (U = 3.125 a dm). The generator part (rooms, doors, windows, furniture) is that of HOUSEGEN.
70 LOAD LIBRARY "w3dkit"
80 DIM RM(2,8,6),RMN(2),DOR(2,16,4),DON(2),WIN(40,7),FU(2,64,5),FUC(2,64),FUN(2),CL(2,24,4),CLN(2),FLZ(2),DS(5),OA1(70),OA2(70),OZ1(70),OZ2(70),OTY(70),ZB(160),LA1(70),LA2(70),RA1(40),RA2(40),CV(5),XBK(40),YBK(40)
90 ON ERROR GOTO FAILED
100 U=3.125:TW=4:FLZ(0)=3:FLZ(1)=32:RC=0:SD=1:WN=0:PW=0:OKP=0
110 GOTO MAIN
120 ' ------------------------------------------------------------------------------------------------ random numbers (from the seed and a counter: the same house every time)
130 FUNC RN()
140   RC=RC+1
150   RETURN HASH(SD*7919,RC,17)
160 END FUNC
170 FUNC RI(A,B)
180   RETURN A+INT(FN RN()*(B-A+1))
190 END FUNC
200 ' the pixel column of the horizontal house coordinate A (dm) in the view being drawn (EVM 0 front, 1 the gable side seen from the west: y runs to the left), and the pixel row of a height Z
210 ' the plan's pixel column / row (the street side, y = 0, is at the bottom)
220 ' is the box free of furniture and of the door and stair clearances of floor F? (-1 yes, 0 no)
230 FUNC FREEBOX(F,X1,Y1,X2,Y2)
240   LOCAL I
250   FOR I=0 TO FUN(F)-1
260     IF X1<FU(F,I,2) AND FU(F,I,0)<X2 AND Y1<FU(F,I,3) AND FU(F,I,1)<Y2 THEN RETURN 0
270   NEXT I
280   FOR I=0 TO CLN(F)-1
290     IF X1<CL(F,I,2) AND CL(F,I,0)<X2 AND Y1<CL(F,I,3) AND CL(F,I,1)<Y2 THEN RETURN 0
300   NEXT I
310   RETURN -1
320 END FUNC
330 ' ------------------------------------------------------------------------------------------------ the house: parts
340 PROC ADDROOM(F,X1,Y1,X2,Y2,T)
350   LOCAL N
360   N=RMN(F)
370   RM(F,N,0)=X1:RM(F,N,1)=Y1:RM(F,N,2)=X2:RM(F,N,3)=Y2:RM(F,N,4)=T:RM(F,N,5)=20+FN RI(0,5)
380   RMN(F)=N+1
390 END PROC
400 ' a door in a partition: AX 0 a wall at x = X (1 dm thick) with the door centred at y = Y, AX 1 a wall at y = Y with the door centred at x = X; W wide
410 PROC ADDDOOR(F,AX,X,Y,W)
420   LOCAL N,C
430   N=DON(F):DOR(F,N,0)=AX:DOR(F,N,1)=X:DOR(F,N,2)=Y:DOR(F,N,3)=W:DON(F)=N+1
440   C=CLN(F)
450   IF AX=0 THEN
460     CL(F,C,0)=X-9:CL(F,C,1)=Y-W/2:CL(F,C,2)=X+10:CL(F,C,3)=Y+W/2
470   ELSE
480     CL(F,C,0)=X-W/2:CL(F,C,1)=Y-9:CL(F,C,2)=X+W/2:CL(F,C,3)=Y+10
490   END IF
500   CLN(F)=C+1
510 END PROC
520 ' a window or door in an outer wall: SIDE 0 front (y = 0), 1 back, 2 west (x = 0), 3 east; POS along the wall; kind 0 window, 1 terrace door, 2 front door
530 PROC ADDWIN(F,SIDE,PP,W,SL,HD,K)
540   IF WN>=40 THEN EXIT PROC
550   WIN(WN,0)=F:WIN(WN,1)=SIDE:WIN(WN,2)=PP:WIN(WN,3)=W:WIN(WN,4)=SL:WIN(WN,5)=HD:WIN(WN,6)=K
560   WN=WN+1
570 END PROC
580 ' windows along one wall of a room from A1 to A2 (a terrace door instead when K = 1 and the wall is wide enough)
590 PROC WALLWIN(F,SIDE,A1,A2,W,SL,HD,K)
600   LOCAL N,P,W2,S2,H2,K2
610   N=INT((A2-A1)/32):IF N<1 THEN N=1
620   W2=W:S2=SL:H2=HD:K2=K
630   IF K2=1 THEN
640     IF A2-A1<28 THEN
650       K2=0
660     ELSE
670       N=1:W2=20:S2=0:H2=22
680     END IF
690   END IF
700   FOR P=0 TO N-1
710     CALL ADDWIN(F,SIDE,A1+(A2-A1)*(P+0.5)/N,W2,S2,H2,K2)
720   NEXT P
730 END PROC
740 PROC ROOMWIN(F,I)
750   LOCAL X1,Y1,X2,Y2,T,W,SL,HD,K
760   X1=RM(F,I,0):Y1=RM(F,I,1):X2=RM(F,I,2):Y2=RM(F,I,3):T=RM(F,I,4)
770   W=12:SL=9:HD=21
780   IF T=2 OR T=9 THEN W=6:SL=14:HD=22
790   IF Y1=TW THEN CALL WALLWIN(F,0,X1,X2,W,SL,HD,0)
800   IF Y2=DY-TW THEN
810     K=0:IF T=3 THEN K=1
820     CALL WALLWIN(F,1,X1,X2,W,SL,HD,K)
830   END IF
840   IF X1=TW THEN CALL WALLWIN(F,2,Y1,Y2,W,SL,HD,0)
850   IF X2=LX-TW THEN CALL WALLWIN(F,3,Y1,Y2,W,SL,HD,0)
860 END PROC
870 PROC ADDFU(F,X1,Y1,X2,Y2,C)
880   LOCAL N
890   N=FUN(F)
900   IF N>=64 THEN EXIT PROC
910   FU(F,N,0)=X1:FU(F,N,1)=Y1:FU(F,N,2)=X2:FU(F,N,3)=Y2:FUC(F,N)=C:FUN(F)=N+1
920 END PROC
930 ' a piece of furniture against a wall of room I: W along the wall, H deep; WALL 0 south (y1 side), 1 north, 2 west, 3 east, tried from WALL on; PF 0 .. 1 where along the wall
940 ' (the next walls and places are tried when it does not fit); sets OKP and PW (the wall used) and LQ1 .. LQ4 (the box)
950 PROC SETF(F,I,W,H,WALL,PF,C)
960   LOCAL T,WL,RX1,RY1,RX2,RY2,LNG,Q,A,X1,Y1,X2,Y2
970   RX1=RM(F,I,0):RY1=RM(F,I,1):RX2=RM(F,I,2):RY2=RM(F,I,3)
980   OKP=0
990   FOR T=0 TO 7
1000     WL=(WALL+T) MOD 4
1010     IF WL<2 THEN LNG=RX2-RX1-W ELSE LNG=RY2-RY1-W
1020     IF LNG>=0 THEN
1030       Q=PF+T*0.37:Q=Q-INT(Q)
1040       A=Q*LNG
1050       IF WL=0 THEN X1=RX1+A:Y1=RY1:X2=X1+W:Y2=Y1+H
1060       IF WL=1 THEN X1=RX1+A:Y2=RY2:X2=X1+W:Y1=Y2-H
1070       IF WL=2 THEN Y1=RY1+A:X1=RX1:Y2=Y1+W:X2=X1+H
1080       IF WL=3 THEN Y1=RY1+A:X2=RX2:Y2=Y1+W:X1=X2-H
1090       IF X1>=RX1 AND X2<=RX2 AND Y1>=RY1 AND Y2<=RY2 THEN
1100         IF FN FREEBOX(F,X1,Y1,X2,Y2) THEN
1110           CALL ADDFU(F,X1,Y1,X2,Y2,C)
1120           LQ1=X1:LQ2=Y1:LQ3=X2:LQ4=Y2:PW=WL:OKP=-1
1130           EXIT PROC
1140         END IF
1150       END IF
1160     END IF
1170   NEXT T
1180 END PROC
1190 ' a piece of furniture in the open (the middle of the room, 5 dm from the walls)
1200 PROC SETC(F,I,W,H,C)
1210   LOCAL T,RX1,RY1,RX2,RY2,X1,Y1,X2,Y2,AX,AY
1220   RX1=RM(F,I,0)+5:RY1=RM(F,I,1)+5:RX2=RM(F,I,2)-5:RY2=RM(F,I,3)-5
1230   OKP=0
1240   IF RX2-RX1<W OR RY2-RY1<H THEN EXIT PROC
1250   AX=RX2-RX1-W:AY=RY2-RY1-H
1260   FOR T=0 TO 7
1270     X1=RX1+AX*(0.5+(FN RN()-0.5)*0.5):Y1=RY1+AY*(0.5+(FN RN()-0.5)*0.5):X2=X1+W:Y2=Y1+H
1280     IF FN FREEBOX(F,X1,Y1,X2,Y2) THEN
1290       CALL ADDFU(F,X1,Y1,X2,Y2,C)
1300       LQ1=X1:LQ2=Y1:LQ3=X2:LQ4=Y2:OKP=-1
1310       EXIT PROC
1320     END IF
1330   NEXT T
1340 END PROC
1350 ' the furniture of room I of floor F by its kind: 1 hall, 2 WC, 3 living room, 4 dining room, 5 kitchen, 6 study, 7 bedroom, 8 children's room, 9 bathroom
1360 PROC FITROOM(F,I)
1370   LOCAL T,K,W,WL,OP,C,TX1,TY1,TX2,TY2,N
1380   T=RM(F,I,4)
1390   IF T=1 THEN
1400     CALL SETF(F,I,10,3.5,FN RI(0,3),FN RN(),41)
1410     CALL SETF(F,I,6,2,FN RI(0,3),FN RN(),39)
1420   END IF
1430   IF T=2 THEN
1440     CALL SETF(F,I,4.5,7,1,0.5,54)
1450     CALL SETF(F,I,4,3.5,FN RI(0,3),FN RN(),54)
1460   END IF
1470   IF T=3 THEN
1480     C=42:IF FN RN()<0.4 THEN C=53
1490     IF FN RN()<0.25 THEN C=58
1500     CALL SETF(F,I,20,9,FN RI(0,3),FN RN(),C)
1510     IF OKP THEN
1520       OP=PW+1-2*(PW MOD 2)
1530       CALL SETF(F,I,15,4.5,OP,0.5,40)
1540       CALL SETC(F,I,10,6,41)
1550     END IF
1560     CALL SETF(F,I,12,3.5,FN RI(0,3),FN RN(),40)
1570     CALL SETF(F,I,8,8,FN RI(0,3),FN RN(),C)
1580   END IF
1590   IF T=4 THEN
1600     CALL SETC(F,I,16,9,40)
1610     IF OKP THEN
1620       TX1=LQ1:TY1=LQ2:TX2=LQ3:TY2=LQ4
1630       FOR N=0 TO 1
1640         CALL ADDFU(F,TX1+3+N*7,TY1-3.5,TX1+6+N*7,TY1-0.5,41)
1650         CALL ADDFU(F,TX1+3+N*7,TY2+0.5,TX1+6+N*7,TY2+3.5,41)
1660       NEXT N
1670       IF FN RN()<0.5 THEN CALL ADDFU(F,TX1-3.5,TY1+3,TX1-0.5,TY1+6,41)
1680       IF FN RN()<0.5 THEN CALL ADDFU(F,TX2+0.5,TY1+3,TX2+3.5,TY1+6,41)
1690     END IF
1700     CALL SETF(F,I,14,4,FN RI(0,3),FN RN(),41)
1710   END IF
1720   IF T=5 THEN
1730     CALL SETF(F,I,RM(F,I,2)-RM(F,I,0)-8,6,FN RI(0,3),0.5,54)
1740     WL=PW
1750     IF OKP THEN
1760       IF WL<2 THEN
1770         CALL SETF(F,I,18,6,2+FN RI(0,1),0.5,54)
1780       ELSE
1790         CALL SETF(F,I,18,6,FN RI(0,1),0.5,54)
1800       END IF
1810     END IF
1820     CALL SETF(F,I,6,6,FN RI(0,3),FN RN(),54)
1830     CALL SETC(F,I,10,8,40)
1840     IF OKP THEN
1850       TX1=LQ1:TY1=LQ2:TX2=LQ3:TY2=LQ4
1860       CALL ADDFU(F,TX1+1,TY1-3.5,TX1+4,TY1-0.5,41):CALL ADDFU(F,TX2-4,TY2+0.5,TX2-1,TY2+3.5,41)
1870     END IF
1880   END IF
1890   IF T=6 THEN
1900     CALL SETF(F,I,14,7,FN RI(0,3),FN RN(),40)
1910     CALL SETF(F,I,12,3.5,FN RI(0,3),FN RN(),41)
1920     CALL SETF(F,I,12,3.5,FN RI(0,3),FN RN(),41)
1930     CALL SETF(F,I,16,8,FN RI(0,3),FN RN(),42)
1940   END IF
1950   IF T=7 THEN
1960     CALL SETF(F,I,18,21,FN RI(0,3),FN RN(),53)
1970     CALL SETF(F,I,4.5,4.5,FN RI(0,3),FN RN(),40)
1980     CALL SETF(F,I,4.5,4.5,FN RI(0,3),FN RN(),40)
1990     CALL SETF(F,I,20,6.5,FN RI(0,3),FN RN(),39)
2000     CALL SETF(F,I,12,4.5,FN RI(0,3),FN RN(),41)
2010   END IF
2020   IF T=8 THEN
2030     CALL SETF(F,I,9,20,FN RI(0,3),FN RN(),42)
2040     CALL SETF(F,I,12,6,FN RI(0,3),FN RN(),39)
2050     CALL SETF(F,I,12,6,FN RI(0,3),FN RN(),40)
2060     IF RM(F,I,3)-RM(F,I,1)>50 THEN CALL SETF(F,I,9,20,FN RI(0,3),FN RN(),58):CALL SETF(F,I,16,3.5,FN RI(0,3),FN RN(),41)
2070   END IF
2080   IF T=9 THEN
2090     CALL SETF(F,I,17,7.5,FN RI(0,1),0.5,54)
2100     CALL SETF(F,I,6,5,FN RI(0,3),FN RN(),54)
2110     CALL SETF(F,I,4.5,7,FN RI(0,3),FN RN(),54)
2120   END IF
2130   IF T=11 THEN
2140     CALL SETC(F,I,16,8,40)
2150     IF OKP THEN
2160       TX1=LQ1:TY1=LQ2:TX2=LQ3:TY2=LQ4
2170       CALL ADDFU(F,TX1+2,TY1-3.5,TX1+5,TY1-0.5,41):CALL ADDFU(F,TX2-5,TY2+0.5,TX2-2,TY2+3.5,41)
2180     END IF
2190     CALL SETF(F,I,14,3.5,FN RI(0,3),FN RN(),41)
2200     CALL SETF(F,I,10,6,FN RI(0,3),FN RN(),42)
2210   END IF
2220   IF T=10 THEN
2230     CALL SETF(F,I,24,6,FN RI(0,3),FN RN(),41)
2240     CALL SETF(F,I,16,3.5,FN RI(0,3),FN RN(),40)
2250     CALL SETF(F,I,8,8,FN RI(0,3),FN RN(),39)
2260     CALL SETC(F,I,6,6,40)
2270   END IF
2280 END PROC
2290 ' ------------------------------------------------------------------------------------------------ making a house from the seed SD
2300 PROC GENHOUSE
2310   LOCAL I,IW,LW,RW,ZLO,ZHI,YE,XE,C,C2,Q,XC,XD,XA1,XA2,XB1,XB2,YF1,YF2,YC,J,EXD,EXC
2320   RC=0:WN=0
2330   FOR I=0 TO 1:RMN(I)=0:DON(I)=0:FUN(I)=0:CLN(I)=0:NEXT I
2340   LX=FN RI(100,120):DY=FN RI(80,100)
2350   HX=FN RI(26,30):IW=LX-2*TW
2360   LW=INT((IW-HX-2)*(0.45+FN RN()*0.1)):RW=IW-HX-2-LW
2370   FD=FN RI(28,36):IF FD>DY-50 THEN FD=DY-50
2380   WCD=FN RI(20,26)
2390   XA1=TW+LW:XA2=XA1+1:XB1=XA2+HX:XB2=XB1+1:XE=LX-TW:YE=DY-TW
2400   YF1=TW+FD:YF2=YF1+1:WY=YE-WCD-1
2410   SS=FN RI(0,1)
2420   ' the stairs: 10 dm wide, 31 long, along the hall wall of the living side, ending at the WC / bathroom wall
2430   IF SS=0 THEN SX1=XA2:SX2=XA2+10 ELSE SX1=XB1-10:SX2=XB1
2440   SY1=WY-31:SY2=WY
2450   FOR I=0 TO 1:C=CLN(I):CL(I,C,0)=SX1-1:CL(I,C,1)=SY1-1:CL(I,C,2)=SX2+1:CL(I,C,3)=SY2:CLN(I)=C+1:NEXT I
2460   XC=(XA2+XB1)/2:XD=XC+4:IF SS=1 THEN XD=XC-4
2470   ' ground floor rooms: 0 hall, 1 WC, 2 west front, 3 west back, 4 east front, 5 east back
2480   CALL ADDROOM(0,XA2,TW,XB1,WY,1):CALL ADDROOM(0,XA2,WY+1,XB1,YE,2)
2490   IF SS=0 THEN
2500     CALL ADDROOM(0,TW,TW,XA1,YF1,4):CALL ADDROOM(0,TW,YF2,XA1,YE,3)
2510     CALL ADDROOM(0,XB2,TW,XE,YF1,6):CALL ADDROOM(0,XB2,YF2,XE,YE,5)
2520   ELSE
2530     CALL ADDROOM(0,TW,TW,XA1,YF1,6):CALL ADDROOM(0,TW,YF2,XA1,YE,5)
2540     CALL ADDROOM(0,XB2,TW,XE,YF1,4):CALL ADDROOM(0,XB2,YF2,XE,YE,3)
2550   END IF
2560   ' doors of the ground floor: the front door, the WC, the dining room (to the hall), living and dining room open to each other, the kitchen and the study to the hall
2570   CALL ADDWIN(0,0,XD,10,0,21,2)
2580   CALL ADDDOOR(0,1,XD,WY,8)
2590   IF SS=0 THEN
2600     CALL ADDDOOR(0,0,XA1,FN RI(TW+5,YF1-5),9)
2610     CALL ADDDOOR(0,1,(TW+XA1)/2,YF1,16)
2620     CALL ADDDOOR(0,0,XB1,FN RI(TW+5,YF1-5),9)
2630     CALL ADDDOOR(0,0,XB1,FN RI(YF2+5,WY-5),9)
2640   ELSE
2650     CALL ADDDOOR(0,0,XB1,FN RI(TW+5,YF1-5),9)
2660     CALL ADDDOOR(0,1,(XB2+XE)/2,YF1,16)
2670     CALL ADDDOOR(0,0,XA1,FN RI(TW+5,YF1-5),9)
2680     CALL ADDDOOR(0,0,XA1,FN RI(YF2+5,WY-5),9)
2690   END IF
2700   ' upper floor: 0 landing, 1 bathroom, 2 the long room over the living side, 3 service side front, 4 service side back
2710   CALL ADDROOM(1,XA2,TW,XB1,WY,1):CALL ADDROOM(1,XA2,WY+1,XB1,YE,9)
2720   IF SS=0 THEN
2730     CALL ADDROOM(1,TW,TW,XA1,YE,8)
2740     CALL ADDROOM(1,XB2,TW,XE,YF1,8):CALL ADDROOM(1,XB2,YF2,XE,YE,7)
2750   ELSE
2760     CALL ADDROOM(1,XB2,TW,XE,YE,8)
2770     CALL ADDROOM(1,TW,TW,XA1,YF1,8):CALL ADDROOM(1,TW,YF2,XA1,YE,7)
2780   END IF
2790   CALL ADDWIN(1,0,XC,10,9,21,0)
2800   CALL ADDDOOR(1,1,XD,WY,8)
2810   IF SS=0 THEN
2820     CALL ADDDOOR(1,0,XA1,FN RI(TW+5,SY1-5),9)
2830     CALL ADDDOOR(1,0,XB1,FN RI(TW+5,YF1-5),9)
2840     CALL ADDDOOR(1,0,XB1,FN RI(YF2+5,WY-5),9)
2850   ELSE
2860     CALL ADDDOOR(1,0,XB1,FN RI(TW+5,SY1-5),9)
2870     CALL ADDDOOR(1,0,XA1,FN RI(TW+5,YF1-5),9)
2880     CALL ADDDOOR(1,0,XA1,FN RI(YF2+5,WY-5),9)
2890   END IF
2900   ' windows (the hall of the ground floor has the door instead)
2910   FOR C=0 TO 1
2920     FOR I=0 TO RMN(C)-1
2930       IF I>0 THEN CALL ROOMWIN(C,I)
2940     NEXT I
2950   NEXT C
2960   ' type 2: a single storey annex (the garage) at the east gable, with a door from the east room at the front
2970   IF HT=2 THEN
2980     AI=FN RI(45,55):AY=FN RI(50,65)
2990     CALL ADDROOM(0,LX,TW,LX+AI,AY,10)
3000     J=0
3010     FOR I=0 TO WN-1
3020       IF NOT ( WIN(I,0)=0 AND WIN(I,1)=3 AND WIN(I,2)-WIN(I,3)/2<AY+TW ) THEN
3030         FOR C=0 TO 6:WIN(J,C)=WIN(I,C):NEXT C
3040         J=J+1
3050       END IF
3060     NEXT I
3070     WN=J
3080     CALL ADDWIN(0,3,(TW+YF1)/2,9,0,21,3)
3090     CALL ADDWIN(0,4,LX+AI/2,24,0,22,4)
3100     CALL ADDWIN(0,5,AY/2+2,10,10,20,0)
3110   END IF
3120   ' type 5: a bay window (two storeys) in the front of the west front room and a flat roofed extension at the back, at the widest back room that is not the WC
3130   IF HT=5 THEN
3140     BC=LX/4:BW=16
3150     FOR I=0 TO RMN(0)-1
3160       IF RM(0,I,0)=TW AND RM(0,I,1)=TW THEN BC=(RM(0,I,0)+RM(0,I,2))/2:BW=MIN(18,RM(0,I,2)-RM(0,I,0)-8)
3170     NEXT I
3180     BX1=BC-BW/2:BX2=BC+BW/2
3190     J=0
3200     FOR I=0 TO WN-1
3210       IF NOT ( WIN(I,1)=0 AND WIN(I,2)+WIN(I,3)/2>BX1-1 AND WIN(I,2)-WIN(I,3)/2<BX2+1 ) THEN
3220         FOR C=0 TO 6:WIN(J,C)=WIN(I,C):NEXT C
3230         J=J+1
3240       END IF
3250     NEXT I
3260     WN=J
3270     CALL ADDWIN(0,0,BC,BW,0,21,5):CALL ADDWIN(1,0,BC,BW,0,21,5)
3280     EXD=0:EXC=LX/2
3290     FOR I=0 TO RMN(0)-1
3300       IF RM(0,I,3)=YE AND RM(0,I,4)<>2 AND RM(0,I,2)-RM(0,I,0)>EXD THEN EXD=RM(0,I,2)-RM(0,I,0):EXC=(RM(0,I,0)+RM(0,I,2))/2
3310     NEXT I
3320     EXW=FN RI(34,46):EXY=FN RI(28,38)
3330     EXX1=EXC-EXW/2:EXX2=EXX1+EXW
3340     IF EXX1<TW+4 THEN EXX1=TW+4:EXX2=EXX1+EXW
3350     IF EXX2>LX-TW-4 THEN EXX2=LX-TW-4:EXX1=EXX2-EXW
3360     IF EXC<EXX1+6 THEN EXC=EXX1+6
3370     IF EXC>EXX2-6 THEN EXC=EXX2-6
3380     CALL ADDROOM(0,EXX1,DY,EXX2,DY+EXY,11)
3390     J=0
3400     FOR I=0 TO WN-1
3410       IF NOT ( WIN(I,0)=0 AND WIN(I,1)=1 AND WIN(I,2)+WIN(I,3)/2>EXX1-4 AND WIN(I,2)-WIN(I,3)/2<EXX2+4 ) THEN
3420         FOR C=0 TO 6:WIN(J,C)=WIN(I,C):NEXT C
3430         J=J+1
3440       END IF
3450     NEXT I
3460     WN=J
3470     CALL ADDWIN(0,1,EXC,9,0,21,3)
3480     CALL ADDWIN(0,9,(EXX1+EXX2)/2,20,0,22,1)
3490     CALL ADDWIN(0,7,DY+EXY/2,12,9,21,0):CALL ADDWIN(0,8,DY+EXY/2,12,9,21,0)
3500   END IF
3510   ' the roof: the eaves, the ridge 8.5 .. 10 m high with a pitch of 27 .. 43 degrees
3520   KN=FN RI(0,6):EZ=FLZ(1)+28+KN
3530   ZLO=MAX(85,INT(EZ+0.52*DY/2)):ZHI=MIN(100,INT(EZ+0.95*DY/2)):IF ZHI<ZLO THEN ZHI=ZLO
3540   ZR=FN RI(ZLO,ZHI):CHX=FN RI(INT(LX*0.25),INT(LX*0.65))
3550   PLC=8+FN RI(0,5):RFC=26+FN RI(0,2):ATT=FN RI(0,1)
3560   ' the furniture
3570   FOR C=0 TO 1
3580     FOR I=0 TO RMN(C)-1
3590       CALL FITROOM(C,I)
3600     NEXT I
3610   NEXT C
3620 END PROC
3630 ' ------------------------------------------------------------------------------------------------ the 3D house (units: dm in the builder, U = 3.125 game units a dm)
3640 FUNC HR(A,B)
3650   RETURN HASH(SD*7919+5,A,B)
3660 END FUNC
3670 FUNC CLP(V,A,B)
3680   IF V<A THEN RETURN A
3690   IF V>B THEN RETURN B
3700   RETURN V
3710 END FUNC
3720 ' a box in dm; FC = the faces (M3D BOX mask), 0 = all
3730 PROC BXD(O,X1,Y1,Z1,X2,Y2,Z2,TX)
3740   LOCAL T,FC
3750   IF X2<X1 THEN T=X1:X1=X2:X2=T
3760   IF Y2<Y1 THEN T=Y1:Y1=Y2:Y2=T
3770   IF Z2<Z1 THEN T=Z1:Z1=Z2:Z2=T
3780   FC=BFC:BFC=63
3790   IF X2-X1<0.05 OR Y2-Y1<0.05 OR Z2-Z1<0.05 THEN EXIT PROC
3800   M3D BOX O,X1*U,Y1*U,Z1*U,X2*U,Y2*U,Z2*U,TX,FC
3810 END PROC
3820 ' ---- walls: a wall runs along the axis AX (0: x, 1: y) over A1 .. A2, its thickness is C1 .. C2 across, from Z1 to Z2. PWID names it for the hash, PF is the floor, WTOP the top
3830 ' of the whole wall. The wall is cut into columns of 10 dm (a column's height after the damage and its picture come from the hash), openings are cut out by WALLSEG.
3840 PROC PIECE(O,AX,C1,C2,A1,A2,Z1,Z2)
3850   LOCAL K,K1,K2,NC,KK,CA1,CA2,RR,RR2,RR3,ZT,KP,FR,BP,T,FC,JAG,FST,LST
3860   K1=INT(A1/10):K2=INT((A2-0.001)/10)
3870   NC=K2-K1+1:IF D<0.01 THEN NC=1
3880   JAG=(PF=1 AND D>0.6) OR (PF=0 AND D>0.9)
3890   FOR KK=0 TO NC-1
3900     IF D<0.01 THEN
3910       K=K1:CA1=A1:CA2=A2
3920     ELSE
3930       K=K1+KK:CA1=MAX(A1,K*10):CA2=MIN(A2,K*10+10)
3940     END IF
3950     IF CA2-CA1>0.05 THEN
3960       RR=FN HR(PWID*64+K,3):RR2=FN HR(PWID*64+K,4+INT(Z1/9)*3):RR3=FN HR(PWID*64+K,5+INT(Z1/9)*3)
3970       ZT=Z2
3980       IF PF=1 AND D>0.6 THEN
3990         KP=(0.97-D)*2.6:IF KP<0 THEN KP=0
4000         FR=KP*(0.4+0.6*RR):IF FR>1 THEN FR=1
4010         ZT=FLZ(1)+(WTOP-FLZ(1))*FR
4020       END IF
4030       IF PF=0 AND D>0.9 THEN ZT=MIN(ZT,FLZ(1)*(0.74+0.26*RR))
4040       ZT=MIN(ZT,Z2)
4050       IF ZT-Z1>0.3 THEN
4060         BP=D*0.6:IF PF=1 THEN BP=D*1.4
4070         T=PTX
4080         IF RR2<BP THEN
4090           T=PTXC
4100         ELSE
4110           IF PCAT=0 AND RR3<D*0.6 THEN T=303
4120         END IF
4130         ' the faces that can be seen: the room or outer side, the other side once the walls fall (INFD), the top once a roof can be missing, the sides at openings and at jagged columns
4140         FC=63
4150         IF NOT PFULL THEN
4160           FC=OSF
4170           IF D>INFD THEN FC=FC OR INF
4180           IF D>0.3 OR TOPO THEN FC=FC OR 16
4190           IF BOTO THEN FC=FC OR 32
4200           FST=(KK=0 AND EDS) OR (KK>0 AND JAG)
4210           LST=(KK=NC-1 AND EDE) OR (KK<NC-1 AND JAG)
4220           IF AX=0 THEN
4230             IF FST THEN FC=FC OR 2
4240             IF LST THEN FC=FC OR 1
4250           ELSE
4260             IF FST THEN FC=FC OR 8
4270             IF LST THEN FC=FC OR 4
4280           END IF
4290         END IF
4300         BFC=FC
4310         IF AX=0 THEN CALL BXD(O,CA1,C1,Z1,CA2,C2,ZT,T) ELSE CALL BXD(O,C1,CA1,Z1,C2,CA2,ZT,T)
4320       END IF
4330     END IF
4340   NEXT KK
4350 END PROC
4360 PROC SORTL
4370   LOCAL I,J,T
4380   FOR I=0 TO NL-2
4390     FOR J=0 TO NL-2-I
4400       IF LA1(J)>LA1(J+1) THEN
4410         T=LA1(J):LA1(J)=LA1(J+1):LA1(J+1)=T
4420         T=LA2(J):LA2(J)=LA2(J+1):LA2(J+1)=T
4430       END IF
4440     NEXT J
4450   NEXT I
4460 END PROC
4470 ' the parts of A1 .. A2 that the sorted list LA1 / LA2 (NL entries) does not cover, as wall pieces of the band B1 .. B2
4480 PROC FREEIV(O,AX,C1,C2,A1,A2,B1,B2)
4490   LOCAL J,P,Q
4500   P=A1
4510   FOR J=0 TO NL-1
4520     Q=MIN(LA1(J),A2)
4530     IF Q>P THEN EDS=(P>A1+0.001):EDE=(Q<A2-0.001):CALL PIECE(O,AX,C1,C2,P,Q,B1,B2)
4540     P=MAX(P,LA2(J))
4550   NEXT J
4560   IF A2>P THEN EDS=(P>A1+0.001):EDE=0:CALL PIECE(O,AX,C1,C2,P,A2,B1,B2)
4570 END PROC
4580 ' a wall with the openings OPN (OA1 .. OA2 along, OZ1 .. OZ2 high; type 0 opening, 1 hole of the beam, 2 its glassy rim: drawn with the picture RTX when RTX > 0)
4590 PROC WALLSEG(O,AX,C1,C2,A1,A2,Z1,Z2)
4600   LOCAL I,J,K,NZ,B1,B2,V,T1,T2,NR
4610   NZ=2:ZB(0)=Z1:ZB(1)=Z2
4620   FOR I=0 TO OPN-1
4630     FOR J=0 TO 1
4640       IF J=0 THEN V=OZ1(I) ELSE V=OZ2(I)
4650       IF V>Z1+0.05 AND V<Z2-0.05 AND NZ<158 THEN ZB(NZ)=V:NZ=NZ+1
4660     NEXT J
4670   NEXT I
4680   FOR I=0 TO NZ-2
4690     FOR J=0 TO NZ-2-I
4700       IF ZB(J)>ZB(J+1) THEN V=ZB(J):ZB(J)=ZB(J+1):ZB(J+1)=V
4710     NEXT J
4720   NEXT I
4730   FOR K=0 TO NZ-2
4740     B1=ZB(K):B2=ZB(K+1)
4750     IF B2-B1>0.05 THEN
4760       NL=0:NR=0
4770       FOR I=0 TO OPN-1
4780         IF OZ1(I)<=B1+0.01 AND OZ2(I)>=B2-0.01 THEN
4790           T1=MAX(A1,OA1(I)):T2=MIN(A2,OA2(I))
4800           IF T2>T1 THEN
4810             LA1(NL)=T1:LA2(NL)=T2:NL=NL+1
4820             IF OTY(I)=2 THEN RA1(NR)=T1:RA2(NR)=T2:NR=NR+1
4830           END IF
4840         END IF
4850       NEXT I
4860       CALL SORTL
4870       TOPO=0:BOTO=0
4880       FOR I=0 TO OPN-1
4890         IF ABS(OZ1(I)-B2)<0.02 THEN TOPO=-1
4900         IF ABS(OZ2(I)-B1)<0.02 THEN BOTO=-1
4910       NEXT I
4920       CALL FREEIV(O,AX,C1,C2,A1,A2,B1,B2)
4930       IF RTX>0 AND NR>0 THEN
4940         NL=0
4950         FOR I=0 TO OPN-1
4960           IF OTY(I)<2 AND OZ1(I)<=B1+0.01 AND OZ2(I)>=B2-0.01 THEN
4970             T1=MAX(A1,OA1(I)):T2=MIN(A2,OA2(I))
4980             IF T2>T1 THEN LA1(NL)=T1:LA2(NL)=T2:NL=NL+1
4990           END IF
5000         NEXT I
5010         CALL SORTL
5020         SV1=PTX:SV2=PTXC:SV3=PCAT:PTX=RTX:PTXC=RTX:PCAT=1:PFULL=-1
5030         FOR I=0 TO NR-1
5040           PTX=RTX:PTXC=RTX:PCAT=1:CALL FREEIV(O,AX,C1,C2,RA1(I),RA2(I),B1,B2)
5050         NEXT I
5060         PTX=SV1:PTXC=SV2:PCAT=SV3:PFULL=0
5070       END IF
5080     END IF
5090   NEXT K
5100 END PROC
5110 ' the openings of the outer wall SIDE (0 south, 1 north, 2 west, 3 east, 4 / 6 / 5 the garage's south / north / east wall) of floor F: windows, doors and the hole of the beam
5120 PROC OPWALL(F,SIDE)
5130   LOCAL I,J,ZC,R,YB,W,W2,BH
5140   OPN=0
5150   FOR I=0 TO WN-1
5160     IF WIN(I,0)=F AND WIN(I,1)=SIDE THEN
5170       OA1(OPN)=WIN(I,2)-WIN(I,3)/2:OA2(OPN)=WIN(I,2)+WIN(I,3)/2:OZ1(OPN)=FLZ(F)+WIN(I,4):OZ2(OPN)=FLZ(F)+WIN(I,5):OTY(OPN)=0:OPN=OPN+1
5180     END IF
5190   NEXT I
5200   IF HOLE AND F=0 AND SIDE=HS THEN
5210     R=HRAD:BH=2*R/9
5220     FOR J=0 TO 8
5230       YB=(J+0.5)*BH-R
5240       W=SQR(MAX(0,R*R-YB*YB)):W2=SQR(MAX(0,(R+1.2)*(R+1.2)-YB*YB))
5250       OA1(OPN)=HC-W:OA2(OPN)=HC+W:OZ1(OPN)=HZC-R+J*BH:OZ2(OPN)=HZC-R+(J+1)*BH:OTY(OPN)=1:OPN=OPN+1
5260       OA1(OPN)=HC-W2:OA2(OPN)=HC+W2:OZ1(OPN)=HZC-R+J*BH:OZ2(OPN)=HZC-R+(J+1)*BH:OTY(OPN)=2:OPN=OPN+1
5270     NEXT J
5280     OA1(OPN)=HC-5.4:OA2(OPN)=HC+5.4:OZ1(OPN)=HZC+R:OZ2(OPN)=HZC+R+1.2:OTY(OPN)=2:OPN=OPN+1
5290     OA1(OPN)=HC-5.4:OA2(OPN)=HC+5.4:OZ1(OPN)=HZC-R-1.2:OZ2(OPN)=HZC-R:OTY(OPN)=2:OPN=OPN+1
5300   END IF
5310 END PROC
5320 ' the doors of a partition: AX 0 a wall at x = CC, AX 1 a wall at y = CC (its low side)
5330 PROC OPDOOR(F,AX,CC)
5340   LOCAL I,P,Q
5350   OPN=0
5360   FOR I=0 TO DON(F)-1
5370     IF DOR(F,I,0)=AX THEN
5380       IF AX=0 THEN P=DOR(F,I,1):Q=DOR(F,I,2) ELSE P=DOR(F,I,2):Q=DOR(F,I,1)
5390       IF ABS(P-CC)<0.01 THEN
5400         OA1(OPN)=Q-DOR(F,I,3)/2:OA2(OPN)=Q+DOR(F,I,3)/2:OZ1(OPN)=FLZ(F):OZ2(OPN)=FLZ(F)+21:OTY(OPN)=0:OPN=OPN+1
5410       END IF
5420     END IF
5430   NEXT I
5440 END PROC
5450 ' ---- the outer walls (3.5 dm of plaster over brick; the rooms add their own 0.5 dm of colour inside), floor by floor
5460 PROC SHELLS
5470   LOCAL F,Z1,Z2,S
5480   FOR F=0 TO 1
5490     PF=F
5500     IF F=0 THEN Z1=0:Z2=FLZ(1) ELSE Z1=FLZ(1):Z2=EZ
5510     WTOP=Z2
5520     FOR S=0 TO 3
5530       CALL OPWALL(F,S):PWID=100+F*10+S:INFD=0.3
5540       IF S=0 THEN OSF=8:INF=4
5550       IF S=1 THEN OSF=4:INF=8
5560       IF S=2 THEN OSF=2:INF=1
5570       IF S=3 THEN OSF=1:INF=2
5580       IF S=0 THEN PTX=301:PTXC=302:PCAT=0:RTX=330:CALL WALLSEG(2,0,0,3.5,0,LX,Z1,Z2)
5590       IF S=1 THEN PTX=301:PTXC=302:PCAT=0:RTX=330:CALL WALLSEG(2,0,DY-3.5,DY,0,LX,Z1,Z2)
5600       IF S=2 THEN PTX=301:PTXC=302:PCAT=0:RTX=330:CALL WALLSEG(2,1,0,3.5,0,DY,Z1,Z2)
5610       IF S=3 THEN PTX=301:PTXC=302:PCAT=0:RTX=330:CALL WALLSEG(2,1,LX-3.5,LX,0,DY,Z1,Z2)
5620     NEXT S
5630   NEXT F
5640   IF HT=2 THEN
5650     PF=0:WTOP=FLZ(1)-3
5660     CALL OPWALL(0,4):PWID=150:OSF=8:INF=4:INFD=0.3:PTX=301:PTXC=302:PCAT=0:RTX=0:CALL WALLSEG(2,0,0,3.5,LX,LX+AI+4,0,FLZ(1)-3)
5670     CALL OPWALL(0,6):PWID=151:OSF=4:INF=8:INFD=0.3:PTX=301:PTXC=302:PCAT=0:RTX=0:CALL WALLSEG(2,0,AY+0.5,AY+4,LX,LX+AI+4,0,FLZ(1)-3)
5680     CALL OPWALL(0,5):PWID=152:OSF=1:INF=2:INFD=0.3:PTX=301:PTXC=302:PCAT=0:RTX=0:CALL WALLSEG(2,1,LX+AI+0.5,LX+AI+4,0,AY+4,0,FLZ(1)-3)
5690   END IF
5700   IF HT=5 THEN
5710     PF=0:WTOP=FLZ(1)-3
5720     CALL OPWALL(0,7):PWID=153:OSF=2:INF=1:INFD=0.3:PTX=301:PTXC=302:PCAT=0:RTX=0:CALL WALLSEG(2,1,EXX1-4,EXX1-0.5,DY,DY+EXY+4,0,FLZ(1)-3)
5730     CALL OPWALL(0,8):PWID=154:OSF=1:INF=2:INFD=0.3:PTX=301:PTXC=302:PCAT=0:RTX=0:CALL WALLSEG(2,1,EXX2+0.5,EXX2+4,DY,DY+EXY+4,0,FLZ(1)-3)
5740     CALL OPWALL(0,9):PWID=155:OSF=4:INF=8:INFD=0.3:PTX=301:PTXC=302:PCAT=0:RTX=0:CALL WALLSEG(2,0,DY+EXY+0.5,DY+EXY+4,EXX1-4,EXX2+4,0,FLZ(1)-3)
5750   END IF
5760 END PROC
5770 ' the gable triangles (both sides drawn) over the end walls: they stand while the upper floor's walls do
5780 PROC GABLE(X1,X2,TX)
5790   LOCAL B
5800   B=M3D("VERTS",2)
5810   M3D VERTEX 2,X1*U,0,EZ*U:M3D VERTEX 2,X1*U,DY*U,EZ*U:M3D VERTEX 2,X1*U,DY/2*U,ZR*U
5820   M3D VERTEX 2,X2*U,0,EZ*U:M3D VERTEX 2,X2*U,DY*U,EZ*U:M3D VERTEX 2,X2*U,DY/2*U,ZR*U
5830   M3D FACE 2,B,B+1,B+2,TX:M3D FACE 2,B,B+2,B+1,TX
5840   M3D FACE 2,B+3,B+4,B+5,TX:M3D FACE 2,B+3,B+5,B+4,TX
5850 END PROC
5860 PROC GABLES
5870   LOCAL T
5880   IF D>0.6 OR HT=3 THEN EXIT PROC
5890   T=301:IF FN HR(300,1)<D*1.4 THEN T=302
5900   CALL GABLE(0,3.5,T)
5910   T=301:IF FN HR(300,2)<D*1.4 THEN T=302
5920   CALL GABLE(LX-3.5,LX,T)
5930 END PROC
5940 ' ---- the rooms: 0.5 dm of colour on every wall of a room, openings cut, the floor
5950 PROC ROOMLAYERS(F,I)
5960   LOCAL X1,Y1,X2,Y2,T,TX,Z1,Z2,AN,ET
5970   X1=RM(F,I,0):Y1=RM(F,I,1):X2=RM(F,I,2):Y2=RM(F,I,3):T=RM(F,I,4)
5980   TX=305+RM(F,I,5)-20
5990   AN=(T=10):ET=(T=11)
6000   Z1=FLZ(F):Z2=FLZ(F)+26
6010   PF=F:WTOP=Z2
6020   PWID=200+F*40+I*4
6030   IF NOT ET THEN
6040     IF Y1=TW THEN
6050       IF AN THEN CALL OPWALL(F,4) ELSE CALL OPWALL(F,0)
6060     ELSE
6070       CALL OPDOOR(F,1,Y1-1)
6080     END IF
6090     OSF=4:INF=8:INFD=0.6:PTX=TX:PTXC=302:PCAT=1:RTX=0:CALL WALLSEG(3,0,Y1-0.5,Y1,X1,X2,Z1,Z2)
6100   END IF
6110   PWID=PWID+1
6120   IF AN THEN
6130     CALL OPWALL(F,6)
6140   ELSE
6150     IF ET THEN
6160       CALL OPWALL(F,9)
6170     ELSE
6180       IF Y2=DY-TW THEN CALL OPWALL(F,1) ELSE CALL OPDOOR(F,1,Y2)
6190     END IF
6200   END IF
6210   OSF=8:INF=4:INFD=0.6:PTX=TX:PTXC=302:PCAT=1:RTX=0:CALL WALLSEG(3,0,Y2,Y2+0.5,X1,X2,Z1,Z2)
6220   PWID=PWID+1
6230   IF NOT AN THEN
6240     IF ET THEN
6250       CALL OPWALL(F,7)
6260     ELSE
6270       IF X1=TW THEN CALL OPWALL(F,2) ELSE CALL OPDOOR(F,0,X1-1)
6280     END IF
6290     OSF=1:INF=2:INFD=0.6:PTX=TX:PTXC=302:PCAT=1:RTX=0:CALL WALLSEG(3,1,X1-0.5,X1,Y1,Y2,Z1,Z2)
6300   END IF
6310   PWID=PWID+1
6320   IF AN THEN
6330     CALL OPWALL(F,5)
6340   ELSE
6350     IF ET THEN
6360       CALL OPWALL(F,8)
6370     ELSE
6380       IF X2=LX-TW THEN CALL OPWALL(F,3) ELSE CALL OPDOOR(F,0,X2)
6390     END IF
6400   END IF
6410   OSF=2:INF=1:INFD=0.6:PTX=TX:PTXC=302:PCAT=1:RTX=0:CALL WALLSEG(3,1,X2,X2+0.5,Y1,Y2,Z1,Z2)
6420 END PROC
6430 ' the picture of a room's floor
6440 FUNC FLOORTEX(T)
6450   IF T=1 OR T=2 OR T=5 OR T=9 OR T=11 THEN RETURN 313
6460   IF T=10 THEN RETURN 304
6470   RETURN 312
6480 END FUNC
6490 ' the plate of the upper floor in a rectangle (cell present by the hash of the 12 dm grid)
6500 PROC SLABRECT(X1,Y1,X2,Y2,TX)
6510   LOCAL GX,GY,P1,Q1,P2,Q2,SM
6520   IF X2-X1<0.05 OR Y2-Y1<0.05 THEN EXIT PROC
6530   SM=32 OR OPM:IF D>=0.5 THEN SM=SM OR 15
6540   IF D<=0.5 THEN
6550     BFC=16:CALL BXD(10,X1,Y1,FLZ(1)-0.4,X2,Y2,FLZ(1),TX)
6560     BFC=SM:CALL BXD(10,X1,Y1,FLZ(1)-3,X2,Y2,FLZ(1)-0.4,310)
6570     EXIT PROC
6580   END IF
6590   FOR GX=INT(X1/12) TO INT((X2-0.001)/12)
6600     FOR GY=INT(Y1/12) TO INT((Y2-0.001)/12)
6610       IF D<0.55+0.4*FN HR(1000+GX,GY) THEN
6620         P1=MAX(X1,GX*12):P2=MIN(X2,GX*12+12):Q1=MAX(Y1,GY*12):Q2=MIN(Y2,GY*12+12)
6630         BFC=16:CALL BXD(10,P1,Q1,FLZ(1)-0.4,P2,Q2,FLZ(1),TX)
6640         BFC=SM:CALL BXD(10,P1,Q1,FLZ(1)-3,P2,Q2,FLZ(1)-0.4,310)
6650       END IF
6660     NEXT GY
6670   NEXT GX
6680 END PROC
6690 PROC FLOORPIECE(X1,Y1,X2,Y2,TX)
6700   OPM=0
6710   IF X2<=SX1 OR X1>=SX2 OR Y2<=SY1 OR Y1>=SY2 THEN
6720     CALL SLABRECT(X1,Y1,X2,Y2,TX)
6730     EXIT PROC
6740   END IF
6750   OPM=1:IF SX1>X1 THEN CALL SLABRECT(X1,Y1,SX1,Y2,TX)
6760   OPM=2:IF X2>SX2 THEN CALL SLABRECT(SX2,Y1,X2,Y2,TX)
6770   OPM=4:IF SY1>Y1 THEN CALL SLABRECT(MAX(X1,SX1),Y1,MIN(X2,SX2),SY1,TX)
6780   OPM=8:IF Y2>SY2 THEN CALL SLABRECT(MAX(X1,SX1),SY2,MIN(X2,SX2),Y2,TX)
6790   OPM=0
6800 END PROC
6810 ' ground floor, upper floor with its stairwell, the ceiling over it, the flat roof of the garage
6820 PROC SLABS
6830   LOCAL I,GX,GY,P1,Q1,P2,Q2,T,CM
6840   BFC=16:CALL BXD(4,0,0,0,LX,DY,FLZ(0)-0.4,304)
6850   IF HT=2 THEN BFC=16:CALL BXD(4,LX,0,0,LX+AI+4,AY+4,FLZ(0)-0.4,304)
6860   IF HT=5 THEN BFC=16:CALL BXD(4,EXX1-4,DY,0,EXX2+4,DY+EXY+4,FLZ(0)-0.4,304)
6870   FOR I=0 TO RMN(0)-1
6880     BFC=16:CALL BXD(10,RM(0,I,0),RM(0,I,1),FLZ(0)-0.4,RM(0,I,2),RM(0,I,3),FLZ(0),FN FLOORTEX(RM(0,I,4)))
6890   NEXT I
6900   FOR I=0 TO RMN(1)-1
6910     CALL FLOORPIECE(RM(1,I,0),RM(1,I,1),RM(1,I,2),RM(1,I,3),FN FLOORTEX(RM(1,I,4)))
6920   NEXT I
6930   ' the ceiling over the upper floor: one slab while none of its cells can be missing (D < 0.35)
6940   IF D<0.35 THEN
6950     CM=32:IF D>0.2 THEN CM=48
6960     BFC=CM:CALL BXD(10,0,0,FLZ(1)+26,LX,DY,FLZ(1)+28,309)
6970   ELSE
6980     FOR GX=0 TO INT((LX-0.001)/12)
6990       FOR GY=0 TO INT((DY-0.001)/12)
7000         IF D<0.35+0.4*FN HR(2000+GX,GY) THEN
7010           P1=GX*12:P2=MIN(LX,GX*12+12):Q1=GY*12:Q2=MIN(DY,GY*12+12)
7020           BFC=63:CALL BXD(10,P1,Q1,FLZ(1)+26,P2,Q2,FLZ(1)+28,309)
7030         END IF
7040       NEXT GY
7050     NEXT GX
7060   END IF
7070   ' the flat roofs of the garage and the extension: one slab while all cells stand (D < 0.3), top and underside only
7080   IF HT=2 THEN CALL FLATROOF(LX,0,LX+AI+4,AY+4)
7090   IF HT=5 THEN CALL FLATROOF(EXX1-4,DY,EXX2+4,DY+EXY+4)
7100 END PROC
7110 PROC FLATROOF(X1,Y1,X2,Y2)
7120   LOCAL GX,GY,P1,Q1,P2,Q2,T
7130   IF D<0.3 THEN
7140     BFC=48:CALL BXD(4,X1,Y1,FLZ(1)-3,X2,Y2,FLZ(1),304)
7150     EXIT PROC
7160   END IF
7170   FOR GX=INT(X1/12) TO INT((X2-0.001)/12)
7180     FOR GY=INT(Y1/12) TO INT((Y2-0.001)/12)
7190       IF D<0.3+0.5*FN HR(3000+GX,GY) AND D<0.7 THEN
7200         P1=MAX(X1,GX*12):P2=MIN(X2,GX*12+12):Q1=MAX(Y1,GY*12):Q2=MIN(Y2,GY*12+12)
7210         T=304:IF FN HR(3500+GX,GY)<D*1.5 THEN T=302
7220         BFC=63:CALL BXD(4,P1,Q1,FLZ(1)-3,P2,Q2,FLZ(1),T)
7230       END IF
7240     NEXT GY
7250   NEXT GX
7260 END PROC
7270 ' the stairs: 16 steps along the stairwell, solid
7280 PROC STAIRS
7290   LOCAL I,T,Y1,Y2
7300   T=312:IF D>0.25 THEN T=302
7310   FOR I=0 TO 15
7320     Y1=SY1+I*(SY2-SY1)/16:Y2=SY1+(I+1)*(SY2-SY1)/16
7330     BFC=27:CALL BXD(9,SX1,Y1,FLZ(0)-0.4,SX2,Y2,FLZ(0)+(I+1)*(FLZ(1)-FLZ(0))/16,T)
7340   NEXT I
7350 END PROC
7360 ' ---- the roof: a gable roof over the long side, cells of about 10 dm that burn away, rafters under them
7370 FUNC HZ(X,Y,SL)
7380   RETURN EZ+SL*MIN(MIN(X,LX-X),MIN(Y,DY-Y))
7390 END FUNC
7400 PROC ROOFGABLE
7410   LOCAL NX,WX,SL,OV,ZE,I,J,S,X1,X2,T1,T2,Y1,Y2,Z1,Z2,B,TX,R,IX
7420   OV=5:SL=(ZR-EZ)/(DY/2):ZE=EZ-OV*SL
7430   NX=INT((LX+6)/10)+1:WX=(LX+6)/NX
7440   FOR S=0 TO 1
7450     FOR I=0 TO NX-1
7460       FOR J=0 TO 3
7470         IX=S*1000+I*10+J
7480         R=FN HR(500,IX)
7490         IF D<0.3+0.5*R AND D<0.7 THEN
7500           X1=-3+I*WX:X2=X1+WX
7510           T1=J/4:T2=(J+1)/4
7520           Y1=-OV+(DY/2+OV)*T1:Y2=-OV+(DY/2+OV)*T2:Z1=ZE+(ZR-ZE)*T1:Z2=ZE+(ZR-ZE)*T2
7530           IF S=1 THEN Y1=DY-Y1:Y2=DY-Y2
7540           TX=315:IF FN HR(501,IX)<D*1.5 THEN TX=302
7550           B=M3D("VERTS",5)
7560           M3D VERTEX 5,X1*U,Y1*U,Z1*U:M3D VERTEX 5,X2*U,Y1*U,Z1*U:M3D VERTEX 5,X2*U,Y2*U,Z2*U:M3D VERTEX 5,X1*U,Y2*U,Z2*U
7570           M3D QUAD 5,B,B+1,B+2,B+3,TX
7580         END IF
7590       NEXT J
7600     NEXT I
7610   NEXT S
7620 END PROC
7630 FUNC FRONTX()
7640   LOCAL I,X
7650   X=LX/2
7660   FOR I=0 TO WN-1
7670     IF WIN(I,0)=0 AND WIN(I,1)=0 AND WIN(I,6)=2 THEN X=WIN(I,2)
7680   NEXT I
7690   RETURN X
7700 END FUNC
7710 ' rafters (ribbons under the roof, from X RX1 to RX2) and the ridge beam (RB1 to RB2): they burn with the roof
7720 PROC RAFTERS(RX1,RX2,RB1,RB2)
7730   LOCAL OV,SL,ZE,I,S,X1,Y1,Y2,Z1,Z2,B
7740   IF D>0.6 THEN EXIT PROC
7750   OV=5:SL=(ZR-EZ)/(DY/2):ZE=EZ-OV*SL
7760   FOR S=0 TO 1
7770     FOR I=0 TO INT((RX2-RX1)/8)
7780       X1=RX1+I*8
7790       Y1=-OV:Y2=DY/2:Z1=ZE-0.3:Z2=ZR-0.3
7800       IF S=1 THEN Y1=DY-Y1:Y2=DY-Y2
7810       B=M3D("VERTS",5)
7820       M3D VERTEX 5,(X1-0.6)*U,Y1*U,Z1*U:M3D VERTEX 5,(X1+0.6)*U,Y1*U,Z1*U:M3D VERTEX 5,(X1+0.6)*U,Y2*U,Z2*U:M3D VERTEX 5,(X1-0.6)*U,Y2*U,Z2*U
7830       M3D QUAD 5,B,B+1,B+2,B+3,302
7840     NEXT I
7850   NEXT S
7860   B=M3D("VERTS",5)
7870   M3D VERTEX 5,RB1*U,(DY/2-0.8)*U,(ZR-0.8)*U:M3D VERTEX 5,RB2*U,(DY/2-0.8)*U,(ZR-0.8)*U:M3D VERTEX 5,RB2*U,(DY/2+0.8)*U,(ZR-0.8)*U:M3D VERTEX 5,RB1*U,(DY/2+0.8)*U,(ZR-0.8)*U
7880   M3D QUAD 5,B,B+1,B+2,B+3,302
7890 END PROC
7900 ' the hip roof (type 3): four planes of one pitch, z = EZ + slope * the distance to the nearest wall, cells of the grid XBK / YBK (the creases run along its diagonals), two triangles a cell
7910 PROC ROOFHIP
7920   LOCAL OV,SL,NX,NY,I,J,K,N,X1,X2,Y1,Y2,CX,CY,IX,TX,R,B
7930   OV=5:SL=(ZR-EZ)/(DY/2)
7940   NX=0:XBK(0)=-OV:XBK(1)=0:NX=2
7950   K=10
7960   WHILE K<DY/2-1
7970     XBK(NX)=K:NX=NX+1:K=K+10
7980   WEND
7990   XBK(NX)=DY/2:NX=NX+1
8000   N=INT((LX-DY)/12)+1
8010   FOR I=1 TO N-1
8020     XBK(NX)=DY/2+(LX-DY)*I/N:NX=NX+1
8030   NEXT I
8040   XBK(NX)=LX-DY/2:NX=NX+1
8050   K=10:WHILE K<DY/2-1:K=K+10:WEND
8060   K=K-10
8070   WHILE K>=10
8080     XBK(NX)=LX-K:NX=NX+1:K=K-10
8090   WEND
8100   XBK(NX)=LX:XBK(NX+1)=LX+OV:NX=NX+2
8110   NY=0:YBK(0)=-OV:YBK(1)=0:NY=2
8120   K=10
8130   WHILE K<DY/2-1
8140     YBK(NY)=K:NY=NY+1:K=K+10
8150   WEND
8160   YBK(NY)=DY/2:NY=NY+1
8170   K=10:WHILE K<DY/2-1:K=K+10:WEND
8180   K=K-10
8190   WHILE K>=10
8200     YBK(NY)=DY-K:NY=NY+1:K=K-10
8210   WEND
8220   YBK(NY)=DY:YBK(NY+1)=DY+OV:NY=NY+2
8230   FOR I=0 TO NX-2
8240     FOR J=0 TO NY-2
8250       X1=XBK(I):X2=XBK(I+1):Y1=YBK(J):Y2=YBK(J+1)
8260       IX=I*40+J:R=FN HR(500,IX)
8270       IF D<0.3+0.5*R AND D<0.7 THEN
8280         TX=315:IF FN HR(501,IX)<D*1.5 THEN TX=302
8290         CX=(X1+X2)/2:CY=(Y1+Y2)/2
8300         B=M3D("VERTS",5)
8310         IF (CX<LX/2)=(CY<DY/2) THEN
8320           M3D VERTEX 5,X1*U,Y1*U,FN HZ(X1,Y1,SL)*U:M3D VERTEX 5,X2*U,Y1*U,FN HZ(X2,Y1,SL)*U:M3D VERTEX 5,X2*U,Y2*U,FN HZ(X2,Y2,SL)*U
8330           M3D FACE 5,B,B+1,B+2,TX
8340           M3D VERTEX 5,X1*U,Y1*U,FN HZ(X1,Y1,SL)*U:M3D VERTEX 5,X2*U,Y2*U,FN HZ(X2,Y2,SL)*U:M3D VERTEX 5,X1*U,Y2*U,FN HZ(X1,Y2,SL)*U
8350           M3D FACE 5,B+3,B+4,B+5,TX
8360         ELSE
8370           M3D VERTEX 5,X1*U,Y1*U,FN HZ(X1,Y1,SL)*U:M3D VERTEX 5,X2*U,Y1*U,FN HZ(X2,Y1,SL)*U:M3D VERTEX 5,X1*U,Y2*U,FN HZ(X1,Y2,SL)*U
8380           M3D FACE 5,B,B+1,B+2,TX
8390           M3D VERTEX 5,X2*U,Y1*U,FN HZ(X2,Y1,SL)*U:M3D VERTEX 5,X2*U,Y2*U,FN HZ(X2,Y2,SL)*U:M3D VERTEX 5,X1*U,Y2*U,FN HZ(X1,Y2,SL)*U
8400           M3D FACE 5,B+3,B+4,B+5,TX
8410         END IF
8420       END IF
8430     NEXT J
8440   NEXT I
8450 END PROC
8460 PROC ROOF
8470   IF HT=3 THEN
8480     CALL ROOFHIP
8490     CALL RAFTERS(DY/2,LX-DY/2,DY/2,LX-DY/2)
8500   ELSE
8510     CALL ROOFGABLE
8520     CALL RAFTERS(2,LX-2,-3,LX+3)
8530   END IF
8540   ' the chimney stack on the west wall: brick, it stands at every stage
8550   BFC=31:CALL BXD(2,-6,DY/2-4,0,0,DY/2+4,ZR+5,303)
8560   IF HT=4 THEN CALL DORMER
8570 END PROC
8580 ' ---- furniture
8590 FUNC FUH(W,H,C)
8600   LOCAL L,S
8610   L=MAX(W,H):S=MIN(W,H)
8620   IF C=54 THEN
8630     IF L>=15 THEN RETURN 5
8640     RETURN 8
8650   END IF
8660   IF C=53 OR C=42 OR C=58 THEN
8670     IF L>1.6*S THEN RETURN 8
8680     RETURN 5
8690   END IF
8700   IF L<=4 THEN RETURN 9
8710   IF S<=4.5 THEN RETURN 17
8720   IF S<=7.5 AND L>=12 THEN RETURN 9
8730   RETURN 7.5
8740 END FUNC
8750 FUNC FUTEX(C)
8760   IF C=39 THEN RETURN 320
8770   IF C=40 THEN RETURN 321
8780   IF C=41 THEN RETURN 322
8790   IF C=42 THEN RETURN 323
8800   IF C=53 THEN RETURN 324
8810   IF C=54 THEN RETURN 325
8820   IF C=58 THEN RETURN 326
8830   RETURN 321
8840 END FUNC
8850 PROC FURNITURE
8860   LOCAL F,I,X1,Y1,X2,Y2,C,H,T,R,OK,CX,CY
8870   FOR F=0 TO 1
8880     FOR I=0 TO FUN(F)-1
8890       X1=FU(F,I,0):Y1=FU(F,I,1):X2=FU(F,I,2):Y2=FU(F,I,3):C=FUC(F,I)
8900       OK=-1
8910       CX=(X1+X2)/2:CY=(Y1+Y2)/2
8920       IF F=1 THEN
8930         IF NOT (D<0.55+0.4*FN HR(1000+INT(CX/12),INT(CY/12))) THEN OK=0
8940       END IF
8950       IF D>0.4 THEN
8960         IF FN HR(700+F,I)>1.25-D*0.9 THEN OK=0
8970       END IF
8980       IF OK THEN
8990         H=FN FUH(X2-X1,Y2-Y1,C)
9000         T=FN FUTEX(C):IF FN HR(710+F,I)<D*1.3 THEN T=302
9010         BFC=31:CALL BXD(6,X1,Y1,FLZ(F),X2,Y2,FLZ(F)+H,T)
9020       END IF
9030     NEXT I
9040   NEXT F
9050 END PROC
9060 ' ---- debris on the ground floor where the ceilings fell
9070 PROC RUBBLE
9080   LOCAL I,N,R,X,Y,W,H,L,K,F
9090   IF D<0.7 THEN EXIT PROC
9100   N=INT((D-0.5)*70)
9110   FOR I=0 TO N-1
9120     R=INT(FN HR(800,I)*RMN(0)):IF R>=RMN(0) THEN R=RMN(0)-1
9130     IF RM(0,R,4)<>10 OR FN HR(801,I)<0.4 THEN
9140       X=RM(0,R,0)+2+FN HR(802,I)*(RM(0,R,2)-RM(0,R,0)-4):Y=RM(0,R,1)+2+FN HR(803,I)*(RM(0,R,3)-RM(0,R,1)-4)
9150       IF FN HR(804,I)<0.35 THEN
9160         L=15+FN HR(805,I)*15
9170         IF FN HR(806,I)<0.5 THEN BFC=31:CALL BXD(8,X,Y,FLZ(0),X+L,Y+1.3,FLZ(0)+1.3,302) ELSE BFC=31:CALL BXD(8,X,Y,FLZ(0),X+1.3,Y+L,FLZ(0)+1.3,302)
9180       ELSE
9190         W=3+FN HR(807,I)*6:H=3+FN HR(808,I)*6:K=1+FN HR(809,I)*3
9200         IF FN HR(810,I)<0.5 THEN F=302 ELSE F=337
9210         BFC=31:CALL BXD(8,X,Y,FLZ(0),X+W,Y+H,FLZ(0)+K,F)
9220       END IF
9230     END IF
9240   NEXT I
9250 END PROC
9260 ' ---- windows and doors: flat quads in the openings (frames with see-through panes, doors ajar); present while the fire has not taken them
9270 ' the dormer of type 4 on the south slope, with a window, and the porch over the front door (posts and a canopy)
9280 PROC DORMER
9290   LOCAL SL,DX,DW,YF,ZR0,ZT,YB,R,T,B
9300   IF D>0.6 THEN EXIT PROC
9310   SL=(ZR-EZ)/(DY/2)
9320   DX=LX*(0.4+0.2*FN HR(190,1)):DW=18:YF=9
9330   ZR0=EZ+SL*YF:ZT=MIN(ZR0+14,ZR-6):YB=(ZT-EZ)/SL
9340   T=301:IF FN HR(191,1)<D*1.4 THEN T=302
9350   BFC=63:CALL BXD(2,DX-DW/2,YF,ZR0-1,DX+DW/2,YF+1.5,ZR0+3,T)
9360   BFC=63:CALL BXD(2,DX-DW/2,YF,ZT-3,DX+DW/2,YF+1.5,ZT,T)
9370   BFC=63:CALL BXD(2,DX-DW/2,YF,ZR0+3,DX-DW/2+2,YF+1.5,ZT-3,T)
9380   BFC=63:CALL BXD(2,DX+DW/2-2,YF,ZR0+3,DX+DW/2,YF+1.5,ZT-3,T)
9390   BFC=63:CALL BXD(2,DX-DW/2,YF,ZR0-1,DX-DW/2+1.2,YB+1,ZT,T)
9400   BFC=63:CALL BXD(2,DX+DW/2-1.2,YF,ZR0-1,DX+DW/2,YB+1,ZT,T)
9410   T=315:IF FN HR(192,1)<D*1.5 THEN T=302
9420   IF D<0.5+0.3*FN HR(193,1) THEN BFC=63:CALL BXD(2,DX-DW/2-1.5,YF-1.5,ZT,DX+DW/2+1.5,YB+1.5,ZT+1.2,T)
9430   IF D<0.3+0.5*FN HR(194,1) THEN
9440     B=M3D("VERTS",7)
9450     M3D VERTEX 7,(DX-DW/2+2)*U,(YF+0.75)*U,(ZT-3)*U,0,0:M3D VERTEX 7,(DX+DW/2-2)*U,(YF+0.75)*U,(ZT-3)*U,64,0:M3D VERTEX 7,(DX+DW/2-2)*U,(YF+0.75)*U,(ZR0+3)*U,64,96:M3D VERTEX 7,(DX-DW/2+2)*U,(YF+0.75)*U,(ZR0+3)*U,0,96
9460     M3D QUAD 7,B,B+1,B+2,B+3,331
9470   END IF
9480 END PROC
9490 PROC PORCH
9500   LOCAL P0,I,T,X
9510   P0=FN FRONTX()
9520   BFC=63:CALL BXD(4,P0-14,-14,0,P0+14,0.5,FLZ(0)-0.4,304)
9530   FOR I=0 TO 1
9540     IF FN HR(195,I)>D*0.5 THEN
9550       T=301:IF FN HR(196,I)<D*1.4 THEN T=302
9560       X=P0-13+I*24
9570       BFC=63:CALL BXD(2,X,-13,FLZ(0)-0.4,X+2,-11,FLZ(0)+22.5,T)
9580     END IF
9590   NEXT I
9600   IF D<0.5+0.3*FN HR(197,1) AND D<0.7 THEN
9610     T=315:IF FN HR(198,1)<D*1.5 THEN T=302
9620     BFC=63:CALL BXD(2,P0-15,-15,FLZ(0)+22.5,P0+15,1,FLZ(0)+24.3,T)
9630   END IF
9640 END PROC
9650 ' the bay window of type 5 on the front: two storeys, cheeks and a front with a window, a flat roof
9660 PROC BAY
9670   LOCAL F,Z1,Z2,B,T
9680   FOR F=0 TO 1
9690     PF=F:Z1=FLZ(F):Z2=FLZ(F)+26
9700     IF F=0 THEN Z1=0:Z2=FLZ(1)
9710     WTOP=FLZ(F)+26:PWID=170+F*5
9720     PTX=301:PTXC=302:PCAT=0:PFULL=-1
9730     CALL PIECE(2,1,BX1-1.5,BX1,-9,0,Z1,Z2)
9740     PWID=PWID+1:CALL PIECE(2,1,BX2,BX2+1.5,-9,0,Z1,Z2)
9750     PWID=PWID+1:CALL PIECE(2,0,-9,-7.5,BX1-1.5,BX2+1.5,Z1,FLZ(F)+3)
9760     PWID=PWID+1:CALL PIECE(2,0,-9,-7.5,BX1-1.5,BX2+1.5,FLZ(F)+22,Z2)
9770     PFULL=0
9780     BFC=63:CALL BXD(4,BX1-1.5,-9,FLZ(F)-3,BX2+1.5,0,FLZ(F)-0.4,304)
9790     BFC=16:CALL BXD(4,BX1,-7.5,FLZ(F)-0.4,BX2,0,FLZ(F),312)
9800     IF D<0.3+0.5*FN HR(180,F) AND D<0.7 THEN
9810       B=M3D("VERTS",7)
9820       M3D VERTEX 7,BX1*U,-8*U,(FLZ(F)+22)*U,0,0:M3D VERTEX 7,BX2*U,-8*U,(FLZ(F)+22)*U,64,0:M3D VERTEX 7,BX2*U,-8*U,(FLZ(F)+3)*U,64,96:M3D VERTEX 7,BX1*U,-8*U,(FLZ(F)+3)*U,0,96
9830       M3D QUAD 7,B,B+1,B+2,B+3,331
9840     END IF
9850   NEXT F
9860   IF D<0.5+0.3*FN HR(181,0) AND D<0.7 THEN
9870     T=315:IF FN HR(182,0)<D*1.5 THEN T=302
9880     BFC=63:CALL BXD(4,BX1-2.5,-10.5,FLZ(1)+26,BX2+2.5,0.5,FLZ(1)+28.6,T)
9890   END IF
9900 END PROC
9910 PROC LEAF(S,PP,W,Z1,Z2,TX)
9920   LOCAL B,X1,X2,Y1,Y2,PLN
9930   PLN=2
9940   IF S=0 OR S=4 THEN
9950     B=M3D("VERTS",7)
9960     M3D VERTEX 7,(PP-W/2)*U,PLN*U,Z2*U,0,0:M3D VERTEX 7,(PP+W/2)*U,PLN*U,Z2*U,64,0:M3D VERTEX 7,(PP+W/2)*U,PLN*U,Z1*U,64,96:M3D VERTEX 7,(PP-W/2)*U,PLN*U,Z1*U,0,96
9970   END IF
9980   IF S=1 OR S=6 OR S=9 THEN
9990     IF S=1 THEN PLN=DY-2
10000     IF S=6 THEN PLN=AY+2
10010     IF S=9 THEN PLN=DY+EXY+2
10020     B=M3D("VERTS",7)
10030     M3D VERTEX 7,(PP-W/2)*U,PLN*U,Z2*U,0,0:M3D VERTEX 7,(PP+W/2)*U,PLN*U,Z2*U,64,0:M3D VERTEX 7,(PP+W/2)*U,PLN*U,Z1*U,64,96:M3D VERTEX 7,(PP-W/2)*U,PLN*U,Z1*U,0,96
10040   END IF
10050   IF S=2 OR S=3 OR S=5 OR S=7 OR S=8 THEN
10060     IF S=3 THEN PLN=LX-2
10070     IF S=5 THEN PLN=LX+AI+2
10080     IF S=7 THEN PLN=EXX1-2
10090     IF S=8 THEN PLN=EXX2+2
10100     B=M3D("VERTS",7)
10110     M3D VERTEX 7,PLN*U,(PP-W/2)*U,Z2*U,0,0:M3D VERTEX 7,PLN*U,(PP+W/2)*U,Z2*U,64,0:M3D VERTEX 7,PLN*U,(PP+W/2)*U,Z1*U,64,96:M3D VERTEX 7,PLN*U,(PP-W/2)*U,Z1*U,0,96
10120   END IF
10130   M3D QUAD 7,B,B+1,B+2,B+3,TX
10140 END PROC
10150 ' a door leaf hinged at (HX0, HY0), W wide, TH degrees open from the closed position along the wall (AX 0: the wall runs along y, 1: along x)
10160 PROC DOORLEAF(AX,HX0,HY0,W,TH,Z1,Z2,TX)
10170   LOCAL B,DX,DYY,A
10180   A=TH*PI/180
10190   IF AX=0 THEN DX=W*SIN(A):DYY=W*COS(A) ELSE DX=W*COS(A):DYY=W*SIN(A)
10200   B=M3D("VERTS",7)
10210   M3D VERTEX 7,HX0*U,HY0*U,Z2*U,0,0:M3D VERTEX 7,(HX0+DX)*U,(HY0+DYY)*U,Z2*U,64,0:M3D VERTEX 7,(HX0+DX)*U,(HY0+DYY)*U,Z1*U,64,128:M3D VERTEX 7,HX0*U,HY0*U,Z1*U,0,128
10220   M3D QUAD 7,B,B+1,B+2,B+3,TX
10230 END PROC
10240 PROC LEAVES
10250   LOCAL I,F,S,PP,W,Z1,Z2,K,R,TH
10260   FOR I=0 TO WN-1
10270     F=WIN(I,0):S=WIN(I,1):PP=WIN(I,2):W=WIN(I,3):K=WIN(I,6)
10280     Z1=FLZ(F)+WIN(I,4):Z2=FLZ(F)+WIN(I,5)
10290     R=FN HR(600,I)
10300     IF D<0.3+0.5*R AND D<0.7 THEN
10310       IF K=0 OR K=1 THEN CALL LEAF(S,PP,W,Z1,Z2,331)
10320       IF K=4 THEN CALL LEAF(S,PP,W,Z1,Z2,333)
10330       IF K=2 OR K=3 THEN
10340         TH=80+FN HR(601,I)*12
10350         IF S=0 THEN CALL DOORLEAF(1,PP-W/2,2,W,TH,Z1,Z2,332)
10360         IF S=3 THEN CALL DOORLEAF(0,LX-2,PP-W/2,W,TH,Z1,Z2,332)
10370         IF S=1 THEN CALL DOORLEAF(1,PP-W/2,DY-2,W,TH,Z1,Z2,332)
10380       END IF
10390     END IF
10400   NEXT I
10410   FOR F=0 TO 1
10420     FOR I=0 TO DON(F)-1
10430       IF D<0.45+0.5*FN HR(620+F,I) AND D<0.75 THEN
10440         TH=60+FN HR(630+F,I)*35
10450         IF DOR(F,I,0)=0 THEN CALL DOORLEAF(0,DOR(F,I,1)+0.5,DOR(F,I,2)-DOR(F,I,3)/2,DOR(F,I,3),TH,FLZ(F),FLZ(F)+21,332)
10460         IF DOR(F,I,0)=1 THEN CALL DOORLEAF(1,DOR(F,I,1)-DOR(F,I,3)/2,DOR(F,I,2)+0.5,DOR(F,I,3),TH,FLZ(F),FLZ(F)+21,332)
10470       END IF
10480     NEXT I
10490   NEXT F
10500 END PROC
10510 ' ---- the pictures
10520 PROC MKFLAT(N,H,S)
10530   LOCAL I
10540   GFX CLEAR FN W3K_C(H,S)
10550   FOR I=1 TO 140
10560     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H,FN CLP(S-2+FN W3K_R(5),1,15))
10570   NEXT I
10580   CALL W3K_GRAB(N,64,64)
10590 END PROC
10600 PROC MKCHAR(N)
10610   LOCAL I
10620   GFX CLEAR FN W3K_C(0,1)
10630   FOR I=1 TO 260
10640     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(0,FN W3K_R(5))
10650   NEXT I
10660   FOR I=1 TO 30
10670     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(12,2+FN W3K_R(3))
10680   NEXT I
10690   CALL W3K_GRAB(N,64,64)
10700 END PROC
10710 PROC MKGLASS(N)
10720   LOCAL I
10730   GFX CLEAR FN W3K_C(9,4)
10740   FOR I=1 TO 60
10750     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(7,9+FN W3K_R(6))
10760   NEXT I
10770   CALL W3K_GRAB(N,64,64)
10780 END PROC
10790 PROC MKTEX
10800   LOCAL I,H
10810   RANDOMIZE 1987
10820   CALL W3K_GRASS(334):CALL W3K_SKY(335)
10830   CALL W3K_BRICK(303,0):CALL W3K_STONE(304,0)
10840   CALL MKCHAR(302):CALL MKGLASS(330):CALL W3K_STONE(337,0)
10850   CALL W3K_PLANKS(312):CALL W3K_TILES(313,8,0)
10860   CALL W3K_WINDOW(331):CALL W3K_DOORTEX(332,12):CALL W3K_DOORTEX(333,0)
10870   CALL MKFLAT(320,12,12):CALL MKFLAT(321,12,9):CALL MKFLAT(322,12,6):CALL MKFLAT(323,8,8):CALL MKFLAT(324,1,8):CALL MKFLAT(325,0,15):CALL MKFLAT(326,5,7)
10880 END PROC
10890 ' the pictures that depend on the house: the outer plaster, the six room colours, the roof
10900 PROC MKHOUSETEX
10910   LOCAL I,H,S
10920   RANDOMIZE SD
10930   I=INT(FN HR(40,1)*6):IF I>5 THEN I=5
10940   RESTORE OUTERHUES
10950   FOR H=0 TO I:READ OHU,OSH:NEXT H
10960   CALL MKFLAT(301,OHU,OSH)
10970   RESTORE INNERHUES
10980   FOR H=0 TO 5
10990     READ IHU,ISH
11000     CALL MKFLAT(305+H,IHU,ISH)
11010   NEXT H
11020   I=INT(FN HR(40,2)*3):IF I>2 THEN I=2
11030   H=1:IF I=1 THEN H=12
11040   IF I=2 THEN H=0
11050   CALL W3K_TILES(315,H,H)
11060 END PROC
11070 ' ---- the whole house
11080 PROC MAKEHOUSE
11090   LOCAL I,T0
11100   T0=TI
11110   CALL GENHOUSE
11120   D=DS(STG)
11130   CALL MKHOUSETEX
11140   HOLE=(D>=0.5):HS=INT(FN HR(9,1)*4):IF HS>3 THEN HS=3
11150   IF HT=2 AND HS=3 THEN HS=1
11160   IF HT=4 AND HS=0 THEN HS=1
11170   IF HT=5 THEN HS=2+(HS AND 1)
11180   IF HS<2 THEN HC=LX*(0.3+0.4*FN HR(9,2)) ELSE HC=DY*(0.3+0.4*FN HR(9,2))
11190   HRAD=8+2*FN HR(9,3):HZC=FLZ(0)+13
11200   FOR I=1 TO 10:M3D OBJECT I,0,235:NEXT I
11210   M3D OBJECT 5,16,235:M3D OBJECT 7,21,235:M3D OBJECT 3,0,235
11220   M3D BOX 1,-2400,-2400,-30,2400,2400,0,334,16
11230   CALL SHELLS
11240   FOR I=0 TO RMN(0)-1:CALL ROOMLAYERS(0,I):NEXT I
11250   FOR I=0 TO RMN(1)-1:CALL ROOMLAYERS(1,I):NEXT I
11260   CALL GABLES
11270   CALL SLABS
11280   CALL STAIRS
11290   CALL ROOF
11300   IF HT=4 THEN CALL PORCH
11310   IF HT=5 THEN CALL BAY
11320   CALL FURNITURE
11330   CALL RUBBLE
11340   CALL LEAVES
11350   BMS=INT((TI-T0)*1000/60)
11360   BVT=0
11370   FOR I=1 TO 10:BVT=BVT+M3D("VERTS",I):NEXT I
11380   INTON=-2
11390 END PROC
11400 ' the interior (the room walls, floors and ceilings, furniture, stairs, debris: the objects 3, 6, 8, 9, 10) is only there when the viewer is within NEARD dm of the house or inside (a house seen from afar needs only its outside); IMODE 1 always, 2 never
11410 PROC INTVIS
11420   LOCAL X,Y,DX,DYY,VS,X1,Y1
11430   X=M3D("X")/U:Y=M3D("Y")/U
11440   X1=LX:Y1=DY
11450   IF HT=2 THEN X1=LX+AI+4
11460   IF HT=5 THEN Y1=DY+EXY+4
11470   DX=MAX(MAX(-6-X,X-X1),0):DYY=MAX(MAX(-15-Y,Y-Y1),0)
11480   VS=(SQR(DX*DX+DYY*DYY)<NEARD)
11490   IF IMODE=1 THEN VS=-1
11500   IF IMODE=2 THEN VS=0
11510   IF VS<>INTON THEN
11520     M3D OBJSHOW 3,-VS:M3D OBJSHOW 6,-VS:M3D OBJSHOW 8,-VS:M3D OBJSHOW 9,-VS:M3D OBJSHOW 10,-VS
11530     INTON=VS
11540   END IF
11550 END PROC
11560 PROC STAGENAME
11570   SN$="INTACT"
11580   IF STG=1 THEN SN$="SCORCHED"
11590   IF STG=2 THEN SN$="ROOF BURNT"
11600   IF STG=3 THEN SN$="FLOORS FELL"
11610   IF STG=4 THEN SN$="SHELL"
11620 END PROC
11630 ' put the viewer in front of the house (CX, CY in dm), looking at it
11640 PROC CAMENV
11650   LOCAL A$,P,I
11660   A$=ENV$("H3_CAM")+","
11670   FOR I=0 TO 4
11680     P=INSTR(A$,",")
11690     CV(I)=VAL(LEFT$(A$,P-1)):A$=MID$(A$,P+1)
11700   NEXT I
11710   M3D CAMERA CV(0)*U,CV(1)*U,CV(2)*U,CV(3),CV(4)
11720 END PROC
11730 PROC STARTPOS
11740   M3D CAMERA FN FRONTX()*U,-60*U,0,90
11750 END PROC
11760 ' the self test (H3_TEST=1, no graphics, run by engine1999c): the invariants of 100 houses of each of the five types (the generator part: ridge height, rooms, the garage annex of type 2 and the bay window and extension of type 5 with their doors and windows, windows on their walls, furniture inside the rooms); exit status = the number of failures
11770 PROC SELFTEST3
11780   LOCAL T,S,I,F,J,NH,NF,BAD,N0,K3,K4,K5,OKF,KT
11790   NH=0:NF=0
11800   FOR T=1 TO 5
11810     HT=T
11820     FOR S=1 TO 100
11830       SD=S:CALL GENHOUSE:NH=NH+1:BAD=0
11840       IF ZR>100 OR ZR<EZ+8 OR EZ>FLZ(1)+34 OR ZR<85 THEN BAD=1
11850       N0=6:IF HT=2 OR HT=5 THEN N0=7
11860       IF RMN(0)<>N0 OR RMN(1)<>5 THEN BAD=2
11870       K3=0:K4=0:K5=0:KT=0
11880       FOR I=0 TO WN-1
11890         IF WIN(I,6)=3 THEN K3=K3+1
11900         IF WIN(I,6)=4 THEN K4=K4+1
11910         IF WIN(I,6)=5 THEN K5=K5+1
11920         IF WIN(I,6)=1 AND WIN(I,1)=9 THEN KT=KT+1
11930         IF WIN(I,1)>3 AND HT<>2 AND HT<>5 THEN BAD=8
11940       NEXT I
11950       IF HT=2 THEN
11960         IF RM(0,6,0)<>LX OR RM(0,6,2)<>LX+AI OR RM(0,6,1)<>TW OR RM(0,6,3)<>AY OR AY+4>DY THEN BAD=3
11970         FOR I=0 TO WN-1
11980           IF WIN(I,6)=3 THEN
11990             IF WIN(I,1)<>3 OR WIN(I,2)<TW+5 OR WIN(I,2)>AY-5 THEN BAD=4
12000           END IF
12010           IF WIN(I,6)=4 THEN
12020             IF WIN(I,1)<>4 OR WIN(I,2)-WIN(I,3)/2<LX OR WIN(I,2)+WIN(I,3)/2>LX+AI THEN BAD=5
12030           END IF
12040           IF WIN(I,0)=0 AND WIN(I,1)=3 AND WIN(I,6)<>3 AND WIN(I,2)-WIN(I,3)/2<AY+TW THEN BAD=6
12050         NEXT I
12060         IF K3<>1 OR K4<>1 THEN BAD=7
12070       END IF
12080       IF HT=5 THEN
12090         IF RM(0,6,1)<>DY OR RM(0,6,3)<>DY+EXY OR RM(0,6,0)<>EXX1 OR RM(0,6,2)<>EXX2 OR EXX1<TW+4 OR EXX2>LX-TW-4 THEN BAD=3
12100         IF K3<>1 OR K5<>2 OR KT<>1 THEN BAD=7
12110         FOR I=0 TO WN-1
12120           IF WIN(I,6)=3 THEN
12130             IF WIN(I,1)<>1 OR WIN(I,2)<EXX1+5 OR WIN(I,2)>EXX2-5 THEN BAD=4
12140           END IF
12150           IF WIN(I,6)=5 THEN
12160             IF WIN(I,1)<>0 OR WIN(I,2)-WIN(I,3)/2<TW OR WIN(I,3)<8 THEN BAD=5
12170           END IF
12180           IF WIN(I,6)<>5 AND WIN(I,1)=0 AND WIN(I,2)+WIN(I,3)/2>BX1-1 AND WIN(I,2)-WIN(I,3)/2<BX2+1 THEN BAD=6
12190           IF WIN(I,6)<>3 AND WIN(I,0)=0 AND WIN(I,1)=1 AND WIN(I,2)+WIN(I,3)/2>EXX1-4 AND WIN(I,2)-WIN(I,3)/2<EXX2+4 THEN BAD=6
12200         NEXT I
12210       END IF
12220       FOR F=0 TO 1
12230         FOR I=0 TO FUN(F)-1
12240           OKF=0
12250           FOR J=0 TO RMN(F)-1
12260             IF FU(F,I,0)>=RM(F,J,0)-0.01 AND FU(F,I,2)<=RM(F,J,2)+0.01 AND FU(F,I,1)>=RM(F,J,1)-0.01 AND FU(F,I,3)<=RM(F,J,3)+0.01 THEN OKF=-1
12270           NEXT J
12280           IF NOT OKF THEN BAD=9
12290         NEXT I
12300       NEXT F
12310       IF BAD>0 THEN PRINT "house";S;" type";T;" fails check";BAD:NF=NF+1
12320     NEXT S
12330   NEXT T
12340   PRINT "house3d selftest: ";NH;" houses, ";NF;" failures"
12350   IF NF>0 THEN BYE 1
12360   BYE 0
12370 END PROC
12380 LABEL MAIN
12390 IF ENV$("H3_TEST")<>"" THEN CALL SELFTEST3
12400 DS(0)=0:DS(1)=0.25:DS(2)=0.5:DS(3)=0.75:DS(4)=1
12410 HT=1:STG=0:SD=1:BMS=0:BVT=0:INTON=-2:IMODE=0:NEARD=100:OSF=63:INF=0:INFD=9:EDS=0:EDE=0:TOPO=0:BOTO=0:PFULL=0:OPM=0:BFC=63:PTX=301:PTXC=302:PCAT=0:RTX=0:SV1=0:SV2=0:SV3=0:HOLE=0:HS=0:HC=0:HRAD=9:HZC=16:AI=50:AY=55:OPN=0:NL=0:PF=0:PWID=0:WTOP=0:D=0
12420 IF ENV$("H3_TYPE")<>"" THEN HT=VAL(ENV$("H3_TYPE"))
12430 IF ENV$("H3_STAGE")<>"" THEN STG=VAL(ENV$("H3_STAGE"))
12440 IF ENV$("H3_SEED")<>"" THEN SD=VAL(ENV$("H3_SEED"))
12450 CALL W3K_SETUP:CALL W3K_MESH:M3D RESET
12460 CALL W3K_VIEW(0,0,640,264,2)
12470 CALL MKTEX
12480 M3D COLORMAP
12490 M3D SKY 335
12500 M3D FAR 9000
12510 CALL MAKEHOUSE
12520 CALL STARTPOS
12530 CALL INTVIS
12540 IF ENV$("H3_CAM")<>"" THEN
12550   CALL CAMENV
12560 END IF
12570 QF=0
12580 REPEAT
12590   CALL W3K_WALK
12600   K$=INKEY$
12610   IF K$="q" OR K$="Q" THEN QF=-1
12620   IF K$>="1" AND K$<="5" THEN STG=VAL(K$)-1:CALL MAKEHOUSE
12630   IF K$="t" OR K$="T" THEN HT=HT MOD 5+1:CALL MAKEHOUSE
12640   IF K$="n" OR K$="N" THEN SD=SD+1:CALL MAKEHOUSE
12650   IF K$="h" OR K$="H" THEN CALL STARTPOS
12660   IF K$="i" OR K$="I" THEN IMODE=(IMODE+1) MOD 3
12670   CALL INTVIS
12680   M3D RENDER
12690   CALL STAGENAME
12700   GFX TEXT 6,4,"TYPE "+STR$(HT)+"  STAGE "+STR$(STG+1)+" "+SN$+"  SEED "+STR$(SD),FN W3K_C(3,15)
12710   GFX TEXT 6,14,"1-5 STAGE  T TYPE  N SEED  I INTERIOR  H HOME  Q QUIT  WASD WALK",FN W3K_C(0,12)
12720   IM$="AUTO":IF IMODE=1 THEN IM$="ON"
12730   IF IMODE=2 THEN IM$="OFF"
12740   GFX TEXT 6,24,STR$(BMS)+" ms  "+STR$(INT(BVT/2))+" triangles built  "+STR$(M3D("DRAWN"))+" drawn  interior "+IM$,FN W3K_C(0,12)
12750   CALL W3K_SHOW
12760 UNTIL QF
12770 CALL W3K_DONE
12780 END
12790 LABEL FAILED
12800 GFX RESET
12810 PRINT "Error: ";ERR$;" in line ";ERL
12820 END
12830 LABEL OUTERHUES
12840 DATA 13,12, 3,13, 8,12, 14,12, 5,12, 0,13
12850 LABEL INNERHUES
12860 DATA 3,14, 13,13, 4,13, 8,14, 14,13, 0,14
