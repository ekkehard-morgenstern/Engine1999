10 ' MANOR WALK - a walk through a small house, made with the software 3D sector renderer (W3D ...) of Engine1999.
20 ' A walled garden under the sky with a pool (you can fall in, but the step up is too high to walk: jump out), a front door that slides up when you press the
30 ' use key (E or RETURN, or the X button), a hall with pillars, a living room with a higher cupola, a study with a see-through window, a staircase
40 ' up to a gallery, and a dark cellar behind a second door with flickering torches.
50 ' Keys: arrows or WASD walk and turn (A and D slide sideways), SHIFT runs, R and F look up and down (HOME looks straight), E or RETURN opens doors, SPACE jumps (out of the pool, too),
60 ' P pauses, O opens the 3D settings (invert the X or Y axis, gamma, field of view, turning speed; they are kept for next time), Q or ESC quits.
70 ' Game controller: left stick walks, right stick turns and looks, LT runs, A jumps, X opens doors, Y the settings, START pauses, BACK quits.
80 ' How it is made: the level is DATA (sectors with a floor and ceiling height, flats, a light level and the walls around them; a wall that has a
90 ' neighbor on the other side is a portal), read by LOADLEVEL into W3D SECTOR / W3D WALL. The textures are drawn with GFX statements by the library
100 ' w3dkit and grabbed into W3D TEXTURE. Things (plants, lamps, torches, barrels) are flat pictures that always face you.
110 ' The picture is drawn into the graphics layer that is not shown and swapped in (flicker free). Window only.
120 LOAD LIBRARY "w3dkit"
130 LOAD LIBRARY "input"
140 LOAD LIBRARY "text"
150 LOAD LIBRARY "prefs3d"
160 BREAK OFF
170 ON ERROR GOTO FAILED
180 DIM NM$(20),DSEC(3),DOPEN(3),DCUR(3),TX(40),TY(40),TT(40),TW(40),TH(40),TZ(40),TL(40)
190 GOTO MAIN
200 ' ------------------------------------------------------------------------------------------------ the level
210 PROC MAKETEX
220   CALL W3K_BRICK(1,1)
230   CALL W3K_PLASTER(2,13)
240   CALL W3K_PLASTER(3,8)
250   CALL W3K_STONE(4,0)
260   CALL W3K_TILES(5,0,8)
270   CALL W3K_CARPET(6,1)
280   CALL W3K_PLANKS(7)
290   CALL W3K_GRASS(8)
300   CALL W3K_SKY(9)
310   CALL W3K_DOORTEX(10,12)
320   CALL W3K_WINDOW(11)
330   CALL W3K_STONE(14,13)
340   CALL W3K_PLASTER(15,4)
350   CALL W3K_STONE(16,5)
360   CALL W3K_TILES(30,8,7)
370   CALL W3K_PLANT(20)
380   CALL W3K_LAMP(21)
390   CALL W3K_TORCH(22)
400   CALL W3K_BARREL(24)
410   W3D SKY 9
420 END PROC
430 PROC LOADLEVEL
440   LOCAL NS,I,S,F,C,FT,CT,L,TG,NW,J,X1,Y1,X2,Y2,T,NX,FL,UP,LO,XO,YO
450   RESTORE LEVELDATA
460   READ NS
470   FOR I=1 TO NS
480     READ S,F,C,FT,CT,L,TG,NW
490     W3D SECTOR S,F,C,FT,CT,L
500     W3D TAG S,TG
510     FOR J=0 TO NW-1
520       READ X1,Y1,X2,Y2,T,NX,FL,UP,LO,XO,YO
530       W3D WALL S,X1,Y1,X2,Y2,T,NX
540       IF UP>=0 OR LO>=0 THEN W3D WALLTEX S,J,-1,UP,LO
550       IF FL<>0 THEN W3D WALLFLAG S,J,FL
560       IF XO<>0 OR YO<>0 THEN W3D WALLOFF S,J,XO,YO
570     NEXT J
580   NEXT I
590 END PROC
600 PROC PLACE
610   LOCAL I
620   RESTORE THINGDATA
630   NT=0
640   READ TX(NT)
650   WHILE TX(NT)<>9999
660     READ TY(NT),TT(NT),TW(NT),TH(NT),TZ(NT),TL(NT)
670     W3D THING NT,TX(NT),TY(NT),TT(NT),TW(NT),TH(NT)
680     IF TZ(NT)<>0 THEN W3D THINGZ NT,TZ(NT)
690     IF TL(NT)>=0 THEN W3D THINGLIGHT NT,TL(NT)
700     NT=NT+1
710     READ TX(NT)
720   WEND
730 END PROC
740 ' ------------------------------------------------------------------------------------------------ doors
750 PROC DOORUSE
760   LOCAL S,I
770   S=W3D("USE",70)
780   IF S<0 THEN EXIT PROC
790   FOR I=1 TO 2
800     IF S=DSEC(I) THEN
810       DOPEN(I)=NOT DOPEN(I)
820       SFX 1
830     END IF
840   NEXT I
850 END PROC
860 PROC DOORS
870   LOCAL I,G
880   FOR I=1 TO 2
890     IF DOPEN(I) THEN G=100 ELSE G=0
900     IF DCUR(I)<G THEN DCUR(I)=MIN(G,DCUR(I)+2.5)
910     IF DCUR(I)>G THEN DCUR(I)=MAX(G,DCUR(I)-2.5)
920     W3D HEIGHT DSEC(I),0,DCUR(I)
930   NEXT I
940 END PROC
950 ' ------------------------------------------------------------------------------------------------ the screen
960 PROC TORCHES
970   LOCAL I
980   FOR I=0 TO NT-1
990     IF TT(I)=22 THEN W3D THINGTEX I,22+(((FR\5)+I) AND 1)
1000   NEXT I
1010 END PROC
1020 PROC HUD
1030   LOCAL T
1040   CALL W3K_HUDBAR(264,36)
1050   T=W3D("TAG",W3D("SECTOR"))
1060   IF T>=10 THEN LASTT=T
1070   GFX TEXT 8,270,NM$(LASTT-10),FN W3K_C(3,14)
1080   GFX TEXT 8,284,"WASD/ARROWS WALK  SHIFT RUN  R/F LOOK  E OPEN  SPACE JUMP  O SETTINGS  P PAUSE  Q QUIT",FN W3K_C(0,10)
1090   IF FR<300 THEN
1100     GFX LINE 150,60,490,150,FN W3K_C(0,1),BF
1110     GFX LINE 150,60,490,150,FN W3K_C(3,12),B
1120     CALL BIGTEXT(72,"MANOR WALK",FN W3K_C(3,15),3)
1130     GFX TEXT 232,112,"A WALK THROUGH A SMALL HOUSE",FN W3K_C(0,13)
1140     GFX TEXT 224,128,"THE FRONT DOOR OPENS WITH E",FN W3K_C(0,10)
1150   END IF
1160   CROSS=FN W3K_C(0,12)
1170 END PROC
1180 LABEL MAIN
1190 CALL TX_INIT
1200 CALL W3K_SETUP
1210 IN_QUIT=0
1220 NM$(0)="THE GARDEN":NM$(1)="THE HALL":NM$(2)="THE LIVING ROOM":NM$(3)="THE STUDY":NM$(4)="THE GALLERY":NM$(5)="THE CELLAR":NM$(6)="THE POOL"
1230 CLS:COLOR 15,0:PRINT "Building the house...":GFX LAYER 2,ON
1240 CALL MAKETEX
1250 CALL LOADLEVEL
1260 CALL PLACE
1270 GFX LAYER 2,OFF
1280 W3D PLAYER 14,56,46,24
1290 CALL W3K_VIEW(0,0,640,264,2)
1300 W3D FOG 800
1310 W3D COLORMAP
1320 CALL P3_LOAD
1330 W3D CAMERA 320,60,90
1340 DSEC(1)=1:DSEC(2)=16:DOPEN(1)=0:DOPEN(2)=0:DCUR(1)=0:DCUR(2)=0
1350 SFX 1,"W3 V0.5 ML X0,0.05,0.4,0.3 S160,70,18"
1360 LASTT=10:FR=0:UL=0:YL=0
1370 REPEAT
1380   CALL W3K_WALK
1390   CALL W3K_JUMP(KEY("SPACE") OR JOY("A"))
1400   U=KEY("E") OR KEY("RETURN") OR JOY("X")
1410   IF U<>0 AND UL=0 THEN CALL DOORUSE
1420   UL=U
1430   IF KEY("ESC") THEN IN_QUIT=1
1440   CALL DOORS
1450   CALL TORCHES
1460   W3D RENDER
1470   CALL HUD
1480   GFX LINE 318,131,321,132,FN W3K_C(0,13),BF
1490   CALL W3K_SHOW
1500   FR=FR+1
1510   IF FN IN_SERVICE() THEN
1520     CALL BIGTEXT(110,"PAUSED",FN W3K_C(0,15),3)
1530     CALL IN_PAUSELOOP
1540     W3K_T0=TI
1550   END IF
1560   Y=JOY("Y")
1570   IF IN_KEY=79 OR (Y<>0 AND YL=0) THEN CALL P3_DIALOG
1580   YL=Y
1590 UNTIL IN_QUIT
1600 CALL W3K_DONE
1610 CALL TX_BYE("MANOR WALK")
1620 END
1630 LABEL FAILED
1640 CALL W3K_DONE
1650 PRINT "Error: ";ERR$;" in line ";ERL
1660 END
