10 ' MANOR WALK - a walk through a small house, made with the software 3D sector renderer (W3D ...) of Engine1999.
20 ' A walled garden under the sky with a pool you can not enter (the step down is too deep), a front door that slides up when you press the
30 ' use key (SPACE or the A button), a hall with pillars, a living room with a higher cupola, a study with a see-through window, a staircase
40 ' up to a gallery, and a dark cellar behind a second door with flickering torches.
50 ' Keys: arrows or WASD walk and turn (A and D slide sideways), SHIFT runs, R and F look up and down (HOME looks straight), SPACE opens doors,
60 ' P pauses, Q or ESC quits. Game controller: left stick walks, right stick turns and looks, LT runs, A opens doors, START pauses, BACK quits.
70 ' How it is made: the level is DATA (sectors with a floor and ceiling height, flats, a light level and the walls around them; a wall that has a
80 ' neighbor on the other side is a portal), read by LOADLEVEL into W3D SECTOR / W3D WALL. The textures are drawn with GFX statements by the library
90 ' w3dkit and grabbed into W3D TEXTURE. Things (plants, lamps, torches, barrels) are flat pictures that always face you.
100 ' The picture is drawn into the graphics layer that is not shown and swapped in (flicker free). Window only.
110 LOAD LIBRARY "w3dkit"
120 LOAD LIBRARY "input"
130 LOAD LIBRARY "text"
140 BREAK OFF
150 DIM NM$(20),DSEC(3),DOPEN(3),DCUR(3),TX(40),TY(40),TT(40),TW(40),TH(40),TZ(40),TL(40)
160 GOTO MAIN
170 ' ------------------------------------------------------------------------------------------------ the level
180 PROC MAKETEX
190   CALL W3K_BRICK(1,1)
200   CALL W3K_PLASTER(2,13)
210   CALL W3K_PLASTER(3,8)
220   CALL W3K_STONE(4,0)
230   CALL W3K_TILES(5,0,8)
240   CALL W3K_CARPET(6,1)
250   CALL W3K_PLANKS(7)
260   CALL W3K_GRASS(8)
270   CALL W3K_SKY(9)
280   CALL W3K_DOORTEX(10,12)
290   CALL W3K_WINDOW(11)
300   CALL W3K_STONE(14,13)
310   CALL W3K_PLASTER(15,4)
320   CALL W3K_STONE(16,5)
330   CALL W3K_TILES(30,8,7)
340   CALL W3K_PLANT(20)
350   CALL W3K_LAMP(21)
360   CALL W3K_TORCH(22)
370   CALL W3K_BARREL(24)
380   W3D SKY 9
390 END PROC
400 PROC LOADLEVEL
410   LOCAL NS,I,S,F,C,FT,CT,L,TG,NW,J,X1,Y1,X2,Y2,T,NX,FL,UP,LO,XO,YO
420   RESTORE LEVELDATA
430   READ NS
440   FOR I=1 TO NS
450     READ S,F,C,FT,CT,L,TG,NW
460     W3D SECTOR S,F,C,FT,CT,L
470     W3D TAG S,TG
480     FOR J=0 TO NW-1
490       READ X1,Y1,X2,Y2,T,NX,FL,UP,LO,XO,YO
500       W3D WALL S,X1,Y1,X2,Y2,T,NX
510       IF UP>=0 OR LO>=0 THEN W3D WALLTEX S,J,-1,UP,LO
520       IF FL<>0 THEN W3D WALLFLAG S,J,FL
530       IF XO<>0 OR YO<>0 THEN W3D WALLOFF S,J,XO,YO
540     NEXT J
550   NEXT I
560 END PROC
570 PROC PLACE
580   LOCAL I
590   RESTORE THINGDATA
600   NT=0
610   READ TX(NT)
620   WHILE TX(NT)<>9999
630     READ TY(NT),TT(NT),TW(NT),TH(NT),TZ(NT),TL(NT)
640     W3D THING NT,TX(NT),TY(NT),TT(NT),TW(NT),TH(NT)
650     IF TZ(NT)<>0 THEN W3D THINGZ NT,TZ(NT)
660     IF TL(NT)>=0 THEN W3D THINGLIGHT NT,TL(NT)
670     NT=NT+1
680     READ TX(NT)
690   WEND
700 END PROC
710 ' ------------------------------------------------------------------------------------------------ doors
720 PROC DOORUSE
730   LOCAL S,I
740   S=W3D("USE",70)
750   IF S<0 THEN RETURN
760   FOR I=1 TO 2
770     IF S=DSEC(I) THEN
780       DOPEN(I)=NOT DOPEN(I)
790       SFX 1
800     END IF
810   NEXT I
820 END PROC
830 PROC DOORS
840   LOCAL I,G
850   FOR I=1 TO 2
860     IF DOPEN(I) THEN G=100 ELSE G=0
870     IF DCUR(I)<G THEN DCUR(I)=MIN(G,DCUR(I)+2.5)
880     IF DCUR(I)>G THEN DCUR(I)=MAX(G,DCUR(I)-2.5)
890     W3D HEIGHT DSEC(I),0,DCUR(I)
900   NEXT I
910 END PROC
920 ' ------------------------------------------------------------------------------------------------ the screen
930 PROC TORCHES
940   LOCAL I
950   FOR I=0 TO NT-1
960     IF TT(I)=22 THEN W3D THINGTEX I,22+(((FR\5)+I) AND 1)
970   NEXT I
980 END PROC
990 PROC HUD
1000   LOCAL T
1010   CALL W3K_HUDBAR(264,36)
1020   T=W3D("TAG",W3D("SECTOR"))
1030   IF T>=10 THEN LASTT=T
1040   GFX TEXT 8,270,NM$(LASTT-10),FN W3K_C(3,14)
1050   GFX TEXT 8,284,"WASD/ARROWS WALK  SHIFT RUN  R/F LOOK  SPACE OPEN  P PAUSE  Q QUIT",FN W3K_C(0,10)
1060   IF FR<300 THEN
1070     GFX LINE 150,60,490,150,FN W3K_C(0,1),BF
1080     GFX LINE 150,60,490,150,FN W3K_C(3,12),B
1090     CALL BIGTEXT(72,"MANOR WALK",FN W3K_C(3,15),3)
1100     GFX TEXT 232,112,"A WALK THROUGH A SMALL HOUSE",FN W3K_C(0,13)
1110     GFX TEXT 224,128,"THE FRONT DOOR OPENS WITH SPACE",FN W3K_C(0,10)
1120   END IF
1130   CROSS=FN W3K_C(0,12)
1140 END PROC
1150 LABEL MAIN
1160 CALL TX_INIT
1170 CALL W3K_INIT
1180 IN_QUIT=0
1190 NM$(0)="THE GARDEN":NM$(1)="THE HALL":NM$(2)="THE LIVING ROOM":NM$(3)="THE STUDY":NM$(4)="THE GALLERY":NM$(5)="THE CELLAR":NM$(6)="THE POOL"
1200 CLS:COLOR 15,0:PRINT "Building the house...":GFX LAYER 2,ON
1210 CALL MAKETEX
1220 CALL LOADLEVEL
1230 CALL PLACE
1240 GFX LAYER 2,OFF
1250 W3D PLAYER 14,56,46,24
1260 W3D VIEW 0,0,640,264,2,90
1270 W3D FOG 800
1280 W3D COLORMAP
1290 W3D CAMERA 320,60,90
1300 DSEC(1)=1:DSEC(2)=16:DOPEN(1)=0:DOPEN(2)=0:DCUR(1)=0:DCUR(2)=0
1310 SFX 1,"W3 V0.5 ML X0,0.05,0.4,0.3 S160,70,18"
1320 LASTT=10:FR=0:UL=0
1330 REPEAT
1340   CALL W3K_WALK
1350   U=KEY("SPACE") OR JOY("A")
1360   IF U<>0 AND UL=0 THEN CALL DOORUSE
1370   UL=U
1380   IF KEY("ESC") THEN IN_QUIT=1
1390   CALL DOORS
1400   CALL TORCHES
1410   W3D RENDER
1420   CALL HUD
1430   GFX LINE 318,131,321,132,FN W3K_C(0,13),BF
1440   CALL W3K_SHOW
1450   FR=FR+1
1460   IF FN IN_SERVICE() THEN
1470     CALL BIGTEXT(110,"PAUSED",FN W3K_C(0,15),3)
1480     CALL IN_PAUSELOOP
1490     W3K_T0=TI
1500   END IF
1510 UNTIL IN_QUIT
1520 CALL W3K_DONE
1530 CALL TX_BYE("MANOR WALK")
1540 END
