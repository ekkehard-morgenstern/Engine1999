170 MF(0)=110:MF(1)=98:MF(2)=87:MF(3)=82
180 IM(1)=0:IM(2)=2:IM(3)=2:IM(4)=4:IM(5)=4
190 SV(0)=50:SV(1)=100:SV(2)=150:SV(3)=300
200 SX=36:SY=26:SHY=216:PY=262:UY=14
210 HI=0
220 ' sounds
230 SFX 1,"W1 V0.3 ML S1600,300,16"
240 SFX 2,"W3 V0.6 ML X0,0.01,0.25,0.08 S1500,120,16"
250 SFX 3,"W3 V1 ML X0,0.02,0.5,0.5 S700,35,2"
