2420 ' ---------------------------------------------------------------------------------------------- keys
2430 LABEL KEYS
2440 N=0
2450 REPEAT
2460 K$=INKEY$
2470 IF K$<>"" THEN GOSUB KEYACT
2480 N=N+1
2490 UNTIL K$="" OR N>=6
2500 RETURN
2510 LABEL KEYACT
2520 K=ASC(K$):IF K>=97 AND K<=122 THEN K=K-32
2530 IF K=65 OR K=90 THEN PD=-1
2540 IF K=68 OR K=88 THEN PD=1
2550 IF K=83 THEN PD=0
2560 IF K=32 THEN FQ=1
2570 IF K=81 THEN QT=1
2580 IF K=80 THEN GOSUB PAUSE
2590 RETURN
2600 LABEL PAUSE
2610 COLOR 140:LOCATE 36,21:PRINT "PAUSED"; :COLOR 140
2620 REPEAT
2630 GFX VSYNC
2640 K$=INKEY$
2650 UNTIL K$="p" OR K$="P" OR K$="q" OR K$="Q"
2660 IF K$="q" OR K$="Q" THEN QT=1
2670 TXT FILL 36,21,41,21,32
2680 RETURN
2690 ' ---------------------------------------------------------------------------------------------- the cannon and its bullet
2700 LABEL MOVECANNON
2710 IF PD=0 THEN RETURN
2720 PX=PX+PD*3
2730 IF PX<4 THEN PX=4:PD=0
2740 IF PX>620 THEN PX=620:PD=0
2750 SPRITE 40,PX,PY
2760 RETURN
2770 LABEL BULLET
2780 IF FQ=1 THEN GOSUB FIRE
2790 IF PBA=0 THEN RETURN
2800 PBY=PBY-7
2810 IF PBY<8 THEN PBA=0:SPRITE 41,OFF:RETURN
2820 SPRITE 41,PBX,PBY
2830 TX=PBX+7:TY=PBY+6
2840 IF POINT(TX,TY)>0 THEN GOSUB SHIELDHIT:PBA=0:SPRITE 41,OFF:RETURN
2850 IF UA=1 AND TX>=UX AND TX<UX+16 AND TY>=UY+2 AND TY<UY+20 THEN GOSUB UFOHIT:RETURN
2860 IF TX>=FX AND TY>=FY THEN GOSUB INVADERHIT
2870 RETURN
2880 LABEL FIRE
2890 FQ=0
2900 IF PBA=1 THEN RETURN
2910 PBA=1:PBX=PX:PBY=PY-8
2920 SPRITE 41,PBX,PBY,7:SPRITE 41,ON
2930 SFX 1
2940 RETURN
2950 ' did the bullet (TX,TY) hit an invader?
2960 LABEL INVADERHIT
2970 C=(TX-FX)\SX:RX=TX-FX-C*SX
2980 RW=(TY-FY)\SY+1:RY=TY-FY-(RW-1)*SY
2990 IF C<=7 AND RW<=5 AND RX<16 AND RY>=4 AND RY<20 THEN
3000 IF A(RW,C)=1 THEN GOSUB ZAP
3010 ENDIF
3020 RETURN
3030 LABEL ZAP
3040 A(RW,C)=0:NA=NA-1
3050 IF RW=1 THEN SC=SC+30
3060 IF RW=2 OR RW=3 THEN SC=SC+20
3070 IF RW>=4 THEN SC=SC+10
3080 N=(RW-1)*8+C
3090 SPRITE N,OFF
3100 EI=1-EI
3110 SPRITE 46+EI,FX+C*SX,FY+(RW-1)*SY,10:SPRITE 46+EI,ON:ET(EI)=8
3120 SFX 2
3130 PBA=0:SPRITE 41,OFF
3140 GOSUB SCORED
3150 SP=NA\2+2-WV:IF SP<2 THEN SP=2
3160 RETURN
3170 ' score changed: an extra life every 1500 points, the high score, redraw the score line
3180 LABEL SCORED
3190 IF SC>=NX THEN LV=LV+1:NX=NX+1500:SFX 5
3200 IF SC>HI THEN HI=SC
3210 HF=1
3220 RETURN
3230 ' ---------------------------------------------------------------------------------------------- the invaders' bombs
3240 LABEL BOMBS
3250 FOR I=0 TO 2
3260 IF BO(I)=1 THEN GOSUB BOMBMOVE
3270 NEXT I
3280 RM=BR:GOSUB RNG
3290 IF R=0 THEN GOSUB SPAWN
3300 RETURN
3310 LABEL BOMBMOVE
3320 BY(I)=BY(I)+BS
3330 IF BY(I)>288 THEN BO(I)=0:SPRITE 42+I,OFF:RETURN
3340 SPRITE 42+I,BX(I),BY(I)
3350 TX=BX(I)+7:TY=BY(I)+16
3360 IF TY<286 AND POINT(TX,TY)>0 THEN GOSUB SHIELDHIT:BO(I)=0:SPRITE 42+I,OFF:RETURN
3370 IF TY>=PY+14 AND TX>=PX+1 AND TX<=PX+15 THEN GOSUB CANNONHIT:RETURN
3380 IF PBA=1 AND TX>=PBX+4 AND TX<=PBX+11 AND TY>=PBY+6 AND TY<=PBY+18 THEN BO(I)=0:SPRITE 42+I,OFF:PBA=0:SPRITE 41,OFF:SFX 6
3390 RETURN
3400 ' a new bomb from the lowest invader of a random column that still has one
3410 LABEL SPAWN
3420 J=-1
3430 FOR Z=0 TO 2
3440 IF BO(Z)=0 THEN J=Z
3450 NEXT Z
3460 IF J<0 THEN RETURN
3470 RM=8:GOSUB RNG:C=R
3480 FOR Z=1 TO 8
3490 RW=5
3500 WHILE A(RW,C)=0 AND RW>0
3510 RW=RW-1
3520 WEND
3530 IF RW>0 THEN GOSUB DROPBOMB:RETURN
3540 C=C+1:IF C>7 THEN C=0
3550 NEXT Z
3560 RETURN
3570 LABEL DROPBOMB
3580 BO(J)=1:BX(J)=FX+C*SX:BY(J)=FY+(RW-1)*SY+12
3590 SPRITE 42+J,BX(J),BY(J),8:SPRITE 42+J,ON
3600 RETURN
3610 ' a hit on a shield at (TX,TY): a crumbly hole
3620 LABEL SHIELDHIT
3630 GFX LINE TX-4,TY-5,TX+3,TY+4,0,BF
3640 FOR Z=1 TO 5
3650 RM=14:GOSUB RNG:XX=TX-7+R
3660 RM=14:GOSUB RNG:GFX PSET XX,TY-7+R,0
3670 NEXT Z
3680 SFX 6
3690 RETURN
3700 ' ---------------------------------------------------------------------------------------------- the pineapple
3710 LABEL UFO
3720 IF UA=1 THEN
3730 UX=UX+UD*2
3740 SPRITE 45,UX,UY
3750 IF UX<-20 OR UX>640 THEN UA=0:SPRITE 45,OFF:SOUND OFF 2
3760 RETURN
3770 ENDIF
3780 UT=UT-1
3790 IF UT<=0 AND NA>6 THEN GOSUB UFOSTART
3800 RETURN
3810 LABEL UFOSTART
3820 UA=1
3830 RM=2:GOSUB RNG
3840 IF R=0 THEN UX=-16:UD=1 ELSE UX=640:UD=-1
3850 SPRITE 45,UX,UY,9:SPRITE 45,ON
3860 WAVE 2,0:VIBRATO 2,7,4:SOUND 2,600,0,0.12
3870 RM=600:GOSUB RNG:UT=700+R
3880 RETURN
3890 LABEL UFOHIT
3900 RM=4:GOSUB RNG:SC=SC+SV(R)
3910 EI=1-EI
3920 SPRITE 46+EI,UX,UY,10:SPRITE 46+EI,ON:ET(EI)=12
3930 UA=0:SPRITE 45,OFF:SOUND OFF 2
3940 PBA=0:SPRITE 41,OFF
3950 SFX 4
3960 GOSUB SCORED
3970 RETURN
3980 ' ---------------------------------------------------------------------------------------------- the formation
3990 LABEL FORM
4000 ST=ST+1
4010 IF ST<SP THEN RETURN
4020 ST=0
4030 GOSUB MARCH
4040 RETURN
4050 LABEL MARCH
4060 MN=8:MX=-1:LR=0
4070 FOR C=0 TO 7
4080 FOR RW=1 TO 5
4090 IF A(RW,C)=1 AND MN=8 THEN MN=C
4100 IF A(RW,C)=1 THEN MX=C
4110 IF A(RW,C)=1 AND RW>LR THEN LR=RW
4120 NEXT RW
4130 NEXT C
4140 IF (DX=1 AND FX+MX*SX+16+SD>630) OR (DX=-1 AND FX+MN*SX-SD<8) THEN
4150 DX=0-DX:FY=FY+10
4160 ELSE
4170 FX=FX+DX*SD
4180 ENDIF
4190 FA=1-FA
4200 SOUND 1,MF(MI),0.08,0.3
4210 MI=MI+1:IF MI>3 THEN MI=0
4220 FOR RW=1 TO 5
4230 FOR C=0 TO 7
4240 IF A(RW,C)=1 THEN SPRITE (RW-1)*8+C,FX+C*SX,FY+(RW-1)*SY,IM(RW)+FA
4250 NEXT C
4260 NEXT RW
4270 IF FY+(LR-1)*SY+20>=SHY-2 THEN OV=1:LANDED=1
4280 RETURN
4290 ' ---------------------------------------------------------------------------------------------- explosions
4300 LABEL EFFECTS
4310 FOR I=0 TO 1
4320 IF ET(I)>0 THEN GOSUB ETICK
4330 NEXT I
4340 RETURN
4350 LABEL ETICK
4360 ET(I)=ET(I)-1
4370 IF ET(I)=0 THEN SPRITE 46+I,OFF
4380 RETURN
4390 ' the cannon was hit
4400 LABEL CANNONHIT
4410 LV=LV-1
4420 SFX 3
4430 PBA=0:SPRITE 41,OFF
4440 FOR Z=0 TO 2
4450 BO(Z)=0:SPRITE 42+Z,OFF
4460 NEXT Z
4470 SPRITE 40,OFF
4480 SPRITE 48,PX-8,PY-4,11:SPRITE 48,ON
4490 FOR Z=1 TO 70
4500 IF Z=36 THEN SPRITE 48,IMAGE 10
4510 GFX VSYNC
4520 K$=INKEY$
4530 NEXT Z
4540 SPRITE 48,OFF
4550 IF LV<=0 THEN OV=1:RETURN
4560 PX=312:PD=0
4570 SPRITE 40,PX,PY,6:SPRITE 40,ON
4580 HF=1
4590 RETURN
