3730 LABEL UFO
3740 IF UA=1 THEN
3750 UX=UX+UD*2
3760 SPRITE 45,UX,UY
3770 IF UX<-20 OR UX>640 THEN UA=0:SPRITE 45,OFF:SOUND OFF 2
3780 RETURN
3790 ENDIF
3800 UT=UT-1
3810 IF UT<=0 AND NA>6 THEN GOSUB UFOSTART
3820 RETURN
3830 LABEL UFOSTART
3840 UA=1
3850 RM=2:GOSUB RNG
