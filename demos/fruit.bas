2440 ' ---------------------------------------------------------------------------------------------- keys
2450 LABEL KEYS
2460 N=0
2470 REPEAT
2480 K$=INKEY$
2490 IF K$<>"" THEN GOSUB KEYACT
2500 N=N+1
2510 UNTIL K$="" OR N>=6
2520 RETURN
2530 LABEL KEYACT
2540 K=ASC(K$):IF K>=97 AND K<=122 THEN K=K-32
2550 IF K=65 OR K=90 THEN PD=-1
2560 IF K=68 OR K=88 THEN PD=1
2570 IF K=83 THEN PD=0
2580 IF K=32 THEN FQ=1
2590 IF K=81 THEN QT=1
2600 IF K=80 THEN GOSUB PAUSE
2610 RETURN
2620 LABEL PAUSE
2630 COLOR 140:LOCATE 36,21:PRINT "PAUSED"; :COLOR 140
2640 REPEAT
2650 GFX VSYNC
2660 K$=INKEY$
2670 UNTIL K$="p" OR K$="P" OR K$="q" OR K$="Q"
2680 IF K$="q" OR K$="Q" THEN QT=1
2690 TXT FILL 36,21,41,21,32
2700 RETURN
2710 ' ---------------------------------------------------------------------------------------------- the cannon and its bullet
2720 LABEL MOVECANNON
2730 IF PD=0 THEN RETURN
2740 PX=PX+PD*3
2750 IF PX<4 THEN PX=4:PD=0
2760 IF PX>620 THEN PX=620:PD=0
2770 SPRITE 40,PX,PY
2780 RETURN
2790 LABEL BULLET
2800 IF FQ=1 THEN GOSUB FIRE
2810 IF PBA=0 THEN RETURN
2820 PBY=PBY-7
2830 IF PBY<8 THEN PBA=0:SPRITE 41,OFF:RETURN
2840 SPRITE 41,PBX,PBY
2850 TX=PBX+7:TY=PBY+6
2860 IF POINT(TX,TY)>0 THEN GOSUB SHIELDHIT:PBA=0:SPRITE 41,OFF:RETURN
2870 IF UA=1 AND TX>=UX AND TX<UX+16 AND TY>=UY+2 AND TY<UY+20 THEN GOSUB UFOHIT:RETURN
2880 IF TX>=FX AND TY>=FY THEN GOSUB INVADERHIT
2890 RETURN
2900 LABEL FIRE
2910 FQ=0
2920 IF PBA=1 THEN RETURN
2930 PBA=1:PBX=PX:PBY=PY-8
2940 SPRITE 41,PBX,PBY,7:SPRITE 41,ON
2950 SFX 1
2960 RETURN
2970 ' did the bullet (TX,TY) hit an invader?
2980 LABEL INVADERHIT
2990 Q%=(TX-FX)/SX:C=Q%:RX=TX-FX-C*SX
3000 Q%=(TY-FY)/SY:RW=Q%+1:RY=TY-FY-(RW-1)*SY
3010 IF C<=7 AND RW<=5 AND RX<16 AND RY>=4 AND RY<20 THEN
3020 IF A(RW,C)=1 THEN GOSUB ZAP
3030 ENDIF
3040 RETURN
3050 LABEL ZAP
3060 A(RW,C)=0:NA=NA-1
3070 IF RW=1 THEN SC=SC+30
3080 IF RW=2 OR RW=3 THEN SC=SC+20
3090 IF RW>=4 THEN SC=SC+10
3100 N=(RW-1)*8+C
3110 SPRITE N,OFF
3120 EI=1-EI
3130 SPRITE 46+EI,FX+C*SX,FY+(RW-1)*SY,10:SPRITE 46+EI,ON:ET(EI)=8
3140 SFX 2
3150 PBA=0:SPRITE 41,OFF
3160 GOSUB SCORED
3170 Q%=NA/2:SP=Q%+2-WV:IF SP<2 THEN SP=2
3180 RETURN
3190 ' score changed: an extra life every 1500 points, the high score, redraw the score line
3200 LABEL SCORED
3210 IF SC>=NX THEN LV=LV+1:NX=NX+1500:SFX 5
3220 IF SC>HI THEN HI=SC
3230 HF=1
3240 RETURN
3250 ' ---------------------------------------------------------------------------------------------- the invaders' bombs
3260 LABEL BOMBS
3270 FOR I=0 TO 2
3280 IF BO(I)=1 THEN GOSUB BOMBMOVE
3290 NEXT I
3300 RM=BR:GOSUB RNG
3310 IF R=0 THEN GOSUB SPAWN
3320 RETURN
3330 LABEL BOMBMOVE
3340 BY(I)=BY(I)+BS
3350 IF BY(I)>288 THEN BO(I)=0:SPRITE 42+I,OFF:RETURN
3360 SPRITE 42+I,BX(I),BY(I)
3370 TX=BX(I)+7:TY=BY(I)+16
3380 IF TY<286 AND POINT(TX,TY)>0 THEN GOSUB SHIELDHIT:BO(I)=0:SPRITE 42+I,OFF:RETURN
3390 IF TY>=PY+14 AND TX>=PX+1 AND TX<=PX+15 THEN GOSUB CANNONHIT:RETURN
3400 IF PBA=1 AND TX>=PBX+4 AND TX<=PBX+11 AND TY>=PBY+6 AND TY<=PBY+18 THEN BO(I)=0:SPRITE 42+I,OFF:PBA=0:SPRITE 41,OFF:SFX 6
3410 RETURN
3420 ' a new bomb from the lowest invader of a random column that still has one
3430 LABEL SPAWN
3440 J=-1
3450 FOR Z=0 TO 2
3460 IF BO(Z)=0 THEN J=Z
3470 NEXT Z
3480 IF J<0 THEN RETURN
3490 RM=8:GOSUB RNG:C=R
3500 FOR Z=1 TO 8
3510 RW=5
3520 WHILE A(RW,C)=0 AND RW>0
3530 RW=RW-1
3540 WEND
3550 IF RW>0 THEN GOSUB DROPBOMB:RETURN
3560 C=C+1:IF C>7 THEN C=0
3570 NEXT Z
3580 RETURN
3590 LABEL DROPBOMB
3600 BO(J)=1:BX(J)=FX+C*SX:BY(J)=FY+(RW-1)*SY+12
3610 SPRITE 42+J,BX(J),BY(J),8:SPRITE 42+J,ON
3620 RETURN
3630 ' a hit on a shield at (TX,TY): a crumbly hole
3640 LABEL SHIELDHIT
3650 GFX LINE TX-4,TY-5,TX+3,TY+4,0,BF
3660 FOR Z=1 TO 5
3670 RM=14:GOSUB RNG:XX=TX-7+R
3680 RM=14:GOSUB RNG:GFX PSET XX,TY-7+R,0
3690 NEXT Z
3700 SFX 6
3710 RETURN
