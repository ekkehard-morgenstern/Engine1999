4610 LABEL NEWWAVE
4620 FOR RW=1 TO 5
4630 FOR C=0 TO 7
4640 A(RW,C)=1
4650 NEXT C
4660 NEXT RW
4670 NA=40
4680 Q=WV-1:IF Q>4 THEN Q=4
4690 FX=40:FY=34+Q*8:DX=1:SD=6
4700 SP=22-WV:IF SP<10 THEN SP=10
4710 ST=0:MI=0:FA=0
4720 BS=2+WV\2:IF BS>5 THEN BS=5
4730 BR=50-WV*5:IF BR<14 THEN BR=14
4740 GFX CLEAR
4750 GOSUB SHIELDS
4760 FOR I=0 TO 2
4770 BO(I)=0:SPRITE 42+I,OFF
4780 NEXT I
4790 PBA=0:SPRITE 41,OFF
4800 UA=0:SPRITE 45,OFF:SOUND OFF 2
4810 RM=600:GOSUB RNG:UT=500+R
4820 FOR RW=1 TO 5
4830 FOR C=0 TO 7
4840 SPRITE (RW-1)*8+C,FX+C*SX,FY+(RW-1)*SY,IM(RW)
4850 SPRITE (RW-1)*8+C,ON
4860 NEXT C
4870 NEXT RW
4880 PX=312:PD=0:FQ=0
4890 SPRITE 40,PX,PY,6:SPRITE 40,ON
4900 COLOR 140:LOCATE 35,21:PRINT "WAVE ";WV; :COLOR 140
4910 GOSUB HUD
4920 FOR Z=1 TO 75
4930 GFX VSYNC
4940 K$=INKEY$
4950 NEXT Z
4960 TXT FILL 35,21,44,21,32
4970 RETURN
4980 LABEL WAVEDONE
4990 SOUND OFF
5000 PLAY "T200 W1 V0.35 O5 C8 E8 G8 >C4","T200 W2 V0.3 O4 C8 E8 G8 >C4"
5010 FOR Z=1 TO 90
5020 GFX VSYNC
5030 NEXT Z
