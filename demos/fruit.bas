4880 NEXT C
4890 NEXT RW
4900 PX=312:PD=0:FQ=0
4910 SPRITE 40,PX,PY,6:SPRITE 40,ON
4920 COLOR 140:LOCATE 35,21:PRINT "WAVE ";WV; :COLOR 140
4930 GOSUB HUD
4940 FOR Z=1 TO 75
