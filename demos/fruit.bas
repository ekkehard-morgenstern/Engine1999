5320 RETURN
5330 LABEL PLAYGAME
5340 SC=0:LV=3:WV=1:NX=1500:OV=0:LANDED=0:QT=0
5350 PBA=0:UA=0:EI=0:ET(0)=0:ET(1)=0
5360 GOSUB CLEARALL
5370 GOSUB NEWWAVE
5380 WHILE OV=0
5390 GOSUB KEYS
5400 IF QT=1 THEN OV=1
5410 GOSUB MOVECANNON
5420 GOSUB BULLET
5430 GOSUB BOMBS
5440 GOSUB UFO
5450 GOSUB FORM
5460 GOSUB EFFECTS
5470 IF HF=1 THEN GOSUB HUD
5480 IF NA=0 AND OV=0 THEN GOSUB WAVEDONE
5490 GFX VSYNC
5500 WEND
5510 GOSUB OVER
5520 RETURN
5530 LABEL OVER
5540 SOUND OFF
5550 IF QT=1 THEN RETURN
5560 FOR I=0 TO 48
5570 SPRITE I,OFF
5580 NEXT I
5590 GFX TEXT 168,110,"GAME OVER",110,5,5
5600 IF LANDED=1 THEN COLOR 140:LOCATE 28,18:PRINT "The fruit has landed!";
5610 COLOR 140:LOCATE 30,20:PRINT "Score ";SC; :COLOR 140
5620 PLAY "T100 W2 V0.5 O4 C4 <B4 A4 G2"
5630 FOR Z=1 TO 150
5640 GFX VSYNC
5650 K$=INKEY$
5660 NEXT Z
5670 RETURN
