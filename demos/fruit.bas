3880 WAVE 2,0:VIBRATO 2,7,4:SOUND 2,600,0,0.12
3890 RM=600:GOSUB RNG:UT=700+R
3900 RETURN
3910 LABEL UFOHIT
3920 RM=4:GOSUB RNG:SC=SC+SV(R)
3930 EI=1-EI
3940 SPRITE 46+EI,UX,UY,10:SPRITE 46+EI,ON:ET(EI)=12
3950 UA=0:SPRITE 45,OFF:SOUND OFF 2
3960 PBA=0:SPRITE 41,OFF
3970 SFX 4
3980 GOSUB SCORED
3990 RETURN
4000 ' ---------------------------------------------------------------------------------------------- the formation
4010 LABEL FORM
4020 ST=ST+1
4030 IF ST<SP THEN RETURN
4040 ST=0
4050 GOSUB MARCH
4060 RETURN
4070 LABEL MARCH
4080 MN=8:MX=-1:LR=0
4090 FOR C=0 TO 7
4100 FOR RW=1 TO 5
4110 IF A(RW,C)=1 AND MN=8 THEN MN=C
4120 IF A(RW,C)=1 THEN MX=C
4130 IF A(RW,C)=1 AND RW>LR THEN LR=RW
4140 NEXT RW
4150 NEXT C
4160 IF (DX=1 AND FX+MX*SX+16+SD>630) OR (DX=-1 AND FX+MN*SX-SD<8) THEN
4170 DX=0-DX:FY=FY+10
4180 ELSE
4190 FX=FX+DX*SD
4200 ENDIF
4210 FA=1-FA
4220 SOUND 1,MF(MI),0.08,0.3
4230 MI=MI+1:IF MI>3 THEN MI=0
4240 FOR RW=1 TO 5
4250 FOR C=0 TO 7
4260 IF A(RW,C)=1 THEN SPRITE (RW-1)*8+C,FX+C*SX,FY+(RW-1)*SY,IM(RW)+FA
4270 NEXT C
4280 NEXT RW
4290 IF FY+(LR-1)*SY+20>=SHY-2 THEN OV=1:LANDED=1
4300 RETURN
