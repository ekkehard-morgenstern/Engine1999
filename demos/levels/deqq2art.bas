10 ' deqq2art.bas - the sprites of demos/deqq2.bas (Deqq's House II) as DATA lines, drawn with a tiny command language: engine1999c deqq2art.bas [file]
20 '   DATA n,w,h                      a sprite: texture number, width, height (index 0 = see-through)
30 '   DATA t,a,b,c,d,hue,shade        one command: t 1 filled rectangle a,b,c,d  2 rectangle outline  3 line a,b to c,d  4 filled ellipse centre a,b radius c, d/10 as high as wide
40 '                                   5 pixel a,b  (hue 0 gray, 1 red, 2 orange, 3 yellow, 4 lime, 5 green, 6 teal, 7 cyan, 8 azure, 9 blue, 10 purple, 11 magenta, 12 brown, 13 sand, 14 pink; shade 0..15)
50 '   DATA 0                          the end of the sprite;  DATA -1 ends the table
60 ' The drawing procedures: CR rectangle, CO outline, CL line, CE ellipse (the last size is the ratio in tenths: 12 = 1.2 times as high as wide), CP pixel.
70 F$=ARG$(1):IF F$="" THEN F$="stdout:"
80 OPEN F$ FOR OUTPUT AS #1
90 PROC SPR(N,W,H)
100   PRINT #1,"DATA "+STR$(N)+","+STR$(W)+","+STR$(H)
110 END PROC
120 PROC SEND
130   PRINT #1,"DATA 0"
140 END PROC
150 PROC CMD(T,A,B,C,D,H,S)
160   PRINT #1,"DATA "+STR$(T)+","+STR$(A)+","+STR$(B)+","+STR$(C)+","+STR$(D)+","+STR$(H)+","+STR$(S)
170 END PROC
180 PROC CR(A,B,C,D,H,S)
190   CALL CMD(1,A,B,C,D,H,S)
200 END PROC
210 PROC CO(A,B,C,D,H,S)
220   CALL CMD(2,A,B,C,D,H,S)
230 END PROC
240 PROC CL(A,B,C,D,H,S)
250   CALL CMD(3,A,B,C,D,H,S)
260 END PROC
270 PROC CE(X,Y,R,RT,H,S)
280   CALL CMD(4,X,Y,R,RT,H,S)
290 END PROC
300 PROC CP(A,B,H,S)
310   CALL CMD(5,A,B,0,0,H,S)
320 END PROC
330 ' Deqq: a tall mint-green alien in a gray cape, big black eyes; two walking frames and an alerted one
340 PROC DEQQ(N,LEGS,ALERT)
350   CALL SPR(N,40,72)
360   CALL CL(14,56,12+LEGS*3,70,0,3):CALL CL(26,56,28-LEGS*3,70,0,3):CALL CR(10+LEGS*3,68,15+LEGS*3,71,0,2):CALL CR(24-LEGS*3,68,29-LEGS*3,71,0,2)
370   CALL CR(8,24,31,58,0,8):CALL CR(10,26,29,56,0,10):CALL CR(6,22,33,26,0,6)
380   IF ALERT THEN
390     CALL CL(8,30,1,14,6,9):CALL CL(31,30,38,14,6,9)
400   ELSE
410     CALL CL(8,32,3,48,6,9):CALL CL(31,32,36,48,6,9)
420   END IF
430   CALL CE(20,14,11,12,6,11):CALL CE(20,13,9,11,6,13)
440   CALL CE(15,13,3,15,0,1):CALL CE(25,13,3,15,0,1)
450   IF ALERT THEN
460     CALL CP(15,12,1,13):CALL CP(25,12,1,13):CALL CP(14,12,1,13):CALL CP(26,12,1,13)
470   ELSE
480     CALL CP(15,12,0,15):CALL CP(25,12,0,15)
490   END IF
500   CALL CL(17,21,23,21,0,3):CALL CL(20,0,20,5,6,9):CALL CE(20,1,2,10,3,13)
510   CALL SEND
520 END PROC
530 CALL DEQQ(40,0,0):CALL DEQQ(41,1,0):CALL DEQQ(42,0,-1)
540 ' the glorp: a blob with big eyes (hungry: purple, a frown; fed: lime, a smile)
550 PROC GLORP(N,HUE,HAPPY)
560   CALL SPR(N,36,28)
570   CALL CE(18,17,15,7,HUE,10):CALL CE(18,15,12,6,HUE,12):CALL CE(11,10,4,10,0,15):CALL CE(25,10,4,10,0,15):CALL CE(11,11,2,10,0,1):CALL CE(25,11,2,10,0,1)
580   IF HAPPY THEN
590     CALL CL(10,19,14,23,0,2):CALL CL(14,23,22,23,0,2):CALL CL(22,23,26,19,0,2)
600   ELSE
610     CALL CL(10,23,14,19,0,2):CALL CL(14,19,22,19,0,2):CALL CL(22,19,26,23,0,2)
620   END IF
630   CALL SEND
640 END PROC
650 CALL GLORP(43,10,0):CALL GLORP(44,4,-1)
