1 ' License: free for everybody to use, copy, change and build into executables (BUILD).
2 ' An executable made with BUILD contains the Engine1999 runtime: the Engine1999 Runtime Exception
3 ' (file LICENSE-EXCEPTION of Engine1999) applies if the runtime is unmodified and its notice stays
4 ' in the executable (it shows with the command line option --engine1999-about).
10 ' mkw3d - builds a level of rectangular sectors and writes it as DATA lines for the W3D statements (a library: LOAD LIBRARY "mkw3d").
20 ' Used by the level generators manor.bas, bunker.bas and deqq2.bas in demos/levels (run them with engine1999c, e.g. engine1999c manor.bas out.txt;
30 ' the output is pasted into the demos). The same job was done by mkw3d.py before; the output is identical.
40 ' Output:  DATA nsectors
50 '          DATA s,floor,ceil,floortex,ceiltex,light,tag,nwalls                  (one line per sector, in the order of the numbers)
60 '          DATA x1,y1,x2,y2,tex,next,flags,upper,lower,xoff,yoff                 (one line per wall)
70 ' Calls (a side is "S" = the y1 edge, "N" = the y2 edge, "W" = the x1 edge, "E" = the x2 edge; -1 = not given for a texture or an upper / lower wall):
80 '   CALL MK_ROOM(id,x1,y1,x2,y2,floor,ceil,look$)   a rectangular sector; look$ = "floortex,ceiltex,light,tag,walltex" (a procedure has at most 8 parameters)
90 '   CALL MK_LINK(a,side$,lo,hi,b)                a portal from sector a along its side, between lo and hi, to the sector b (whose opposite side must touch it)
100 '   CALL MK_LINKT(a,side$,lo,hi,b,tex)           the same with the picture of the walls
110 '   CALL MK_LINKX(a,side$,lo,hi,b,more$)         the same with everything: more$ = "tex,up,low,flags,xoff,yoff"
120 '   CALL MK_PILLAR(a,x1,y1,x2,y2,tex)            a solid block in sector a
130 '   CALL MK_INNER(a,b,tex)                       sector b lies inside sector a (a hole in a): all four sides of b are portals
140 '   CALL MK_INNERF(a,b,tex,flags)                the same, the ring of walls (both sides) has these flags: a fence = 250 and 3 (a masked picture that blocks)
150 '   CALL MK_HOUSE(id,side$,lo,hi)                an outdoor sector's wall between lo and hi is the house (see MK_FINISH)
160 '   CALL MK_OUTDOOR(id)                          an outdoor sector without house walls
170 '   CALL MK_GROUND(g)                            before MK_FINISH: the far wall of every fence sector is a portal into the sector g (which may lie over the premises: rays only follow portals), so there is no wall behind the fence
180 '   CALL MK_FENCE(tex,flags)                     before MK_FINISH: the picture and the wall flags of the portal between an outdoor sector and its fence sector (default -1 and 6: nothing to see, nobody passes; 250 and 3 = a masked railing)
190 '   CALL MK_FINISH(housetex,fenceh,fencetex)     outdoor sectors: solid walls become the house (tall picture) or a low fence sector behind the wall
200 '   CALL MK_POLY(id,floor,ceil,look$,pts$)        a sector of any shape: pts$ = "x,y,x,y,..." (3 to 32 corners, walked in order, closed by itself); look$ as for MK_ROOM (the walltex is the default of all its walls)
210 '   CALL MK_PLINK(a,edge,b)  /  CALL MK_PLINKT(a,edge,b,tex)   edge number e (0 = from the first corner to the second ...) of the polygon a is a portal to the sector b (whose edge must run along it, the other way round)
220 '   CALL MK_PTEX(a,edge,tex)                     the picture of one edge;  FN MK_ARC$(cx,cy,radius,angle1,angle2,steps) = the corners "x,y,..." of an arc (angles in degrees, any DEG / RAD / GRAD mode)
230 '   CALL MK_SLOPE(id,floorx,floory,ceilx,ceily)  slopes of the floor and ceiling (rise per unit; the heights given to the room are those at its middle)
240 '   CALL MK_THING(n,x,y,tex,w,h,z)               a thing;   CALL MK_RAW(line$)  a line of the map file as it is (SKY, FOG, FAR ...; only for MK_EMITMAP)
250 '   CALL MK_EMITMAP(file$) / CALL MK_EMITMAPDATA(file$)   writes the level as a map file for the library w3dmap (see there) instead of DATA lines; the second form writes DATA lines with quoted text (a program READs them and feeds WM_LINE)
260 '   CALL MK_EMIT(file$)                          writes the DATA lines ("" = standard output)
262 '   CALL MK_ENVIRON(name$,fog,startx,starty,angle)  the name, fog distance and start of the world document;  CALL MK_NAME(id,name$)  a name for a room
264 '   CALL MK_EMITJSON(file$)                      writes the level as a world document (docs/world-model.md: rooms, solids, openings, things, environment; W3D WORLD builds it); call it after MK_FINISH:
266 '                                                it writes what was said (rooms, holes, links, house spans, the fence), not the sectors MK_FINISH made: the loader makes those again. Not supported: polygons, pillars, slopes
270 LIBRARY "mkw3d","MK_"
280 PROC MK_INIT
290   DIM MK_X1(600),MK_Y1(600),MK_X2(600),MK_Y2(600),MK_F(600),MK_C(600),MK_FT(600),MK_CT(600),MK_LT(600),MK_TG(600),MK_WT(600),MK_EX(600),MK_OUT(600)
300   DIM MK_ORD(600),MK_HN(2400),MK_HLO(9600),MK_HHI(9600)
310   DIM MK_LA(2000),MK_LS(2000),MK_LLO(2000),MK_LHI(2000),MK_LB(2000),MK_LTX(2000),MK_LUP(2000),MK_LLW(2000),MK_LFL(2000),MK_LXO(2000),MK_LYO(2000)
320   DIM MK_PFL(800),MK_PR(800),MK_PK(800),MK_PX1(800),MK_PY1(800),MK_PX2(800),MK_PY2(800),MK_PB(800),MK_PTX(800)
330   DIM MK_SL(200),MK_SH(200),MK_SB(200),MK_SI(200),MK_PV(20),MK_TI(2000),MK_WL(400,12),MK_GL(100),MK_GH(100),MK_PCK(100),MK_PCL(100),MK_PCH(100)
340   DIM MK_PLY(600),MK_PNN(600),MK_PPX(19200),MK_PPY(19200),MK_PEB(19200),MK_PET(19200),MK_PT(66),MK_SFX(600),MK_SFY(600),MK_SCX(600),MK_SCY(600),MK_SLO(600),MK_TH(300,8),MK_RW$(300)
345   DIM MK_JA(2000),MK_JK(2000),MK_JLO(2000),MK_JHI(2000),MK_JB(2000),MK_JTX(2000),MK_JUP(2000),MK_JLW(2000),MK_JFL(2000),MK_JXO(2000),MK_JYO(2000),MK_J2(2000),MK_INH(600),MK_ITX(600),MK_IFL(600),MK_NM$(600)
350   MK_NR=0:MK_NL=0:MK_NP=0:MK_NW=0:MK_PN=0:MK_NTH=0:MK_NRW=0:MK_FTX0=-1:MK_FFL=6:MK_LF=0:MK_GND=-1:MK_NJ=0:MK_REC=-1:MK_NR0=-1:MK_FIN=0:MK_NPIL=0:MK_FOG=-1:MK_WNAME$=""
360 END PROC
370 ' MK_PARSE: the numbers of a comma separated string in MK_PV(0..MK_PN-1)
380 PROC MK_PARSE(S$)
390   LOCAL I,C$,T$
400   MK_PN=0:T$=""
410   FOR I=1 TO LEN(S$)+1
420     IF I>LEN(S$) THEN C$="," ELSE C$=MID$(S$,I,1)
430     IF C$="," THEN
440       MK_PV(MK_PN)=VAL(T$):MK_PN=MK_PN+1:T$=""
450     ELSE
460       IF C$<>" " THEN T$=T$+C$
470     END IF
480   NEXT I
490 END PROC
500 PROC MK_FAIL(M$)
510   OPEN "stderr:" FOR OUTPUT AS #2
520   PRINT #2,"mkw3d: ";M$
530   CLOSE #2
540   BYE 1
550 END PROC
560 FUNC MK_SIDE(S$)
570   IF S$="S" THEN RETURN 0
580   IF S$="E" THEN RETURN 1
590   IF S$="N" THEN RETURN 2
600   IF S$="W" THEN RETURN 3
610   CALL MK_FAIL("bad side "+S$)
620   RETURN 0
630 END FUNC
640 PROC MK_ROOM(ID,X1,Y1,X2,Y2,F,C,L$)
650   CALL MK_PARSE(L$)
660   CALL MK_ROOMN(ID,X1,Y1,X2,Y2,F,C)
670 END PROC
680 ' MK_ROOMN: a sector whose look is in MK_PV(0..4) (floortex,ceiltex,light,tag,walltex)
690 PROC MK_ROOMN(ID,X1,Y1,X2,Y2,F,C)
700   LOCAL K
710   IF ID<0 OR ID>599 THEN CALL MK_FAIL("sector number out of range")
720   IF NOT MK_EX(ID) THEN
730     MK_ORD(MK_NR)=ID:MK_NR=MK_NR+1
740   END IF
750   MK_EX(ID)=-1:MK_OUT(ID)=0:MK_PLY(ID)=0:MK_SLO(ID)=0:MK_INH(ID)=-1:MK_NM$(ID)=""
760   MK_X1(ID)=X1:MK_Y1(ID)=Y1:MK_X2(ID)=X2:MK_Y2(ID)=Y2:MK_F(ID)=F:MK_C(ID)=C
770   MK_FT(ID)=MK_PV(0):MK_CT(ID)=MK_PV(1):MK_LT(ID)=MK_PV(2):MK_TG(ID)=MK_PV(3):MK_WT(ID)=MK_PV(4)
780   FOR K=0 TO 3
790     MK_HN(ID*4+K)=0
800   NEXT K
810 END PROC
820 ' MK_ADD: a link; tex, upper, lower, flags, xoff, yoff are in MK_XTX, MK_XUP, MK_XLW, MK_XFL, MK_XXO, MK_XYO
830 PROC MK_ADD(A,K,LO,HI,B)
840   IF MK_NL>=2000 THEN CALL MK_FAIL("too many links")
845   IF MK_REC THEN CALL MK_JNOTE(A,K,LO,HI,B,0)
850   MK_LA(MK_NL)=A:MK_LS(MK_NL)=K:MK_LLO(MK_NL)=LO:MK_LHI(MK_NL)=HI:MK_LB(MK_NL)=B:MK_LTX(MK_NL)=MK_XTX
860   MK_LUP(MK_NL)=MK_XUP:MK_LLW(MK_NL)=MK_XLW:MK_LFL(MK_NL)=MK_XFL:MK_LXO(MK_NL)=MK_XXO:MK_LYO(MK_NL)=MK_XYO
870   MK_NL=MK_NL+1
880 END PROC
890 PROC MK_SETX(TEX,UP,LOW,FL,XO,YO)
900   MK_XTX=TEX:MK_XUP=UP:MK_XLW=LOW:MK_XFL=FL:MK_XXO=XO:MK_XYO=YO
910 END PROC
920 PROC MK_LINKX(A,S$,LO,HI,B,X$)
930   CALL MK_PARSE(X$)
940   CALL MK_LINKN(A,S$,LO,HI,B,MK_PV(0),MK_PV(1),MK_PV(2))
950 END PROC
960 ' MK_LINKN: a link with tex, upper, lower and the rest in MK_PV(3..5) (flags, xoff, yoff)
970 PROC MK_LINKN(A,S$,LO,HI,B,TEX,UP,LOW)
980   LOCAL K,O,C1,C2,R1,R2,R3,R4
990   CALL MK_SETX(TEX,UP,LOW,MK_PV(3),MK_PV(4),MK_PV(5))
1000   IF NOT MK_EX(A) OR NOT MK_EX(B) THEN CALL MK_FAIL("link between unknown sectors "+STR$(A)+" "+STR$(B))
1010   K=FN MK_SIDE(S$):O=(K+2) MOD 4
1020   IF K=0 THEN
1030     C1=MK_Y1(A):C2=MK_Y2(B):R1=MK_X1(A):R2=MK_X2(A):R3=MK_X1(B):R4=MK_X2(B)
1040   END IF
1050   IF K=2 THEN
1060     C1=MK_Y2(A):C2=MK_Y1(B):R1=MK_X1(A):R2=MK_X2(A):R3=MK_X1(B):R4=MK_X2(B)
1070   END IF
1080   IF K=3 THEN
1090     C1=MK_X1(A):C2=MK_X2(B):R1=MK_Y1(A):R2=MK_Y2(A):R3=MK_Y1(B):R4=MK_Y2(B)
1100   END IF
1110   IF K=1 THEN
1120     C1=MK_X2(A):C2=MK_X1(B):R1=MK_Y1(A):R2=MK_Y2(A):R3=MK_Y1(B):R4=MK_Y2(B)
1130   END IF
1140   IF C1<>C2 THEN CALL MK_FAIL("rooms do not touch: "+STR$(A)+" "+S$+" "+STR$(B))
1150   IF NOT (R1<=LO AND LO<HI AND HI<=R2 AND R3<=LO AND HI<=R4) THEN CALL MK_FAIL("span outside: "+STR$(A)+" "+S$+" "+STR$(LO)+" "+STR$(B))
1155   MK_RS=MK_REC:IF MK_RS THEN CALL MK_JNOTE(A,K,LO,HI,B,-1)
1156   MK_REC=0
1160   CALL MK_ADD(A,K,LO,HI,B)
1170   CALL MK_ADD(B,O,LO,HI,A)
1175   MK_REC=MK_RS
1180 END PROC
1190 PROC MK_SETV(A,B,C,D,E,F)
1200   MK_PV(0)=A:MK_PV(1)=B:MK_PV(2)=C:MK_PV(3)=D:MK_PV(4)=E:MK_PV(5)=F
1210 END PROC
1220 PROC MK_LINKT(A,S$,LO,HI,B,TEX)
1230   CALL MK_SETV(TEX,-1,-1,0,0,0)
1240   CALL MK_LINKN(A,S$,LO,HI,B,TEX,-1,-1)
1250 END PROC
1260 PROC MK_LINK(A,S$,LO,HI,B)
1270   CALL MK_SETV(-1,-1,-1,0,0,0)
1280   CALL MK_LINKN(A,S$,LO,HI,B,-1,-1,-1)
1290 END PROC
1300 PROC MK_LOOP(A,KIND,X1,Y1,X2,Y2,B,TEX)
1310   IF MK_NP>=800 THEN CALL MK_FAIL("too many loops")
1320   MK_PFL(MK_NP)=MK_LF:MK_PR(MK_NP)=A:MK_PK(MK_NP)=KIND:MK_PX1(MK_NP)=X1:MK_PY1(MK_NP)=Y1:MK_PX2(MK_NP)=X2:MK_PY2(MK_NP)=Y2:MK_PB(MK_NP)=B:MK_PTX(MK_NP)=TEX
1330   MK_NP=MK_NP+1
1340 END PROC
1350 PROC MK_PILLAR(A,X1,Y1,X2,Y2,TEX)
1355   MK_NPIL=MK_NPIL+1
1360   CALL MK_LOOP(A,0,X1,Y1,X2,Y2,-1,TEX)
1370 END PROC
1380 PROC MK_INNERF(A,B,TEX,FL)
1390   LOCAL K
1400   MK_LF=FL
1410   CALL MK_LOOP(A,1,MK_X1(B),MK_Y1(B),MK_X2(B),MK_Y2(B),B,TEX)
1420   MK_LF=0
1430   IF FL=0 THEN CALL MK_SETX(-1,-1,-1,0,0,0) ELSE CALL MK_SETX(TEX,-1,-1,FL,0,0)
1435   MK_RS=MK_REC:MK_REC=0:MK_INH(B)=A:MK_ITX(B)=TEX:MK_IFL(B)=FL
1440   FOR K=0 TO 3
1450     IF K=0 OR K=2 THEN CALL MK_ADD(B,K,MK_X1(B),MK_X2(B),A)
1460     IF K=1 OR K=3 THEN CALL MK_ADD(B,K,MK_Y1(B),MK_Y2(B),A)
1470   NEXT K
1475   MK_REC=MK_RS
1480 END PROC
1490 PROC MK_INNER(A,B,TEX)
1500   CALL MK_INNERF(A,B,TEX,0)
1510 END PROC
1520 PROC MK_HOUSE(ID,S$,LO,HI)
1530   LOCAL K,N,J,P,OK
1540   K=FN MK_SIDE(S$):MK_OUT(ID)=-1
1550   N=MK_HN(ID*4+K):P=ID*16+K*4
1560   IF N>=4 THEN CALL MK_FAIL("too many house spans")
1570   J=N:OK=-1
1580   WHILE OK
1590     IF J=0 THEN
1600       OK=0
1610     ELSE
1620       IF MK_HLO(P+J-1)>LO THEN
1630         MK_HLO(P+J)=MK_HLO(P+J-1):MK_HHI(P+J)=MK_HHI(P+J-1):J=J-1
1640       ELSE
1650         OK=0
1660       END IF
1670     END IF
1680   WEND
1690   MK_HLO(P+J)=LO:MK_HHI(P+J)=HI
1700   MK_HN(ID*4+K)=N+1
1710 END PROC
1720 PROC MK_OUTDOOR(ID)
1730   MK_OUT(ID)=-1
1740 END PROC
1750 ' MK_SORT: the links of sector R on side K, ordered by their start (stable), as indices in MK_TI(0..MK_TN-1)
1760 PROC MK_SORT(R,K)
1770   LOCAL I,J,OK
1780   MK_TN=0
1790   FOR I=0 TO MK_NL-1
1800     IF MK_LA(I)=R AND MK_LS(I)=K THEN
1810       J=MK_TN:OK=-1
1820       WHILE OK
1830         IF J=0 THEN
1840           OK=0
1850         ELSE
1860           IF MK_LLO(MK_TI(J-1))>MK_LLO(I) THEN
1870             MK_TI(J)=MK_TI(J-1):J=J-1
1880           ELSE
1890             OK=0
1900           END IF
1910         END IF
1920       WEND
1930       MK_TI(J)=I:MK_TN=MK_TN+1
1940     END IF
1950   NEXT I
1960 END PROC
1970 ' MK_PUTW: a wall; flags, upper, lower, xoff, yoff are in MK_RFL, MK_RUP, MK_RLW, MK_RXO, MK_RYO
1980 PROC MK_SETR(FL,UP,LW,XO,YO)
1990   MK_RFL=FL:MK_RUP=UP:MK_RLW=LW:MK_RXO=XO:MK_RYO=YO
2000 END PROC
2010 PROC MK_PUTW(X1,Y1,X2,Y2,T,NX)
2020   IF MK_NW>=400 THEN CALL MK_FAIL("too many walls in a sector")
2030   MK_WL(MK_NW,0)=X1:MK_WL(MK_NW,1)=Y1:MK_WL(MK_NW,2)=X2:MK_WL(MK_NW,3)=Y2:MK_WL(MK_NW,4)=T:MK_WL(MK_NW,5)=NX
2040   MK_WL(MK_NW,6)=MK_RFL:MK_WL(MK_NW,7)=MK_RUP:MK_WL(MK_NW,8)=MK_RLW:MK_WL(MK_NW,9)=MK_RXO:MK_WL(MK_NW,10)=MK_RYO
2050   MK_NW=MK_NW+1
2060 END PROC
2070 ' one wall segment of the side K (fixed = the constant coordinate, P..Q along the side as walked)
2080 PROC MK_SEG(HZ,FX,P,Q,T,NX)
2090   IF HZ THEN
2100     CALL MK_PUTW(P,FX,Q,FX,T,NX)
2110   ELSE
2120     CALL MK_PUTW(FX,P,FX,Q,T,NX)
2130   END IF
2140 END PROC
2150 ' MK_WALLS: the walls of sector R in MK_WL(0..MK_NW-1, 0..10)
2160 PROC MK_WALLS(R)
2170   LOCAL K,FX,A0,A1,RV,HZ,POS,I,J,N,L,LO,HI,B,T
2180   MK_NW=0
2190   IF MK_PLY(R) THEN
2200     CALL MK_POLYWALLS(R)
2210     EXIT PROC
2220   END IF
2230   FOR K=0 TO 3
2240     IF K=0 THEN FX=MK_Y1(R):A0=MK_X1(R):A1=MK_X2(R):RV=0:HZ=-1
2250     IF K=1 THEN FX=MK_X2(R):A0=MK_Y1(R):A1=MK_Y2(R):RV=0:HZ=0
2260     IF K=2 THEN FX=MK_Y2(R):A0=MK_X1(R):A1=MK_X2(R):RV=-1:HZ=-1
2270     IF K=3 THEN FX=MK_X1(R):A0=MK_Y1(R):A1=MK_Y2(R):RV=-1:HZ=0
2280     CALL MK_SORT(R,K)
2290     POS=A0:N=0
2300     FOR I=0 TO MK_TN-1
2310       L=MK_TI(I)
2320       IF MK_LLO(L)<POS THEN CALL MK_FAIL("links overlap in sector "+STR$(R))
2330       IF MK_LLO(L)>POS THEN MK_SL(N)=POS:MK_SH(N)=MK_LLO(L):MK_SB(N)=-1:MK_SI(N)=-1:N=N+1
2340       MK_SL(N)=MK_LLO(L):MK_SH(N)=MK_LHI(L):MK_SB(N)=MK_LB(L):MK_SI(N)=L:N=N+1
2350       POS=MK_LHI(L)
2360     NEXT I
2370     IF POS<A1 THEN MK_SL(N)=POS:MK_SH(N)=A1:MK_SB(N)=-1:MK_SI(N)=-1:N=N+1
2380     FOR J=0 TO N-1
2390       IF RV THEN I=N-1-J ELSE I=J
2400       IF RV THEN LO=MK_SH(I):HI=MK_SL(I) ELSE LO=MK_SL(I):HI=MK_SH(I)
2410       L=MK_SI(I)
2420       IF L<0 THEN
2430         CALL MK_SETR(0,-1,-1,0,0)
2440         CALL MK_SEG(HZ,FX,LO,HI,MK_WT(R),-1)
2450       ELSE
2460         T=MK_LTX(L):IF T<0 THEN T=MK_WT(R)
2470         IF MK_SB(I)=-2 THEN
2480           CALL MK_SETR(0,-1,-1,0,0)
2490           CALL MK_SEG(HZ,FX,LO,HI,T,-1)
2500         ELSE
2510           CALL MK_SETR(MK_LFL(L),MK_LUP(L),MK_LLW(L),MK_LXO(L),MK_LYO(L))
2520           CALL MK_SEG(HZ,FX,LO,HI,T,MK_SB(I))
2530         END IF
2540       END IF
2550     NEXT J
2560   NEXT K
2570   FOR I=0 TO MK_NP-1
2580     IF MK_PR(I)=R THEN
2590       T=MK_PTX(I):IF T<0 THEN T=MK_WT(R)
2600       B=MK_PB(I):CALL MK_SETR(MK_PFL(I),-1,-1,0,0)
2610       CALL MK_PUTW(MK_PX1(I),MK_PY1(I),MK_PX1(I),MK_PY2(I),T,B)
2620       CALL MK_PUTW(MK_PX1(I),MK_PY2(I),MK_PX2(I),MK_PY2(I),T,B)
2630       CALL MK_PUTW(MK_PX2(I),MK_PY2(I),MK_PX2(I),MK_PY1(I),T,B)
2640       CALL MK_PUTW(MK_PX2(I),MK_PY1(I),MK_PX1(I),MK_PY1(I),T,B)
2650     END IF
2660   NEXT I
2670 END PROC
2680 ' MK_FINISH: outdoor sectors higher than a fence (the house stands next to them): their solid walls are the house (a tall picture) or a low fence:
2690 ' a thin sector behind the wall, as high as a fence and open to the sky, that you can see through but not walk into (flags 2 + 4).
2700 PROC MK_GROUND(G)
2710   MK_GND=G
2720 END PROC
2730 PROC MK_FENCE(TEX,FL)
2740   MK_FTX0=TEX:MK_FFL=FL
2750 END PROC
2760 PROC MK_FINISH(HT,FH,FTX)
2770   LOCAL FID,N0,OI,R,K,A0,A1,GN,POS,I,L,G,G0,G1,CUR,NP,H,HN,P,LO,HI,Q
2780   FID=100:N0=MK_NR
2785   MK_NR0=MK_NR:MK_REC=0:MK_FIN=-1:MK_FHT=HT:MK_FFH=FH:MK_FFT=FTX
2790   FOR OI=0 TO N0-1
2800     R=MK_ORD(OI)
2810     IF MK_OUT(R) THEN
2820       FOR K=0 TO 3
2830         IF K=0 OR K=2 THEN A0=MK_X1(R):A1=MK_X2(R) ELSE A0=MK_Y1(R):A1=MK_Y2(R)
2840         CALL MK_SORT(R,K)
2850         GN=0:POS=A0
2860         FOR I=0 TO MK_TN-1
2870           L=MK_TI(I)
2880           IF MK_LLO(L)>POS THEN MK_GL(GN)=POS:MK_GH(GN)=MK_LLO(L):GN=GN+1
2890           POS=MK_LHI(L)
2900         NEXT I
2910         IF POS<A1 THEN MK_GL(GN)=POS:MK_GH(GN)=A1:GN=GN+1
2920         FOR G=0 TO GN-1
2930           G0=MK_GL(G):G1=MK_GH(G):NP=0:CUR=G0
2940           HN=MK_HN(R*4+K):P=R*16+K*4
2950           FOR H=0 TO HN-1
2960             LO=MK_HLO(P+H):IF G0>LO THEN LO=G0
2970             HI=MK_HHI(P+H):IF G1<HI THEN HI=G1
2980             IF LO<HI THEN
2990               IF LO>CUR THEN MK_PCK(NP)=0:MK_PCL(NP)=CUR:MK_PCH(NP)=LO:NP=NP+1
3000               MK_PCK(NP)=1:MK_PCL(NP)=LO:MK_PCH(NP)=HI:NP=NP+1
3010               CUR=HI
3020             END IF
3030           NEXT H
3040           IF CUR<G1 THEN MK_PCK(NP)=0:MK_PCL(NP)=CUR:MK_PCH(NP)=G1:NP=NP+1
3050           FOR Q=0 TO NP-1
3060             LO=MK_PCL(Q):HI=MK_PCH(Q)
3070             IF MK_PCK(Q)=1 THEN
3080               CALL MK_SETX(HT,-1,-1,0,0,0)
3090               CALL MK_ADD(R,K,LO,HI,-2)
3100             ELSE
3110               MK_PV(0)=10:MK_PV(1)=-1:MK_PV(2)=255:MK_PV(3)=0:MK_PV(4)=FTX
3120               IF K=0 THEN CALL MK_ROOMN(FID,LO,MK_Y1(R)-20,HI,MK_Y1(R),0,FH)
3130               IF K=2 THEN CALL MK_ROOMN(FID,LO,MK_Y2(R),HI,MK_Y2(R)+20,0,FH)
3140               IF K=3 THEN CALL MK_ROOMN(FID,MK_X1(R)-20,LO,MK_X1(R),HI,0,FH)
3150               IF K=1 THEN CALL MK_ROOMN(FID,MK_X2(R),LO,MK_X2(R)+20,HI,0,FH)
3160               CALL MK_SETV(-1,-1,-1,MK_FFL,0,0)
3170               CALL MK_LINKN(R,MID$("SENW",K+1,1),LO,HI,FID,MK_FTX0,-1,-1)
3180               IF MK_GND>=0 THEN
3190                 CALL MK_SETX(-1,-1,-1,0,0,0)
3200                 CALL MK_ADD(FID,K,LO,HI,MK_GND)
3210                 IF K=0 THEN CALL MK_ADD(FID,1,MK_Y1(R)-20,MK_Y1(R),MK_GND):CALL MK_ADD(FID,3,MK_Y1(R)-20,MK_Y1(R),MK_GND)
3220                 IF K=2 THEN CALL MK_ADD(FID,1,MK_Y2(R),MK_Y2(R)+20,MK_GND):CALL MK_ADD(FID,3,MK_Y2(R),MK_Y2(R)+20,MK_GND)
3230                 IF K=3 THEN CALL MK_ADD(FID,0,MK_X1(R)-20,MK_X1(R),MK_GND):CALL MK_ADD(FID,2,MK_X1(R)-20,MK_X1(R),MK_GND)
3240                 IF K=1 THEN CALL MK_ADD(FID,0,MK_X2(R),MK_X2(R)+20,MK_GND):CALL MK_ADD(FID,2,MK_X2(R),MK_X2(R)+20,MK_GND)
3250               END IF
3260               FID=FID+1
3270             END IF
3280           NEXT Q
3290         NEXT G
3300       NEXT K
3310     END IF
3320   NEXT OI
3330 END PROC
3340 PROC MK_EMIT(F$)
3350   LOCAL N,I,R,W,J,L$
3360   IF F$="" THEN F$="stdout:"
3370   OPEN F$ FOR OUTPUT AS #1
3380   N=0
3390   FOR R=0 TO 599
3400     IF MK_EX(R) THEN N=N+1
3410   NEXT R
3420   PRINT #1,"DATA ";STR$(N)
3430   FOR R=0 TO 599
3440     IF MK_EX(R) THEN
3450       CALL MK_WALLS(R)
3460       PRINT #1,"DATA ";STR$(R);",";STR$(MK_F(R));",";STR$(MK_C(R));",";STR$(MK_FT(R));",";STR$(MK_CT(R));",";STR$(MK_LT(R));",";STR$(MK_TG(R));",";STR$(MK_NW)
3470       FOR W=0 TO MK_NW-1
3480         L$="DATA "+STR$(MK_WL(W,0))
3490         FOR J=1 TO 10
3500           L$=L$+","+STR$(MK_WL(W,J))
3510         NEXT J
3520         PRINT #1,L$
3530       NEXT W
3540     END IF
3550   NEXT R
3560   CLOSE #1
3570 END PROC
3580 ' -- sectors of any shape (polygons) ---------------------------------------------------------------------------------------------------
3590 PROC MK_POLY(ID,F,C,L$,P$)
3600   LOCAL I,K,N,C$,T$,X1,Y1,X2,Y2
3610   N=0:T$=""
3620   FOR I=1 TO LEN(P$)+1
3630     IF I>LEN(P$) THEN C$="," ELSE C$=MID$(P$,I,1)
3640     IF C$="," THEN
3650       IF LEN(T$)>0 THEN
3660         IF N>=64 THEN CALL MK_FAIL("too many corners")
3670         MK_PT(N)=VAL(T$):N=N+1
3680       END IF
3690       T$=""
3700     ELSE
3710       IF C$<>" " THEN T$=T$+C$
3720     END IF
3730   NEXT I
3740   IF N<6 OR N MOD 2<>0 THEN CALL MK_FAIL("a polygon needs 3 to 32 corners (x,y pairs)")
3750   N=N\2
3760   X1=MK_PT(0):X2=X1:Y1=MK_PT(1):Y2=Y1
3770   FOR I=0 TO N-1
3780     IF MK_PT(2*I)<X1 THEN X1=MK_PT(2*I)
3790     IF MK_PT(2*I)>X2 THEN X2=MK_PT(2*I)
3800     IF MK_PT(2*I+1)<Y1 THEN Y1=MK_PT(2*I+1)
3810     IF MK_PT(2*I+1)>Y2 THEN Y2=MK_PT(2*I+1)
3820   NEXT I
3830   CALL MK_PARSE(L$)
3840   CALL MK_ROOMN(ID,X1,Y1,X2,Y2,F,C)
3850   MK_PLY(ID)=-1:MK_PNN(ID)=N
3860   FOR I=0 TO N-1
3870     K=ID*32+I
3880     MK_PPX(K)=MK_PT(2*I):MK_PPY(K)=MK_PT(2*I+1):MK_PEB(K)=-1:MK_PET(K)=-1
3890   NEXT I
3900 END PROC
3910 PROC MK_PLINKT(A,E,B,TEX)
3920   IF NOT MK_EX(A) OR NOT MK_PLY(A) THEN CALL MK_FAIL("not a polygon: "+STR$(A))
3930   IF E<0 OR E>=MK_PNN(A) THEN CALL MK_FAIL("no such edge")
3940   MK_PEB(A*32+E)=B:MK_PET(A*32+E)=TEX
3950 END PROC
3960 PROC MK_PLINK(A,E,B)
3970   CALL MK_PLINKT(A,E,B,-1)
3980 END PROC
3990 PROC MK_PTEX(A,E,TEX)
4000   IF NOT MK_EX(A) OR NOT MK_PLY(A) THEN CALL MK_FAIL("not a polygon: "+STR$(A))
4010   IF E<0 OR E>=MK_PNN(A) THEN CALL MK_FAIL("no such edge")
4020   MK_PET(A*32+E)=TEX
4030 END PROC
4040 PROC MK_POLYWALLS(R)
4050   LOCAL I,J,K,N,T
4060   MK_NW=0
4070   N=MK_PNN(R)
4080   FOR I=0 TO N-1
4090     J=(I+1) MOD N
4100     K=R*32+I
4110     T=MK_PET(K):IF T<0 THEN T=MK_WT(R)
4120     CALL MK_SETR(0,-1,-1,0,0)
4130     CALL MK_PUTW(MK_PPX(K),MK_PPY(K),MK_PPX(R*32+J),MK_PPY(R*32+J),T,MK_PEB(K))
4140   NEXT I
4150 END PROC
4160 ' the corners of an arc around (CX,CY) from angle A1 to A2 degrees in STEPS steps (STEPS+1 corners), as "x,y,x,y..." for MK_POLY
4170 FUNC MK_ARC$(CX,CY,R,A1,A2,ST)
4180   LOCAL I,A,U,S$
4190   IF ABS(SIN(30)-0.5)<0.0001 THEN
4200     U=1
4210   ELSE
4220     IF ABS(SIN(33.333333)-0.5)<0.0001 THEN U=400/360 ELSE U=3.14159265358979/180
4230   END IF
4240   S$=""
4250   FOR I=0 TO ST
4260     A=(A1+(A2-A1)*I/ST)*U
4270     IF I>0 THEN S$=S$+","
4280     S$=S$+STR$(INT(CX+R*COS(A)+0.5))+","+STR$(INT(CY+R*SIN(A)+0.5))
4290   NEXT I
4300   RETURN S$
4310 END FUNC
4320 PROC MK_SLOPE(ID,FX,FY,CX,CY)
4330   IF NOT MK_EX(ID) THEN CALL MK_FAIL("no such sector: "+STR$(ID))
4340   MK_SFX(ID)=FX:MK_SFY(ID)=FY:MK_SCX(ID)=CX:MK_SCY(ID)=CY
4350   MK_SLO(ID)=FX<>0 OR FY<>0 OR CX<>0 OR CY<>0
4360 END PROC
4370 PROC MK_THING(N,X,Y,TX,W,H,Z)
4380   IF MK_NTH>=300 THEN CALL MK_FAIL("too many things")
4390   MK_TH(MK_NTH,0)=N:MK_TH(MK_NTH,1)=X:MK_TH(MK_NTH,2)=Y:MK_TH(MK_NTH,3)=TX:MK_TH(MK_NTH,4)=W:MK_TH(MK_NTH,5)=H:MK_TH(MK_NTH,6)=Z
4400   MK_NTH=MK_NTH+1
4410 END PROC
4420 PROC MK_RAW(L$)
4430   IF MK_NRW>=300 THEN CALL MK_FAIL("too many lines")
4440   MK_RW$(MK_NRW)=L$:MK_NRW=MK_NRW+1
4450 END PROC
4460 ' one line of the map: as it is, or as a quoted DATA line (MK_MAPDATA)
4470 PROC MK_ML(L$)
4480   IF MK_MAPDATA THEN PRINT #1,"DATA ";CHR$(34);L$;CHR$(34) ELSE PRINT #1,L$
4490 END PROC
4500 PROC MK_EMITMAP(F$)
4510   MK_MAPDATA=0
4520   CALL MK_MAPOUT(F$)
4530 END PROC
4540 PROC MK_EMITMAPDATA(F$)
4550   MK_MAPDATA=-1
4560   CALL MK_MAPOUT(F$)
4570 END PROC
4580 PROC MK_MAPOUT(F$)
4590   LOCAL R,W,J,I,L$
4600   IF F$="" THEN F$="stdout:"
4610   OPEN F$ FOR OUTPUT AS #1
4620   CALL MK_ML("W3DMAP,1")
4630   FOR I=0 TO MK_NRW-1
4640     CALL MK_ML(MK_RW$(I))
4650   NEXT I
4660   FOR R=0 TO 599
4670     IF MK_EX(R) THEN
4680       CALL MK_WALLS(R)
4690       CALL MK_ML("SECTOR,"+STR$(R)+","+STR$(MK_F(R))+","+STR$(MK_C(R))+","+STR$(MK_FT(R))+","+STR$(MK_CT(R))+","+STR$(MK_LT(R))+","+STR$(MK_TG(R)))
4700       IF MK_SLO(R) THEN CALL MK_ML("SLOPE,"+STR$(R)+","+STR$(MK_SFX(R))+","+STR$(MK_SFY(R))+","+STR$(MK_SCX(R))+","+STR$(MK_SCY(R))+","+STR$((MK_X1(R)+MK_X2(R))/2)+","+STR$((MK_Y1(R)+MK_Y2(R))/2))
4710       FOR W=0 TO MK_NW-1
4720         L$="WALL,"+STR$(R)+","+STR$(MK_WL(W,0))+","+STR$(MK_WL(W,1))+","+STR$(MK_WL(W,2))+","+STR$(MK_WL(W,3))+","+STR$(MK_WL(W,4))+","+STR$(MK_WL(W,5))
4730         L$=L$+","+STR$(MK_WL(W,7))+","+STR$(MK_WL(W,8))+","+STR$(MK_WL(W,9))+","+STR$(MK_WL(W,10))+","+STR$(MK_WL(W,6))
4740         CALL MK_ML(L$)
4750       NEXT W
4760     END IF
4770   NEXT R
4780   FOR I=0 TO MK_NTH-1
4790     L$="THING"
4800     FOR J=0 TO 6
4810       L$=L$+","+STR$(MK_TH(I,J))
4820     NEXT J
4830     CALL MK_ML(L$+",-1,0,-1")
4840   NEXT I
4850   CLOSE #1
4860 END PROC
4870 ' -- the world document (docs/world-model.md) --------------------------------------------------------------------------------------------------
4880 PROC MK_JNOTE(A,K,LO,HI,B,TW)
4890   IF MK_NJ>=2000 THEN CALL MK_FAIL("too many links for the world document")
4900   MK_JA(MK_NJ)=A:MK_JK(MK_NJ)=K:MK_JLO(MK_NJ)=LO:MK_JHI(MK_NJ)=HI:MK_JB(MK_NJ)=B:MK_JTX(MK_NJ)=MK_XTX:MK_JUP(MK_NJ)=MK_XUP:MK_JLW(MK_NJ)=MK_XLW
4910   MK_JFL(MK_NJ)=MK_XFL:MK_JXO(MK_NJ)=MK_XXO:MK_JYO(MK_NJ)=MK_XYO:MK_J2(MK_NJ)=TW
4920   MK_NJ=MK_NJ+1
4930 END PROC
4940 PROC MK_ENVIRON(N$,FOG,SX,SY,AN)
4950   MK_WNAME$=N$:MK_FOG=FOG:MK_SX=SX:MK_SY=SY:MK_SA=AN
4960 END PROC
4970 PROC MK_NAME(ID,N$)
4980   IF NOT MK_EX(ID) THEN CALL MK_FAIL("no such sector: "+STR$(ID))
4990   MK_NM$(ID)=N$
5000 END PROC
5010 ' wall flags as an array of names (bits without a name as a number)
5020 PROC MK_JFLAGS(P$,FL)
5030   LOCAL N,R
5040   R=FL:N=0
5050   JSON NEW P$,ARRAY
5060   IF R AND 1 THEN JSON SETS P$+"."+STR$(N),"masked":N=N+1:R=R-1
5070   IF R AND 2 THEN JSON SETS P$+"."+STR$(N),"block":N=N+1:R=R-2
5080   IF R AND 4 THEN JSON SETS P$+"."+STR$(N),"solid":N=N+1:R=R-4
5090   IF R AND 8 THEN JSON SETS P$+"."+STR$(N),"sky":N=N+1:R=R-8
5100   IF R AND 16 THEN JSON SETS P$+"."+STR$(N),"translucent":N=N+1:R=R-16
5110   IF R<>0 THEN JSON SET P$+"."+STR$(N),R
5120 END PROC
5130 ' the fields of a room or a solid
5140 PROC MK_JROOM(P$,R)
5150   LOCAL K,J,Q$,S$
5160   JSON SET P$+".id",R
5170   IF MK_NM$(R)<>"" THEN JSON SETS P$+".name",MK_NM$(R)
5180   JSON SET P$+".box.0",MK_X1(R):JSON SET P$+".box.1",MK_Y1(R):JSON SET P$+".box.2",MK_X2(R):JSON SET P$+".box.3",MK_Y2(R)
5190   JSON SET P$+".floor.z",MK_F(R):JSON SET P$+".floor.tex",MK_FT(R)
5200   JSON SET P$+".ceiling.z",MK_C(R):JSON SET P$+".ceiling.tex",MK_CT(R)
5210   JSON SET P$+".light",MK_LT(R):JSON SET P$+".tag",MK_TG(R):JSON SET P$+".walls",MK_WT(R)
5220   IF MK_TG(R)=97 THEN JSON SETB P$+".ghost",-1
5230   IF MK_PLY(R) OR MK_SLO(R) THEN CALL MK_FAIL("polygons and slopes are not part of the world document yet: sector "+STR$(R))
5240 END PROC
5250 PROC MK_EMITJSON(F$)
5260   LOCAL I,R,K,J,P$,N0,NR,NS,Q,S$
5270   IF MK_NPIL>0 THEN CALL MK_FAIL("pillars are not part of the world document yet")
5280   N0=MK_NR:IF MK_NR0>=0 THEN N0=MK_NR0
5290   JSON CLEAR
5300   JSON SETS "format","e99-world":JSON SET "version",1
5310   IF MK_WNAME$<>"" THEN JSON SETS "name",MK_WNAME$
5320   JSON NEW "rooms",ARRAY:JSON NEW "solids",ARRAY:JSON NEW "openings",ARRAY:JSON NEW "things",ARRAY
5330   NR=0:NS=0
5340   FOR I=0 TO N0-1
5350     R=MK_ORD(I)
5360     IF MK_INH(R)<0 THEN
5370       P$="rooms."+STR$(NR):NR=NR+1
5380       CALL MK_JROOM(P$,R)
5390       IF MK_OUT(R) THEN JSON SETB P$+".outdoor",-1
5400       Q=0
5410       FOR K=0 TO 3
5420         FOR J=0 TO MK_HN(R*4+K)-1
5430           S$=P$+".house."+STR$(Q):Q=Q+1
5440           JSON SETS S$+".side",MID$("SENW",K+1,1)
5450           JSON SET S$+".range.0",MK_HLO(R*16+K*4+J):JSON SET S$+".range.1",MK_HHI(R*16+K*4+J)
5460         NEXT J
5470       NEXT K
5480     ELSE
5490       P$="solids."+STR$(NS):NS=NS+1
5500       CALL MK_JROOM(P$,R)
5510       JSON SET P$+".in",MK_INH(R)
5520       JSON SET P$+".rim.tex",MK_ITX(R)
5530       IF MK_IFL(R)<>0 THEN CALL MK_JFLAGS(P$+".rim.flags",MK_IFL(R))
5540     END IF
5550   NEXT I
5560   FOR I=0 TO MK_NJ-1
5570     P$="openings."+STR$(I)
5580     JSON SET P$+".from",MK_JA(I):JSON SETS P$+".side",MID$("SENW",MK_JK(I)+1,1)
5590     JSON SET P$+".range.0",MK_JLO(I):JSON SET P$+".range.1",MK_JHI(I):JSON SET P$+".to",MK_JB(I)
5600     IF MK_JTX(I)>=0 THEN JSON SET P$+".tex",MK_JTX(I)
5610     IF MK_JUP(I)>=0 THEN JSON SET P$+".upper",MK_JUP(I)
5620     IF MK_JLW(I)>=0 THEN JSON SET P$+".lower",MK_JLW(I)
5630     IF MK_JFL(I)<>0 THEN CALL MK_JFLAGS(P$+".flags",MK_JFL(I))
5640     IF MK_JXO(I)<>0 OR MK_JYO(I)<>0 THEN JSON SET P$+".offset.0",MK_JXO(I):JSON SET P$+".offset.1",MK_JYO(I)
5650     IF MK_J2(I)=0 THEN JSON SETB P$+".oneway",-1
5660   NEXT I
5670   FOR I=0 TO MK_NTH-1
5680     P$="things."+STR$(I)
5690     JSON SET P$+".id",MK_TH(I,0):JSON SET P$+".tex",MK_TH(I,3)
5700     JSON SET P$+".x",MK_TH(I,1):JSON SET P$+".y",MK_TH(I,2):JSON SET P$+".w",MK_TH(I,4):JSON SET P$+".h",MK_TH(I,5)
5710     IF MK_TH(I,6)<>0 THEN JSON SET P$+".z",MK_TH(I,6)
5720   NEXT I
5730   IF MK_FIN THEN
5740     JSON SET "environment.fence.tex",MK_FTX0
5750     CALL MK_JFLAGS("environment.fence.flags",MK_FFL)
5760     JSON SET "environment.fence.height",MK_FFH:JSON SET "environment.fence.wall",MK_FFT:JSON SET "environment.fence.house",MK_FHT
5770     IF MK_GND>=0 THEN JSON SET "environment.fence.ground",MK_GND
5780   END IF
5790   IF MK_FOG>=0 THEN JSON SET "environment.fog",MK_FOG:JSON SET "start.x",MK_SX:JSON SET "start.y",MK_SY:JSON SET "start.angle",MK_SA
5800   JSON SAVE F$
5810 END PROC
