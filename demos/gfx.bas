10 ' Graphics demo: palettes, the graphics layer, tiles, DESIGN pictures, sprites and the text screen.
20 CLS:GFX LAYER 3,ON:GFX LAYER 1,ON
30 GFX BACKDROP RGB(0,0,48)
40 ' palette 4 (sprites) and 1 (tiles): a few colors of our own
50 GFX PALETTE 4,1,RGB(255,220,0):GFX PALETTE 4,2,RGB(0,0,0):GFX PALETTE 4,3,RGB(255,64,64)
60 GFX PALETTE 1,1,RGB(40,60,120):GFX PALETTE 1,2,RGB(70,100,180)
70 ' a checkered tile, the whole tile screen filled with it
80 DESIGN TILE 1
90 FOR R=0 TO 11:@ "1111111122222222":NEXT R
100 FOR R=0 TO 11:@ "2222222211111111":NEXT R
110 FOR Y=0 TO 12:FOR X=0 TO 40:TILE SET X,Y,1:NEXT X:NEXT Y
120 ' a sprite
130 DESIGN SPRITE 0
140 @ "....11111111...."
150 @ "...1111111111..."
160 @ "..111111111111.."
170 @ ".11111111111111."
180 @ ".11122111122111."
190 @ "1111221111221111"
200 @ "1111221111221111"
210 @ "1111111111111111"
220 @ "1111111111111111"
230 @ "1113111111113111"
240 @ "1111311111131111"
250 @ ".11113333331111."
260 @ ".11111111111111."
270 @ "..111111111111.."
280 @ "...1111111111..."
290 @ "....11111111...."
300 FOR R=17 TO 24:@ "................":NEXT R
310 SPRITE 0,ON:SPRITE 0,40,200:SPRITE 0,PRIORITY 1
320 ' the graphics layer: shapes in the colors of the default palette
330 GFX CLEAR
340 GFX LINE 10,10,629,289,110
350 GFX LINE 10,289,629,10,13
360 GFX CIRCLE 320,150,100,15
370 GFX CIRCLE 320,150,100,137,0,90
380 GFX LINE 250,110,390,190,140,B
390 GFX PAINT 320,150,111,140
400 GFX TEXT 232,60,"Engine1999 graphics",140,2,2
410 GFX DRAW "C5BM100,250R60D20L60U20"
420 COLOR 140:LOCATE 2,22:PRINT "Layers: tiles, graphics, text, sprites"
430 TXT FILL 0,24,79,24,32,1,46
440 ' move the sprite across the screen, then back
450 SPRITE 0,MOVETO 560,200,180
460 WHILE SPRITE("X",0)<560:GFX VSYNC:WEND
470 SPRITE 0,MOVETO 40,100,120
480 WHILE SPRITE("X",0)>40:GFX VSYNC:WEND
490 TILE SCROLL 8,12
500 PRINT "done"
