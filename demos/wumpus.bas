10 REM HUNT THE WUMPUS - the classic cave game (1973), written the old way: line numbers,
20 REM GOTO, GOSUB, DATA and READ, INPUT, RND - no procedures, no labels. It runs in the
30 REM window (engine1999) and in the console (engine1999c) alike: it only uses PRINT and INPUT.
40 REM
50 REM The caves are the 20 corners of a dodecahedron; every cave has three tunnels.
60 REM L(0) is you, L(1) the wumpus, L(2) and L(3) the bottomless pits, L(4) and L(5) the bats.
70 DIM N(21,4),L(6)
80 FOR I=1 TO 20:FOR J=1 TO 3:READ N(I,J):NEXT J:NEXT I
90 DATA 2,5,8, 1,3,10, 2,4,12, 3,5,14, 1,4,6
100 DATA 5,7,15, 6,8,17, 1,7,9, 8,10,18, 2,9,11
110 DATA 10,12,19, 3,11,13, 12,14,20, 4,13,15, 6,14,16
120 DATA 15,17,20, 7,16,18, 9,17,19, 11,18,20, 13,16,19
130 PRINT "HUNT THE WUMPUS":PRINT
140 PRINT "INSTRUCTIONS (Y-N)";:INPUT Y$
150 IF Y$="Y" OR Y$="y" THEN GOSUB 1000
200 REM ---- a new game: everybody gets a cave of his own
210 RANDOMIZE
220 FOR I=0 TO 5
230 L(I)=INT(20*RND(1))+1
240 FOR J=0 TO I-1
250 IF L(I)=L(J) THEN 230
260 NEXT J
270 NEXT I
280 A=5
290 REM ---- a turn: the warnings, then the question
300 PRINT
310 FOR K=1 TO 3
320 R=N(L(0),K)
330 IF R=L(1) THEN PRINT "I SMELL A WUMPUS!"
340 IF R=L(2) OR R=L(3) THEN PRINT "I FEEL A DRAFT"
350 IF R=L(4) OR R=L(5) THEN PRINT "BATS NEARBY!"
360 NEXT K
370 PRINT "YOU ARE IN CAVE ";L(0)
380 PRINT "TUNNELS LEAD TO ";N(L(0),1);" ";N(L(0),2);" ";N(L(0),3)
390 PRINT "SHOOT OR MOVE (S-M)";:INPUT X$
400 IF X$="S" OR X$="s" THEN 500
410 IF X$="M" OR X$="m" THEN 700
420 GOTO 390
500 REM ---- shoot: the arrow flies through up to five caves, from tunnel to tunnel
510 PRINT "NO. OF ROOMS (1-5)";:INPUT J9
520 IF J9<1 OR J9>5 THEN 510
530 F=L(0)
540 FOR K=1 TO J9
550 PRINT "ROOM #";:INPUT R
560 IF R=N(F,1) OR R=N(F,2) OR R=N(F,3) THEN 580
570 PRINT "ARROWS AREN'T THAT CROOKED - TRY ANOTHER ROOM":GOTO 550
580 F=R
590 IF F=L(1) THEN PRINT "AHA! YOU GOT THE WUMPUS!":GOTO 900
600 IF F=L(0) THEN PRINT "OUCH! ARROW GOT YOU!":GOTO 950
610 NEXT K
620 PRINT "MISSED"
630 A=A-1
640 GOSUB 800
650 IF A=0 THEN PRINT "YOU RAN OUT OF ARROWS.":GOTO 950
660 GOTO 300
700 REM ---- move
710 PRINT "WHERE TO";:INPUT R
720 IF R=N(L(0),1) OR R=N(L(0),2) OR R=N(L(0),3) THEN 740
730 PRINT "NOT POSSIBLE":GOTO 710
740 L(0)=R
750 GOSUB 850
760 GOTO 300
800 REM ---- the noise wakes the wumpus (3 times in 4 he walks to a cave next to his)
810 IF RND(1)<0.75 THEN L(1)=N(L(1),INT(3*RND(1))+1)
820 IF L(1)=L(0) THEN PRINT "TSK TSK TSK - WUMPUS GOT YOU!":POP:GOTO 950
830 RETURN
850 REM ---- what is in the cave you came into?
860 IF L(0)=L(1) THEN PRINT "...OOPS! BUMPED A WUMPUS!":GOSUB 800
870 IF L(0)=L(2) OR L(0)=L(3) THEN PRINT "YYYIIIEEE... FELL IN A PIT!":POP:GOTO 950
880 IF L(0)=L(4) OR L(0)=L(5) THEN PRINT "ZAP--SUPER BAT SNATCH! ELSEWHEREVILLE FOR YOU!":L(0)=INT(20*RND(1))+1:GOTO 860
890 RETURN
900 PRINT "YOU WIN - THE WUMPUS WILL NOT BOTHER YOU ANY MORE!":GOTO 960
950 PRINT "YOU LOSE - THE WUMPUS GOT THE BETTER OF YOU THIS TIME!"
960 PRINT
970 PRINT "PLAY AGAIN (Y-N)";:INPUT Y$
980 IF Y$="Y" OR Y$="y" THEN 200
990 END
1000 REM ---- the instructions
1010 PRINT
1020 PRINT "THE WUMPUS LIVES IN A CAVE OF 20 ROOMS. EACH ROOM HAS 3 TUNNELS"
1030 PRINT "LEADING TO OTHER ROOMS. HAZARDS: TWO BOTTOMLESS PITS (YOU FALL IN"
1040 PRINT "AND LOSE), TWO COLONIES OF SUPER BATS (THEY CARRY YOU TO ANOTHER"
1050 PRINT "ROOM), AND THE WUMPUS ITSELF (IF YOU ENTER ITS ROOM, OR IF IT WAKES"
1060 PRINT "UP AND WALKS INTO YOURS, IT EATS YOU)."
1070 PRINT
1080 PRINT "MOVE: GIVE THE NUMBER OF ONE OF THE THREE ROOMS NEXT TO YOU."
1090 PRINT "SHOOT: YOU HAVE 5 ARROWS. AN ARROW FLIES THROUGH UP TO FIVE ROOMS;"
1100 PRINT "YOU NAME THEM ONE AFTER THE OTHER, EACH NEXT TO THE ONE BEFORE."
1110 PRINT "IT KILLS THE WUMPUS IF IT PASSES ITS ROOM - AND YOU, IF IT PASSES"
1120 PRINT "YOURS. A MISSED SHOT WAKES THE WUMPUS UP."
1130 PRINT
1140 PRINT "WARNINGS: I SMELL A WUMPUS / I FEEL A DRAFT / BATS NEARBY"
1150 PRINT "(A HAZARD IN A ROOM NEXT TO YOURS)."
1160 PRINT
1170 RETURN
