7710 GFX PALETTE 1,2,RGB(INT(190+60*SIN(STW/7+1)),INT(190+60*SIN(STW/7+1)),255)
7720 GFX PALETTE 1,4,RGB(INT(120+90*SIN(STW/5+2)),INT(120+90*SIN(STW/5+2)),INT(200+50*SIN(STW/5+2)))
7730 END IF
