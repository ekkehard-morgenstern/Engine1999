8230 END PROC
8240 ' centered text on the graphics layer with a shadow
8250 PROC BIGTEXT(Y,T$,C,S)
8260 LOCAL X
8270 X=(640-LEN(T$)*8*S)\2
8280 GFX TEXT X+S\2+1,Y+S\2+1,T$,11,S,S
