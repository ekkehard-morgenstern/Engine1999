7360 ' ------------------------------------------------------------------------------------------------ Deqq
7370 PROC DQMOVE(DX,DY,SP,TF)
7380   W3D THINGMOVE IDEQQ,DX*SP,DY*SP
7390   DQANG=ATAN2(DY,DX)
7400   W3D THINGTEX IDEQQ,TF
7410 END PROC
7420 FUNC NEARWP(X,Y)
7430   LOCAL I,B,D,R,LO,HI
7440   IF DQAWAY THEN LO=50:HI=TWEND ELSE LO=0:HI=48
7450   R=LO:B=1.0E9
7460   FOR I=LO TO HI
7470     D=(WPX(I)-X)^2+(WPY(I)-Y)^2
7480     IF D<B THEN B=D:R=I
7490   NEXT I
7500   RETURN R
7510 END FUNC
7770 PROC CAUGHT
7780   LOCAL I,N,OUT
7790   OUT=NOT (PX>=180 AND PX<=840 AND PY>=300 AND PY<=730) AND NOT (PX<-400 AND PY>=330 AND PY<=650)
7800   CAUGHTN=CAUGHTN+1
7810   MU_AF=2
7820   CALL MU_FORCE(5)
7830   CALL SOUND_(4)
7840   IF OUT THEN
7850     CALL BANNER("DEQQ HAS CAUGHT YOU","HE MARCHES YOU TO THE GATE AND THROWS YOU OUT OF HIS GARDEN. THE GATE SLAMS SHUT.",2.5)
7860   ELSE
7870     CALL BANNER("DEQQ HAS CAUGHT YOU","HE CARRIES YOU OUT OF THE HOUSE AND PUTS YOU DOWN IN THE GARDEN.",2.5)
7880   END IF
7890   FOR I=0 TO 2
7900     N=INV(I)
7910     IF N>=0 THEN
7920       INV(I)=-1
7930       CALL SHOWTHING(N)
7940     END IF
7950   NEXT I
7960   IF OUT THEN
7970     W3D CAMERA 480,-35,270,0,0,W3D("SECTORZ",480,-35,1)
7980     GATET=GT+25:W3D HEIGHT GATESEC,80,300
7990   ELSE
8000     W3D CAMERA 480,150,90,0,0
8010   END IF
8020   W3D LIFT 0
8030   W3K_VZ=0
8040   DQS=0:DQLOST=0
8050   AZ=1
8060   IF OUT THEN
8070     CALL SHOWAT(IDEQQ,480,50)
8080     DQWP=FN NEARWP(480,50)
8090   ELSE
8100     DQWP=5
8110     CALL SHOWAT(IDEQQ,WPX(4),WPY(4))
8120   END IF
8130   W3D THINGTEX IDEQQ,40
8140   DQCD=GT+8
8150   CALL SAY("WHAT YOU CARRIED IS BACK WHERE YOU FOUND IT. THE PARTS BUILT IN STAY.")
8160 END PROC
8170 ' the next way point: the round of the house is 0 .. 48, the walk through the town 50 .. TWEND (out of the gate, once round the block, back in);
8180 ' when his time at home is up (DQLEAVE) the round ends at the front garden (46) and the town walk begins; the town walk ends in the garden: home again
8190 FUNC NEXTWP(I)
8200   LOCAL R
8210   R=I+1
8220   IF I<=48 THEN
8230     IF R>48 THEN R=0
8240     IF I=46 AND DQLEAVE THEN DQAWAY=-1:DQLEAVE=0:R=50
8250   ELSE
8260     IF R=71 AND PY>-30 THEN
8270       CALL SAY("THE GATE CREAKS: DEQQ IS COMING HOME!")
8280       CALL SOUND_(3)
8290     END IF
8300     IF I>=TWEND THEN DQAWAY=0:DQLEAVE=0:DQHT=GT+60+INT(RND(1)*60):R=0
8310   END IF
8320   RETURN R
8330 END FUNC
8340 PROC DEQQAI(DT)
8350   LOCAL DXP,DYP,D,SEEN,LIM,BA,TX,TY,L,DX,DY,F,HID
8360   DXP=W3D("TX",IDEQQ):DYP=W3D("TY",IDEQQ)
8370   D=W3D("DIST",IDEQQ)
8380   HID=(W3D("TAG",W3D("SECTOR"))=50)
8390   SEEN=0
8400   IF GT>=DQCD THEN
8410     LIM=430
8420     IF HID THEN LIM=55
8430     IF D<LIM THEN
8440       BA=ATAN2(PY-DYP,PX-DXP)
8450       IF D<95 OR FN ADIFF(BA,DQANG)<0.95 THEN
8460         IF W3D("SEES",IDEQQ) THEN SEEN=-1
8470       END IF
8480     END IF
8490   END IF
8500   IF DYP<0 THEN SEEN=0
8510   IF NOT DQAWAY AND NOT DQLEAVE AND GT>=DQHT THEN DQLEAVE=-1
8520   F=40+(INT(GT*4) AND 1)
8530    IF DQS=2 AND PY<-5 THEN
8540      DQS=0:DQWP=FN NEARWP(DXP,DYP)
8550      CALL SAY("DEQQ STOPS AT THE FENCE AND SHAKES HIS FIST AT YOU.")
8560      W3D THINGTEX IDEQQ,40
8570    END IF
8580    IF DQS=2 THEN
8590     IF SEEN THEN DQLOST=0 ELSE DQLOST=DQLOST+DT
8600     IF DQLOST>3.5 THEN
8610       DQS=0:DQWP=FN NEARWP(DXP,DYP)
8620       CALL SAY("DEQQ MUTTERS, LOSES YOUR TRACK AND GOES BACK TO HIS ROUND.")
8630       W3D THINGTEX IDEQQ,40
8640     ELSE
8650       IF D>1 THEN CALL DQMOVE((PX-DXP)/D,(PY-DYP)/D,108*DT,42)
8660       IF D<46 AND W3D("SEES",IDEQQ) AND GT>=DQCD THEN CALL CAUGHT
8670     END IF
8680   ELSE
8690     IF SEEN THEN
8700       DQS=2:DQLOST=0
8710       CALL SOUND_(3)
8720       CALL SAY("DEQQ HAS SEEN YOU! RUN, SHUT A DOOR, OR HIDE!")
8730       W3D THINGTEX IDEQQ,42
8740     ELSE
8750      IF DQS=1 THEN
8760       W3D THINGTEX IDEQQ,40
8770       IF GT>=DQPT THEN
8780         DQS=0:DQWP=FN NEXTWP(DQWP)
8790       END IF
8800     ELSE
8810       TX=WPX(DQWP):TY=WPY(DQWP)
8820       DX=TX-DXP:DY=TY-DYP:L=SQR(DX*DX+DY*DY)
8830       IF L<22 THEN
8840         IF WPP(DQWP)>0 THEN
8850           DQS=1:DQPT=GT+WPP(DQWP)
8860         ELSE
8870           DQWP=FN NEXTWP(DQWP)
8880         END IF
8890       ELSE
8900         CALL DQMOVE(DX/L,DY/L,62*DT,F)
8910         IF W3D("HIT") AND 2 THEN DQSTUCK=DQSTUCK+DT ELSE DQSTUCK=0
8920         IF DQSTUCK>1.5 THEN
8930           DQSTUCK=0:DQWP=FN NEXTWP(DQWP)
8940         END IF
8950       END IF
8960     END IF
8970     END IF
8980   END IF
8990   IF DQS<>1 AND D<420 AND GT>=DQFT THEN
9000     CALL SOUND_(2)
9010     DQFT=GT+0.55
9020     IF NOT SEEN AND GT>=DQHEARD AND DQS=0 THEN
9030       CALL SAY("HEAVY FOOTSTEPS. DEQQ IS SOMEWHERE NEAR.")
9040       DQHEARD=GT+30
9050     END IF
9060   END IF
9070 END PROC
