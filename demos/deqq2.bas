10960 ' ------------------------------------------------------------------------------------------------ playing
10970 PROC PROMPTUPDATE
10980   LOCAL N,S,I
10990   PROMPT$=""
11000   N=FN TARGET(0)
11010   IF N>=0 THEN
11020     IF KD(N)>=1 AND KD(N)<=2 THEN
11030       PROMPT$="E: TAKE THE "+NMS$(N)
11040     ELSE
11050       PROMPT$="E: "+NMS$(N)
11060     END IF
11070   ELSE
11080     S=W3D("USE",70)
11090     FOR I=2 TO 4
11100       IF S=DSEC(I) THEN
11110         IF DOP(I) THEN PROMPT$="E: CLOSE THE DOOR" ELSE PROMPT$="E: OPEN THE DOOR"
11120       END IF
11130     NEXT I
11140   END IF
11150 END PROC
11160 PROC PLAYLEVEL
11170   LOCAL DT,U,UL,BL,B,Y,YL,T0,FR
11180   UL=0:BL=0:YL=0:FR=0
11190   T0=TI
11200   REPEAT
11210     DT=(TI-T0)/60:T0=TI
11220     IF DT>0.1 THEN DT=0.1
11230     CALL W3K_WALK
11240     CALL W3K_JUMP(KEY("SPACE") OR JOY("A"))
11250     U=KEY("E") OR KEY("RETURN") OR JOY("X")
11260     IF U<>0 AND UL=0 THEN CALL USEKEY
11270     UL=U
11280     B=KEY("G") OR JOY("B")
11290     IF B<>0 AND BL=0 THEN CALL DROPLAST
11300     BL=B
11310     IF KEY("ESC") THEN IN_QUIT=1
11320     CALL TICK(DT)
11330     IF FR MOD 5=0 THEN CALL PROMPTUPDATE
11340     W3D RENDER
11350     CALL HUD
11360     GFX LINE 318,131,321,132,FN CI(0,13),BF
11370     CALL W3K_SHOW
11380     FR=FR+1
11390     IF FN IN_SERVICE() THEN
11400       CALL BIGTEXT(110,"PAUSED",FN CI(0,15),3)
11410       CALL W3K_SHOW
11420       CALL MU_SILENCE
11430       CALL IN_PAUSELOOP
11440       CALL MU_START
11450       T0=TI:W3K_T0=TI
11460     END IF
11470     IF IN_KEY=77 THEN CALL MU_TOGGLE
11480     Y=JOY("Y")
11490     IF IN_KEY=79 OR (Y<>0 AND YL=0) THEN
11500       CALL P3_DIALOG
11510       T0=TI
11520     END IF
11530     YL=Y
11540   UNTIL IN_QUIT OR ENDREQ
11550 END PROC
11560 PROC ENDING
11570   LOCAL I
11580   MU_AF=0
11590   CALL MU_FORCE(6)
11600   CALL BANNER("THE SHIP HUMS","ALL EIGHT PARTS ARE BUILT IN. THE LIGHTS OF THE WRECK COME ON, ONE BY ONE.",4)
11610   IF HL THEN
11620     PRINT "# ENDING"
11630   ELSE
11640     FOR I=0 TO 90
11650       W3D THINGZ 32,I*2
11660       W3D RENDER
11670       CALL HUD
11680       CALL W3K_SHOW
11690     NEXT I
11700     CALL BANNER("DEQQ SAYS THANK YOU","'YOU FIXED MY SHIP. I SHALL GO HOME. THE HOUSE IS YOURS. IT BITES, A LITTLE.'",5)
11710     CALL BANNER("THE END","TIME "+STR$(INT(GT\60))+" MIN "+STR$(INT(GT) MOD 60)+" S    CAUGHT "+STR$(CAUGHTN)+" TIMES",5)
11720   END IF
11730   IF EXISTS("local:deqq2.sav") THEN KILL "local:deqq2.sav"
11740 END PROC
11750 ' ------------------------------------------------------------------------------------------------ playback (the headless test)
11760 ' commands (lines of the file named by DEQQ2_PLAY): step n | goto x y angle | walk x y | face x y | use | drop | give n | dial 731 | deqq x y | deqqoff | deqqon | state | say text | continue | new | quit
11770 PROC SPLIT(L$)
11780   LOCAL I,N,C$,CUR$
11790   FOR I=0 TO 7
11800     W$(I)=""
11810   NEXT I
11820   N=0:CUR$=""
11830   FOR I=1 TO LEN(L$)
11840     C$=MID$(L$,I,1)
11850     IF C$=" " THEN
11860       IF CUR$<>"" THEN
11870         IF N<7 THEN
11880           W$(N)=CUR$:N=N+1
11890         END IF
11900         CUR$=""
11910       END IF
11920     ELSE
11930       CUR$=CUR$+C$
11940     END IF
11950   NEXT I
11960   IF CUR$<>"" AND N<7 THEN W$(N)=CUR$
11970 END PROC
11980 PROC WALKTO(X,Y)
11990   LOCAL I,DX,DY,L,A
12000   FOR I=1 TO 1500
12010     DX=X-W3D("X"):DY=Y-W3D("Y"):L=SQR(DX*DX+DY*DY)
12020     IF L<8 THEN EXIT PROC
12030     A=ATAN2(DY,DX)*180/3.141592654
12040     W3D CAMERA W3D("X"),W3D("Y"),A
12050     W3D MOVE MIN(L,3.2),0
12060     W3D RENDER
12070     CALL TICK(1/60)
12080     IF ENDREQ THEN EXIT PROC
12090   NEXT I
12100   PRINT "# walk to ";X;",";Y;" failed at ";INT(W3D("X"));",";INT(W3D("Y"))
12110 END PROC
12120 PROC PLAYBACK
12130   LOCAL L$,C$,I,N
12140   WHILE NOT EOF(4) AND NOT QUITREQ
12150     LINE INPUT #4,L$
12160     CALL SPLIT(L$)
12170     C$=W$(0)
12180     IF C$="step" THEN
12190       FOR I=1 TO VAL(W$(1))
12200         CALL TICK(1/60)
12210       NEXT I
12220     END IF
12230     IF C$="goto" THEN
12240       Z=VAL(W$(4)):IF Z=0 THEN Z=1
12250       W3D CAMERA VAL(W$(1)),VAL(W$(2)),VAL(W$(3)),0,0,W3D("SECTORZ",VAL(W$(1)),VAL(W$(2)),Z)
12260       PX=W3D("X"):PY=W3D("Y")
12270       FOR I=1 TO 12
12280         W3D RENDER
12290       NEXT I
12300     END IF
12310     IF C$="walk" THEN CALL WALKTO(VAL(W$(1)),VAL(W$(2)))
12320     IF C$="face" THEN W3D CAMERA W3D("X"),W3D("Y"),ATAN2(VAL(W$(2))-W3D("Y"),VAL(W$(1))-W3D("X"))*180/3.141592654
12330     IF C$="use" THEN CALL USEKEY
12340     IF C$="drop" THEN CALL DROPLAST
12350     IF C$="give" THEN
12360       N=VAL(W$(1))
12370       CALL TAKE(N)
12380     END IF
12390     IF C$="dial" THEN DIALIN$=W$(1)
12400     IF C$="deqq" THEN
12410       AZ=VAL(W$(3)):IF AZ=0 THEN AZ=1
12420       CALL SHOWAT(IDEQQ,VAL(W$(1)),VAL(W$(2)))
12430       DQS=0:DQCD=GT
12440     END IF
12450     IF C$="deqqoff" THEN DQON=0
12460     IF C$="deqqon" THEN
12470       DQON=-1:DQAWAY=0:DQLEAVE=0:DQHT=GT+100000:DQWP=26:AZ=120:DQS=0:DQCD=GT+3
12480       CALL SHOWAT(IDEQQ,WPX(DQWP),WPY(DQWP))
12490     END IF
12500     IF C$="deqqaway" THEN
12510       DQON=-1:DQAWAY=-1:DQLEAVE=0:DQWP=VAL(W$(1)):IF DQWP=0 THEN DQWP=60
12520       AZ=1:CALL SHOWAT(IDEQQ,WPX(DQWP),WPY(DQWP)):DQS=0:DQCD=GT
12530     END IF
12540     IF C$="say" THEN PRINT "# ";MID$(L$,5)
12550     IF C$="deqqleave" THEN DQLEAVE=-1
12560     IF C$="state" THEN
12570       PRINT "# state built=";NBUILT;" caught=";CAUGHTN;" dqs=";DQS;" sector=";W3D("SECTOR");" inv=";INV(0);INV(1);INV(2);" t=";INT(GT);" away=";DQAWAY;" wp=";DQWP;" gate=";GATET;" cars=";NCARS;" wpxy=";WPX(DQWP);",";WPY(DQWP);" deqq=";INT(W3D("TX",IDEQQ));",";INT(W3D("TY",IDEQQ));" sec ";W3D("TSECTOR",IDEQQ)
12580     END IF
12590     IF C$="continue" THEN
12600       IF FN LOADSAVE(0) THEN
12610         CALL NEWGAME(-1)
12620         PRINT "# continued with mask ";SAVEDMASK
12630       ELSE
12640         PRINT "# no saved game"
12650       END IF
12660     END IF
12670     IF C$="new" THEN CALL NEWGAME(0)
12680     IF C$="quit" THEN QUITREQ=-1
12690     IF ENDREQ THEN
12700       CALL ENDING
12710       ENDREQ=0
12720     END IF
12730   WEND
12740 END PROC
