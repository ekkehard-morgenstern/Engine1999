10020       IF K$<>"" THEN
10030         IF K$="n" OR K$="N" OR K$=" " OR K$=CHR$(13) THEN C=1
10040         IF (K$="c" OR K$="C") AND SV AND SAVEDMASK>0 THEN C=2
10050         IF K$="q" OR K$="Q" OR K$=CHR$(27) THEN C=3
10060       END IF
10070       IF FN IN_ANYA(0) OR FN IN_ANYSTART(0) THEN C=1
10080       IF FN IN_ANYBACK(0) THEN C=3
10090     UNTIL C<>0
