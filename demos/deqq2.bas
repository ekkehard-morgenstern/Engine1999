4050 ' ------------------------------------------------------------------------------------------------ the puzzles
4060 ' a part or an item is taken (some parts have a condition)
4070 PROC PICKUP(N)
4080   IF N=PCRYSTAL AND W3D("SECTOR")<>CHAIRSEC THEN
4090     CALL SAY("IT IS ON TOP OF THE CUPBOARD, OUT OF REACH. YOU NEED TO STAND ON SOMETHING.")
4100     CALL SOUND_(6)
4110     EXIT PROC
4120   END IF
4130   IF N=PNOZZLE AND NOT FED THEN
4140     CALL SAY("THE GLORP SITS ON THE NOZZLE AND SNIFFS THE AIR. IT WANTS GREEN JELLY.")
4150     CALL SOUND_(6)
4160     EXIT PROC
4170   END IF
4180   CALL TAKE(N)
4190 END PROC
4200 PROC DOACT(N)
4210   LOCAL A
4220   A=ACT(N)
4230   IF A=20 THEN CALL SAY(DESC$(N))
4240   IF A=1 THEN
4250     IF OVENCOOL THEN
4260       IF NOT OVENOPEN THEN
4270         OVENOPEN=-1:TXN(OOVEN)=66:CALL SHOWTHING(OOVEN)
4280         CALL REVEAL(PCOIL)
4290         CALL SAY("YOU OPEN THE OVEN. INSIDE LIES A FLUX COIL!")
4300         CALL SOUND_(5)
4310       ELSE
4320         CALL SAY("THE OVEN IS EMPTY NOW.")
4330       END IF
4340     ELSE
4350      IF OVENT>0 THEN
4360       CALL SAY("THE OVEN IS STILL TOO HOT TO OPEN. BE PATIENT.")
4370     ELSE
4380       OVENT=GT
4390       CALL SAY("THE OVEN IS HOT. YOU TURN THE KNOB OFF: IT STARTS TO COOL DOWN.")
4400       CALL SOUND_(8)
4410     END IF
4420     END IF
4430   END IF
4440   IF A=2 THEN
4450     IF FRIDGEOP THEN
4460       CALL SAY("THE FRIDGE HUMS IN TWO KEYS AT ONCE.")
4470     ELSE
4480       FRIDGEOP=-1:TXN(OFRIDGE)=68:CALL SHOWTHING(OFRIDGE)
4490       CALL REVEAL(IJELLY):CALL REVEAL(IICE)
4500       CALL SAY("YOU OPEN THE FRIDGE: GREEN JELLY, AND A BLOCK OF ICE WITH SOMETHING INSIDE.")
4510       CALL SOUND_(5)
4520     END IF
4530   END IF
4540   IF A=3 THEN
4550     IF FN HAS(IICE) THEN
4560       CALL USEUP(IICE)
4570       MELTT=GT+5
4580       CALL SAY("YOU TURN ON THE TAP AND HOLD THE ICE UNDER THE WARM WATER...")
4590       CALL SOUND_(9)
4600     ELSE
4610       CALL SAY("A DEEP STONE SINK. THE TAP RUNS WARM WATER.")
4620     END IF
4630   END IF
4640   IF A=4 THEN
4650     IF FN HAS(ICHAIR) THEN
4660       CALL USEUP(ICHAIR)
4670       CHAIRON=-1
4680       W3D HEIGHT CHAIRSEC,56,200
4690       CALL SAY("YOU PUT THE CHAIR UNDER THE CUPBOARD. JUMP ONTO IT!")
4700       CALL SOUND_(5)
4710     ELSE
4720      IF CHAIRON THEN
4730       CALL SAY("THE CHAIR STANDS UNDER THE CUPBOARD.")
4740     ELSE
4750       CALL SAY("A VERY TALL CUPBOARD. SOMETHING GLOWS VIOLET ON TOP, OUT OF REACH.")
4760     END IF
4770     END IF
4780   END IF
4790   IF A=6 THEN
4800     IF FED THEN
4810       CALL SAY("THE GLORP PURRS. IT LOOKS AT YOU WITH ENORMOUS EYES.")
4820     ELSE
4830      IF FN HAS(IJELLY) THEN
4840       CALL USEUP(IJELLY)
4850       FED=-1
4860       TXN(IGLORP)=44:HX(IGLORP)=HX(IGLORP)-60:CALL SHOWTHING(IGLORP)
4870       CALL SAY("THE GLORP EATS THE GREEN JELLY, GURGLES HAPPILY AND MOVES AWAY FROM THE NOZZLE.")
4880       CALL SOUND_(7)
4890     ELSE
4900       CALL SAY("A GLORP. IT SITS ON SOMETHING SHINY AND SNIFFS THE AIR. IT WANTS GREEN JELLY.")
4910     END IF
4920     END IF
4930   END IF
4940   IF A=8 THEN
4950     IF NOT FN HAS(ILANT) THEN
4960       CALL SAY("IT IS TOO DARK TO READ THE LABELS. YOU NEED A LIGHT.")
4970       CALL SOUND_(6)
4980     ELSE
4990      IF NOT POWEROFF THEN
5000       POWEROFF=-1
