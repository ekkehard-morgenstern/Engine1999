12380 ' ------------------------------------------------------------------------------------------------ playback (the headless test)
12390 ' commands (lines of the file named by DEQQ2_PLAY): step n | goto x y angle | walk x y | face x y | use | drop | give n | dial 731 | deqq x y | deqqoff | deqqon | state | say text | continue | new | quit
12400 PROC SPLIT(L$)
12410   LOCAL I,N,C$,CUR$
12420   FOR I=0 TO 7
12430     W$(I)=""
12440   NEXT I
12450   N=0:CUR$=""
12460   FOR I=1 TO LEN(L$)
12470     C$=MID$(L$,I,1)
12480     IF C$=" " THEN
12490       IF CUR$<>"" THEN
12500         IF N<7 THEN
12510           W$(N)=CUR$:N=N+1
12520         END IF
12530         CUR$=""
12540       END IF
12550     ELSE
12560       CUR$=CUR$+C$
12570     END IF
12580   NEXT I
12590   IF CUR$<>"" AND N<7 THEN W$(N)=CUR$
12600 END PROC
12610 PROC WALKTO(X,Y)
12620   LOCAL I,DX,DY,L,A
12630   FOR I=1 TO 1500
12640     DX=X-W3D("X"):DY=Y-W3D("Y"):L=SQR(DX*DX+DY*DY)
12650     IF L<8 THEN EXIT PROC
12660     A=ATAN2(DY,DX)*180/3.141592654
12670     W3D CAMERA W3D("X"),W3D("Y"),A
12680     W3D MOVE MIN(L,3.2),0
12690     W3D RENDER
12700     CALL TICK(1/60)
12710     IF ENDREQ THEN EXIT PROC
12720   NEXT I
12730   PRINT "# walk to ";X;",";Y;" failed at ";INT(W3D("X"));",";INT(W3D("Y"))
12740 END PROC
12750 PROC PLAYBACK
12760   LOCAL L$,C$,I,N
12770   WHILE NOT EOF(4) AND NOT QUITREQ
12780     LINE INPUT #4,L$
12790     CALL SPLIT(L$)
12800     C$=W$(0)
12810     IF C$="step" THEN
12820       FOR I=1 TO VAL(W$(1))
12830         CALL TICK(1/60)
12840       NEXT I
12850     END IF
12860     IF C$="goto" THEN
12870       Z=VAL(W$(4)):IF Z=0 THEN Z=1
12880       W3D CAMERA VAL(W$(1)),VAL(W$(2)),VAL(W$(3)),0,0,W3D("SECTORZ",VAL(W$(1)),VAL(W$(2)),Z)
12890       PX=W3D("X"):PY=W3D("Y")
12900       FOR I=1 TO 12
12910         W3D RENDER
12920       NEXT I
12930     END IF
12940     IF C$="walk" THEN CALL WALKTO(VAL(W$(1)),VAL(W$(2)))
12950     IF C$="face" THEN W3D CAMERA W3D("X"),W3D("Y"),ATAN2(VAL(W$(2))-W3D("Y"),VAL(W$(1))-W3D("X"))*180/3.141592654
12960     IF C$="use" THEN CALL USEKEY
12970     IF C$="drop" THEN CALL DROPLAST
12980     IF C$="give" THEN
12990       N=VAL(W$(1))
13000       CALL TAKE(N)
13010     END IF
13020     IF C$="dial" THEN DIALIN$=W$(1)
13030     IF C$="deqq" THEN
13040       AZ=VAL(W$(3)):IF AZ=0 THEN AZ=1
13050       CALL SHOWAT(IDEQQ,VAL(W$(1)),VAL(W$(2)))
13060       DQS=0:DQCD=GT
13070     END IF
13080     IF C$="deqqoff" THEN DQON=0
13090     IF C$="deqqon" THEN
13100       DQON=-1:DQAWAY=0:DQLEAVE=0:DQHT=GT+100000:DQWP=26:AZ=120:DQS=0:DQCD=GT+3
13110       CALL SHOWAT(IDEQQ,WPX(DQWP),WPY(DQWP))
13120     END IF
13130     IF C$="deqqaway" THEN
13140       DQON=-1:DQAWAY=-1:DQLEAVE=0:DQWP=VAL(W$(1)):IF DQWP=0 THEN DQWP=60
13150       AZ=1:CALL SHOWAT(IDEQQ,WPX(DQWP),WPY(DQWP)):DQS=0:DQCD=GT
13160     END IF
13170     IF C$="say" THEN PRINT "# ";MID$(L$,5)
13180     IF C$="deqqleave" THEN DQLEAVE=-1
13190     IF C$="state" THEN
13200       PRINT "# state built=";NBUILT;" caught=";CAUGHTN;" dqs=";DQS;" sector=";W3D("SECTOR");" inv=";INV(0);INV(1);INV(2);" t=";INT(GT);" away=";DQAWAY;" wp=";DQWP;" gate=";GATET;" cars=";NCARS;" wpxy=";WPX(DQWP);",";WPY(DQWP);" deqq=";INT(W3D("TX",IDEQQ));",";INT(W3D("TY",IDEQQ));" sec ";W3D("TSECTOR",IDEQQ)
13210     END IF
13220     IF C$="continue" THEN
13230       IF FN LOADSAVE(0) THEN
13240         CALL NEWGAME(-1)
13250         PRINT "# continued with mask ";SAVEDMASK
13260       ELSE
13270         PRINT "# no saved game"
13280       END IF
13290     END IF
13300     IF C$="new" THEN CALL NEWGAME(0)
13310     IF C$="quit" THEN QUITREQ=-1
13320     IF ENDREQ THEN
13330       CALL ENDING
13340       ENDREQ=0
13350     END IF
13360   WEND
13370 END PROC
