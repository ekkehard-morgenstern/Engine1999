3970 ' ------------------------------------------------------------------------------------------------ doors, the cellar's light, timers
3980 PROC DOORS(DT)
3990   LOCAL I,G
4000   FOR I=1 TO 4
4010     IF DOP(I) THEN G=100 ELSE G=0
4020     IF DCUR(I)<G THEN DCUR(I)=MIN(G,DCUR(I)+90*DT)
4030     IF DCUR(I)>G THEN DCUR(I)=MAX(G,DCUR(I)-90*DT)
4040     W3D HEIGHT DSEC(I),0,DCUR(I)
4050   NEXT I
4060 END PROC
4070 PROC LANTERNLIGHT
4080   LOCAL L,S
4090   L=FN HAS(ILANT)
4100   IF L=LANTON THEN EXIT PROC
4110   LANTON=L
4120   FOR S=34 TO 38
4130     IF L THEN W3D LIGHT S,170 ELSE W3D LIGHT S,90
4140   NEXT S
4150   FOR S=39 TO 45
4160     IF S=39 OR S=45 THEN
4170       IF L THEN W3D LIGHT S,185 ELSE W3D LIGHT S,45
4180     END IF
4190   NEXT S
4200 END PROC
4210 ' things that happen after a while: the oven cools down, the compass comes out of the melting ice
4220 PROC TIMERS
4230   IF OVENT>0 AND OVENCOOL=0 AND GT>=OVENT+30 THEN
4240     OVENCOOL=-1
4250     TXN(OOVEN)=65:CALL SHOWTHING(OOVEN)
4260     CALL SAY("THE OVEN HAS COOLED DOWN. YOU CAN OPEN IT NOW.")
4270     CALL SOUND_(8)
4280   END IF
4290   IF MELTT>0 AND GT>=MELTT THEN
4300     MELTT=0
4310     CALL REVEAL(PCOMPASS)
4320     CALL SAY("THE ICE HAS MELTED: A BRASS STAR COMPASS LIES IN THE SINK!")
4330     CALL SOUND_(8)
4340   END IF
4350 END PROC
4360 ' ------------------------------------------------------------------------------------------------ the puzzles
4370 ' a part or an item is taken (some parts have a condition)
4380 PROC PICKUP(N)
4390   IF N=PCRYSTAL AND W3D("SECTOR")<>CHAIRSEC THEN
4400     CALL SAY("IT IS ON TOP OF THE CUPBOARD, OUT OF REACH. YOU NEED TO STAND ON SOMETHING.")
4410     CALL SOUND_(6)
4420     EXIT PROC
4430   END IF
4440   IF N=PNOZZLE AND NOT FED THEN
4450     CALL SAY("THE GLORP SITS ON THE NOZZLE AND SNIFFS THE AIR. IT WANTS GREEN JELLY.")
4460     CALL SOUND_(6)
4470     EXIT PROC
4480   END IF
4490   CALL TAKE(N)
4500 END PROC
4510 PROC DOACT(N)
4520   LOCAL A
4530   A=ACT(N)
4540   IF A=20 THEN CALL SAY(DESC$(N))
4550   IF A=1 THEN
4560     IF OVENCOOL THEN
4570       IF NOT OVENOPEN THEN
4580         OVENOPEN=-1:TXN(OOVEN)=66:CALL SHOWTHING(OOVEN)
4590         CALL REVEAL(PCOIL)
4600         CALL SAY("YOU OPEN THE OVEN. INSIDE LIES A FLUX COIL!")
4610         CALL SOUND_(5)
4620       ELSE
4630         CALL SAY("THE OVEN IS EMPTY NOW.")
4640       END IF
4650     ELSE
4660      IF OVENT>0 THEN
4670       CALL SAY("THE OVEN IS STILL TOO HOT TO OPEN. BE PATIENT.")
4680     ELSE
4690       OVENT=GT
4700       CALL SAY("THE OVEN IS HOT. YOU TURN THE KNOB OFF: IT STARTS TO COOL DOWN.")
4710       CALL SOUND_(8)
4720     END IF
4730     END IF
4740   END IF
4750   IF A=2 THEN
4760     IF FRIDGEOP THEN
4770       CALL SAY("THE FRIDGE HUMS IN TWO KEYS AT ONCE.")
4780     ELSE
4790       FRIDGEOP=-1:TXN(OFRIDGE)=68:CALL SHOWTHING(OFRIDGE)
4800       CALL REVEAL(IJELLY):CALL REVEAL(IICE)
4810       CALL SAY("YOU OPEN THE FRIDGE: GREEN JELLY, AND A BLOCK OF ICE WITH SOMETHING INSIDE.")
4820       CALL SOUND_(5)
4830     END IF
4840   END IF
