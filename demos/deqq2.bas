3570 PROC LOADLEVEL
3580   LOCAL NS,I,S,F,C,FT,CT,L,TG,NW,J,X1,Y1,X2,Y2,T,NX,FL,UP,LO,XO,YO
3590   RESTORE LEVELDATA
3600   READ NS
3610   FOR I=1 TO NS
3620     READ S,F,C,FT,CT,L,TG,NW
3630     W3D SECTOR S,F,C,FT,CT,L
3640     W3D TAG S,TG
3650     FOR J=0 TO NW-1
3660       READ X1,Y1,X2,Y2,T,NX,FL,UP,LO,XO,YO
3670       W3D WALL S,X1,Y1,X2,Y2,T,NX
3680       IF UP>=0 OR LO>=0 THEN W3D WALLTEX S,J,-1,UP,LO
3690       IF FL<>0 THEN W3D WALLFLAG S,J,FL
3700       IF XO<>0 OR YO<>0 THEN W3D WALLOFF S,J,XO,YO
3710     NEXT J
3720   NEXT I
3730 END PROC
