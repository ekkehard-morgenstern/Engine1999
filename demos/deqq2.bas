4630       CALL SAY("THE GLORP EATS THE GREEN JELLY, GURGLES HAPPILY AND MOVES AWAY FROM THE NOZZLE.")
4640       CALL SOUND_(7)
4650     ELSE
4660       CALL SAY("A GLORP. IT SITS ON SOMETHING SHINY AND SNIFFS THE AIR. IT WANTS GREEN JELLY.")
4670     END IF
4680     END IF
4690   END IF
4700   IF A=8 THEN
4710     IF NOT FN HAS(ILANT) THEN
4720       CALL SAY("IT IS TOO DARK TO READ THE LABELS. YOU NEED A LIGHT.")
4730       CALL SOUND_(6)
4740     ELSE
4750      IF NOT POWEROFF THEN
4760       POWEROFF=-1
