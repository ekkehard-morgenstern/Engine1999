3100 PROC LOADLEVEL
3110   LOCAL NS,I,S,F,C,FT,CT,L,TG,NW,J,X1,Y1,X2,Y2,T,NX,FL,UP,LO,XO,YO
3120   RESTORE LEVELDATA
3130   READ NS
3140   FOR I=1 TO NS
3150     READ S,F,C,FT,CT,L,TG,NW
3160     W3D SECTOR S,F,C,FT,CT,L
3170     W3D TAG S,TG
3180     IF TG=97 THEN W3D GHOST S,1
3190     FOR J=0 TO NW-1
3200       READ X1,Y1,X2,Y2,T,NX,FL,UP,LO,XO,YO
3210       W3D WALL S,X1,Y1,X2,Y2,T,NX
3220       IF UP>=0 OR LO>=0 THEN W3D WALLTEX S,J,-1,UP,LO
3230       IF FL<>0 THEN W3D WALLFLAG S,J,FL
3240       IF XO<>0 OR YO<>0 THEN W3D WALLOFF S,J,XO,YO
3250     NEXT J
3260   NEXT I
3270   READ S
3280   WHILE S>=0
3290     READ X1,Y1,T,NX,FL,UP
3300     W3D THING S,X1,Y1,T,NX,FL,W3D("SECTORZ",X1,Y1,1)
3310     IF UP<>0 THEN W3D THINGZ S,UP
3320     READ S
3330   WEND
3340 END PROC
