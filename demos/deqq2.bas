4880       CALL SAY("YOU OPEN THE FRIDGE: GREEN JELLY, AND A BLOCK OF ICE WITH SOMETHING INSIDE.")
4890       CALL SOUND_(5)
4900     END IF
4910   END IF
4920   IF A=3 THEN
