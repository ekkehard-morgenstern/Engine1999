3980   A=ACT(N)
3990   IF A=20 THEN CALL SAY(DESC$(N))
4000   IF A=1 THEN
4010     IF OVENCOOL THEN
4020       IF NOT OVENOPEN THEN
4030         OVENOPEN=-1:TXN(OOVEN)=66:CALL SHOWTHING(OOVEN)
4040         CALL REVEAL(PCOIL)
4050         CALL SAY("YOU OPEN THE OVEN. INSIDE LIES A FLUX COIL!")
4060         CALL SOUND_(5)
4070       ELSE
4080         CALL SAY("THE OVEN IS EMPTY NOW.")
4090       END IF
4100     ELSE
4110      IF OVENT>0 THEN
