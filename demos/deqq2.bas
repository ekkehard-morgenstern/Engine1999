6970 ' ------------------------------------------------------------------------------------------------ Deqq
6980 PROC DQMOVE(DX,DY,SP,TF)
6990   M3D THINGMOVE IDEQQ,DX*SP,DY*SP
7000   DQANG=ATAN2(DY,DX)
7010   M3D THINGTEX IDEQQ,TF
7020 END PROC
7030 FUNC NEARWP(X,Y)
7040   LOCAL I,B,D,R,LO,HI
7050   IF DQAWAY THEN LO=50:HI=TWEND ELSE LO=0:HI=48
7060   R=LO:B=1.0E9
7070   FOR I=LO TO HI
7080     D=(WPX(I)-X)^2+(WPY(I)-Y)^2
7090     IF D<B THEN B=D:R=I
7100   NEXT I
7110   RETURN R
7120 END FUNC
7130 PROC CAUGHT
7140   LOCAL I,N,OUT
7150   OUT=NOT (PX>=180 AND PX<=840 AND PY>=300 AND PY<=730) AND NOT (PX<-400 AND PY>=330 AND PY<=650)
7160   CAUGHTN=CAUGHTN+1
7170   MU_AF=2
7180   CALL MU_FORCE(5)
7190   CALL SOUND_(4)
7200   IF OUT THEN
7210     CALL BANNER("DEQQ HAS CAUGHT YOU","HE MARCHES YOU TO THE GATE AND THROWS YOU OUT OF HIS GARDEN. THE GATE SLAMS SHUT.",2.5)
7220   ELSE
7230     CALL BANNER("DEQQ HAS CAUGHT YOU","HE CARRIES YOU OUT OF THE HOUSE AND PUTS YOU DOWN IN THE GARDEN.",2.5)
7240   END IF
7250   FOR I=0 TO 2
7260     N=INV(I)
7270     IF N>=0 THEN
7280       INV(I)=-1
7290       CALL SHOWTHING(N)
7300     END IF
7310   NEXT I
7320   IF OUT THEN
7330     M3D CAMERA 480,-35,0,270
7340     GATET=GT+25:M3D OBJSHOW 3000,-1
7350   ELSE
7360     M3D CAMERA 480,150,0,90
7370   END IF
7380   M3D LIFT 0
7390   W3K_VZ=0
7400   DQS=0:DQLOST=0
7410   AZ=1
7420   IF OUT THEN
7430     CALL SHOWAT(IDEQQ,480,50)
7440     DQWP=FN NEARWP(480,50)
7450   ELSE
7460     DQWP=5
7470     CALL SHOWAT(IDEQQ,WPX(4),WPY(4))
7480   END IF
7490   M3D THINGTEX IDEQQ,40
7500   DQCD=GT+8
7510   CALL SAY("WHAT YOU CARRIED IS BACK WHERE YOU FOUND IT. THE PARTS BUILT IN STAY.")
7520 END PROC
7530 ' the next way point: the round of the house is 0 .. 48, the walk through the town 50 .. TWEND (out of the gate, once round the block, back in);
7540 ' when his time at home is up (DQLEAVE) the round ends at the front garden (46) and the town walk begins; the town walk ends in the garden: home again
7550 FUNC NEXTWP(I)
7560   LOCAL R
7570   R=I+1
7580   IF I<=48 THEN
7590     IF R>48 THEN R=0
7600     IF I=46 AND DQLEAVE THEN DQAWAY=-1:DQLEAVE=0:R=50
7610   ELSE
7620     IF R=71 AND PY>-30 THEN
7630       CALL SAY("THE GATE CREAKS: DEQQ IS COMING HOME!")
7640       CALL SOUND_(3)
7650     END IF
7660     IF I>=TWEND THEN DQAWAY=0:DQLEAVE=0:DQHT=GT+60+INT(RND(1)*60):R=0
7670   END IF
7680   RETURN R
7690 END FUNC
7700 PROC DEQQAI(DT)
7710   LOCAL DXP,DYP,D,SEEN,LIM,BA,TX,TY,L,DX,DY,F,HID
7720   DXP=M3D("TX",IDEQQ):DYP=M3D("TY",IDEQQ)
7730   D=M3D("DIST",IDEQQ)
7740   HID=(FN TAGP=50)
7750   SEEN=0
7760   IF GT>=DQCD THEN
7770     LIM=430
7780     IF HID THEN LIM=55
7790     IF D<LIM THEN
7800       BA=ATAN2(PY-DYP,PX-DXP)
7810       IF D<95 OR FN ADIFF(BA,DQANG)<0.95 THEN
7820         IF M3D("SEES",IDEQQ) THEN SEEN=-1
7830       END IF
7840     END IF
7850   END IF
7860   IF DYP<0 OR FN ZONEP>=400 THEN SEEN=0
7870   IF NOT DQAWAY AND NOT DQLEAVE AND GT>=DQHT THEN DQLEAVE=-1
7880   F=40+(INT(GT*4) AND 1)
7890    IF DQS=2 AND FN ZONEP>=400 THEN
7900      DQS=0:DQWP=FN NEARWP(DXP,DYP)
7910      CALL SAY("DEQQ STOPS AT THE FENCE AND SHAKES HIS FIST AT YOU.")
7920      M3D THINGTEX IDEQQ,40
7930    END IF
7940    IF DQS=2 THEN
7950     IF SEEN THEN DQLOST=0 ELSE DQLOST=DQLOST+DT
7960     IF DQLOST>3.5 THEN
7970       DQS=0:DQWP=FN NEARWP(DXP,DYP)
7980       CALL SAY("DEQQ MUTTERS, LOSES YOUR TRACK AND GOES BACK TO HIS ROUND.")
7990       M3D THINGTEX IDEQQ,40
8000     ELSE
8010       IF D>1 THEN CALL DQMOVE((PX-DXP)/D,(PY-DYP)/D,108*DT,42)
8020       IF D<46 AND M3D("SEES",IDEQQ) AND GT>=DQCD THEN CALL CAUGHT
8030     END IF
8040   ELSE
8050     IF SEEN THEN
8060       DQS=2:DQLOST=0
8070       CALL SOUND_(3)
8080       CALL SAY("DEQQ HAS SEEN YOU! RUN, SHUT A DOOR, OR HIDE!")
8090       M3D THINGTEX IDEQQ,42
8100     ELSE
8110      IF DQS=1 THEN
8120       M3D THINGTEX IDEQQ,40
8130       IF GT>=DQPT THEN
8140         DQS=0:DQWP=FN NEXTWP(DQWP)
8150       END IF
8160     ELSE
8170       TX=WPX(DQWP):TY=WPY(DQWP)
8180       DX=TX-DXP:DY=TY-DYP:L=SQR(DX*DX+DY*DY)
8190       IF L<22 THEN
8200         IF WPP(DQWP)>0 THEN
8210           DQS=1:DQPT=GT+WPP(DQWP)
8220         ELSE
8230           DQWP=FN NEXTWP(DQWP)
8240         END IF
8250       ELSE
8260         CALL DQMOVE(DX/L,DY/L,62*DT,F)
8270         IF M3D("HIT") AND 2 THEN DQSTUCK=DQSTUCK+DT ELSE DQSTUCK=0
8280         IF DQSTUCK>1.5 THEN
8290           DQSTUCK=0:DQWP=FN NEXTWP(DQWP)
8300         END IF
8310       END IF
8320     END IF
8330     END IF
8340   END IF
8350   IF DQS<>1 AND D<420 AND GT>=DQFT THEN
8360     CALL SOUND_(2)
8370     DQFT=GT+0.55
8380     IF NOT SEEN AND GT>=DQHEARD AND DQS=0 THEN
8390       CALL SAY("HEAVY FOOTSTEPS. DEQQ IS SOMEWHERE NEAR.")
8400       DQHEARD=GT+30
8410     END IF
8420   END IF
8430 END PROC
