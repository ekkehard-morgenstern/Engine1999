5400     END IF
5410     END IF
5420   END IF
5430   IF A=12 THEN
5440     PHOTOSEEN=-1
5450     CALL SAY("YOU TURN THE PHOTO OVER. SCRATCHED INTO THE BACK WITH A PIN: 7 3 1.")
5460   END IF
5470   IF A=13 THEN
5480     IF SAFEOP THEN
5490       CALL SAY("THE SAFE IS OPEN AND EMPTY.")
5500     ELSE
5510      IF FN DIAL(0) THEN
5520       SAFEOP=-1:TXN(OSAFE)=75:CALL SHOWTHING(OSAFE)
5530       CALL REVEAL(PGLYPH)
5540       CALL SAY("CLICK! THE SAFE OPENS. INSIDE IS AN IGNITION GLYPH.")
5550       CALL SOUND_(5)
5560     ELSE
5570       CALL SAY("THE SAFE STAYS SHUT.")
5580     END IF
5590     END IF
5600   END IF
5610   IF A=14 THEN
5620     IF CRANKED THEN
5630       CALL SAY("THE BUCKET HANGS HIGH ABOVE THE WELL.")
5640     ELSE
5650      IF FN HAS(ICRANK) THEN
5660       CRANKED=-1
5670       CALL USEUP(ICRANK)
5680       CALL REVEAL(PANT)
5690       CALL SAY("YOU FIT THE CRANK TO THE WINDLASS AND WIND. THE BUCKET COMES UP WITH AN ANTENNA!")
5700       CALL SOUND_(8)
5710     ELSE
5720       CALL SAY("THE WINDLASS HAS NO CRANK. THE BUCKET IS STUCK DEEP IN THE WELL.")
5730     END IF
5740     END IF
5750   END IF
5760   IF A=15 THEN
5770     IF KEYTAKEN THEN
5780       CALL SAY("A CROOKED FLOWERPOT WITH A WITHERED PLANT.")
5790     ELSE
5800       KEYTAKEN=-1
5810       TXN(OPOT)=85:CALL SHOWTHING(OPOT)
5820       CALL REVEAL(IKEY)
5830       CALL SAY("YOU LIFT THE CROOKED POT: A SPARE KEY LIES UNDER IT.")
5840       CALL SOUND_(5)
5850     END IF
5860   END IF
5870   IF A=16 THEN
5880     IF TBOXOP THEN
5890       CALL SAY("THE TOOLBOX IS EMPTY NOW.")
5900     ELSE
5910       TBOXOP=-1
5920       CALL REVEAL(ICRANK):CALL REVEAL(ISCREW)
5930       CALL SAY("YOU OPEN THE TOOLBOX: A CRANK HANDLE AND A SCREWDRIVER WITH A FOUR-POINTED TIP.")
5940       CALL SOUND_(5)
5950     END IF
5960   END IF
