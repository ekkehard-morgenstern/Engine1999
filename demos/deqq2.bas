3660 ' ------------------------------------------------------------------------------------------------ doors, the cellar's light, timers
3670 PROC DOORS(DT)
3680   LOCAL I,G
3690   FOR I=1 TO 4
3700     IF DOP(I) THEN G=100 ELSE G=0
3710     IF DCUR(I)<G THEN DCUR(I)=MIN(G,DCUR(I)+90*DT)
3720     IF DCUR(I)>G THEN DCUR(I)=MAX(G,DCUR(I)-90*DT)
3730     W3D HEIGHT DSEC(I),0,DCUR(I)
3740   NEXT I
3750 END PROC
3760 PROC LANTERNLIGHT
3770   LOCAL L,S
3780   L=FN HAS(ILANT)
3790   IF L=LANTON THEN EXIT PROC
3800   LANTON=L
3810   FOR S=34 TO 38
3820     IF L THEN W3D LIGHT S,170 ELSE W3D LIGHT S,90
3830   NEXT S
3840   FOR S=39 TO 45
3850     IF S=39 OR S=45 THEN
3860       IF L THEN W3D LIGHT S,185 ELSE W3D LIGHT S,45
3870     END IF
3880   NEXT S
3890 END PROC
3900 ' things that happen after a while: the oven cools down, the compass comes out of the melting ice
3910 PROC TIMERS
3920   IF OVENT>0 AND OVENCOOL=0 AND GT>=OVENT+30 THEN
3930     OVENCOOL=-1
3940     TXN(OOVEN)=65:CALL SHOWTHING(OOVEN)
3950     CALL SAY("THE OVEN HAS COOLED DOWN. YOU CAN OPEN IT NOW.")
