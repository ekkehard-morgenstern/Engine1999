2760 ' the sprites: DATA n,w,h then commands t,a,b,c,d,hue,shade (see demos/levels/deqq2art.py) up to a 0; the table ends with -1
2770 PROC MAKESPRITES
2780   LOCAL N,W,H,T,A,B,C,D,HU,SH,K
2790   RESTORE ARTDATA
2800   READ N
2810   WHILE N>=0
2820     READ W,H
2830     GFX CLEAR 0
2840     READ T
2850     WHILE T>0
2860       READ A,B,C,D,HU,SH
2870       K=FN CI(HU,SH)
2880       IF T=1 THEN GFX LINE A,B,C,D,K,BF
2890       IF T=2 THEN GFX LINE A,B,C,D,K,B
2900       IF T=3 THEN GFX LINE A,B,C,D,K
2910       IF T=4 THEN
2920         GFX CIRCLE A,B,C,K,-1,-1,D/10
2930         GFX PAINT A,B,K,K
2940       END IF
2950       IF T=5 THEN GFX PSET A,B,K
2960       READ T
2970     WEND
2980     CALL W3K_GRAB(N,W,H)
2990     READ N
3000   WEND
3010   GFX CLEAR 0
3020   CALL W3K_GRAB(99,4,4)
3030 END PROC
3040 PROC LOADLEVEL
3050   LOCAL NS,I,S,F,C,FT,CT,L,TG,NW,J,X1,Y1,X2,Y2,T,NX,FL,UP,LO,XO,YO
3060   RESTORE LEVELDATA
3070   READ NS
3080   FOR I=1 TO NS
3090     READ S,F,C,FT,CT,L,TG,NW
3100     W3D SECTOR S,F,C,FT,CT,L
3110     W3D TAG S,TG
3120     FOR J=0 TO NW-1
3130       READ X1,Y1,X2,Y2,T,NX,FL,UP,LO,XO,YO
3140       W3D WALL S,X1,Y1,X2,Y2,T,NX
3150       IF UP>=0 OR LO>=0 THEN W3D WALLTEX S,J,-1,UP,LO
3160       IF FL<>0 THEN W3D WALLFLAG S,J,FL
3170       IF XO<>0 OR YO<>0 THEN W3D WALLOFF S,J,XO,YO
3180     NEXT J
3190   NEXT I
3200 END PROC
