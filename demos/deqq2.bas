300 END FUNC
310 FUNC RI(M)
320   RETURN INT(RND(1)*M)
330 END FUNC
340 ' the angle difference of two directions (radians): 0 .. pi
350 FUNC ADIFF(A,B)
360   LOCAL D
370   D=A-B
380   D=D-INT(D/6.283185307)*6.283185307
390   IF D>3.141592654 THEN D=6.283185307-D
400   RETURN D
410 END FUNC
420 ' ------------------------------------------------------------------------------------------------ messages
430 ' SAY shows a line of at most two rows at the top of the picture for a few seconds (the headless test prints them)
440 PROC SAY(T$)
450   LOCAL I,K
460   IF HL THEN
470     PRINT "> ";T$
480     EXIT PROC
490   END IF
500   MSG1$=T$:MSG2$=""
510   IF LEN(T$)>76 THEN
520     K=76
530     FOR I=76 TO 40 STEP -1
540       IF MID$(T$,I,1)=" " AND K=76 THEN K=I
550     NEXT I
560     MSG1$=LEFT$(T$,K-1):MSG2$=MID$(T$,K+1)
570   END IF
580   MSGT=4.5
590 END PROC
600 PROC SOUND_(N)
610   IF NOT HL THEN SFX N
620 END PROC
630 ' ------------------------------------------------------------------------------------------------ things and what you carry
640 PROC PLACEALL
650   LOCAL N,X,Y,T,W,H,ZO,LT,K,SLT,A,R,SH,LV,NA$
660   FOR N=0 TO 199
670     KD(N)=0
680     W3D THINGOFF N
690   NEXT N
700   NIL=0
710   RESTORE OBJDATA
720   READ N
730   WHILE N>=0
740     READ X,Y,T,W,H,ZO,LT,K,SLT,A,R,SH,LV,NA$
750     KD(N)=K:SL(N)=SLT:HX(N)=X:HY(N)=Y:TXN(N)=T:TWD(N)=W:THT(N)=H:TZO(N)=ZO:TLT(N)=LT:ACT(N)=A:RCH(N)=R:NMS$(N)=NA$
760     TLZ(N)=1:IF LV=1 THEN TLZ(N)=120
770     IF LV=2 THEN TLZ(N)=230
780     IF LV=-1 THEN TLZ(N)=-60
790     IF K>0 THEN
800       IL(NIL)=N
810       NIL=NIL+1
820     END IF
830     IF SH THEN CALL SHOWTHING(N)
840     READ N
850   WEND
860   CALL TOWNTHINGS
870 END PROC
880 ' trees and lamp posts of the town (things 300 ..): lamps along both edges of the ring road, trees on the strips of grass between the road and the first row of houses
890 PROC TT(N,X,Y,TX,W,H)
900   W3D THING N,X,Y,TX,W,H,W3D("SECTORZ",X,Y,1)
910 END PROC
920 PROC TOWNTHINGS
930   LOCAL N,X,Y,K
940   N=300
950   FOR X=-500 TO 1600 STEP 280
960     CALL TT(N,X,-70,91,24,56):CALL TT(N+1,X+140,-212,91,24,56)
970     CALL TT(N+2,X,1587,91,24,56):CALL TT(N+3,X+140,1733,91,24,56)
980     N=N+4
990   NEXT X
1000   FOR Y=0 TO 1500 STEP 280
1010     CALL TT(N,-450,Y,91,24,56):CALL TT(N+1,-590,Y+140,91,24,56)
1020     CALL TT(N+2,1535,Y+140,91,24,56):CALL TT(N+3,1685,Y,91,24,56)
1030     N=N+4
1040   NEXT Y
1050   FOR X=-1500 TO 2500 STEP 130
1060     CALL TT(N,X+INT(RND(1)*60),-290+INT(RND(1)*40),61,66,100)
1070     CALL TT(N+1,X+INT(RND(1)*60),1770+INT(RND(1)*40),61,66,100)
1080     N=N+2
1090   NEXT X
1100   FOR Y=-100 TO 1700 STEP 130
1110     CALL TT(N,-680+INT(RND(1)*50),Y,61,66,100)
1120     CALL TT(N+1,1730+INT(RND(1)*50),Y,61,66,100)
1130     N=N+2
1140   NEXT Y
1150 END PROC
1160 ' puts thing N in the world at its place (its home place, or X,Y if they are given: CALL SHOWAT)
1170 PROC SHOWTHING(N)
1180   W3D THING N,HX(N),HY(N),TXN(N),TWD(N),THT(N),W3D("SECTORZ",HX(N),HY(N),TLZ(N))
1190   IF TZO(N)<>0 THEN W3D THINGZ N,TZO(N)
1200   IF TLT(N)>=0 THEN W3D THINGLIGHT N,TLT(N)
1210 END PROC
1220 PROC SHOWAT(N,X,Y)
1230   W3D THING N,X,Y,TXN(N),TWD(N),THT(N),W3D("SECTORZ",X,Y,AZ)
1240   AZ=1
1250   IF TZO(N)<>0 THEN W3D THINGZ N,TZO(N)
1260   IF TLT(N)>=0 THEN W3D THINGLIGHT N,TLT(N)
1270 END PROC
1280 ' a thing appears where it lies hidden (it is a new home for it)
1290 PROC REVEAL(N)
1300   CALL SHOWTHING(N)
1310 END PROC
1320 FUNC SLOTSUSED(X)
1330   LOCAL I,S
1340   S=0
1350   FOR I=0 TO 2
1360     IF INV(I)>=0 THEN S=S+SL(INV(I))
1370   NEXT I
1380   RETURN S
1390 END FUNC
1400 FUNC HAS(N)
1410   LOCAL I,R
1420   R=0
1430   FOR I=0 TO 2
1440     IF INV(I)=N THEN R=-1
1450   NEXT I
1460   RETURN R
1470 END FUNC
1480 PROC TAKE(N)
1490   LOCAL I,F
1500   IF FN SLOTSUSED(0)+SL(N)>3 THEN
1510     CALL SAY("YOU CAN CARRY THREE PLACES OF THINGS. PUT SOMETHING DOWN FIRST (G).")
1520     CALL SOUND_(6)
1530     EXIT PROC
1540   END IF
1550   F=-1
1560   FOR I=2 TO 0 STEP -1
1570     IF INV(I)<0 THEN F=I
1580   NEXT I
1590   INV(F)=N
1600   W3D THINGOFF N
1610   CALL SAY("YOU TAKE THE "+NMS$(N)+".")
1620   CALL SOUND_(1)
1630 END PROC
1640 ' removes N from what you carry (used up or built in); the thing stays hidden
1650 PROC USEUP(N)
1660   LOCAL I
1670   FOR I=0 TO 2
1680     IF INV(I)=N THEN INV(I)=-1
1690   NEXT I
1700 END PROC
1710 PROC DROPLAST
1720   LOCAL I,N,X,Y,F,A
1730   N=-1
1740   FOR I=0 TO 2
1750     IF INV(I)>=0 THEN N=INV(I):F=I
1760   NEXT I
1770   IF N<0 THEN
1780     CALL SAY("YOU CARRY NOTHING.")
1790     EXIT PROC
1800   END IF
1810   A=W3D("ANGLE")*3.141592654/180
1820   X=PX+COS(A)*34:Y=PY+SIN(A)*34
1830   IF W3D("SECTORAT",X,Y)<0 OR W3D("TAG",W3D("SECTORAT",X,Y))=50 THEN X=PX:Y=PY
1840   IF W3D("SECTORAT",X,Y)<0 THEN EXIT PROC
1850   INV(F)=-1
1860   AZ=W3D("FLOORZ")+1
1870   CALL SHOWAT(N,X,Y)
1880   CALL SAY("YOU PUT DOWN THE "+NMS$(N)+".")
1890 END PROC
1900 ' the nearest thing that you can use in front of you (within its reach, in view); -1 if there is none
1910 FUNC TARGET(X)
1920   LOCAL I,N,B,D,BEST,BD
1930   BEST=-1:BD=1000
1940   FOR I=0 TO NIL-1
1950     N=IL(I)
1960     IF W3D("TON",N) THEN
1970       D=W3D("DIST",N)
1980       IF D<RCH(N) AND D<BD THEN
1990         B=ABS(W3D("BEARING",N))
2000         IF B<40 OR D<30 THEN
2010           IF W3D("SEES",N) THEN
2020             BEST=N:BD=D
2030           END IF
2040         END IF
2050       END IF
2060     END IF
2070   NEXT I
2080   RETURN BEST
2090 END FUNC
2100 ' ------------------------------------------------------------------------------------------------ the safe's dial
2110 FUNC DIAL(X)
2120   LOCAL SEL,OK,CN,LOK,LCN,LU,LD,LL,LR,U,D,L,R,DONE,RES,I,C
2130   IF HL THEN
2140     RES=(DIALIN$="731")
2150     DIALIN$=""
2160     RETURN RES
2170   END IF
2180   DG(0)=0:DG(1)=0:DG(2)=0:SEL=0:DONE=0:RES=0
2190   WHILE INKEY$<>""
2200   WEND
2210   LOK=-1:LCN=-1:LU=-1:LD=-1:LL=-1:LR=-1
2220   REPEAT
2230     W3D RENDER
2240     GFX LINE 200,70,439,190,FN CI(0,1),BF
2250     GFX LINE 200,70,439,190,FN CI(0,9),B
2260     GFX LINE 201,71,438,189,FN CI(0,5),B
2270     CALL CTEXT(78,"THE SAFE",FN CI(3,15))
2280     CALL CTEXT(94,"THREE DIGITS: UP/DOWN CHANGE, LEFT/RIGHT CHOOSE",FN CI(0,10))
2290     FOR I=0 TO 2
2300       IF I=SEL THEN C=FN CI(3,15) ELSE C=FN CI(0,11)
2310       GFX LINE 240+I*60,112,279+I*60,160,FN CI(0,3),BF
2320       GFX LINE 240+I*60,112,279+I*60,160,C,B
2330       GFX TEXT 250+I*60,122,STR$(DG(I)),C,3,3
2340     NEXT I
2350     CALL CTEXT(168,"RETURN: TRY    ESC: LEAVE",FN CI(0,10))
2360     IF DIALMSG>0 THEN
2370       CALL CTEXT(180,"NOTHING HAPPENS.",FN CI(1,13))
2380       DIALMSG=DIALMSG-1
2390     END IF
2400     CALL W3K_SHOW
2410     U=KEY("UP") OR KEY("W") OR JOY("UP"):D=KEY("DOWN") OR KEY("S") OR JOY("DOWN")
2420     L=KEY("LEFT") OR KEY("A") OR JOY("LEFT"):R=KEY("RIGHT") OR KEY("D") OR JOY("RIGHT")
2430     OK=KEY("RETURN") OR KEY("E") OR JOY("A") OR JOY("X"):CN=KEY("ESC") OR JOY("B") OR JOY("BACK")
2440     IF U<>0 AND LU=0 THEN DG(SEL)=(DG(SEL)+1) MOD 10
2450     IF D<>0 AND LD=0 THEN DG(SEL)=(DG(SEL)+9) MOD 10
2460     IF L<>0 AND LL=0 THEN SEL=(SEL+2) MOD 3
2470     IF R<>0 AND LR=0 THEN SEL=(SEL+1) MOD 3
2480     IF OK<>0 AND LOK=0 THEN
2490       IF DG(0)=7 AND DG(1)=3 AND DG(2)=1 THEN
2500         RES=-1:DONE=-1
2510       ELSE
2520         DIALMSG=40
2530         CALL SOUND_(6)
2540       END IF
2550     END IF
2560     IF CN<>0 AND LCN=0 THEN DONE=-1
2570     LU=U:LD=D:LL=L:LR=R:LOK=OK:LCN=CN
2580   UNTIL DONE
2590   WHILE KEY("RETURN") OR KEY("E") OR KEY("ESC")
2600     FRAME
2610   WEND
2620   WHILE INKEY$<>""
2630   WEND
2640   W3K_T0=TI
2650   RETURN RES
2660 END FUNC
2670 FUNC BITS(M)
2680   LOCAL K,N
2690   N=0
2700   FOR K=0 TO 7
2710     IF (M\(2^K)) AND 1 THEN N=N+1
2720   NEXT K
2730   RETURN N
2740 END FUNC
