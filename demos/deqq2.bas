6980 ' ------------------------------------------------------------------------------------------------ Deqq
6990 PROC DQMOVE(DX,DY,SP,TF)
7000   W3D THINGMOVE IDEQQ,DX*SP,DY*SP
7010   DQANG=ATAN2(DY,DX)
7020   W3D THINGTEX IDEQQ,TF
7030 END PROC
7040 FUNC NEARWP(X,Y)
7050   LOCAL I,B,D,R,LO,HI
7060   IF DQAWAY THEN LO=50:HI=TWEND ELSE LO=0:HI=48
7070   R=LO:B=1.0E9
7080   FOR I=LO TO HI
7090     D=(WPX(I)-X)^2+(WPY(I)-Y)^2
7100     IF D<B THEN B=D:R=I
7110   NEXT I
7120   RETURN R
7130 END FUNC
7140 PROC CAUGHT
7150   LOCAL I,N,OUT
7160   OUT=NOT (PX>=180 AND PX<=840 AND PY>=300 AND PY<=730) AND NOT (PX<-400 AND PY>=330 AND PY<=650)
7170   CAUGHTN=CAUGHTN+1
7180   MU_AF=2
7190   CALL MU_FORCE(5)
7200   CALL SOUND_(4)
7210   IF OUT THEN
7220     CALL BANNER("DEQQ HAS CAUGHT YOU","HE MARCHES YOU TO THE GATE AND THROWS YOU OUT OF HIS GARDEN. THE GATE SLAMS SHUT.",2.5)
7230   ELSE
7240     CALL BANNER("DEQQ HAS CAUGHT YOU","HE CARRIES YOU OUT OF THE HOUSE AND PUTS YOU DOWN IN THE GARDEN.",2.5)
7250   END IF
7260   FOR I=0 TO 2
7270     N=INV(I)
7280     IF N>=0 THEN
7290       INV(I)=-1
7300       CALL SHOWTHING(N)
7310     END IF
7320   NEXT I
7330   IF OUT THEN
7340     W3D CAMERA 480,-35,270,0,0,W3D("SECTORZ",480,-35,1)
7350     GATET=GT+25:W3D HEIGHT GATESEC,80,300
7360   ELSE
7370     W3D CAMERA 480,150,90,0,0
7380   END IF
7390   W3D LIFT 0
7400   W3K_VZ=0
7410   DQS=0:DQLOST=0
7420   AZ=1
7430   IF OUT THEN
7440     CALL SHOWAT(IDEQQ,480,50)
7450     DQWP=FN NEARWP(480,50)
7460   ELSE
7470     DQWP=5
7480     CALL SHOWAT(IDEQQ,WPX(4),WPY(4))
7490   END IF
7500   W3D THINGTEX IDEQQ,40
7510   DQCD=GT+8
7520   CALL SAY("WHAT YOU CARRIED IS BACK WHERE YOU FOUND IT. THE PARTS BUILT IN STAY.")
7530 END PROC
7540 ' the next way point: the round of the house is 0 .. 48, the walk through the town 50 .. TWEND (out of the gate, once round the block, back in);
7550 ' when his time at home is up (DQLEAVE) the round ends at the front garden (46) and the town walk begins; the town walk ends in the garden: home again
7560 FUNC NEXTWP(I)
7570   LOCAL R
7580   R=I+1
7590   IF I<=48 THEN
7600     IF R>48 THEN R=0
7610     IF I=46 AND DQLEAVE THEN DQAWAY=-1:DQLEAVE=0:R=50
7620   ELSE
7630     IF R=71 AND PY>-30 THEN
7640       CALL SAY("THE GATE CREAKS: DEQQ IS COMING HOME!")
7650       CALL SOUND_(3)
7660     END IF
7670     IF I>=TWEND THEN DQAWAY=0:DQLEAVE=0:DQHT=GT+60+INT(RND(1)*60):R=0
7680   END IF
7690   RETURN R
7700 END FUNC
7710 PROC DEQQAI(DT)
7720   LOCAL DXP,DYP,D,SEEN,LIM,BA,TX,TY,L,DX,DY,F,HID
7730   DXP=W3D("TX",IDEQQ):DYP=W3D("TY",IDEQQ)
7740   D=W3D("DIST",IDEQQ)
7750   HID=(W3D("TAG",W3D("SECTOR"))=50)
7760   SEEN=0
7770   IF GT>=DQCD THEN
7780     LIM=430
7790     IF HID THEN LIM=55
7800     IF D<LIM THEN
7810       BA=ATAN2(PY-DYP,PX-DXP)
7820       IF D<95 OR FN ADIFF(BA,DQANG)<0.95 THEN
7830         IF W3D("SEES",IDEQQ) THEN SEEN=-1
7840       END IF
7850     END IF
7860   END IF
7870   IF DYP<0 OR W3D("SECTOR")>=400 THEN SEEN=0
7880   IF NOT DQAWAY AND NOT DQLEAVE AND GT>=DQHT THEN DQLEAVE=-1
7890   F=40+(INT(GT*4) AND 1)
7900    IF DQS=2 AND W3D("SECTOR")>=400 THEN
7910      DQS=0:DQWP=FN NEARWP(DXP,DYP)
7920      CALL SAY("DEQQ STOPS AT THE FENCE AND SHAKES HIS FIST AT YOU.")
7930      W3D THINGTEX IDEQQ,40
7940    END IF
7950    IF DQS=2 THEN
7960     IF SEEN THEN DQLOST=0 ELSE DQLOST=DQLOST+DT
7970     IF DQLOST>3.5 THEN
7980       DQS=0:DQWP=FN NEARWP(DXP,DYP)
7990       CALL SAY("DEQQ MUTTERS, LOSES YOUR TRACK AND GOES BACK TO HIS ROUND.")
8000       W3D THINGTEX IDEQQ,40
8010     ELSE
8020       IF D>1 THEN CALL DQMOVE((PX-DXP)/D,(PY-DYP)/D,108*DT,42)
8030       IF D<46 AND W3D("SEES",IDEQQ) AND GT>=DQCD THEN CALL CAUGHT
8040     END IF
8050   ELSE
8060     IF SEEN THEN
8070       DQS=2:DQLOST=0
8080       CALL SOUND_(3)
8090       CALL SAY("DEQQ HAS SEEN YOU! RUN, SHUT A DOOR, OR HIDE!")
8100       W3D THINGTEX IDEQQ,42
8110     ELSE
8120      IF DQS=1 THEN
8130       W3D THINGTEX IDEQQ,40
8140       IF GT>=DQPT THEN
8150         DQS=0:DQWP=FN NEXTWP(DQWP)
8160       END IF
8170     ELSE
8180       TX=WPX(DQWP):TY=WPY(DQWP)
8190       DX=TX-DXP:DY=TY-DYP:L=SQR(DX*DX+DY*DY)
8200       IF L<22 THEN
8210         IF WPP(DQWP)>0 THEN
8220           DQS=1:DQPT=GT+WPP(DQWP)
8230         ELSE
8240           DQWP=FN NEXTWP(DQWP)
8250         END IF
8260       ELSE
8270         CALL DQMOVE(DX/L,DY/L,62*DT,F)
8280         IF W3D("HIT") AND 2 THEN DQSTUCK=DQSTUCK+DT ELSE DQSTUCK=0
8290         IF DQSTUCK>1.5 THEN
8300           DQSTUCK=0:DQWP=FN NEXTWP(DQWP)
8310         END IF
8320       END IF
8330     END IF
8340     END IF
8350   END IF
8360   IF DQS<>1 AND D<420 AND GT>=DQFT THEN
8370     CALL SOUND_(2)
8380     DQFT=GT+0.55
8390     IF NOT SEEN AND GT>=DQHEARD AND DQS=0 THEN
8400       CALL SAY("HEAVY FOOTSTEPS. DEQQ IS SOMEWHERE NEAR.")
8410       DQHEARD=GT+30
8420     END IF
8430   END IF
8440 END PROC
