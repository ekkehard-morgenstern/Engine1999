3230   FOR I=1 TO NS
3240     READ S,F,C,FT,CT,L,TG,NW
3250     W3D SECTOR S,F,C,FT,CT,L
3260     W3D TAG S,TG
3270     FOR J=0 TO NW-1
3280       READ X1,Y1,X2,Y2,T,NX,FL,UP,LO,XO,YO
3290       W3D WALL S,X1,Y1,X2,Y2,T,NX
3300       IF UP>=0 OR LO>=0 THEN W3D WALLTEX S,J,-1,UP,LO
3310       IF FL<>0 THEN W3D WALLFLAG S,J,FL
3320       IF XO<>0 OR YO<>0 THEN W3D WALLOFF S,J,XO,YO
3330     NEXT J
3340   NEXT I
3350 END PROC
