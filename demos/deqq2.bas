5210     END IF
5220   END IF
5230   IF A=11 THEN
5240     IF PLATEOUT THEN
5250       CALL SAY("JUST A DULL PANEL IS LEFT, WITH FOUR HOLES.")
5260     ELSE
5270      IF FN HAS(ISCREW) THEN
5280       SCREWS=SCREWS+1
5290       CALL SOUND_(8)
