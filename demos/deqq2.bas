10 ' DEQQ'S HOUSE II - a real-time 3D adventure for Engine1999, made with the software 3D sector renderer (W3D ...).
20 ' The sequel of the text adventure deqq.bas: Deqq, an alien, crash-landed and lives in an abandoned house. Eight parts of his spaceship are hidden in the house, the
30 ' garden, the shed and the cellar, each behind a small puzzle. Find them (you can carry three things, the big parts and the chair take two places), carry them to the
40 ' wreck at the end of the back yard and build them in. But Deqq is home, and he walks through the house on his round: if he sees you he follows you and carries
50 ' you out of the front door, and what you carried goes back where you found it (the parts already built in stay). Hide in the coat closet, the pantry, behind the
60 ' sofa, in the wardrobe, behind the shower curtain, between the barrels or in the trunk, close doors in his face, run (SHIFT) and listen for his footsteps.
70 ' Nobody is hurt in this game.
80 ' Keys: arrows or WASD walk and turn (A and D slide sideways), SHIFT runs, SPACE jumps, R and F look up and down (HOME looks straight), E or RETURN uses or takes what is
90 ' in front of you (the prompt at the bottom says what), G puts down the last thing you carry, O opens the 3D settings (invert axes, gamma, field of view, turning
100 ' speed; kept for next time), P pauses, Q or ESC quits. Game controller: left stick walks, right stick turns and looks, LT runs, A jumps, X uses and takes, B puts
110 ' down, Y the settings, START pauses, BACK quits. The built parts are saved (the file deqq2.sav of the folder ~/.local/share/<name>/).
120 ' How it is made: the house is DATA (rectangular sectors, walls and portals: demos/levels/deqq2.py), the pictures are drawn by GFX statements from a table of
130 ' drawing commands (demos/levels/deqq2art.py) and grabbed into W3D TEXTURE, everything you can touch is a thing (W3D THING) that W3D("DIST"), ("BEARING") and ("SEES")
140 ' find; Deqq walks with W3D THINGMOVE along a route of way points and sees you with W3D("SEES", 0). The whole game logic also runs in the console host without a
150 ' picture, for the test deqq2test.sh: environment DEQQ2_HEADLESS=1 and DEQQ2_PLAY=file (commands; see PLAYBACK).
160 LOAD LIBRARY "w3dkit"
170 LOAD LIBRARY "input"
180 LOAD LIBRARY "text"
190 LOAD LIBRARY "prefs3d"
200 BREAK OFF
210 ON ERROR GOTO FAILED
220 DIM KD(200),SL(200),HX(200),HY(200),TXN(200),TWD(200),THT(200),TZO(200),TLT(200),ACT(200),RCH(200),NMS$(200),IL(100),PARTNO(200),DESC$(200),DG(3),W$(8)
230 DIM INV(3),BUILT(9),DSEC(5),DOP(5),DLK(5),DCUR(5),WPX(60),WPY(60),WPP(60),NM$(30),CMT$(12)
240 GOTO MAIN
250 ' ------------------------------------------------------------------------------------------------ small helpers
260 FUNC CI(H,S)
270   RETURN 16+H*16+S
280 END FUNC
290 FUNC RI(M)
300   RETURN INT(RND(1)*M)
310 END FUNC
320 ' the angle difference of two directions (radians): 0 .. pi
330 FUNC ADIFF(A,B)
340   LOCAL D
350   D=A-B
360   D=D-INT(D/6.283185307)*6.283185307
370   IF D>3.141592654 THEN D=6.283185307-D
380   RETURN D
390 END FUNC
400 ' ------------------------------------------------------------------------------------------------ messages
410 ' SAY shows a line of at most two rows at the top of the picture for a few seconds (the headless test prints them)
420 PROC SAY(T$)
430   LOCAL I,K
440   IF HL THEN
450     PRINT "> ";T$
460     EXIT PROC
470   END IF
480   MSG1$=T$:MSG2$=""
490   IF LEN(T$)>76 THEN
500     K=76
510     FOR I=76 TO 40 STEP -1
520       IF MID$(T$,I,1)=" " AND K=76 THEN K=I
530     NEXT I
540     MSG1$=LEFT$(T$,K-1):MSG2$=MID$(T$,K+1)
550   END IF
560   MSGT=4.5
570 END PROC
580 PROC SOUND_(N)
590   IF NOT HL THEN SFX N
600 END PROC
610 ' ------------------------------------------------------------------------------------------------ things and what you carry
620 PROC PLACEALL
630   LOCAL N,X,Y,T,W,H,ZO,LT,K,SLT,A,R,SH,NA$
640   FOR N=0 TO 199
650     KD(N)=0
660     W3D THINGOFF N
670   NEXT N
680   NIL=0
690   RESTORE OBJDATA
700   READ N
710   WHILE N>=0
720     READ X,Y,T,W,H,ZO,LT,K,SLT,A,R,SH,NA$
730     KD(N)=K:SL(N)=SLT:HX(N)=X:HY(N)=Y:TXN(N)=T:TWD(N)=W:THT(N)=H:TZO(N)=ZO:TLT(N)=LT:ACT(N)=A:RCH(N)=R:NMS$(N)=NA$
740     IF K>0 THEN
750       IL(NIL)=N
760       NIL=NIL+1
770     END IF
780     IF SH THEN CALL SHOWTHING(N)
790     READ N
800   WEND
810 END PROC
820 ' puts thing N in the world at its place (its home place, or X,Y if they are given: CALL SHOWAT)
830 PROC SHOWTHING(N)
840   W3D THING N,HX(N),HY(N),TXN(N),TWD(N),THT(N)
850   IF TZO(N)<>0 THEN W3D THINGZ N,TZO(N)
860   IF TLT(N)>=0 THEN W3D THINGLIGHT N,TLT(N)
870 END PROC
880 PROC SHOWAT(N,X,Y)
890   W3D THING N,X,Y,TXN(N),TWD(N),THT(N)
900   IF TZO(N)<>0 THEN W3D THINGZ N,TZO(N)
910   IF TLT(N)>=0 THEN W3D THINGLIGHT N,TLT(N)
920 END PROC
930 ' a thing appears where it lies hidden (it is a new home for it)
940 PROC REVEAL(N)
950   CALL SHOWTHING(N)
960 END PROC
970 FUNC SLOTSUSED(X)
980   LOCAL I,S
990   S=0
1000   FOR I=0 TO 2
1010     IF INV(I)>=0 THEN S=S+SL(INV(I))
1020   NEXT I
1030   RETURN S
1040 END FUNC
1050 FUNC HAS(N)
1060   LOCAL I,R
1070   R=0
1080   FOR I=0 TO 2
1090     IF INV(I)=N THEN R=-1
1100   NEXT I
1110   RETURN R
1120 END FUNC
1130 PROC TAKE(N)
1140   LOCAL I,F
1150   IF FN SLOTSUSED(0)+SL(N)>3 THEN
1160     CALL SAY("YOU CAN CARRY THREE PLACES OF THINGS. PUT SOMETHING DOWN FIRST (G).")
1170     CALL SOUND_(6)
1180     EXIT PROC
1190   END IF
1200   F=-1
1210   FOR I=2 TO 0 STEP -1
1220     IF INV(I)<0 THEN F=I
1230   NEXT I
1240   INV(F)=N
1250   W3D THINGOFF N
1260   CALL SAY("YOU TAKE THE "+NMS$(N)+".")
1270   CALL SOUND_(1)
1280 END PROC
1290 ' removes N from what you carry (used up or built in); the thing stays hidden
1300 PROC USEUP(N)
1310   LOCAL I
1320   FOR I=0 TO 2
1330     IF INV(I)=N THEN INV(I)=-1
1340   NEXT I
1350 END PROC
1360 PROC DROPLAST
1370   LOCAL I,N,X,Y,F,A
1380   N=-1
1390   FOR I=0 TO 2
1400     IF INV(I)>=0 THEN N=INV(I):F=I
1410   NEXT I
1420   IF N<0 THEN
1430     CALL SAY("YOU CARRY NOTHING.")
1440     EXIT PROC
1450   END IF
1460   A=W3D("ANGLE")*3.141592654/180
1470   X=PX+COS(A)*34:Y=PY+SIN(A)*34
1480   IF W3D("SECTORAT",X,Y)<0 OR W3D("TAG",W3D("SECTORAT",X,Y))=50 THEN X=PX:Y=PY
1490   IF W3D("SECTORAT",X,Y)<0 THEN EXIT PROC
1500   INV(F)=-1
1510   CALL SHOWAT(N,X,Y)
1520   CALL SAY("YOU PUT DOWN THE "+NMS$(N)+".")
1530 END PROC
1540 ' the nearest thing that you can use in front of you (within its reach, in view); -1 if there is none
1550 FUNC TARGET(X)
1560   LOCAL I,N,B,D,BEST,BD
1570   BEST=-1:BD=1000
1580   FOR I=0 TO NIL-1
1590     N=IL(I)
1600     IF W3D("TON",N) THEN
1610       D=W3D("DIST",N)
1620       IF D<RCH(N) AND D<BD THEN
1630         B=ABS(W3D("BEARING",N))
1640         IF B<40 OR D<30 THEN
1650           IF W3D("SEES",N) THEN
1660             BEST=N:BD=D
1670           END IF
1680         END IF
1690       END IF
1700     END IF
1710   NEXT I
1720   RETURN BEST
1730 END FUNC
1740 ' ------------------------------------------------------------------------------------------------ the safe's dial
1750 FUNC DIAL(X)
1760   LOCAL SEL,OK,CN,LOK,LCN,LU,LD,LL,LR,U,D,L,R,DONE,RES,I,C
1770   IF HL THEN
1780     RES=(DIALIN$="731")
1790     DIALIN$=""
1800     RETURN RES
1810   END IF
1820   DG(0)=0:DG(1)=0:DG(2)=0:SEL=0:DONE=0:RES=0
1830   WHILE INKEY$<>""
1840   WEND
1850   LOK=-1:LCN=-1:LU=-1:LD=-1:LL=-1:LR=-1
1860   REPEAT
1870     W3D RENDER
1880     GFX LINE 200,70,439,190,FN CI(0,1),BF
1890     GFX LINE 200,70,439,190,FN CI(0,9),B
1900     GFX LINE 201,71,438,189,FN CI(0,5),B
1910     CALL CTEXT(78,"THE SAFE",FN CI(3,15))
1920     CALL CTEXT(94,"THREE DIGITS: UP/DOWN CHANGE, LEFT/RIGHT CHOOSE",FN CI(0,10))
1930     FOR I=0 TO 2
1940       IF I=SEL THEN C=FN CI(3,15) ELSE C=FN CI(0,11)
1950       GFX LINE 240+I*60,112,279+I*60,160,FN CI(0,3),BF
1960       GFX LINE 240+I*60,112,279+I*60,160,C,B
1970       GFX TEXT 250+I*60,122,STR$(DG(I)),C,3,3
1980     NEXT I
1990     CALL CTEXT(168,"RETURN: TRY    ESC: LEAVE",FN CI(0,10))
2000     IF DIALMSG>0 THEN
2010       CALL CTEXT(180,"NOTHING HAPPENS.",FN CI(1,13))
2020       DIALMSG=DIALMSG-1
2030     END IF
2040     CALL W3K_SHOW
2050     U=KEY("UP") OR KEY("W") OR JOY("UP"):D=KEY("DOWN") OR KEY("S") OR JOY("DOWN")
2060     L=KEY("LEFT") OR KEY("A") OR JOY("LEFT"):R=KEY("RIGHT") OR KEY("D") OR JOY("RIGHT")
2070     OK=KEY("RETURN") OR KEY("E") OR JOY("A") OR JOY("X"):CN=KEY("ESC") OR JOY("B") OR JOY("BACK")
2080     IF U<>0 AND LU=0 THEN DG(SEL)=(DG(SEL)+1) MOD 10
2090     IF D<>0 AND LD=0 THEN DG(SEL)=(DG(SEL)+9) MOD 10
2100     IF L<>0 AND LL=0 THEN SEL=(SEL+2) MOD 3
2110     IF R<>0 AND LR=0 THEN SEL=(SEL+1) MOD 3
2120     IF OK<>0 AND LOK=0 THEN
2130       IF DG(0)=7 AND DG(1)=3 AND DG(2)=1 THEN
2140         RES=-1:DONE=-1
2150       ELSE
2160         DIALMSG=40
2170         CALL SOUND_(6)
2180       END IF
2190     END IF
2200     IF CN<>0 AND LCN=0 THEN DONE=-1
2210     LU=U:LD=D:LL=L:LR=R:LOK=OK:LCN=CN
2220   UNTIL DONE
2230   WHILE KEY("RETURN") OR KEY("E") OR KEY("ESC")
2240     FRAME
2250   WEND
2260   WHILE INKEY$<>""
2270   WEND
2280   W3K_T0=TI
2290   RETURN RES
2300 END FUNC
2310 FUNC BITS(M)
2320   LOCAL K,N
2330   N=0
2340   FOR K=0 TO 7
2350     IF (M\(2^K)) AND 1 THEN N=N+1
2360   NEXT K
2370   RETURN N
2380 END FUNC
