5140     END IF
5150     END IF
5160   END IF
5170   IF A=6 THEN
5180     IF FED THEN
5190       CALL SAY("THE GLORP PURRS. IT LOOKS AT YOU WITH ENORMOUS EYES.")
5200     ELSE
5210      IF FN HAS(IJELLY) THEN
5220       CALL USEUP(IJELLY)
5230       FED=-1
5240       TXN(IGLORP)=44:HX(IGLORP)=HX(IGLORP)-60:CALL SHOWTHING(IGLORP)
5250       CALL SAY("THE GLORP EATS THE GREEN JELLY, GURGLES HAPPILY AND MOVES AWAY FROM THE NOZZLE.")
5260       CALL SOUND_(7)
5270     ELSE
5280       CALL SAY("A GLORP. IT SITS ON SOMETHING SHINY AND SNIFFS THE AIR. IT WANTS GREEN JELLY.")
5290     END IF
5300     END IF
5310   END IF
5320   IF A=8 THEN
5330     IF NOT FN HAS(ILANT) THEN
5340       CALL SAY("IT IS TOO DARK TO READ THE LABELS. YOU NEED A LIGHT.")
5350       CALL SOUND_(6)
5360     ELSE
5370      IF NOT POWEROFF THEN
5380       POWEROFF=-1
