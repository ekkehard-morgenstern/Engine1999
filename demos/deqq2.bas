37240 ' a square tube between two points (a telescope): H = half the thickness
37245 PROC TUBE(O,X1,Y1,Z1,X2,Y2,Z2,H)
37250   LOCAL AX,AY,AZ,L,PX2,PY2,PZ2,QX2,QY2,QZ2,B,I,SA,SB
37255   AX=X2-X1:AY=Y2-Y1:AZ=Z2-Z1
37260   L=SQR(AX*AX+AY*AY+AZ*AZ):AX=AX/L:AY=AY/L:AZ=AZ/L
37265   PX2=AY:PY2=-AX:PZ2=0
37270   L=SQR(PX2*PX2+PY2*PY2):PX2=PX2/L:PY2=PY2/L
37275   QX2=AY*PZ2-AZ*PY2:QY2=AZ*PX2-AX*PZ2:QZ2=AX*PY2-AY*PX2
37280   B=M3D("VERTS",O)
37285   FOR I=0 TO 7
37290     SA=1:IF (I AND 1) THEN SA=-1
37295     SB=1:IF (I AND 2) THEN SB=-1
37300     IF I<4 THEN M3D VERTEX O,X1+H*SA*PX2+H*SB*QX2,Y1+H*SA*PY2+H*SB*QY2,Z1+H*SA*PZ2+H*SB*QZ2 ELSE M3D VERTEX O,X2+H*SA*PX2+H*SB*QX2,Y2+H*SA*PY2+H*SB*QY2,Z2+H*SA*PZ2+H*SB*QZ2
37305   NEXT I
37310   M3D QUAD O,B,B+1,B+5,B+4,TUBETX
37315   M3D QUAD O,B+1,B+3,B+7,B+5,TUBETX
37320   M3D QUAD O,B+3,B+2,B+6,B+7,TUBETX
37325   M3D QUAD O,B+2,B,B+4,B+6,TUBETX
37330   M3D QUAD O,B+4,B+5,B+7,B+6,TUBETX
37335   M3D QUAD O,B,B+2,B+3,B+1,TUBETX
37340 END PROC
