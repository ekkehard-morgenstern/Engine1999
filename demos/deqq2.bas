5110         PLATEOUT=-1:TXN(OMIRROR)=77:CALL SHOWTHING(OMIRROR)
5120         CALL REVEAL(PPLATE)
5130         CALL SAY("THE LAST SCREW COMES OUT. THE MIRROR WAS A HULL PLATE!")
5140         CALL SOUND_(5)
5150       END IF
5160     ELSE
5170       CALL SAY("THE MIRROR IS NOT GLASS. FOUR SCREWS WITH FOUR-POINTED HEADS HOLD IT.")
5180     END IF
5190     END IF
5200   END IF
5210   IF A=12 THEN
5220     PHOTOSEEN=-1
5230     CALL SAY("YOU TURN THE PHOTO OVER. SCRATCHED INTO THE BACK WITH A PIN: 7 3 1.")
5240   END IF
5250   IF A=13 THEN
5260     IF SAFEOP THEN
5270       CALL SAY("THE SAFE IS OPEN AND EMPTY.")
5280     ELSE
5290      IF FN DIAL(0) THEN
5300       SAFEOP=-1:TXN(OSAFE)=75:CALL SHOWTHING(OSAFE)
5310       CALL REVEAL(PGLYPH)
5320       CALL SAY("CLICK! THE SAFE OPENS. INSIDE IS AN IGNITION GLYPH.")
5330       CALL SOUND_(5)
5340     ELSE
5350       CALL SAY("THE SAFE STAYS SHUT.")
5360     END IF
5370     END IF
5380   END IF
5390   IF A=14 THEN
5400     IF CRANKED THEN
5410       CALL SAY("THE BUCKET HANGS HIGH ABOVE THE WELL.")
5420     ELSE
5430      IF FN HAS(ICRANK) THEN
5440       CRANKED=-1
5450       CALL USEUP(ICRANK)
5460       CALL REVEAL(PANT)
5470       CALL SAY("YOU FIT THE CRANK TO THE WINDLASS AND WIND. THE BUCKET COMES UP WITH AN ANTENNA!")
5480       CALL SOUND_(8)
5490     ELSE
5500       CALL SAY("THE WINDLASS HAS NO CRANK. THE BUCKET IS STUCK DEEP IN THE WELL.")
5510     END IF
5520     END IF
5530   END IF
5540   IF A=15 THEN
5550     IF KEYTAKEN THEN
5560       CALL SAY("A CROOKED FLOWERPOT WITH A WITHERED PLANT.")
5570     ELSE
5580       KEYTAKEN=-1
5590       TXN(OPOT)=85:CALL SHOWTHING(OPOT)
5600       CALL REVEAL(IKEY)
5610       CALL SAY("YOU LIFT THE CROOKED POT: A SPARE KEY LIES UNDER IT.")
5620       CALL SOUND_(5)
5630     END IF
5640   END IF
5650   IF A=16 THEN
5660     IF TBOXOP THEN
5670       CALL SAY("THE TOOLBOX IS EMPTY NOW.")
5680     ELSE
5690       TBOXOP=-1
5700       CALL REVEAL(ICRANK):CALL REVEAL(ISCREW)
5710       CALL SAY("YOU OPEN THE TOOLBOX: A CRANK HANDLE AND A SCREWDRIVER WITH A FOUR-POINTED TIP.")
5720       CALL SOUND_(5)
5730     END IF
5740   END IF
5750   IF A=17 THEN CALL INSTALL
5760 END PROC
5770 ' you press E at a door: a key opens it
5780 PROC DOORUSE
5790   LOCAL S,I
5800   S=W3D("USE",70)
5810   IF S<0 THEN EXIT PROC
5820   FOR I=1 TO 4
5830     IF S=DSEC(I) THEN
5840       IF I=1 THEN
5850         CALL SAY("THE FRONT DOOR HAS BEEN STUCK OPEN FOR YEARS.")
5860       ELSE
5870        IF DOP(I) THEN
5880         DOP(I)=0
5890         CALL SAY("YOU CLOSE THE DOOR.")
5900         CALL SOUND_(5)
5910       ELSE
5920        IF DLK(I) AND NOT FN HAS(IKEY) THEN
5930         CALL SAY("LOCKED. THE SPARE KEY WOULD FIT.")
5940         CALL SOUND_(6)
5950       ELSE
5960         IF DLK(I) THEN
5970           CALL SAY("YOU UNLOCK AND OPEN THE DOOR.")
5980         ELSE
5990           CALL SAY("YOU OPEN THE DOOR.")
6000         END IF
6010         DLK(I)=0:DOP(I)=-1
6020         CALL SOUND_(5)
6030       END IF
6040       END IF
6050       END IF
6060     END IF
6070   NEXT I
6080 END PROC
6090 PROC USEKEY
6100   LOCAL N
6110   N=FN TARGET(0)
6120   IF N>=0 THEN
6130     IF KD(N)>=1 AND KD(N)<=2 THEN CALL PICKUP(N) ELSE CALL DOACT(N)
6140   ELSE
6150     CALL DOORUSE
6160   END IF
6170 END PROC
6180 ' ------------------------------------------------------------------------------------------------ the wreck, saving
6190 PROC SAVEGAME
6200   LOCAL M,K
6210   M=0
6220   FOR K=1 TO 8
6230     IF BUILT(K) THEN M=M+2^(K-1)
6240   NEXT K
6250   OPEN "local:deqq2.sav" FOR OUTPUT AS #1
6260   PRINT #1,"DEQQ2 1"
6270   PRINT #1,M
6280   PRINT #1,INT(GT)
6290   PRINT #1,CAUGHTN
6300   CLOSE #1
6310 END PROC
6320 ' reads the saved game: SAVEDMASK, SAVEDT, SAVEDC; -1 if there is one
6330 FUNC LOADSAVE(X)
6340   LOCAL A$,R
6350   R=0
6360   SAVEDMASK=0:SAVEDT=0:SAVEDC=0
6370   IF EXISTS("local:deqq2.sav") THEN
6380     OPEN "local:deqq2.sav" FOR INPUT AS #1
6390     A$=""
6400     IF NOT EOF(1) THEN LINE INPUT #1,A$
6410     IF A$="DEQQ2 1" THEN
6420       IF NOT EOF(1) THEN LINE INPUT #1,A$:SAVEDMASK=VAL(A$)
6430       IF NOT EOF(1) THEN LINE INPUT #1,A$:SAVEDT=VAL(A$)
6440       IF NOT EOF(1) THEN LINE INPUT #1,A$:SAVEDC=VAL(A$)
6450       R=-1
6460     END IF
6470     CLOSE #1
6480   END IF
6490   RETURN R
6500 END FUNC
6510 PROC INSTALL
6520   LOCAL I,N,K,C
6530   C=0
6540   FOR I=0 TO 2
6550     N=INV(I)
6560     IF N>=PCOIL AND N<=PANT THEN
6570       K=N-1
6580       INV(I)=-1
6590       IF NOT BUILT(K) THEN
6600         BUILT(K)=-1:NBUILT=NBUILT+1
6610       END IF
6620       CALL SHOWTHING(60+K)
6630       C=C+1
6640     END IF
6650   NEXT I
6660   IF C=0 THEN
6670     CALL SAY("THE WRECK IS A SKELETON OF BEAMS WITH EIGHT GAPS. "+STR$(NBUILT)+" OF 8 PARTS ARE BUILT IN.")
6680   ELSE
6690     CALL SOUND_(7)
6700     CALL SAY("YOU BUILD IN "+STR$(C)+" PART(S) - "+STR$(NBUILT)+" OF 8 DONE.")
6710     CALL SAVEGAME
6720     IF NBUILT=8 THEN ENDREQ=-1
6730   END IF
6740 END PROC
6750 ' ------------------------------------------------------------------------------------------------ Deqq
6760 PROC DQMOVE(DX,DY,SP,TF)
6770   W3D THINGMOVE IDEQQ,DX*SP,DY*SP
6780   DQANG=ATAN2(DY,DX)
6790   W3D THINGTEX IDEQQ,TF
6800 END PROC
6810 FUNC NEARWP(X,Y)
6820   LOCAL I,B,D,R
6830   R=0:B=1.0E9
6840   FOR I=0 TO NWP-1
6850     D=(WPX(I)-X)^2+(WPY(I)-Y)^2
6860     IF D<B THEN B=D:R=I
6870   NEXT I
6880   RETURN R
6890 END FUNC
6900 PROC CAUGHT
6910   LOCAL I,N
6920   CAUGHTN=CAUGHTN+1
6930   MU_AF=2
6940   CALL MU_FORCE(5)
6950   CALL SOUND_(4)
6960   CALL BANNER("DEQQ HAS CAUGHT YOU","HE CARRIES YOU OUT OF THE HOUSE AND PUTS YOU DOWN IN THE GARDEN.",2.5)
6970   FOR I=0 TO 2
6980     N=INV(I)
6990     IF N>=0 THEN
7000       INV(I)=-1
7010       CALL SHOWTHING(N)
7020     END IF
7030   NEXT I
7040   W3D CAMERA 480,150,90,0,0
7050   W3D LIFT 0
7060   W3K_VZ=0
7070   DQS=0:DQWP=5:DQLOST=0
7080   CALL SHOWAT(IDEQQ,WPX(4),WPY(4))
7090   W3D THINGTEX IDEQQ,40
7100   DQCD=GT+8
7110   CALL SAY("WHAT YOU CARRIED IS BACK WHERE YOU FOUND IT. THE PARTS BUILT IN STAY.")
7120 END PROC
7130 PROC DEQQAI(DT)
7140   LOCAL DXP,DYP,D,SEEN,LIM,BA,TX,TY,L,DX,DY,F,HID
7150   DXP=W3D("TX",IDEQQ):DYP=W3D("TY",IDEQQ)
7160   D=W3D("DIST",IDEQQ)
7170   HID=(W3D("TAG",W3D("SECTOR"))=50)
7180   SEEN=0
7190   IF GT>=DQCD THEN
7200     LIM=430
7210     IF HID THEN LIM=55
7220     IF D<LIM THEN
7230       BA=ATAN2(PY-DYP,PX-DXP)
7240       IF D<95 OR FN ADIFF(BA,DQANG)<0.95 THEN
7250         IF W3D("SEES",IDEQQ) THEN SEEN=-1
7260       END IF
7270     END IF
7280   END IF
7290   F=40+(INT(GT*4) AND 1)
7300   IF DQS=2 THEN
7310     IF SEEN THEN DQLOST=0 ELSE DQLOST=DQLOST+DT
7320     IF DQLOST>3.5 THEN
7330       DQS=0:DQWP=FN NEARWP(DXP,DYP)
7340       CALL SAY("DEQQ MUTTERS, LOSES YOUR TRACK AND GOES BACK TO HIS ROUND.")
7350       W3D THINGTEX IDEQQ,40
7360     ELSE
7370       IF D>1 THEN CALL DQMOVE((PX-DXP)/D,(PY-DYP)/D,108*DT,42)
7380       IF D<46 AND W3D("SEES",IDEQQ) AND GT>=DQCD THEN CALL CAUGHT
7390     END IF
7400   ELSE
7410     IF SEEN THEN
7420       DQS=2:DQLOST=0
7430       CALL SOUND_(3)
7440       CALL SAY("DEQQ HAS SEEN YOU! RUN, SHUT A DOOR, OR HIDE!")
7450       W3D THINGTEX IDEQQ,42
7460     ELSE
7470      IF DQS=1 THEN
7480       W3D THINGTEX IDEQQ,40
7490       IF GT>=DQPT THEN
7500         DQS=0:DQWP=(DQWP+1) MOD NWP
7510       END IF
7520     ELSE
7530       TX=WPX(DQWP):TY=WPY(DQWP)
7540       DX=TX-DXP:DY=TY-DYP:L=SQR(DX*DX+DY*DY)
7550       IF L<22 THEN
7560         IF WPP(DQWP)>0 THEN
7570           DQS=1:DQPT=GT+WPP(DQWP)
7580         ELSE
7590           DQWP=(DQWP+1) MOD NWP
7600         END IF
7610       ELSE
7620         CALL DQMOVE(DX/L,DY/L,62*DT,F)
7630         IF W3D("HIT") AND 2 THEN DQSTUCK=DQSTUCK+DT ELSE DQSTUCK=0
7640         IF DQSTUCK>1.5 THEN
7650           DQSTUCK=0:DQWP=(DQWP+1) MOD NWP
7660         END IF
7670       END IF
7680     END IF
7690     END IF
7700   END IF
7710   IF DQS<>1 AND D<420 AND GT>=DQFT THEN
7720     CALL SOUND_(2)
7730     DQFT=GT+0.55
7740     IF NOT SEEN AND GT>=DQHEARD AND DQS=0 THEN
7750       CALL SAY("HEAVY FOOTSTEPS. DEQQ IS SOMEWHERE NEAR.")
7760       DQHEARD=GT+30
7770     END IF
7780   END IF
7790 END PROC
7800 ' ------------------------------------------------------------------------------------------------ the screen
7810 PROC CTEXT(Y,T$,C)
7820   GFX TEXT (640-8*LEN(T$))\2,Y,T$,C
7830 END PROC
7840 ' a banner over the picture of the world for a few seconds (the player stands still)
7850 PROC BANNER(T1$,T2$,SEC)
7860   LOCAL T0
7870   IF HL THEN
7880     PRINT "# ";T1$
7890     EXIT PROC
7900   END IF
7910   T0=TI
7920   WHILE TI-T0<SEC*60
7930     W3D RENDER
7940     GFX LINE 60,70,579,170,FN CI(0,1),BF
7950     GFX LINE 60,70,579,170,FN CI(1,10),B
7960     CALL BIGTEXT(82,T1$,FN CI(3,15),2)
7970     CALL CTEXT(130,LEFT$(T2$,62),FN CI(0,13))
7980     IF LEN(T2$)>62 THEN CALL CTEXT(144,MID$(T2$,63),FN CI(0,13))
7990     CALL W3K_SHOW
8000   WEND
8010   W3K_T0=TI
8020 END PROC
8030 PROC HUD
8040   LOCAL I,N,X,C,T$
8050   IF MSGT>0 THEN
8060     GFX LINE 0,0,639,MSGH,FN CI(0,1),BF
8070     GFX TEXT 6,4,MSG1$,FN CI(0,15)
8080     IF MSG2$<>"" THEN GFX TEXT 6,18,MSG2$,FN CI(0,15)
8090   END IF
8100   IF PROMPT$<>"" THEN
8110     GFX TEXT (640-8*LEN(PROMPT$))\2+1,247,PROMPT$,FN CI(0,1)
8120     GFX TEXT (640-8*LEN(PROMPT$))\2,246,PROMPT$,FN CI(3,15)
8130   END IF
8140   CALL W3K_HUDBAR(264,36)
8150   FOR I=0 TO 2
8160     X=6+I*104
8170     GFX LINE X,268,X+99,295,FN CI(0,3),BF
8180     GFX LINE X,268,X+99,295,FN CI(0,8),B
8190     N=INV(I)
8200     IF N>=0 THEN
8210       T$=NMS$(N)
8220       IF LEN(T$)>11 THEN T$=LEFT$(T$,11)
8230       GFX TEXT X+4,276,T$,FN CI(3,14)
8240     END IF
8250   NEXT I
8260   GFX TEXT 326,268,"PARTS",FN CI(0,11)
8270   FOR I=1 TO 8
8280     IF BUILT(I) THEN C=FN CI(5,13) ELSE C=FN CI(0,4)
8290     GFX LINE 326+(I-1)*14,282,336+(I-1)*14,293,C,BF
8300   NEXT I
8310   IF DQS=2 THEN
8320     GFX TEXT 470,274,"DEQQ SEES YOU!",FN CI(1,14),2,1
8330   ELSE
8340    IF W3D("TAG",W3D("SECTOR"))=50 THEN
8350     GFX TEXT 470,274,"HIDDEN",FN CI(5,13),2,1
8360   END IF
8370   END IF
8380   IF MSGT>0 THEN MSGT=MSGT-0.017
8390   MSGH=18:IF MSG2$<>"" THEN MSGH=32
8400 END PROC
8410 PROC TITLE
8420   LOCAL I,K$,C,SV
8430   CALL MU_FORCE(1)
8440   SV=FN LOADSAVE(0)
8450   C=0
8460   WHILE C=0
8470     FOR I=0 TO 1
8480       GFX CLEAR FN CI(0,1)
8490       GFX LINE 40,24,599,260,FN CI(10,4),B
8500       CALL BIGTEXT(36,"DEQQ'S HOUSE II",FN CI(6,14),4)
8510       CALL CTEXT(96,"DEQQ, AN ALIEN, CRASH-LANDED AND LIVES IN THIS HOUSE.",FN CI(0,13))
8520       CALL CTEXT(112,"EIGHT PARTS OF HIS SHIP ARE HIDDEN IN THE HOUSE AND GARDEN.",FN CI(0,13))
8530       CALL CTEXT(128,"BUILD THEM INTO THE WRECK BEHIND THE BACK YARD - BUT DEQQ IS HOME.",FN CI(0,13))
8540       CALL CTEXT(144,"HE WALKS HIS ROUND AND CARRIES YOU OUT IF HE SEES YOU. NOBODY IS HURT.",FN CI(0,11))
8550       CALL CTEXT(168,"WASD / ARROWS WALK   SPACE JUMP   E USE   G PUT DOWN   SHIFT RUN   O SETTINGS",FN CI(3,13))
8560       CALL CTEXT(184,"PAD: STICKS WALK AND TURN   A JUMP   X USE   B PUT DOWN   Y SETTINGS",FN CI(3,13))
8570       CALL CTEXT(196,"M MUSIC ON/OFF   P PAUSE   Q QUIT",FN CI(0,10))
8580       IF SV AND SAVEDMASK>0 THEN
8590         CALL CTEXT(212,"N NEW GAME     C CONTINUE ("+STR$(FN BITS(SAVEDMASK))+" OF 8 PARTS BUILT)     Q QUIT",FN CI(1,13))
8600       ELSE
8610         CALL CTEXT(212,"N OR FIRE: NEW GAME     Q QUIT",FN CI(1,13))
8620       END IF
8630       CALL W3K_SHOW
8640     NEXT I
8650     CALL IN_WAITRELEASE
8660     REPEAT
8670       FRAME
8680       CALL MU_TICK
8690       K$=INKEY$
8700       IF K$<>"" THEN
8710         IF K$="n" OR K$="N" OR K$=" " OR K$=CHR$(13) THEN C=1
8720         IF (K$="c" OR K$="C") AND SV AND SAVEDMASK>0 THEN C=2
8730         IF K$="q" OR K$="Q" OR K$=CHR$(27) THEN C=3
8740       END IF
8750       IF FN IN_ANYA(0) OR FN IN_ANYSTART(0) THEN C=1
8760       IF FN IN_ANYBACK(0) THEN C=3
8770     UNTIL C<>0
8780   WEND
8790   TITLERES=C
8800 END PROC
8810 ' ------------------------------------------------------------------------------------------------ one step of the world, a new game
8820 ' the music: calm and slow; uneasy (the same with a heartbeat) when Deqq is near; danger while he follows you and for four seconds after
8830 PROC MUSICMOOD
8840   LOCAL W,D
8850   D=W3D("DIST",IDEQQ)
8860   IF DQS=2 THEN MUT=GT+4
8870   IF GT<MUT THEN
8880     W=4
8890   ELSE
8900     IF D<380 THEN W=3 ELSE W=2
8910   END IF
8920   CALL MU_MODE(W)
8930 END PROC
8940 PROC TICK(DT)
8950   GT=GT+DT
8960   PX=W3D("X"):PY=W3D("Y")
8970   CALL DOORS(DT)
8980   CALL LANTERNLIGHT
8990   CALL TIMERS
9000   IF NOT POWEROFF THEN W3D THINGTEX OWASH,70+(INT(GT*5) AND 1)
9010   IF DQON THEN CALL DEQQAI(DT)
9020   CALL MUSICMOOD
9030 END PROC
9040 PROC NEWGAME(CN)
9050   LOCAL I,K
9060   CALL PLACEALL
9070   TXN(IDEQQ)=40:TWD(IDEQQ)=40:THT(IDEQQ)=72:TZO(IDEQQ)=0:TLT(IDEQQ)=-1
9080   FOR I=0 TO 2
9090     INV(I)=-1
9100   NEXT I
9110   FOR K=1 TO 8
9120     BUILT(K)=0
9130   NEXT K
9140   NBUILT=0
9150   OVENT=0:OVENCOOL=0:OVENOPEN=0:FRIDGEOP=0:MELTT=0:CHAIRON=0:FED=0:SCREWS=0:PLATEOUT=0:SAFEOP=0:CRANKED=0:PHOTOSEEN=0
9160   POWEROFF=0:WASHOPEN=0:KEYTAKEN=0:TBOXOP=0:LANTON=-1:ENDREQ=0:QUITREQ=0:DIALIN$="":DIALMSG=0
9170   DSEC(1)=6:DSEC(2)=7:DSEC(3)=8:DSEC(4)=33
9180   FOR I=1 TO 4
9190     DOP(I)=0:DLK(I)=-1:DCUR(I)=0
9200   NEXT I
9210   DOP(1)=-1:DLK(1)=0:DCUR(1)=100
9220   W3D HEIGHT 6,0,100
9230   FOR I=2 TO 4
9240     W3D HEIGHT DSEC(I),0,0
9250   NEXT I
9260   W3D HEIGHT CHAIRSEC,0,200
9270   GT=0:CAUGHTN=0:MSGT=0:MSG1$="":MSG2$="":PROMPT$="":MSGH=18
9280   PX=480:PY=100
9290   W3D CAMERA 480,100,90,0,0
9300   W3D LIFT 0
9310   W3K_VZ=0
9320   DQON=-1:DQS=0:DQWP=21:DQLOST=0:DQCD=3:DQPT=0:DQFT=0:DQHEARD=20:DQSTUCK=0:DQANG=1.5
9330   CALL SHOWAT(IDEQQ,WPX(DQWP),WPY(DQWP))
9340   W3D THINGTEX IDEQQ,40
9350   IF CN THEN
9360     FOR K=1 TO 8
9370       IF (SAVEDMASK\(2^(K-1))) AND 1 THEN
9380         BUILT(K)=-1:NBUILT=NBUILT+1
9390         CALL SHOWTHING(60+K)
9400       END IF
9410     NEXT K
9420     GT=SAVEDT:CAUGHTN=SAVEDC
9430   END IF
9440   CALL LANTERNLIGHT
9450   MUT=0
9460   CALL MU_FORCE(2)
9470 END PROC
9480 ' ------------------------------------------------------------------------------------------------ playing
9490 PROC PROMPTUPDATE
9500   LOCAL N,S,I
9510   PROMPT$=""
9520   N=FN TARGET(0)
9530   IF N>=0 THEN
9540     IF KD(N)>=1 AND KD(N)<=2 THEN
9550       PROMPT$="E: TAKE THE "+NMS$(N)
9560     ELSE
9570       PROMPT$="E: "+NMS$(N)
9580     END IF
9590   ELSE
9600     S=W3D("USE",70)
9610     FOR I=2 TO 4
9620       IF S=DSEC(I) THEN
9630         IF DOP(I) THEN PROMPT$="E: CLOSE THE DOOR" ELSE PROMPT$="E: OPEN THE DOOR"
9640       END IF
9650     NEXT I
9660   END IF
9670 END PROC
9680 PROC PLAYLEVEL
9690   LOCAL DT,U,UL,BL,B,Y,YL,T0,FR
9700   UL=0:BL=0:YL=0:FR=0
9710   T0=TI
9720   REPEAT
9730     DT=(TI-T0)/60:T0=TI
9740     IF DT>0.1 THEN DT=0.1
9750     CALL W3K_WALK
9760     CALL W3K_JUMP(KEY("SPACE") OR JOY("A"))
9770     U=KEY("E") OR KEY("RETURN") OR JOY("X")
9780     IF U<>0 AND UL=0 THEN CALL USEKEY
9790     UL=U
9800     B=KEY("G") OR JOY("B")
9810     IF B<>0 AND BL=0 THEN CALL DROPLAST
9820     BL=B
9830     IF KEY("ESC") THEN IN_QUIT=1
9840     CALL TICK(DT)
9850     IF FR MOD 5=0 THEN CALL PROMPTUPDATE
9860     W3D RENDER
9870     CALL HUD
9880     GFX LINE 318,131,321,132,FN CI(0,13),BF
9890     CALL W3K_SHOW
9900     FR=FR+1
9910     IF FN IN_SERVICE() THEN
9920       CALL BIGTEXT(110,"PAUSED",FN CI(0,15),3)
9930       CALL W3K_SHOW
9940       CALL MU_SILENCE
9950       CALL IN_PAUSELOOP
9960       CALL MU_START
9970       T0=TI:W3K_T0=TI
9980     END IF
9990     IF IN_KEY=77 THEN CALL MU_TOGGLE
10000     Y=JOY("Y")
10010     IF IN_KEY=79 OR (Y<>0 AND YL=0) THEN
10020       CALL P3_DIALOG
10030       T0=TI
10040     END IF
10050     YL=Y
10060   UNTIL IN_QUIT OR ENDREQ
10070 END PROC
10080 PROC ENDING
10090   LOCAL I
10100   MU_AF=0
10110   CALL MU_FORCE(6)
10120   CALL BANNER("THE SHIP HUMS","ALL EIGHT PARTS ARE BUILT IN. THE LIGHTS OF THE WRECK COME ON, ONE BY ONE.",4)
10130   IF HL THEN
10140     PRINT "# ENDING"
10150   ELSE
10160     FOR I=0 TO 90
10170       W3D THINGZ 32,I*2
10180       W3D RENDER
10190       CALL HUD
10200       CALL W3K_SHOW
10210     NEXT I
10220     CALL BANNER("DEQQ SAYS THANK YOU","'YOU FIXED MY SHIP. I SHALL GO HOME. THE HOUSE IS YOURS. IT BITES, A LITTLE.'",5)
10230     CALL BANNER("THE END","TIME "+STR$(INT(GT\60))+" MIN "+STR$(INT(GT) MOD 60)+" S    CAUGHT "+STR$(CAUGHTN)+" TIMES",5)
10240   END IF
10250   IF EXISTS("local:deqq2.sav") THEN KILL "local:deqq2.sav"
10260 END PROC
10270 ' ------------------------------------------------------------------------------------------------ playback (the headless test)
10280 ' commands (lines of the file named by DEQQ2_PLAY): step n | goto x y angle | walk x y | face x y | use | drop | give n | dial 731 | deqq x y | deqqoff | deqqon | state | say text | continue | new | quit
10290 PROC SPLIT(L$)
10300   LOCAL I,N,C$,CUR$
10310   FOR I=0 TO 7
10320     W$(I)=""
10330   NEXT I
10340   N=0:CUR$=""
10350   FOR I=1 TO LEN(L$)
10360     C$=MID$(L$,I,1)
10370     IF C$=" " THEN
10380       IF CUR$<>"" THEN
10390         IF N<7 THEN
10400           W$(N)=CUR$:N=N+1
10410         END IF
10420         CUR$=""
10430       END IF
10440     ELSE
10450       CUR$=CUR$+C$
10460     END IF
10470   NEXT I
10480   IF CUR$<>"" AND N<7 THEN W$(N)=CUR$
10490 END PROC
10500 PROC WALKTO(X,Y)
10510   LOCAL I,DX,DY,L,A
10520   FOR I=1 TO 1500
10530     DX=X-W3D("X"):DY=Y-W3D("Y"):L=SQR(DX*DX+DY*DY)
10540     IF L<8 THEN EXIT PROC
