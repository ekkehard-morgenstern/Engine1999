6720 ' ------------------------------------------------------------------------------------------------ the wreck, saving
6730 PROC SAVEGAME
6740   LOCAL M,K
6750   M=0
6760   FOR K=1 TO 8
6770     IF BUILT(K) THEN M=M+2^(K-1)
6780   NEXT K
6790   OPEN "local:deqq2.sav" FOR OUTPUT AS #1
6800   PRINT #1,"DEQQ2 1"
6810   PRINT #1,M
6820   PRINT #1,INT(GT)
6830   PRINT #1,CAUGHTN
6840   CLOSE #1
6850 END PROC
6860 ' reads the saved game: SAVEDMASK, SAVEDT, SAVEDC; -1 if there is one
6870 FUNC LOADSAVE(X)
6880   LOCAL A$,R
6890   R=0
6900   SAVEDMASK=0:SAVEDT=0:SAVEDC=0
6910   IF EXISTS("local:deqq2.sav") THEN
6920     OPEN "local:deqq2.sav" FOR INPUT AS #1
6930     A$=""
6940     IF NOT EOF(1) THEN LINE INPUT #1,A$
6950     IF A$="DEQQ2 1" THEN
6960       IF NOT EOF(1) THEN LINE INPUT #1,A$:SAVEDMASK=VAL(A$)
6970       IF NOT EOF(1) THEN LINE INPUT #1,A$:SAVEDT=VAL(A$)
6980       IF NOT EOF(1) THEN LINE INPUT #1,A$:SAVEDC=VAL(A$)
6990       R=-1
7000     END IF
7010     CLOSE #1
7020   END IF
7030   RETURN R
7040 END FUNC
7050 PROC INSTALL
7060   LOCAL I,N,K,C
7070   C=0
7080   FOR I=0 TO 2
7090     N=INV(I)
7100     IF N>=PCOIL AND N<=PANT THEN
7110       K=N-1
7120       INV(I)=-1
7130       IF NOT BUILT(K) THEN
7140         BUILT(K)=-1:NBUILT=NBUILT+1
7150       END IF
7160       CALL SHOWTHING(60+K)
7170       C=C+1
7180     END IF
7190   NEXT I
7200   IF C=0 THEN
7210     CALL SAY("THE WRECK IS A SKELETON OF BEAMS WITH EIGHT GAPS. "+STR$(NBUILT)+" OF 8 PARTS ARE BUILT IN.")
7220   ELSE
7230     CALL SOUND_(7)
7240     CALL SAY("YOU BUILD IN "+STR$(C)+" PART(S) - "+STR$(NBUILT)+" OF 8 DONE.")
7250     CALL SAVEGAME
7260     IF NBUILT=8 THEN ENDREQ=-1
7270   END IF
7280 END PROC
7290 ' ------------------------------------------------------------------------------------------------ Deqq
7300 PROC DQMOVE(DX,DY,SP,TF)
7310   W3D THINGMOVE IDEQQ,DX*SP,DY*SP
7320   DQANG=ATAN2(DY,DX)
7330   W3D THINGTEX IDEQQ,TF
7340 END PROC
7350 FUNC NEARWP(X,Y)
7360   LOCAL I,B,D,R
7370   R=0:B=1.0E9
7380   FOR I=0 TO NWP-1
7390     D=(WPX(I)-X)^2+(WPY(I)-Y)^2
7400     IF D<B THEN B=D:R=I
7410   NEXT I
7420   RETURN R
7430 END FUNC
7440 ' is a sector outside of the house? (the gardens, the shed, the niches and the fences; the doors, the cellar and everything inside count as the house)
7450 FUNC OUTSIDE(S)
7460   IF S<0 THEN RETURN 0
7470   IF S<6 OR S=8 OR S=9 OR S=60 OR S=61 OR S>=100 THEN RETURN -1
7480   RETURN 0
7490 END FUNC
7500 PROC CAUGHT
7510   LOCAL I,N
7520   CAUGHTN=CAUGHTN+1
7530   MU_AF=2
7540   CALL MU_FORCE(5)
7550   CALL SOUND_(4)
7560   CALL BANNER("DEQQ HAS CAUGHT YOU","HE CARRIES YOU OUT OF THE HOUSE AND PUTS YOU DOWN IN THE GARDEN.",2.5)
7570   FOR I=0 TO 2
7580     N=INV(I)
7590     IF N>=0 THEN
7600       INV(I)=-1
7610       CALL SHOWTHING(N)
7620     END IF
7630   NEXT I
7640   W3D CAMERA 480,150,90,0,0
7650   W3D LIFT 0
7660   W3K_VZ=0
7670   DQS=0:DQWP=2:DQLOST=0
7680   CALL SHOWAT(IDEQQ,WPX(1),WPY(1))
7690   W3D THINGTEX IDEQQ,40
7700   DQCD=GT+8
7710   CALL SAY("WHAT YOU CARRIED IS BACK WHERE YOU FOUND IT. THE PARTS BUILT IN STAY.")
7720 END PROC
7730 PROC DEQQAI(DT)
7740   LOCAL DXP,DYP,D,SEEN,LIM,BA,TX,TY,L,DX,DY,F,HID,OUT
7750   DXP=W3D("TX",IDEQQ):DYP=W3D("TY",IDEQQ)
7760   D=W3D("DIST",IDEQQ)
7770   HID=(W3D("TAG",W3D("SECTOR"))=50)
7780   OUT=FN OUTSIDE(W3D("SECTOR"))
7790   SEEN=0
7800   IF GT>=DQCD AND NOT OUT THEN
7810     LIM=430
7820     IF HID THEN LIM=55
7830     IF D<LIM THEN
7840       BA=ATAN2(PY-DYP,PX-DXP)
7850       IF D<95 OR FN ADIFF(BA,DQANG)<0.95 THEN
7860         IF W3D("SEES",IDEQQ) THEN SEEN=-1
7870       END IF
7880     END IF
7890   END IF
7900   F=40+(INT(GT*4) AND 1)
7910   IF DQS=2 AND OUT THEN
7920     ' you are out of the house: he is not interested any more and goes back in
7930     CALL SAY("DEQQ GRUMBLES: 'OUTSIDE IS NOT MY BUSINESS.' HE GOES BACK INTO THE HOUSE.")
7940     IF FN OUTSIDE(W3D("TSECTOR",IDEQQ)) THEN DQS=3 ELSE DQS=0:DQWP=FN NEARWP(DXP,DYP)
7950     DQLOST=0
7960     W3D THINGTEX IDEQQ,40
7970   END IF
7980   IF DQS=3 THEN
7990     ' on the way back into the house: to the front door, through it, to the first way point
8000     IF DXP<440 OR DXP>520 OR DYP>330 THEN TX=480:TY=270 ELSE TX=480:TY=420
8010     DX=TX-DXP:DY=TY-DYP:L=SQR(DX*DX+DY*DY)
8020     IF L<22 THEN
8030       IF TY=420 THEN DQS=0:DQWP=0
8040     ELSE
8050       CALL DQMOVE(DX/L,DY/L,80*DT,F)
8060     END IF
8070   ELSE
8080    IF DQS=2 THEN
8090     IF SEEN THEN DQLOST=0 ELSE DQLOST=DQLOST+DT
8100     IF DQLOST>3.5 THEN
8110       DQS=0:DQWP=FN NEARWP(DXP,DYP)
8120       CALL SAY("DEQQ MUTTERS, LOSES YOUR TRACK AND GOES BACK TO HIS ROUND.")
8130       W3D THINGTEX IDEQQ,40
8140     ELSE
8150       IF D>1 THEN CALL DQMOVE((PX-DXP)/D,(PY-DYP)/D,108*DT,42)
8160       IF D<46 AND W3D("SEES",IDEQQ) AND GT>=DQCD THEN CALL CAUGHT
8170     END IF
8180   ELSE
8190     IF SEEN THEN
8200       DQS=2:DQLOST=0
8210       CALL SOUND_(3)
8220       CALL SAY("DEQQ HAS SEEN YOU! RUN, SHUT A DOOR, OR HIDE!")
8230       W3D THINGTEX IDEQQ,42
8240     ELSE
8250      IF DQS=1 THEN
8260       W3D THINGTEX IDEQQ,40
8270       IF GT>=DQPT THEN
8280         DQS=0:DQWP=(DQWP+1) MOD NWP
8290       END IF
8300     ELSE
8310       TX=WPX(DQWP):TY=WPY(DQWP)
8320       DX=TX-DXP:DY=TY-DYP:L=SQR(DX*DX+DY*DY)
8330       IF L<22 THEN
8340         IF WPP(DQWP)>0 THEN
8350           DQS=1:DQPT=GT+WPP(DQWP)
8360         ELSE
8370           DQWP=(DQWP+1) MOD NWP
8380         END IF
8390       ELSE
8400         CALL DQMOVE(DX/L,DY/L,62*DT,F)
8410         IF W3D("HIT") AND 2 THEN DQSTUCK=DQSTUCK+DT ELSE DQSTUCK=0
8420         IF DQSTUCK>1.5 THEN
8430           DQSTUCK=0:DQWP=(DQWP+1) MOD NWP
8440         END IF
8450       END IF
8460     END IF
8470     END IF
8480   END IF
8490   END IF
8500   IF DQS<>1 AND D<420 AND GT>=DQFT THEN
8510     CALL SOUND_(2)
8520     DQFT=GT+0.55
8530     IF NOT SEEN AND GT>=DQHEARD AND DQS=0 THEN
8540       CALL SAY("HEAVY FOOTSTEPS. DEQQ IS SOMEWHERE NEAR.")
8550       DQHEARD=GT+30
8560     END IF
8570   END IF
8580 END PROC
