3430 ' ------------------------------------------------------------------------------------------------ doors, the cellar's light, timers
3440 PROC DOORS(DT)
3450   LOCAL I,G
3460   FOR I=1 TO 4
3470     IF DOP(I) THEN G=100 ELSE G=0
3480     IF DCUR(I)<G THEN DCUR(I)=MIN(G,DCUR(I)+90*DT)
3490     IF DCUR(I)>G THEN DCUR(I)=MAX(G,DCUR(I)-90*DT)
3500     W3D HEIGHT DSEC(I),0,DCUR(I)
3510   NEXT I
3520 END PROC
3530 PROC LANTERNLIGHT
3540   LOCAL L,S
3550   L=FN HAS(ILANT)
3560   IF L=LANTON THEN EXIT PROC
3570   LANTON=L
3580   FOR S=34 TO 38
3590     IF L THEN W3D LIGHT S,170 ELSE W3D LIGHT S,90
3600   NEXT S
3610   FOR S=39 TO 45
3620     IF S=39 OR S=45 THEN
3630       IF L THEN W3D LIGHT S,185 ELSE W3D LIGHT S,45
3640     END IF
3650   NEXT S
3660 END PROC
3670 ' things that happen after a while: the oven cools down, the compass comes out of the melting ice
