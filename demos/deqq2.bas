36185 ' a picture on a vertical plane: local plane x = X (the front of the thing is +x), from Y1 to Y2 and Z1 to Z2, one texel per unit
36190 PROC PICQ(O,X,Y1,Y2,Z1,Z2,TX)
36195   LOCAL B
36200   B=M3D("VERTS",O)
36205   M3D VERTEX O,X,Y1,Z1,0,Z2-Z1
36210   M3D VERTEX O,X,Y2,Z1,Y2-Y1,Z2-Z1
36215   M3D VERTEX O,X,Y2,Z2,Y2-Y1,0
36220   M3D VERTEX O,X,Y1,Z2,0,0
36225   M3D QUAD O,B,B+1,B+2,B+3,TX
36230 END PROC
36235 ' a picture lying on a horizontal surface at height Z (north is the top of the picture)
36240 PROC TOPQ(O,X1,Y1,X2,Y2,Z,TX)
36245   LOCAL B
36250   B=M3D("VERTS",O)
36255   M3D VERTEX O,X1,Y1,Z,0,Y2-Y1
36260   M3D VERTEX O,X2,Y1,Z,X2-X1,Y2-Y1
36265   M3D VERTEX O,X2,Y2,Z,X2-X1,0
36270   M3D VERTEX O,X1,Y2,Z,0,0
36275   M3D QUAD O,B,B+1,B+2,B+3,TX
36280 END PROC
36285 ' a solid of revolution round the vertical axis at CX,CY: NR rings (radius LRR(j) at height LRZ(j), eight sided, bottom to top), closed top and bottom
36290 PROC LATHE(O,CX,CY,NR,TX)
36295   LOCAL J,K,B,A,P
36300   B=M3D("VERTS",O)
36305   FOR J=0 TO NR-1
36310     FOR K=0 TO 7
36315       A=K*0.7853982
36320       M3D VERTEX O,CX+LRR(J)*COS(A),CY+LRR(J)*SIN(A),LRZ(J)
36325     NEXT K
36330   NEXT J
36335   FOR J=0 TO NR-2
36340     FOR K=0 TO 7
36345       P=B+J*8
36350       M3D QUAD O,P+K,P+((K+1) MOD 8),P+8+((K+1) MOD 8),P+8+K,TX
36355     NEXT K
36360   NEXT J
36365   P=B+(NR-1)*8
36370   M3D QUAD O,P,P+1,P+2,P+3,TX
36375   M3D QUAD O,P,P+3,P+4,P+5,TX
36380   M3D QUAD O,P,P+5,P+6,P+7,TX
36385   M3D QUAD O,B,B+3,B+2,B+1,TX
36390   M3D QUAD O,B,B+5,B+4,B+3,TX
36395   M3D QUAD O,B,B+7,B+6,B+5,TX
36400 END PROC
36405 PROC RING(J,R,Z)
36410   LRR(J)=R:LRZ(J)=Z
36415 END PROC
36420 ' a chair (S = scale; the seat is 40 S wide and its top is 56 S high), the centre of the seat at x = y = 0, the front towards +x
36425 PROC CHAIRMESH(O,S)
36430   LOCAL L,H,Q,K,Y
36435   L=20*S:H=34*S:Q=4*S
36440   M3D BOX O,-L,-L,H-7*S,L,L,H-3*S,26
36445   M3D BOX O,-L+2*S,-L+2*S,H-3*S,L-2*S,L-2*S,H,304
36450   M3D BOX O,-L,-L,0,-L+Q,-L+Q,H-7*S,26
36455   M3D BOX O,-L,L-Q,0,-L+Q,L,H-7*S,26
36460   M3D BOX O,L-Q,-L,0,L,-L+Q,H-7*S,26
36465   M3D BOX O,L-Q,L-Q,0,L,L,H-7*S,26
36470   M3D BOX O,-L,-L,H,-L+Q,-L+Q,H*1.75,26
36475   M3D BOX O,-L,L-Q,H,-L+Q,L,H*1.75,26
36480   M3D BOX O,-L,-L+Q,H*1.75-8*S,-L+Q,L-Q,H*1.75,26
36485   FOR K=0 TO 3
36490     Y=-L+Q+K*((2*L-2*Q)/4)+((2*L-2*Q)/8)-S
36495     M3D BOX O,-L+S,Y,H+6*S,-L+Q-S,Y+2*S,H*1.75-8*S,26
36500   NEXT K
36505 END PROC
36510 ' ------------------------------------------------------------------------------------------------ the fixtures
36515 ' the table FIXDATA: thing N, kind (0 a flat thing on a surface, 1 a box with a front picture, 2 a special mesh, 3 a flat thing on a table top), face (the front looks east 0,
36520 ' north 1, west 2, south 3), C = the middle along the wall, BP = the wall's coordinate, picture width and height (pixels = units), depth D, height above the floor Z0, the picture
36525 ' of the sides, the floor level for FLOORAT, then three pairs state picture T (the game's TXN) and picture P (-1 = none)
36530 PROC FIXORIGIN(FACE,C,BP,D)
36535   IF FACE=0 THEN FX=BP+D:FY=C
36540   IF FACE=1 THEN FX=C:FY=BP+D
36545   IF FACE=2 THEN FX=BP-D:FY=C
36550   IF FACE=3 THEN FX=C:FY=BP-D
36555 END PROC
36560 PROC BUILDFIX
36565   LOCAL N,KD2,FACE,C,BP,PW,PH,D,Z0,BT,LZ,I,T,P,O,YW
36570   FOR I=0 TO 419
36575     VOK(I)=0
36580   NEXT I
36585   NMB=0
36590   RESTORE FIXDATA
36595   READ N
36600   WHILE N>=0
36605     READ KD2,FACE,C,BP,PW,PH,D,Z0,BT,LZ
36610     YW=FACE*90
36615     CALL FIXORIGIN(FACE,C,BP,D)
36620     IF KD2=1 OR KD2=0 THEN FZ=M3D("FLOORAT",FX,FY,LZ)+Z0
36625     IF KD2=1 THEN
36630       M3D OBJECT 4000+N,8
36635       M3D OBJPOS 4000+N,FX,FY,FZ,YW
36640       M3D BOX 4000+N,-D,-PW/2,0,0,PW/2,PH,BT,62
36645       IF N=37 THEN M3D BOX 4000+N,-26,-20,-20,0,20,0,302
36650     END IF
36655     FOR I=0 TO 2
36660       READ T,P
36665       IF T>0 THEN
36670         O=3500+T
36675         M3D OBJECT O,12
36680         M3D OBJPOS O,FX,FY,FZ,YW
36685         CALL PICQ(O,0.2,-PW/2,PW/2,0,PH,P)
36690         M3D OBJSHOW O,0
36695         VOK(T)=-1
36700       END IF
36705     NEXT I
36710     IF KD2<>2 AND KD2<>3 THEN CALL FIXBIND(N,0)
36715     IF KD2=2 THEN CALL FIXSPECIAL(N,C,BP)
36720     IF KD2=3 THEN CALL FIXNOTE(N)
36725     READ N
36730   WEND
36735   CALL BUILDCHAIRS
36736   CALL BUILDBOOTH
36740 END PROC
