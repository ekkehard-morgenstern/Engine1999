4510   IF N=PNOZZLE AND NOT FED THEN
4520     CALL SAY("THE GLORP SITS ON THE NOZZLE AND SNIFFS THE AIR. IT WANTS GREEN JELLY.")
4530     CALL SOUND_(6)
4540     EXIT PROC
4550   END IF
4560   CALL TAKE(N)
4570 END PROC
4580 PROC DOACT(N)
4590   LOCAL A
4600   A=ACT(N)
4610   IF A=20 THEN CALL SAY(DESC$(N))
4620   IF A=1 THEN
4630     IF OVENCOOL THEN
4640       IF NOT OVENOPEN THEN
4650         OVENOPEN=-1:TXN(OOVEN)=66:CALL SHOWTHING(OOVEN)
4660         CALL REVEAL(PCOIL)
4670         CALL SAY("YOU OPEN THE OVEN. INSIDE LIES A FLUX COIL!")
4680         CALL SOUND_(5)
4690       ELSE
4700         CALL SAY("THE OVEN IS EMPTY NOW.")
4710       END IF
4720     ELSE
4730      IF OVENT>0 THEN
4740       CALL SAY("THE OVEN IS STILL TOO HOT TO OPEN. BE PATIENT.")
4750     ELSE
4760       OVENT=GT
4770       CALL SAY("THE OVEN IS HOT. YOU TURN THE KNOB OFF: IT STARTS TO COOL DOWN.")
4780       CALL SOUND_(8)
4790     END IF
4800     END IF
4810   END IF
4820   IF A=2 THEN
4830     IF FRIDGEOP THEN
