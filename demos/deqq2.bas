35080 ' where a car is on the ring road: S = the distance driven (0 .. CARLOOP), the outer lanes, anticlockwise: the south road eastbound (y -190), the east road
35090 ' northbound (x 1650), the north road westbound (y 1700), the west road southbound (x -560); sets CX, CY and CH (the heading, in radians, 0 = east)
35100 PROC CARPLACE(S)
35110   IF S<2210 THEN
35120     CX=-560+S:CY=-190:CH=0
35130   ELSE
35140     IF S<4100 THEN
35150       CX=1650:CY=-190+(S-2210):CH=1.5707963
35160     ELSE
35170       IF S<6310 THEN
35180         CX=1650-(S-4100):CY=1700:CH=3.1415927
35190       ELSE
35200         CX=-560:CY=1700-(S-6310):CH=4.712389
35210       END IF
35220     END IF
35230   END IF
35240 END PROC
35250 ' the cars: up to three at a time, a new one every 15 .. 40 seconds, each drives once round the block (51 s) and is gone; one that has you in front of it on the road
35260 ' brakes and honks, then drives on when the way is free; the picture shows the car from the side it is seen from (4 views)
35270 PROC CARS(DT)
35280   LOCAL K,F,L,DX,DY,HX,HY,DT2,V
35290   IF GT>=CARNEXT THEN
35300     CARNEXT=GT+15+RND(1)*25
35310     FOR K=0 TO 2
35320       IF CARON(K)=0 AND CARSP=0 THEN
35330         CARSP=1
35340         CARON(K)=-1:CARD(K)=0:CARV(K)=0:CARCOL(K)=INT(RND(1)*3):CARHON(K)=0:CARSND(K)=0
35350         CALL CARPLACE(0)
35360         M3D OBJPOS 3200+K*3+CARCOL(K),CX,CY,0,0
35365         M3D OBJSHOW 3200+K*3+CARCOL(K),-1
35370       END IF
35380     NEXT K
35390     CARSP=0
35400   END IF
35410   NCARS=0
35420   FOR K=0 TO 2
35430     IF CARON(K) THEN
35440       NCARS=NCARS+1
35450       CALL CARPLACE(CARD(K))
35460       HX=COS(CH):HY=SIN(CH)
35470       DX=PX-CX:DY=PY-CY
35480       F=DX*HX+DY*HY:L=-DX*HY+DY*HX
35490       V=150
35500       IF F>0 AND F<200 AND ABS(L)<70 AND (PY<-60 OR PY>1580 OR PX<-440 OR PX>1530) THEN
35510         V=0
35520         IF GT>=CARHON(K) THEN
35530           CARHON(K)=GT+4:CALL SOUND_(11)
35540           IF PY<-60 OR PY>1580 OR PX<-440 OR PX>1530 THEN CALL SAY("A CAR HONKS: GET OUT OF THE ROAD!")
35550         END IF
35560       END IF
35570       IF CARV(K)<V THEN CARV(K)=MIN(V,CARV(K)+240*DT)
35580       IF CARV(K)>V THEN CARV(K)=MAX(V,CARV(K)-480*DT)
35590       CARD(K)=CARD(K)+CARV(K)*DT
35600       IF CARD(K)>=8200 THEN
35610         CARON(K)=0:M3D OBJSHOW 3200+K*3+CARCOL(K),0
35620       ELSE
35630         CALL CARPLACE(CARD(K))
35640         DX=CX-PX:DY=CY-PY
35650         M3D OBJPOS 3200+K*3+CARCOL(K),CX,CY,0,CH*57.29578
35790         IF SQR(DX*DX+DY*DY)<380 AND GT>=CARSND(K) THEN
35800           CARSND(K)=GT+9:CALL SOUND_(10)
35810         END IF
35820       END IF
35830     END IF
35840   NEXT K
35850 END PROC
36000 ' ------------------------------------------------------------------------------------------------ furniture, appliances and flat things as meshes
36005 ' The things of the game logic (OBJDATA: reach, prompts, states by the picture number TXN) stay where they are, but they are drawn as nothing (picture 299, one see-through
36010 ' pixel); MESHSYNC (end of TICK) shows the mesh that belongs to them: a body (object 4000 + N) and, for each state picture T, a front (object 3500 + T) that is shown
36015 ' while TXN(N) = T. Flat things (a mirror, a photo, the front of the cupboard) are quads in front of the surface next to them, with explicit picture coordinates.
36020 ' pictures: 299 blank, 300 white enamel, 301 steel, 302 dark wood, 303 dark metal, 304 red cushion, 305 linen, 306 the cupboard's front (80 x 58), 307 water, 308 clay,
