2770 ' the sprites: DATA n,w,h then commands t,a,b,c,d,hue,shade (see demos/levels/deqq2art.py) up to a 0; the table ends with -1
2780 PROC MAKESPRITES
2790   LOCAL N,W,H,T,A,B,C,D,HU,SH,K
2800   RESTORE ARTDATA
2810   READ N
2820   WHILE N>=0
2830     READ W,H
2840     GFX CLEAR 0
2850     READ T
2860     WHILE T>0
2870       READ A,B,C,D,HU,SH
2880       K=FN CI(HU,SH)
2890       IF T=1 THEN GFX LINE A,B,C,D,K,BF
2900       IF T=2 THEN GFX LINE A,B,C,D,K,B
2910       IF T=3 THEN GFX LINE A,B,C,D,K
2920       IF T=4 THEN
2930         GFX CIRCLE A,B,C,K,-1,-1,D/10
2940         GFX PAINT A,B,K,K
2950       END IF
2960       IF T=5 THEN GFX PSET A,B,K
2970       READ T
2980     WEND
2990     CALL W3K_GRAB(N,W,H)
3000     READ N
3010   WEND
3020   GFX CLEAR 0
3030   CALL W3K_GRAB(99,4,4)
3040 END PROC
3050 PROC LOADLEVEL
3060   LOCAL NS,I,S,F,C,FT,CT,L,TG,NW,J,X1,Y1,X2,Y2,T,NX,FL,UP,LO,XO,YO
3070   RESTORE LEVELDATA
3080   READ NS
3090   FOR I=1 TO NS
3100     READ S,F,C,FT,CT,L,TG,NW
3110     W3D SECTOR S,F,C,FT,CT,L
3120     W3D TAG S,TG
3130     FOR J=0 TO NW-1
3140       READ X1,Y1,X2,Y2,T,NX,FL,UP,LO,XO,YO
3150       W3D WALL S,X1,Y1,X2,Y2,T,NX
3160       IF UP>=0 OR LO>=0 THEN W3D WALLTEX S,J,-1,UP,LO
3170       IF FL<>0 THEN W3D WALLFLAG S,J,FL
3180       IF XO<>0 OR YO<>0 THEN W3D WALLOFF S,J,XO,YO
3190     NEXT J
3200   NEXT I
3210 END PROC
