3420 ' ------------------------------------------------------------------------------------------------ doors, the cellar's light, timers
3430 PROC DOORS(DT)
3440   LOCAL I,G
3450   FOR I=1 TO 4
3460     IF DOP(I) THEN G=100 ELSE G=0
3470     IF DCUR(I)<G THEN DCUR(I)=MIN(G,DCUR(I)+90*DT)
3480     IF DCUR(I)>G THEN DCUR(I)=MAX(G,DCUR(I)-90*DT)
3490     W3D HEIGHT DSEC(I),0,DCUR(I)
3500   NEXT I
3510 END PROC
3520 PROC LANTERNLIGHT
3530   LOCAL L,S
3540   L=FN HAS(ILANT)
3550   IF L=LANTON THEN EXIT PROC
3560   LANTON=L
3570   FOR S=34 TO 38
3580     IF L THEN W3D LIGHT S,170 ELSE W3D LIGHT S,90
3590   NEXT S
3600   FOR S=39 TO 45
3610     IF S=39 OR S=45 THEN
3620       IF L THEN W3D LIGHT S,185 ELSE W3D LIGHT S,45
3630     END IF
3640   NEXT S
3650 END PROC
3660 ' things that happen after a while: the oven cools down, the compass comes out of the melting ice
3670 PROC TIMERS
3680   IF OVENT>0 AND OVENCOOL=0 AND GT>=OVENT+30 THEN
3690     OVENCOOL=-1
3700     TXN(OOVEN)=65:CALL SHOWTHING(OOVEN)
3710     CALL SAY("THE OVEN HAS COOLED DOWN. YOU CAN OPEN IT NOW.")
