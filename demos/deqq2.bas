10130 ' ------------------------------------------------------------------------------------------------ one step of the world, a new game
10140 ' the music: calm and slow; uneasy (the same with a heartbeat) when Deqq is near; danger while he follows you and for four seconds after
10150 PROC MUSICMOOD
10160   LOCAL W,D
10170   D=M3D("DIST",IDEQQ)
10180   IF DQS=2 THEN MUT=GT+4
10190   IF GT<MUT THEN
10200     W=4
10210   ELSE
10220     IF D<380 THEN W=3 ELSE W=2
10230   END IF
10240   CALL MU_MODE(W)
10250 END PROC
10260 PROC TICK(DT)
10270   GT=GT+DT
10280   PX=M3D("X"):PY=M3D("Y")
10290   CALL DOORS(DT)
10300   CALL LANTERNLIGHT
10310   IF FN HAS(ILANT) THEN M3D LAMP 0,PX,PY,50,280,170 ELSE M3D LAMP 0,PX,PY,50,0,0
10320   IF M3D("TON",OWRECK) THEN M3D LAMP 1,M3D("TX",OWRECK),M3D("TY",OWRECK),60,320,30+NBUILT*18
10330   IF DQON AND DQS=2 THEN M3D LAMP 2,M3D("TX",IDEQQ),M3D("TY",IDEQQ),50,220,120 ELSE M3D LAMP 2,0,0,0,0,0
10340   CALL TIMERS
10350   REM (the washing machine's pictures are shown by MESHSYNC from TXN)
10351   IF NOT POWEROFF THEN TXN(OWASH)=70+(INT(GT*5) AND 1)
10360   IF GATET>0 AND GT>=GATET THEN
10370     GATET=0:M3D OBJSHOW 3000,0
10380     IF PY<0 THEN CALL SAY("THE GATE CLICKS: IT IS UNLOCKED AGAIN.")
10390   END IF
10400   CALL CARS(DT)
10410   IF DQON THEN CALL DEQQAI(DT)
10420   CALL MUSICMOOD
10425   CALL MESHSYNC
10430 END PROC
