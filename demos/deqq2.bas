3310 ' the sprites: DATA n,w,h then commands t,a,b,c,d,hue,shade (see demos/levels/deqq2art.bas) up to a 0; the table ends with -1
3320 PROC MAKESPRITES
3330   LOCAL N,W,H,T,A,B,C,D,HU,SH,K
3340   RESTORE ARTDATA
3350   READ N
3360   WHILE N>=0
3370     READ W,H
3380     GFX CLEAR 0
3390     READ T
3400     WHILE T>0
3410       READ A,B,C,D,HU,SH
3420       K=FN CI(HU,SH)
3430       IF T=1 THEN GFX LINE A,B,C,D,K,BF
3440       IF T=2 THEN GFX LINE A,B,C,D,K,B
3450       IF T=3 THEN GFX LINE A,B,C,D,K
3460       IF T=4 THEN
3470         GFX CIRCLE A,B,C,K,-1,-1,D/10
3480         GFX PAINT A,B,K,K
3490       END IF
3500       IF T=5 THEN GFX PSET A,B,K
3510       READ T
3520     WEND
3530     CALL W3K_GRAB(N,W,H)
3540     READ N
3550   WEND
3560   GFX CLEAR 0
3570   CALL W3K_GRAB(99,4,4)
3580 END PROC
3590 PROC LOADLEVEL
3600   LOCAL NS,I,S,F,C,FT,CT,L,TG,NW,J,X1,Y1,X2,Y2,T,NX,FL,UP,LO,XO,YO
3610   RESTORE LEVELDATA
3620   READ NS
3630   FOR I=1 TO NS
3640     READ S,F,C,FT,CT,L,TG,NW
3650     W3D SECTOR S,F,C,FT,CT,L
3660     W3D TAG S,TG
3670     FOR J=0 TO NW-1
3680       READ X1,Y1,X2,Y2,T,NX,FL,UP,LO,XO,YO
3690       W3D WALL S,X1,Y1,X2,Y2,T,NX
3700       IF UP>=0 OR LO>=0 THEN W3D WALLTEX S,J,-1,UP,LO
3710       IF FL<>0 THEN W3D WALLFLAG S,J,FL
3720       IF XO<>0 OR YO<>0 THEN W3D WALLOFF S,J,XO,YO
3730     NEXT J
3740   NEXT I
3750 END PROC
