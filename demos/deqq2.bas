3190 PROC LOADLEVEL
3200   LOCAL NS,I,S,F,C,FT,CT,L,TG,NW,J,X1,Y1,X2,Y2,T,NX,FL,UP,LO,XO,YO
3210   RESTORE LEVELDATA
