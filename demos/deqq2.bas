8480 ' a banner over the picture of the world for a few seconds (the player stands still)
8490 PROC BANNER(T1$,T2$,SEC)
8492   LOCAL T0,N,R$,P,I
8494   IF HL THEN
8496     PRINT "# ";T1$
8498     EXIT PROC
8500   END IF
8502   R$=T2$:N=0
8504   WHILE R$<>"" AND N<3
8506     P=LEN(R$)
8508     IF P>58 THEN
8510       P=58
8512       WHILE P>1 AND MID$(R$,P+1,1)<>" "
8514         P=P-1
8516       WEND
8518       IF P<=1 THEN P=58
8520     END IF
8522     BNL$(N)=LEFT$(R$,P)
8524     R$=MID$(R$,P+1)
8526     IF LEFT$(R$,1)=" " THEN R$=MID$(R$,2)
8528     N=N+1
8530   WEND
8532   T0=TI
8534   WHILE TI-T0<SEC*60
8536     M3D RENDER
8538     GFX LINE 60,56,579,186,FN CI(0,1),BF
8540     GFX LINE 60,56,579,186,FN CI(1,10),B
8542     CALL BIGTEXT(68,T1$,FN CI(3,15),2)
8544     FOR I=0 TO N-1
8546       CALL CTEXT(112+I*16,BNL$(I),FN CI(0,13))
8548     NEXT I
8550     CALL W3K_SHOW
8552   WEND
8554   W3K_T0=TI
8556 END PROC
