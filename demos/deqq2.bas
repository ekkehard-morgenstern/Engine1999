32720   IF FN W3K_R(100)<LIT THEN GFX LINE X+3,Y+3,X+28,Y+40,FN W3K_C(3,13),BF ELSE GFX LINE X+3,Y+3,X+28,Y+40,FN W3K_C(9,3),BF
32730   GFX LINE X+15,Y+3,X+16,Y+40,FN W3K_C(12,6),BF
32740   GFX LINE X+3,Y+20,X+28,Y+21,FN W3K_C(12,6),BF
32750   GFX LINE X-2,Y+44,X+33,Y+47,FN W3K_C(0,12),BF
32760 END PROC
32770 ' a house front 128 x 300: bricks of hue HW, roof of hue HR, two floors of windows (LIT = percent of lit ones), a door
32780 PROC TOWNFACADE(N,HW,HR,LIT,DK)
32790   LOCAL R,B,X,S,K
32800   GFX CLEAR FN W3K_C(HW,5)
32810   FOR R=0 TO 31
