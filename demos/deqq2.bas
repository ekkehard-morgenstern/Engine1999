3650 ' ------------------------------------------------------------------------------------------------ doors, the cellar's light, timers
3660 PROC DOORS(DT)
3670   LOCAL I,G
3680   FOR I=1 TO 4
3690     IF DOP(I) THEN G=100 ELSE G=0
3700     IF DCUR(I)<G THEN DCUR(I)=MIN(G,DCUR(I)+90*DT)
3710     IF DCUR(I)>G THEN DCUR(I)=MAX(G,DCUR(I)-90*DT)
3720     W3D HEIGHT DSEC(I),0,DCUR(I)
3730   NEXT I
3740 END PROC
3750 PROC LANTERNLIGHT
3760   LOCAL L,S
3770   L=FN HAS(ILANT)
3780   IF L=LANTON THEN EXIT PROC
3790   LANTON=L
3800   FOR S=34 TO 38
3810     IF L THEN W3D LIGHT S,170 ELSE W3D LIGHT S,90
3820   NEXT S
3830   FOR S=39 TO 45
3840     IF S=39 OR S=45 THEN
3850       IF L THEN W3D LIGHT S,185 ELSE W3D LIGHT S,45
3860     END IF
3870   NEXT S
3880 END PROC
3890 ' things that happen after a while: the oven cools down, the compass comes out of the melting ice
3900 PROC TIMERS
