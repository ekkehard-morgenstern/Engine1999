3880   END IF
3890   IF N=PNOZZLE AND NOT FED THEN
3900     CALL SAY("THE GLORP SITS ON THE NOZZLE AND SNIFFS THE AIR. IT WANTS GREEN JELLY.")
3910     CALL SOUND_(6)
3920     EXIT PROC
3930   END IF
3940   CALL TAKE(N)
3950 END PROC
3960 PROC DOACT(N)
