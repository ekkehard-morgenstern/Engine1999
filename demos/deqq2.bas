11020       PROMPT$="E: TAKE THE "+NMS$(N)
11030     ELSE
11040       PROMPT$="E: "+NMS$(N)
11050     END IF
11060   ELSE
11070     S=M3D("USE",70)
11080     FOR I=2 TO 4
11090       IF S=DSEC(I) THEN
11100         IF DOP(I) THEN PROMPT$="E: CLOSE THE DOOR" ELSE PROMPT$="E: OPEN THE DOOR"
11110       END IF
11120     NEXT I
11130   END IF
11140 END PROC
11150 PROC PLAYLEVEL
11160   LOCAL DT,U,UL,BL,B,Y,YL,T0,FR,DBG,DL,FK
11170   UL=0:BL=0:YL=0:FR=0:DBG=0:DL=0
11180   T0=TI
11190   REPEAT
11200     DT=(TI-T0)/60:T0=TI
11210     IF DT>0.1 THEN DT=0.1
11220     CALL W3K_WALK
11230     CALL W3K_JUMP(KEY("SPACE") OR JOY("A"))
11240     U=KEY("E") OR KEY("RETURN") OR JOY("X")
11250     IF U<>0 AND UL=0 THEN CALL USEKEY
11260     UL=U
11270     B=KEY("G") OR JOY("B")
11280     IF B<>0 AND BL=0 THEN CALL DROPLAST
11290     BL=B
11300     IF KEY("ESC") THEN IN_QUIT=1
11310     CALL TICK(DT)
11320     IF FR MOD 5=0 THEN CALL PROMPTUPDATE
11330     M3D RENDER
11340     CALL HUD
11350     FK=KEY("F3")
11360     IF FK<>0 AND DL=0 THEN DBG=NOT DBG
11370     DL=FK
11380     IF DBG THEN
11390       GFX LINE 0,226,639,238,FN CI(0,1),BF
11400       GFX TEXT 4,227,"X "+STR$(INT(M3D("X")))+" Y "+STR$(INT(M3D("Y")))+" Z "+STR$(INT(M3D("Z")))+"  ANGLE "+STR$(INT(M3D("YAW")))+"  SECTOR "+STR$(FN ZONEP),FN CI(3,15)
11410     END IF
11420     ' the aim point (what E uses is straight ahead): a small cross with a dark edge, readable on sky and on walls
11421     GFX LINE 311,130,316,133,FN CI(0,1),BF:GFX LINE 323,130,328,133,FN CI(0,1),BF
11422     GFX LINE 318,123,321,128,FN CI(0,1),BF:GFX LINE 318,135,321,140,FN CI(0,1),BF
11423     GFX LINE 312,131,315,132,FN CI(0,15),BF:GFX LINE 324,131,327,132,FN CI(0,15),BF
11424     GFX LINE 319,124,320,127,FN CI(0,15),BF:GFX LINE 319,136,320,139,FN CI(0,15),BF
11430     CALL W3K_SHOW
11440     FR=FR+1
11450     IF FN IN_SERVICE() THEN
11460       CALL BIGTEXT(110,"PAUSED",FN CI(0,15),3)
11470       CALL W3K_SHOW
11480       CALL MU_SILENCE
11490       CALL IN_PAUSELOOP
11500       CALL MU_START
11510       T0=TI:W3K_T0=TI
11520     END IF
11530     IF IN_KEY=77 THEN CALL MU_TOGGLE
11540     Y=JOY("Y")
11550     IF IN_KEY=79 OR (Y<>0 AND YL=0) THEN
11560       CALL P3_DIALOG
11570       T0=TI
11580     END IF
11590     YL=Y
11600   UNTIL IN_QUIT OR ENDREQ
