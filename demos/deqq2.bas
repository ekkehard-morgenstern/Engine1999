240 DIM INV(3),BUILT(9),DSEC(5),DOP(5),DLK(5),DCUR(5),WPX(60),WPY(60),WPP(60),NM$(30),CMT$(12)
250 GOTO MAIN
260 ' ------------------------------------------------------------------------------------------------ small helpers
270 FUNC CI(H,S)
280   RETURN 16+H*16+S
290 END FUNC
300 FUNC RI(M)
310   RETURN INT(RND(1)*M)
320 END FUNC
330 ' the angle difference of two directions (radians): 0 .. pi
340 FUNC ADIFF(A,B)
350   LOCAL D
360   D=A-B
370   D=D-INT(D/6.283185307)*6.283185307
380   IF D>3.141592654 THEN D=6.283185307-D
390   RETURN D
400 END FUNC
410 ' ------------------------------------------------------------------------------------------------ messages
420 ' SAY shows a line of at most two rows at the top of the picture for a few seconds (the headless test prints them)
430 PROC SAY(T$)
440   LOCAL I,K
450   IF HL THEN
460     PRINT "> ";T$
470     EXIT PROC
480   END IF
490   MSG1$=T$:MSG2$=""
500   IF LEN(T$)>76 THEN
510     K=76
520     FOR I=76 TO 40 STEP -1
530       IF MID$(T$,I,1)=" " AND K=76 THEN K=I
540     NEXT I
550     MSG1$=LEFT$(T$,K-1):MSG2$=MID$(T$,K+1)
560   END IF
570   MSGT=4.5
580 END PROC
590 PROC SOUND_(N)
600   IF NOT HL THEN SFX N
610 END PROC
620 ' ------------------------------------------------------------------------------------------------ things and what you carry
630 PROC PLACEALL
640   LOCAL N,X,Y,T,W,H,ZO,LT,K,SLT,A,R,SH,NA$
650   FOR N=0 TO 199
660     KD(N)=0
670     W3D THINGOFF N
680   NEXT N
690   NIL=0
700   RESTORE OBJDATA
710   READ N
720   WHILE N>=0
730     READ X,Y,T,W,H,ZO,LT,K,SLT,A,R,SH,NA$
740     KD(N)=K:SL(N)=SLT:HX(N)=X:HY(N)=Y:TXN(N)=T:TWD(N)=W:THT(N)=H:TZO(N)=ZO:TLT(N)=LT:ACT(N)=A:RCH(N)=R:NMS$(N)=NA$
750     IF K>0 THEN
760       IL(NIL)=N
770       NIL=NIL+1
780     END IF
790     IF SH THEN CALL SHOWTHING(N)
800     READ N
810   WEND
820 END PROC
830 ' puts thing N in the world at its place (its home place, or X,Y if they are given: CALL SHOWAT)
840 PROC SHOWTHING(N)
850   W3D THING N,HX(N),HY(N),TXN(N),TWD(N),THT(N)
860   IF TZO(N)<>0 THEN W3D THINGZ N,TZO(N)
870   IF TLT(N)>=0 THEN W3D THINGLIGHT N,TLT(N)
880 END PROC
890 PROC SHOWAT(N,X,Y)
900   W3D THING N,X,Y,TXN(N),TWD(N),THT(N)
910   IF TZO(N)<>0 THEN W3D THINGZ N,TZO(N)
920   IF TLT(N)>=0 THEN W3D THINGLIGHT N,TLT(N)
930 END PROC
940 ' a thing appears where it lies hidden (it is a new home for it)
950 PROC REVEAL(N)
960   CALL SHOWTHING(N)
970 END PROC
980 FUNC SLOTSUSED(X)
990   LOCAL I,S
1000   S=0
1010   FOR I=0 TO 2
1020     IF INV(I)>=0 THEN S=S+SL(INV(I))
1030   NEXT I
1040   RETURN S
1050 END FUNC
1060 FUNC HAS(N)
1070   LOCAL I,R
1080   R=0
1090   FOR I=0 TO 2
1100     IF INV(I)=N THEN R=-1
1110   NEXT I
1120   RETURN R
1130 END FUNC
1140 PROC TAKE(N)
1150   LOCAL I,F
1160   IF FN SLOTSUSED(0)+SL(N)>3 THEN
1170     CALL SAY("YOU CAN CARRY THREE PLACES OF THINGS. PUT SOMETHING DOWN FIRST (G).")
1180     CALL SOUND_(6)
1190     EXIT PROC
1200   END IF
1210   F=-1
1220   FOR I=2 TO 0 STEP -1
1230     IF INV(I)<0 THEN F=I
1240   NEXT I
1250   INV(F)=N
1260   W3D THINGOFF N
1270   CALL SAY("YOU TAKE THE "+NMS$(N)+".")
1280   CALL SOUND_(1)
1290 END PROC
1300 ' removes N from what you carry (used up or built in); the thing stays hidden
1310 PROC USEUP(N)
1320   LOCAL I
1330   FOR I=0 TO 2
1340     IF INV(I)=N THEN INV(I)=-1
1350   NEXT I
1360 END PROC
1370 PROC DROPLAST
1380   LOCAL I,N,X,Y,F,A
1390   N=-1
1400   FOR I=0 TO 2
1410     IF INV(I)>=0 THEN N=INV(I):F=I
1420   NEXT I
1430   IF N<0 THEN
1440     CALL SAY("YOU CARRY NOTHING.")
1450     EXIT PROC
1460   END IF
1470   A=W3D("ANGLE")*3.141592654/180
1480   X=PX+COS(A)*34:Y=PY+SIN(A)*34
1490   IF W3D("SECTORAT",X,Y)<0 OR W3D("TAG",W3D("SECTORAT",X,Y))=50 THEN X=PX:Y=PY
1500   IF W3D("SECTORAT",X,Y)<0 THEN EXIT PROC
1510   INV(F)=-1
1520   CALL SHOWAT(N,X,Y)
1530   CALL SAY("YOU PUT DOWN THE "+NMS$(N)+".")
1540 END PROC
1550 ' the nearest thing that you can use in front of you (within its reach, in view); -1 if there is none
1560 FUNC TARGET(X)
1570   LOCAL I,N,B,D,BEST,BD
1580   BEST=-1:BD=1000
1590   FOR I=0 TO NIL-1
1600     N=IL(I)
1610     IF W3D("TON",N) THEN
1620       D=W3D("DIST",N)
1630       IF D<RCH(N) AND D<BD THEN
1640         B=ABS(W3D("BEARING",N))
1650         IF B<40 OR D<30 THEN
1660           IF W3D("SEES",N) THEN
1670             BEST=N:BD=D
1680           END IF
1690         END IF
1700       END IF
1710     END IF
1720   NEXT I
1730   RETURN BEST
1740 END FUNC
1750 ' ------------------------------------------------------------------------------------------------ the safe's dial
1760 FUNC DIAL(X)
1770   LOCAL SEL,OK,CN,LOK,LCN,LU,LD,LL,LR,U,D,L,R,DONE,RES,I,C
1780   IF HL THEN
1790     RES=(DIALIN$="731")
1800     DIALIN$=""
1810     RETURN RES
1820   END IF
1830   DG(0)=0:DG(1)=0:DG(2)=0:SEL=0:DONE=0:RES=0
1840   WHILE INKEY$<>""
1850   WEND
1860   LOK=-1:LCN=-1:LU=-1:LD=-1:LL=-1:LR=-1
1870   REPEAT
1880     W3D RENDER
1890     GFX LINE 200,70,439,190,FN CI(0,1),BF
1900     GFX LINE 200,70,439,190,FN CI(0,9),B
1910     GFX LINE 201,71,438,189,FN CI(0,5),B
1920     CALL CTEXT(78,"THE SAFE",FN CI(3,15))
1930     CALL CTEXT(94,"THREE DIGITS: UP/DOWN CHANGE, LEFT/RIGHT CHOOSE",FN CI(0,10))
1940     FOR I=0 TO 2
1950       IF I=SEL THEN C=FN CI(3,15) ELSE C=FN CI(0,11)
1960       GFX LINE 240+I*60,112,279+I*60,160,FN CI(0,3),BF
1970       GFX LINE 240+I*60,112,279+I*60,160,C,B
1980       GFX TEXT 250+I*60,122,STR$(DG(I)),C,3,3
1990     NEXT I
2000     CALL CTEXT(168,"RETURN: TRY    ESC: LEAVE",FN CI(0,10))
2010     IF DIALMSG>0 THEN
2020       CALL CTEXT(180,"NOTHING HAPPENS.",FN CI(1,13))
2030       DIALMSG=DIALMSG-1
2040     END IF
2050     CALL W3K_SHOW
2060     U=KEY("UP") OR KEY("W") OR JOY("UP"):D=KEY("DOWN") OR KEY("S") OR JOY("DOWN")
2070     L=KEY("LEFT") OR KEY("A") OR JOY("LEFT"):R=KEY("RIGHT") OR KEY("D") OR JOY("RIGHT")
2080     OK=KEY("RETURN") OR KEY("E") OR JOY("A") OR JOY("X"):CN=KEY("ESC") OR JOY("B") OR JOY("BACK")
2090     IF U<>0 AND LU=0 THEN DG(SEL)=(DG(SEL)+1) MOD 10
2100     IF D<>0 AND LD=0 THEN DG(SEL)=(DG(SEL)+9) MOD 10
2110     IF L<>0 AND LL=0 THEN SEL=(SEL+2) MOD 3
2120     IF R<>0 AND LR=0 THEN SEL=(SEL+1) MOD 3
2130     IF OK<>0 AND LOK=0 THEN
2140       IF DG(0)=7 AND DG(1)=3 AND DG(2)=1 THEN
2150         RES=-1:DONE=-1
2160       ELSE
2170         DIALMSG=40
2180         CALL SOUND_(6)
2190       END IF
2200     END IF
2210     IF CN<>0 AND LCN=0 THEN DONE=-1
2220     LU=U:LD=D:LL=L:LR=R:LOK=OK:LCN=CN
2230   UNTIL DONE
2240   WHILE KEY("RETURN") OR KEY("E") OR KEY("ESC")
2250     FRAME
2260   WEND
2270   WHILE INKEY$<>""
2280   WEND
2290   W3K_T0=TI
2300   RETURN RES
2310 END FUNC
2320 FUNC BITS(M)
2330   LOCAL K,N
2340   N=0
2350   FOR K=0 TO 7
2360     IF (M\(2^K)) AND 1 THEN N=N+1
2370   NEXT K
2380   RETURN N
2390 END FUNC
