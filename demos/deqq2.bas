4040 ' ------------------------------------------------------------------------------------------------ the puzzles
4050 ' a part or an item is taken (some parts have a condition)
4060 PROC PICKUP(N)
4070   IF N=PCRYSTAL AND W3D("SECTOR")<>CHAIRSEC THEN
4080     CALL SAY("IT IS ON TOP OF THE CUPBOARD, OUT OF REACH. YOU NEED TO STAND ON SOMETHING.")
4090     CALL SOUND_(6)
4100     EXIT PROC
4110   END IF
4120   IF N=PNOZZLE AND NOT FED THEN
4130     CALL SAY("THE GLORP SITS ON THE NOZZLE AND SNIFFS THE AIR. IT WANTS GREEN JELLY.")
4140     CALL SOUND_(6)
4150     EXIT PROC
4160   END IF
4170   CALL TAKE(N)
4180 END PROC
4190 PROC DOACT(N)
4200   LOCAL A
4210   A=ACT(N)
4220   IF A=20 THEN CALL SAY(DESC$(N))
4230   IF A=1 THEN
4240     IF OVENCOOL THEN
4250       IF NOT OVENOPEN THEN
4260         OVENOPEN=-1:TXN(OOVEN)=66:CALL SHOWTHING(OOVEN)
4270         CALL REVEAL(PCOIL)
4280         CALL SAY("YOU OPEN THE OVEN. INSIDE LIES A FLUX COIL!")
4290         CALL SOUND_(5)
4300       ELSE
4310         CALL SAY("THE OVEN IS EMPTY NOW.")
4320       END IF
4330     ELSE
4340      IF OVENT>0 THEN
4350       CALL SAY("THE OVEN IS STILL TOO HOT TO OPEN. BE PATIENT.")
4360     ELSE
4370       OVENT=GT
4380       CALL SAY("THE OVEN IS HOT. YOU TURN THE KNOB OFF: IT STARTS TO COOL DOWN.")
4390       CALL SOUND_(8)
4400     END IF
4410     END IF
4420   END IF
4430   IF A=2 THEN
4440     IF FRIDGEOP THEN
4450       CALL SAY("THE FRIDGE HUMS IN TWO KEYS AT ONCE.")
4460     ELSE
4470       FRIDGEOP=-1:TXN(OFRIDGE)=68:CALL SHOWTHING(OFRIDGE)
4480       CALL REVEAL(IJELLY):CALL REVEAL(IICE)
4490       CALL SAY("YOU OPEN THE FRIDGE: GREEN JELLY, AND A BLOCK OF ICE WITH SOMETHING INSIDE.")
4500       CALL SOUND_(5)
4510     END IF
4520   END IF
4530   IF A=3 THEN
4540     IF FN HAS(IICE) THEN
4550       CALL USEUP(IICE)
4560       MELTT=GT+5
4570       CALL SAY("YOU TURN ON THE TAP AND HOLD THE ICE UNDER THE WARM WATER...")
4580       CALL SOUND_(9)
4590     ELSE
4600       CALL SAY("A DEEP STONE SINK. THE TAP RUNS WARM WATER.")
4610     END IF
4620   END IF
4630   IF A=4 THEN
4640     IF FN HAS(ICHAIR) THEN
4650       CALL USEUP(ICHAIR)
4660       CHAIRON=-1
4670       W3D HEIGHT CHAIRSEC,56,200
4680       CALL SAY("YOU PUT THE CHAIR UNDER THE CUPBOARD. JUMP ONTO IT!")
4690       CALL SOUND_(5)
4700     ELSE
4710      IF CHAIRON THEN
4720       CALL SAY("THE CHAIR STANDS UNDER THE CUPBOARD.")
4730     ELSE
4740       CALL SAY("A VERY TALL CUPBOARD. SOMETHING GLOWS VIOLET ON TOP, OUT OF REACH.")
4750     END IF
4760     END IF
4770   END IF
4780   IF A=6 THEN
4790     IF FED THEN
4800       CALL SAY("THE GLORP PURRS. IT LOOKS AT YOU WITH ENORMOUS EYES.")
4810     ELSE
4820      IF FN HAS(IJELLY) THEN
4830       CALL USEUP(IJELLY)
4840       FED=-1
4850       TXN(IGLORP)=44:HX(IGLORP)=HX(IGLORP)-60:CALL SHOWTHING(IGLORP)
4860       CALL SAY("THE GLORP EATS THE GREEN JELLY, GURGLES HAPPILY AND MOVES AWAY FROM THE NOZZLE.")
4870       CALL SOUND_(7)
4880     ELSE
4890       CALL SAY("A GLORP. IT SITS ON SOMETHING SHINY AND SNIFFS THE AIR. IT WANTS GREEN JELLY.")
4900     END IF
4910     END IF
4920   END IF
4930   IF A=8 THEN
4940     IF NOT FN HAS(ILANT) THEN
4950       CALL SAY("IT IS TOO DARK TO READ THE LABELS. YOU NEED A LIGHT.")
4960       CALL SOUND_(6)
4970     ELSE
4980      IF NOT POWEROFF THEN
4990       POWEROFF=-1
5000       TXN(OWASH)=72:CALL SHOWTHING(OWASH)
5010       CALL SAY("YOU PULL THE FUSE LABELLED WITH THREE DOTS. THE WASHING MACHINE STOPS.")
5020       CALL SOUND_(8)
5030     ELSE
5040       CALL SAY("THE FUSE IS OUT. THE CELLAR IS QUIET.")
5050     END IF
5060     END IF
5070   END IF
5080   IF A=9 THEN
5090     IF NOT POWEROFF THEN
