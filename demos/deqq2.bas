10140 ' ------------------------------------------------------------------------------------------------ one step of the world, a new game
10150 ' the music: calm and slow; uneasy (the same with a heartbeat) when Deqq is near; danger while he follows you and for four seconds after
10160 PROC MUSICMOOD
10170   LOCAL W,D
10180   D=W3D("DIST",IDEQQ)
10190   IF DQS=2 THEN MUT=GT+4
10200   IF GT<MUT THEN
10210     W=4
10220   ELSE
10230     IF D<380 THEN W=3 ELSE W=2
10240   END IF
10250   CALL MU_MODE(W)
10260 END PROC
10270 PROC TICK(DT)
10280   GT=GT+DT
10290   PX=W3D("X"):PY=W3D("Y")
10300   CALL DOORS(DT)
10310   CALL LANTERNLIGHT
10320   IF FN HAS(ILANT) THEN W3D LAMP 0,PX,PY,50,280,170 ELSE W3D LAMP 0,PX,PY,50,0,0
10330   IF W3D("TON",OWRECK) THEN W3D LAMP 1,W3D("TX",OWRECK),W3D("TY",OWRECK),60,320,30+NBUILT*18
10340   IF DQON AND DQS=2 THEN W3D LAMP 2,W3D("TX",IDEQQ),W3D("TY",IDEQQ),50,220,120 ELSE W3D LAMP 2,0,0,0,0,0
10350   CALL TIMERS
10360   IF NOT POWEROFF THEN W3D THINGTEX OWASH,70+(INT(GT*5) AND 1)
10370   IF GATET>0 AND GT>=GATET THEN
10380     GATET=0:W3D HEIGHT GATESEC,0,300
10390     IF PY<0 THEN CALL SAY("THE GATE CLICKS: IT IS UNLOCKED AGAIN.")
10400   END IF
10410   CALL CARS(DT)
10420   IF DQON THEN CALL DEQQAI(DT)
10430   CALL MUSICMOOD
10440 END PROC
