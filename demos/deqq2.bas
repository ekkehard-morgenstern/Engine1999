2470 ' the front of the house: a roof of tiles (the top 44 rows), an upper floor and a ground floor of gray bricks with windows (W wide, 300 high: the wall is 300 high)
2480 PROC FACADEBG(W)
2490   LOCAL R,B,X,S,I
2500   GFX CLEAR FN W3K_C(0,3)
2510   FOR R=0 TO 31
2520     FOR B=-1 TO W\16
2530       X=B*16+(R AND 1)*8
2540       S=7+FN W3K_R(4)
2550       GFX LINE X+1,48+R*8+1,X+15,48+R*8+7,FN W3K_C(0,S),BF
2560     NEXT B
2570   NEXT R
2580   FOR I=1 TO 140
2590     GFX PSET FN W3K_R(W),48+FN W3K_R(252),FN W3K_C(0,5+FN W3K_R(6))
2600   NEXT I
2610   FOR R=0 TO 5
2620     FOR B=-1 TO W\12
2630       X=B*12+(R AND 1)*6
2640       GFX LINE X+1,R*8+1,X+11,R*8+7,FN W3K_C(1,4+FN W3K_R(3)),BF
2650       GFX LINE X+1,R*8+1,X+11,R*8+1,FN W3K_C(1,8)
2660     NEXT B
2670   NEXT R
2680   GFX LINE 0,44,W-1,47,FN W3K_C(12,4),BF
2690   GFX LINE 0,44,W-1,44,FN W3K_C(12,8)
2700   GFX LINE 0,171,W-1,174,FN W3K_C(0,12),BF
2710   GFX LINE 0,291,W-1,299,FN W3K_C(0,5),BF
2720 END PROC
