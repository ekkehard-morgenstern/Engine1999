32940 ' water (textures 201..204, 64 x 64): four phases of a ripple pattern that repeats sideways; texture 205 shows them in turn (W3D ANIM)
32950 PROC MAKEWATER
32960   LOCAL F,X,Y,YY
32970   FOR F=0 TO 3
32980     GFX CLEAR FN W3K_C(9,6)
32990     FOR Y=0 TO 60 STEP 6
33000       FOR X=0 TO 63
33010         YY=(Y+INT(2.5*SIN((X+F*16)*PI/32+Y))+64) MOD 64
33020         GFX PSET X,YY,FN W3K_C(7,9)
33030         GFX PSET X,(YY+1) MOD 64,FN W3K_C(8,8)
33040       NEXT X
33050     NEXT Y
33060     GFX LINE 4+F*12,10,9+F*12,11,FN W3K_C(0,15),BF
33070     CALL W3K_GRAB(201+F,64,64)
33080   NEXT F
33090   W3D ANIM 205,201,4,3
33100 END PROC
33110 ' ------------------------------------------------------------------------------------------------ the town: painted house fronts, asphalt, railing
33120 PROC TOWNWINDOW(X,Y,LIT)
33130   GFX LINE X,Y,X+31,Y+43,FN W3K_C(12,6),BF
33140   IF FN W3K_R(100)<LIT THEN GFX LINE X+3,Y+3,X+28,Y+40,FN W3K_C(3,13),BF ELSE GFX LINE X+3,Y+3,X+28,Y+40,FN W3K_C(9,3),BF
33150   GFX LINE X+15,Y+3,X+16,Y+40,FN W3K_C(12,6),BF
33160   GFX LINE X+3,Y+20,X+28,Y+21,FN W3K_C(12,6),BF
33170   GFX LINE X-2,Y+44,X+33,Y+47,FN W3K_C(0,12),BF
33180 END PROC
33190 ' a house front 128 x 300: bricks of hue HW, roof of hue HR, two floors of windows (LIT = percent of lit ones), a door
33200 PROC TOWNFACADE(N,HW,HR,LIT,DK)
33210   LOCAL R,B,X,S,K
33220   GFX CLEAR FN W3K_C(HW,5)
33230   FOR R=0 TO 31
33240     FOR B=-1 TO 8
33250       X=B*16+(R AND 1)*8
33260       S=6+FN W3K_R(5)
33270       GFX LINE X+1,48+R*8+1,X+15,48+R*8+7,FN W3K_C(HW,S),BF
33280     NEXT B
33290   NEXT R
33300   FOR R=0 TO 5
33310     FOR B=-1 TO 10
33320       X=B*12+(R AND 1)*6
33330       GFX LINE X+1,R*8+1,X+11,R*8+7,FN W3K_C(HR,3+FN W3K_R(4)),BF
33340       GFX LINE X+1,R*8+1,X+11,R*8+1,FN W3K_C(HR,9)
33350     NEXT B
