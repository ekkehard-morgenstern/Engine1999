10 ' DEQQ'S HOUSE II - a real-time 3D adventure for Engine1999, made with the software 3D mesh renderer (M3D ...).
20 ' The sequel of the text adventure deqq.bas: Deqq, an alien, crash-landed and lives in an abandoned house. Eight parts of his spaceship are hidden in the house, the
30 ' garden, the shed and the cellar, each behind a small puzzle. Find them (you can carry three things, the big parts and the chair take two places), carry them to the
40 ' wreck at the end of the back yard and build them in. But Deqq is home, and he walks through the house on his round: if he sees you he follows you and carries
50 ' you out of the front door, and what you carried goes back where you found it (the parts already built in stay). Hide in the coat closet, the pantry, behind the
60 ' sofa, in the wardrobe, behind the shower curtain, between the barrels or in the trunk, close doors in his face, run (SHIFT) and listen for his footsteps.
70 ' Nobody is hurt in this game.
80 ' Keys: arrows or WASD walk and turn (A and D slide sideways), SHIFT runs, SPACE jumps, R and F look up and down (HOME looks straight), E or RETURN uses or takes what is
90 ' in front of you (the prompt at the bottom says what), G puts down the last thing you carry, O opens the 3D settings (invert axes, gamma, field of view, turning
100 ' speed; kept for next time), M turns the music on and off, P pauses, Q or ESC quits. Game controller: left stick walks, right stick turns and looks, LT runs, A jumps, X uses and takes, B puts
110 ' down, Y the settings, START pauses, BACK quits. The built parts are saved (the file deqq2.sav of the folder ~/.local/share/<name>/).
120 ' How it is made: the house is the mesh world document demos/deqq2.mesh.json (objects of boxes, zones, things: docs/3d-mesh-subsystem.md; JSON LOAD + M3D WORLD), the pictures are drawn by GFX statements from a table of
130 ' drawing commands (demos/levels/deqq2art.bas) and grabbed into W3D TEXTURE, everything you can touch is a thing (W3D THING) that M3D("DIST"), ("BEARING") and ("SEES")
140 ' find; Deqq walks with M3D THINGMOVE along a route of way points and sees you with M3D("SEES", 0). The whole game logic also runs in the console host without a
150 ' picture, for the test deqq2test.sh: environment DEQQ2_HEADLESS=1 and DEQQ2_PLAY=file (commands; see PLAYBACK).
160 LOAD LIBRARY "w3dkit"
170 LOAD LIBRARY "deqqart"
180 LOAD LIBRARY "input"
190 LOAD LIBRARY "text"
200 LOAD LIBRARY "prefs3d"
210 LOAD LIBRARY "music3d"
220 BREAK OFF
230 ON ERROR GOTO FAILED
240 DIM KD(200),SL(200),HX(200),HY(200),TXN(200),TWD(200),THT(200),TZO(200),TLZ(200),TLT(200),ACT(200),RCH(200),NMS$(200),IL(100),PARTNO(200),DESC$(200),DG(3),W$(8)
250 DIM DHX(5),DHY(5),DBY(5),DSG(5),INV(3),BUILT(9),DSEC(5),DOP(5),DLK(5),DCUR(5),WPX(140),WPY(140),WPP(140),CARON(4),CARD(4),CARV(4),CARCOL(4),CARHON(4),CARSND(4),NM$(30),CMT$(12)
255 DIM LRR(10),LRZ(10),VOK(420),MCUR(200),MPX(200),MPY(200),MB(40),MBK(40),BNL$(3)
260 GOTO MAIN
270 ' ------------------------------------------------------------------------------------------------ small helpers
280 FUNC CI(H,S)
290   RETURN 16+H*16+S
300 END FUNC
310 FUNC RI(M)
320   RETURN INT(RND(1)*M)
330 END FUNC
340 ' the angle difference of two directions (radians): 0 .. pi
350 FUNC ADIFF(A,B)
360   LOCAL D
370   D=A-B
380   D=D-INT(D/6.283185307)*6.283185307
390   IF D>3.141592654 THEN D=6.283185307-D
400   RETURN D
410 END FUNC
420 ' ------------------------------------------------------------------------------------------------ messages
430 ' SAY shows a line of at most two rows at the top of the picture for a few seconds (the headless test prints them)
440 PROC SAY(T$)
450   LOCAL I,K
460   IF HL THEN
470     PRINT "> ";T$
480     EXIT PROC
490   END IF
500   MSG1$=T$:MSG2$=""
510   IF LEN(T$)>76 THEN
520     K=76
530     FOR I=76 TO 40 STEP -1
540       IF MID$(T$,I,1)=" " AND K=76 THEN K=I
550     NEXT I
560     MSG1$=LEFT$(T$,K-1):MSG2$=MID$(T$,K+1)
570   END IF
580   MSGT=4.5
590 END PROC
600 PROC SOUND_(N)
610   IF NOT HL THEN SFX N
620 END PROC
630 ' ------------------------------------------------------------------------------------------------ things and what you carry
631 ' the zone (the room, a number of the world document) and its tag at the player's feet: a zone is a named box of space, M3D("ZONE", x, y, z)
632 FUNC ZONEP
633   RETURN M3D("ZONE",M3D("X"),M3D("Y"),M3D("Z")+2)
634 END FUNC
635 FUNC TAGP
636   RETURN M3D("ZONETAG",M3D("X"),M3D("Y"),M3D("Z")+2)
637 END FUNC
640 PROC PLACEALL
650   LOCAL N,X,Y,T,W,H,ZO,LT,K,SLT,A,R,SH,LV,NA$
660   FOR N=0 TO 199
670     KD(N)=0
680     M3D THINGOFF N
690   NEXT N
700   NIL=0
710   RESTORE OBJDATA
720   READ N
730   WHILE N>=0
740     READ X,Y,T,W,H,ZO,LT,K,SLT,A,R,SH,LV,NA$
750     KD(N)=K:SL(N)=SLT:HX(N)=X:HY(N)=Y:TXN(N)=T:TWD(N)=W:THT(N)=H:TZO(N)=ZO:TLT(N)=LT:ACT(N)=A:RCH(N)=R:NMS$(N)=NA$
760     TLZ(N)=1:IF LV=1 THEN TLZ(N)=114
770     IF LV=2 THEN TLZ(N)=226
780     IF LV=-1 THEN TLZ(N)=-60
781   IF LV>=3 THEN TLZ(N)=LV
790     IF K>0 THEN
800       IL(NIL)=N
810       NIL=NIL+1
820     END IF
830     IF SH THEN CALL SHOWTHING(N)
840     READ N
850   WEND
860   CALL TOWNTHINGS
870 END PROC
880 ' trees and lamp posts of the town (things 300 ..): lamps along both edges of the ring road, trees on the strips of grass between the road and the first row of houses
890 PROC TT(N,X,Y,TX,W,H)
900   M3D THING N,X,Y,M3D("FLOORAT",X,Y,1),TX,W,H
910 END PROC
920 PROC TOWNTHINGS
930   LOCAL N,X,Y,K
940   N=700
950   FOR X=-500 TO 1600 STEP 280
960     CALL TT(N,X,-70,91,24,56):CALL TT(N+1,X+140,-212,91,24,56)
970     CALL TT(N+2,X,1587,91,24,56):CALL TT(N+3,X+140,1733,91,24,56)
980     N=N+4
990   NEXT X
1000   FOR Y=0 TO 1500 STEP 280
1010     CALL TT(N,-450,Y,91,24,56):CALL TT(N+1,-590,Y+140,91,24,56)
1020     CALL TT(N+2,1535,Y+140,91,24,56):CALL TT(N+3,1685,Y,91,24,56)
1030     N=N+4
1040   NEXT Y
1050 END PROC
1060 ' puts thing N in the world at its place (its home place, or X,Y if they are given: CALL SHOWAT)
1070 PROC SHOWTHING(N)
1080   M3D THING N,HX(N),HY(N),M3D("FLOORAT",HX(N),HY(N),TLZ(N))+TZO(N),TXN(N),TWD(N),THT(N)
1090   REM (a thing's height above the floor is part of M3D THING)
1100   IF TLT(N)>=0 THEN M3D THINGLIGHT N,TLT(N)
1110 END PROC
1120 PROC SHOWAT(N,X,Y)
1130   M3D THING N,X,Y,M3D("FLOORAT",X,Y,AZ)+TZO(N),TXN(N),TWD(N),THT(N)
1140   AZ=1
1150   REM
1160   IF TLT(N)>=0 THEN M3D THINGLIGHT N,TLT(N)
1170 END PROC
1180 ' a thing appears where it lies hidden (it is a new home for it)
1190 PROC REVEAL(N)
1200   CALL SHOWTHING(N)
1210 END PROC
1220 FUNC SLOTSUSED(X)
1230   LOCAL I,S
1240   S=0
1250   FOR I=0 TO 2
1260     IF INV(I)>=0 THEN S=S+SL(INV(I))
1270   NEXT I
1280   RETURN S
1290 END FUNC
1300 FUNC HAS(N)
1310   LOCAL I,R
1320   R=0
1330   FOR I=0 TO 2
1340     IF INV(I)=N THEN R=-1
1350   NEXT I
1360   RETURN R
1370 END FUNC
1380 PROC TAKE(N)
1390   LOCAL I,F
1400   IF FN SLOTSUSED(0)+SL(N)>3 THEN
1410     CALL SAY("YOU CAN CARRY THREE PLACES OF THINGS. PUT SOMETHING DOWN FIRST (G).")
1420     CALL SOUND_(6)
1430     EXIT PROC
1440   END IF
1450   F=-1
1460   FOR I=2 TO 0 STEP -1
1470     IF INV(I)<0 THEN F=I
1480   NEXT I
1490   INV(F)=N
1500   M3D THINGOFF N
1510   CALL SAY("YOU TAKE THE "+NMS$(N)+".")
1520   CALL SOUND_(1)
1530 END PROC
1540 ' removes N from what you carry (used up or built in); the thing stays hidden
1550 PROC USEUP(N)
1560   LOCAL I
1570   FOR I=0 TO 2
1580     IF INV(I)=N THEN INV(I)=-1
1590   NEXT I
1600 END PROC
1610 PROC DROPLAST
1620   LOCAL I,N,X,Y,F,A
1630   N=-1
1640   FOR I=0 TO 2
1650     IF INV(I)>=0 THEN N=INV(I):F=I
1660   NEXT I
1670   IF N<0 THEN
1680     CALL SAY("YOU CARRY NOTHING.")
1690     EXIT PROC
1700   END IF
1710   A=M3D("YAW")*3.141592654/180
1720   X=PX+COS(A)*34:Y=PY+SIN(A)*34
1730   IF M3D("ZONE",X,Y,M3D("Z")+2)<0 OR M3D("ZONETAG",X,Y,M3D("Z")+2)=50 THEN X=PX:Y=PY
1740   IF M3D("ZONE",X,Y,M3D("Z")+2)<0 THEN EXIT PROC
1750   INV(F)=-1
1760   AZ=M3D("FLOORZ")+1
1770   CALL SHOWAT(N,X,Y)
1780   CALL SAY("YOU PUT DOWN THE "+NMS$(N)+".")
1790 END PROC
1800 ' the nearest thing that you can use in front of you (within its reach, in view); -1 if there is none
1810 FUNC TARGET(X)
1820   LOCAL I,N,B,D,BEST,BD
1830   BEST=-1:BD=1000
1840   FOR I=0 TO NIL-1
1850     N=IL(I)
1860     IF M3D("TON",N) AND NOT ( N=23 AND FN ZONEP=CHAIRSEC ) THEN
1870       D=M3D("DIST",N)
1880       IF D<RCH(N) AND D<BD THEN
1890         B=ABS(M3D("BEARING",N))
1900         IF B<40 OR D<30 THEN
1910           IF M3D("SEES",N) THEN
1920             BEST=N:BD=D
1930           END IF
1940         END IF
1950       END IF
1960     END IF
1970   NEXT I
1980   RETURN BEST
1990 END FUNC
2000 ' ------------------------------------------------------------------------------------------------ the safe's dial
2010 FUNC DIAL(X)
2020   LOCAL SEL,OK,CN,LOK,LCN,LU,LD,LL,LR,U,D,L,R,DONE,RES,I,C
2030   IF HL THEN
2040     RES=(DIALIN$="731")
2050     DIALIN$=""
2060     RETURN RES
2070   END IF
2080   DG(0)=0:DG(1)=0:DG(2)=0:SEL=0:DONE=0:RES=0
2090   WHILE INKEY$<>""
2100   WEND
2110   LOK=-1:LCN=-1:LU=-1:LD=-1:LL=-1:LR=-1
2120   REPEAT
2130     M3D RENDER
2140     GFX LINE 200,70,439,190,FN CI(0,1),BF
2150     GFX LINE 200,70,439,190,FN CI(0,9),B
2160     GFX LINE 201,71,438,189,FN CI(0,5),B
2170     CALL CTEXT(78,"THE SAFE",FN CI(3,15))
2180     CALL CTEXT(94,"THREE DIGITS: UP/DOWN CHANGE, LEFT/RIGHT CHOOSE",FN CI(0,10))
2190     FOR I=0 TO 2
2200       IF I=SEL THEN C=FN CI(3,15) ELSE C=FN CI(0,11)
2210       GFX LINE 240+I*60,112,279+I*60,160,FN CI(0,3),BF
2220       GFX LINE 240+I*60,112,279+I*60,160,C,B
2230       GFX TEXT 250+I*60,122,STR$(DG(I)),C,3,3
2240     NEXT I
2250     CALL CTEXT(168,"RETURN: TRY    ESC: LEAVE",FN CI(0,10))
2260     IF DIALMSG>0 THEN
2270       CALL CTEXT(180,"NOTHING HAPPENS.",FN CI(1,13))
2280       DIALMSG=DIALMSG-1
2290     END IF
2300     CALL W3K_SHOW
2310     U=KEY("UP") OR KEY("W") OR JOY("UP"):D=KEY("DOWN") OR KEY("S") OR JOY("DOWN")
2320     L=KEY("LEFT") OR KEY("A") OR JOY("LEFT"):R=KEY("RIGHT") OR KEY("D") OR JOY("RIGHT")
2330     OK=KEY("RETURN") OR KEY("E") OR JOY("A") OR JOY("X"):CN=KEY("ESC") OR JOY("B") OR JOY("BACK")
2340     IF U<>0 AND LU=0 THEN DG(SEL)=(DG(SEL)+1) MOD 10
2350     IF D<>0 AND LD=0 THEN DG(SEL)=(DG(SEL)+9) MOD 10
2360     IF L<>0 AND LL=0 THEN SEL=(SEL+2) MOD 3
2370     IF R<>0 AND LR=0 THEN SEL=(SEL+1) MOD 3
2380     IF OK<>0 AND LOK=0 THEN
2390       IF DG(0)=7 AND DG(1)=3 AND DG(2)=1 THEN
2400         RES=-1:DONE=-1
2410       ELSE
2420         DIALMSG=40
2430         CALL SOUND_(6)
2440       END IF
2450     END IF
2460     IF CN<>0 AND LCN=0 THEN DONE=-1
2470     LU=U:LD=D:LL=L:LR=R:LOK=OK:LCN=CN
2480   UNTIL DONE
2490   WHILE KEY("RETURN") OR KEY("E") OR KEY("ESC")
2500     FRAME
2510   WEND
2520   WHILE INKEY$<>""
2530   WEND
2540   W3K_T0=TI
2550   RETURN RES
2560 END FUNC
2570 FUNC BITS(M)
2580   LOCAL K,N
2590   N=0
2600   FOR K=0 TO 7
2610     IF (M\(2^K)) AND 1 THEN N=N+1
2620   NEXT K
2630   RETURN N
2640 END FUNC
