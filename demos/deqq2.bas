5110         CALL REVEAL(PPLATE)
5120         CALL SAY("THE LAST SCREW COMES OUT. THE MIRROR WAS A HULL PLATE!")
5130         CALL SOUND_(5)
5140       END IF
5150     ELSE
5160       CALL SAY("THE MIRROR IS NOT GLASS. FOUR SCREWS WITH FOUR-POINTED HEADS HOLD IT.")
5170     END IF
5180     END IF
5190   END IF
5200   IF A=12 THEN
5210     PHOTOSEEN=-1
5220     CALL SAY("YOU TURN THE PHOTO OVER. SCRATCHED INTO THE BACK WITH A PIN: 7 3 1.")
5230   END IF
5240   IF A=13 THEN
5250     IF SAFEOP THEN
5260       CALL SAY("THE SAFE IS OPEN AND EMPTY.")
5270     ELSE
5280      IF FN DIAL(0) THEN
5290       SAFEOP=-1:TXN(OSAFE)=75:CALL SHOWTHING(OSAFE)
5300       CALL REVEAL(PGLYPH)
5310       CALL SAY("CLICK! THE SAFE OPENS. INSIDE IS AN IGNITION GLYPH.")
5320       CALL SOUND_(5)
5330     ELSE
5340       CALL SAY("THE SAFE STAYS SHUT.")
5350     END IF
5360     END IF
5370   END IF
5380   IF A=14 THEN
5390     IF CRANKED THEN
5400       CALL SAY("THE BUCKET HANGS HIGH ABOVE THE WELL.")
5410     ELSE
5420      IF FN HAS(ICRANK) THEN
5430       CRANKED=-1
5440       CALL USEUP(ICRANK)
5450       CALL REVEAL(PANT)
5460       CALL SAY("YOU FIT THE CRANK TO THE WINDLASS AND WIND. THE BUCKET COMES UP WITH AN ANTENNA!")
5470       CALL SOUND_(8)
5480     ELSE
5490       CALL SAY("THE WINDLASS HAS NO CRANK. THE BUCKET IS STUCK DEEP IN THE WELL.")
5500     END IF
5510     END IF
5520   END IF
5530   IF A=15 THEN
5540     IF KEYTAKEN THEN
5550       CALL SAY("A CROOKED FLOWERPOT WITH A WITHERED PLANT.")
5560     ELSE
5570       KEYTAKEN=-1
5580       TXN(OPOT)=85:CALL SHOWTHING(OPOT)
5590       CALL REVEAL(IKEY)
5600       CALL SAY("YOU LIFT THE CROOKED POT: A SPARE KEY LIES UNDER IT.")
5610       CALL SOUND_(5)
5620     END IF
5630   END IF
5640   IF A=16 THEN
5650     IF TBOXOP THEN
5660       CALL SAY("THE TOOLBOX IS EMPTY NOW.")
5670     ELSE
5680       TBOXOP=-1
5690       CALL REVEAL(ICRANK):CALL REVEAL(ISCREW)
5700       CALL SAY("YOU OPEN THE TOOLBOX: A CRANK HANDLE AND A SCREWDRIVER WITH A FOUR-POINTED TIP.")
5710       CALL SOUND_(5)
5720     END IF
5730   END IF
5740   IF A=17 THEN CALL INSTALL
5750 END PROC
5760 ' you press E at a door: a key opens it
5770 PROC DOORUSE
5780   LOCAL S,I
5790   S=W3D("USE",70)
5800   IF S<0 THEN EXIT PROC
5810   FOR I=1 TO 4
5820     IF S=DSEC(I) THEN
5830       IF I=1 THEN
5840         CALL SAY("THE FRONT DOOR HAS BEEN STUCK OPEN FOR YEARS.")
5850       ELSE
5860        IF DOP(I) THEN
5870         DOP(I)=0
5880         CALL SAY("YOU CLOSE THE DOOR.")
5890         CALL SOUND_(5)
5900       ELSE
5910        IF DLK(I) AND NOT FN HAS(IKEY) THEN
5920         CALL SAY("LOCKED. THE SPARE KEY WOULD FIT.")
5930         CALL SOUND_(6)
5940       ELSE
5950         IF DLK(I) THEN
5960           CALL SAY("YOU UNLOCK AND OPEN THE DOOR.")
5970         ELSE
5980           CALL SAY("YOU OPEN THE DOOR.")
5990         END IF
6000         DLK(I)=0:DOP(I)=-1
6010         CALL SOUND_(5)
6020       END IF
6030       END IF
6040       END IF
6050     END IF
6060   NEXT I
6070 END PROC
6080 PROC USEKEY
6090   LOCAL N
6100   N=FN TARGET(0)
6110   IF N>=0 THEN
6120     IF KD(N)>=1 AND KD(N)<=2 THEN CALL PICKUP(N) ELSE CALL DOACT(N)
6130   ELSE
6140     CALL DOORUSE
6150   END IF
6160 END PROC
6170 ' ------------------------------------------------------------------------------------------------ the wreck, saving
6180 PROC SAVEGAME
6190   LOCAL M,K
6200   M=0
6210   FOR K=1 TO 8
6220     IF BUILT(K) THEN M=M+2^(K-1)
6230   NEXT K
6240   OPEN "local:deqq2.sav" FOR OUTPUT AS #1
6250   PRINT #1,"DEQQ2 1"
6260   PRINT #1,M
6270   PRINT #1,INT(GT)
6280   PRINT #1,CAUGHTN
6290   CLOSE #1
6300 END PROC
6310 ' reads the saved game: SAVEDMASK, SAVEDT, SAVEDC; -1 if there is one
6320 FUNC LOADSAVE(X)
6330   LOCAL A$,R
6340   R=0
6350   SAVEDMASK=0:SAVEDT=0:SAVEDC=0
6360   IF EXISTS("local:deqq2.sav") THEN
6370     OPEN "local:deqq2.sav" FOR INPUT AS #1
6380     A$=""
6390     IF NOT EOF(1) THEN LINE INPUT #1,A$
6400     IF A$="DEQQ2 1" THEN
6410       IF NOT EOF(1) THEN LINE INPUT #1,A$:SAVEDMASK=VAL(A$)
6420       IF NOT EOF(1) THEN LINE INPUT #1,A$:SAVEDT=VAL(A$)
6430       IF NOT EOF(1) THEN LINE INPUT #1,A$:SAVEDC=VAL(A$)
6440       R=-1
6450     END IF
6460     CLOSE #1
6470   END IF
6480   RETURN R
6490 END FUNC
6500 PROC INSTALL
6510   LOCAL I,N,K,C
6520   C=0
6530   FOR I=0 TO 2
6540     N=INV(I)
6550     IF N>=PCOIL AND N<=PANT THEN
6560       K=N-1
6570       INV(I)=-1
6580       IF NOT BUILT(K) THEN
6590         BUILT(K)=-1:NBUILT=NBUILT+1
6600       END IF
6610       CALL SHOWTHING(60+K)
6620       C=C+1
6630     END IF
6640   NEXT I
6650   IF C=0 THEN
6660     CALL SAY("THE WRECK IS A SKELETON OF BEAMS WITH EIGHT GAPS. "+STR$(NBUILT)+" OF 8 PARTS ARE BUILT IN.")
6670   ELSE
6680     CALL SOUND_(7)
6690     CALL SAY("YOU BUILD IN "+STR$(C)+" PART(S) - "+STR$(NBUILT)+" OF 8 DONE.")
6700     CALL SAVEGAME
6710     IF NBUILT=8 THEN ENDREQ=-1
6720   END IF
6730 END PROC
6740 ' ------------------------------------------------------------------------------------------------ Deqq
6750 PROC DQMOVE(DX,DY,SP,TF)
6760   W3D THINGMOVE IDEQQ,DX*SP,DY*SP
6770   DQANG=ATAN2(DY,DX)
6780   W3D THINGTEX IDEQQ,TF
6790 END PROC
6800 FUNC NEARWP(X,Y)
6810   LOCAL I,B,D,R
6820   R=0:B=1.0E9
6830   FOR I=0 TO NWP-1
6840     D=(WPX(I)-X)^2+(WPY(I)-Y)^2
6850     IF D<B THEN B=D:R=I
6860   NEXT I
6870   RETURN R
6880 END FUNC
6890 PROC CAUGHT
6900   LOCAL I,N
6910   CAUGHTN=CAUGHTN+1
6920   CALL SOUND_(4)
6930   CALL BANNER("DEQQ HAS CAUGHT YOU","HE CARRIES YOU OUT OF THE HOUSE AND PUTS YOU DOWN IN THE GARDEN.",2.5)
6940   FOR I=0 TO 2
6950     N=INV(I)
6960     IF N>=0 THEN
6970       INV(I)=-1
6980       CALL SHOWTHING(N)
6990     END IF
7000   NEXT I
7010   W3D CAMERA 480,150,90,0,0
7020   W3D LIFT 0
7030   W3K_VZ=0
7040   DQS=0:DQWP=5:DQLOST=0
7050   CALL SHOWAT(IDEQQ,WPX(4),WPY(4))
7060   W3D THINGTEX IDEQQ,40
7070   DQCD=GT+8
7080   CALL SAY("WHAT YOU CARRIED IS BACK WHERE YOU FOUND IT. THE PARTS BUILT IN STAY.")
7090 END PROC
7100 PROC DEQQAI(DT)
7110   LOCAL DXP,DYP,D,SEEN,LIM,BA,TX,TY,L,DX,DY,F,HID
7120   DXP=W3D("TX",IDEQQ):DYP=W3D("TY",IDEQQ)
7130   D=W3D("DIST",IDEQQ)
7140   HID=(W3D("TAG",W3D("SECTOR"))=50)
7150   SEEN=0
7160   IF GT>=DQCD THEN
7170     LIM=430
7180     IF HID THEN LIM=55
7190     IF D<LIM THEN
7200       BA=ATAN2(PY-DYP,PX-DXP)
7210       IF D<95 OR FN ADIFF(BA,DQANG)<0.95 THEN
7220         IF W3D("SEES",IDEQQ) THEN SEEN=-1
7230       END IF
7240     END IF
7250   END IF
7260   F=40+(INT(GT*4) AND 1)
7270   IF DQS=2 THEN
7280     IF SEEN THEN DQLOST=0 ELSE DQLOST=DQLOST+DT
7290     IF DQLOST>3.5 THEN
7300       DQS=0:DQWP=FN NEARWP(DXP,DYP)
7310       CALL SAY("DEQQ MUTTERS, LOSES YOUR TRACK AND GOES BACK TO HIS ROUND.")
7320       W3D THINGTEX IDEQQ,40
7330     ELSE
7340       IF D>1 THEN CALL DQMOVE((PX-DXP)/D,(PY-DYP)/D,108*DT,42)
7350       IF D<46 AND W3D("SEES",IDEQQ) AND GT>=DQCD THEN CALL CAUGHT
7360     END IF
7370   ELSE
7380     IF SEEN THEN
7390       DQS=2:DQLOST=0
7400       CALL SOUND_(3)
7410       CALL SAY("DEQQ HAS SEEN YOU! RUN, SHUT A DOOR, OR HIDE!")
7420       W3D THINGTEX IDEQQ,42
7430     ELSE
7440      IF DQS=1 THEN
7450       W3D THINGTEX IDEQQ,40
7460       IF GT>=DQPT THEN
7470         DQS=0:DQWP=(DQWP+1) MOD NWP
7480       END IF
7490     ELSE
7500       TX=WPX(DQWP):TY=WPY(DQWP)
7510       DX=TX-DXP:DY=TY-DYP:L=SQR(DX*DX+DY*DY)
7520       IF L<22 THEN
7530         IF WPP(DQWP)>0 THEN
7540           DQS=1:DQPT=GT+WPP(DQWP)
7550         ELSE
7560           DQWP=(DQWP+1) MOD NWP
7570         END IF
7580       ELSE
7590         CALL DQMOVE(DX/L,DY/L,62*DT,F)
7600         IF W3D("HIT") AND 2 THEN DQSTUCK=DQSTUCK+DT ELSE DQSTUCK=0
7610         IF DQSTUCK>1.5 THEN
7620           DQSTUCK=0:DQWP=(DQWP+1) MOD NWP
7630         END IF
7640       END IF
7650     END IF
7660     END IF
7670   END IF
7680   IF DQS<>1 AND D<420 AND GT>=DQFT THEN
7690     CALL SOUND_(2)
7700     DQFT=GT+0.55
7710     IF NOT SEEN AND GT>=DQHEARD AND DQS=0 THEN
7720       CALL SAY("HEAVY FOOTSTEPS. DEQQ IS SOMEWHERE NEAR.")
7730       DQHEARD=GT+30
7740     END IF
7750   END IF
7760 END PROC
7770 ' ------------------------------------------------------------------------------------------------ the screen
7780 PROC CTEXT(Y,T$,C)
7790   GFX TEXT (640-8*LEN(T$))\2,Y,T$,C
7800 END PROC
7810 ' a banner over the picture of the world for a few seconds (the player stands still)
7820 PROC BANNER(T1$,T2$,SEC)
7830   LOCAL T0
7840   IF HL THEN
7850     PRINT "# ";T1$
7860     EXIT PROC
7870   END IF
7880   T0=TI
7890   WHILE TI-T0<SEC*60
7900     W3D RENDER
7910     GFX LINE 60,70,579,170,FN CI(0,1),BF
7920     GFX LINE 60,70,579,170,FN CI(1,10),B
7930     CALL BIGTEXT(82,T1$,FN CI(3,15),2)
7940     CALL CTEXT(130,LEFT$(T2$,62),FN CI(0,13))
7950     IF LEN(T2$)>62 THEN CALL CTEXT(144,MID$(T2$,63),FN CI(0,13))
7960     CALL W3K_SHOW
7970   WEND
7980   W3K_T0=TI
7990 END PROC
8000 PROC HUD
8010   LOCAL I,N,X,C,T$
8020   IF MSGT>0 THEN
8030     GFX LINE 0,0,639,MSGH,FN CI(0,1),BF
8040     GFX TEXT 6,4,MSG1$,FN CI(0,15)
8050     IF MSG2$<>"" THEN GFX TEXT 6,18,MSG2$,FN CI(0,15)
8060   END IF
8070   IF PROMPT$<>"" THEN
8080     GFX TEXT (640-8*LEN(PROMPT$))\2+1,247,PROMPT$,FN CI(0,1)
8090     GFX TEXT (640-8*LEN(PROMPT$))\2,246,PROMPT$,FN CI(3,15)
8100   END IF
8110   CALL W3K_HUDBAR(264,36)
8120   FOR I=0 TO 2
8130     X=6+I*104
8140     GFX LINE X,268,X+99,295,FN CI(0,3),BF
8150     GFX LINE X,268,X+99,295,FN CI(0,8),B
8160     N=INV(I)
8170     IF N>=0 THEN
8180       T$=NMS$(N)
8190       IF LEN(T$)>11 THEN T$=LEFT$(T$,11)
8200       GFX TEXT X+4,276,T$,FN CI(3,14)
8210     END IF
8220   NEXT I
8230   GFX TEXT 326,268,"PARTS",FN CI(0,11)
8240   FOR I=1 TO 8
8250     IF BUILT(I) THEN C=FN CI(5,13) ELSE C=FN CI(0,4)
8260     GFX LINE 326+(I-1)*14,282,336+(I-1)*14,293,C,BF
8270   NEXT I
8280   IF DQS=2 THEN
8290     GFX TEXT 470,274,"DEQQ SEES YOU!",FN CI(1,14),2,1
8300   ELSE
8310    IF W3D("TAG",W3D("SECTOR"))=50 THEN
8320     GFX TEXT 470,274,"HIDDEN",FN CI(5,13),2,1
8330   END IF
8340   END IF
8350   IF MSGT>0 THEN MSGT=MSGT-0.017
8360   MSGH=18:IF MSG2$<>"" THEN MSGH=32
8370 END PROC
8380 PROC TITLE
8390   LOCAL I,K$,C,SV
8400   SV=FN LOADSAVE(0)
8410   C=0
8420   WHILE C=0
8430     FOR I=0 TO 1
8440       GFX CLEAR FN CI(0,1)
8450       GFX LINE 40,24,599,260,FN CI(10,4),B
8460       CALL BIGTEXT(36,"DEQQ'S HOUSE II",FN CI(6,14),4)
8470       CALL CTEXT(96,"DEQQ, AN ALIEN, CRASH-LANDED AND LIVES IN THIS HOUSE.",FN CI(0,13))
8480       CALL CTEXT(112,"EIGHT PARTS OF HIS SHIP ARE HIDDEN IN THE HOUSE AND GARDEN.",FN CI(0,13))
8490       CALL CTEXT(128,"BUILD THEM INTO THE WRECK BEHIND THE BACK YARD - BUT DEQQ IS HOME.",FN CI(0,13))
8500       CALL CTEXT(144,"HE WALKS HIS ROUND AND CARRIES YOU OUT IF HE SEES YOU. NOBODY IS HURT.",FN CI(0,11))
8510       CALL CTEXT(168,"WASD / ARROWS WALK   SPACE JUMP   E USE   G PUT DOWN   SHIFT RUN   O SETTINGS",FN CI(3,13))
8520       CALL CTEXT(184,"PAD: STICKS WALK AND TURN   A JUMP   X USE   B PUT DOWN   Y SETTINGS",FN CI(3,13))
8530       IF SV AND SAVEDMASK>0 THEN
8540         CALL CTEXT(212,"N NEW GAME     C CONTINUE ("+STR$(FN BITS(SAVEDMASK))+" OF 8 PARTS BUILT)     Q QUIT",FN CI(1,13))
8550       ELSE
8560         CALL CTEXT(212,"N OR FIRE: NEW GAME     Q QUIT",FN CI(1,13))
8570       END IF
8580       CALL W3K_SHOW
8590     NEXT I
8600     CALL IN_WAITRELEASE
8610     REPEAT
8620       FRAME
8630       K$=INKEY$
8640       IF K$<>"" THEN
8650         IF K$="n" OR K$="N" OR K$=" " OR K$=CHR$(13) THEN C=1
8660         IF (K$="c" OR K$="C") AND SV AND SAVEDMASK>0 THEN C=2
8670         IF K$="q" OR K$="Q" OR K$=CHR$(27) THEN C=3
8680       END IF
8690       IF FN IN_ANYA(0) OR FN IN_ANYSTART(0) THEN C=1
8700       IF FN IN_ANYBACK(0) THEN C=3
8710     UNTIL C<>0
8720   WEND
8730   TITLERES=C
8740 END PROC
8750 ' ------------------------------------------------------------------------------------------------ one step of the world, a new game
8760 PROC TICK(DT)
8770   GT=GT+DT
8780   PX=W3D("X"):PY=W3D("Y")
8790   CALL DOORS(DT)
8800   CALL LANTERNLIGHT
8810   CALL TIMERS
8820   IF NOT POWEROFF THEN W3D THINGTEX OWASH,70+(INT(GT*5) AND 1)
8830   IF DQON THEN CALL DEQQAI(DT)
8840 END PROC
8850 PROC NEWGAME(CN)
8860   LOCAL I,K
8870   CALL PLACEALL
8880   TXN(IDEQQ)=40:TWD(IDEQQ)=40:THT(IDEQQ)=72:TZO(IDEQQ)=0:TLT(IDEQQ)=-1
8890   FOR I=0 TO 2
8900     INV(I)=-1
8910   NEXT I
8920   FOR K=1 TO 8
8930     BUILT(K)=0
8940   NEXT K
8950   NBUILT=0
8960   OVENT=0:OVENCOOL=0:OVENOPEN=0:FRIDGEOP=0:MELTT=0:CHAIRON=0:FED=0:SCREWS=0:PLATEOUT=0:SAFEOP=0:CRANKED=0:PHOTOSEEN=0
8970   POWEROFF=0:WASHOPEN=0:KEYTAKEN=0:TBOXOP=0:LANTON=-1:ENDREQ=0:QUITREQ=0:DIALIN$="":DIALMSG=0
8980   DSEC(1)=6:DSEC(2)=7:DSEC(3)=8:DSEC(4)=33
8990   FOR I=1 TO 4
9000     DOP(I)=0:DLK(I)=-1:DCUR(I)=0
9010   NEXT I
9020   DOP(1)=-1:DLK(1)=0:DCUR(1)=100
9030   W3D HEIGHT 6,0,100
9040   FOR I=2 TO 4
9050     W3D HEIGHT DSEC(I),0,0
9060   NEXT I
9070   W3D HEIGHT CHAIRSEC,0,200
9080   GT=0:CAUGHTN=0:MSGT=0:MSG1$="":MSG2$="":PROMPT$="":MSGH=18
9090   PX=480:PY=100
9100   W3D CAMERA 480,100,90,0,0
9110   W3D LIFT 0
9120   W3K_VZ=0
9130   DQON=-1:DQS=0:DQWP=21:DQLOST=0:DQCD=3:DQPT=0:DQFT=0:DQHEARD=20:DQSTUCK=0:DQANG=1.5
9140   CALL SHOWAT(IDEQQ,WPX(DQWP),WPY(DQWP))
9150   W3D THINGTEX IDEQQ,40
9160   IF CN THEN
9170     FOR K=1 TO 8
9180       IF (SAVEDMASK\(2^(K-1))) AND 1 THEN
9190         BUILT(K)=-1:NBUILT=NBUILT+1
9200         CALL SHOWTHING(60+K)
9210       END IF
9220     NEXT K
9230     GT=SAVEDT:CAUGHTN=SAVEDC
9240   END IF
9250   CALL LANTERNLIGHT
9260 END PROC
9270 ' ------------------------------------------------------------------------------------------------ playing
9280 PROC PROMPTUPDATE
9290   LOCAL N,S,I
9300   PROMPT$=""
9310   N=FN TARGET(0)
9320   IF N>=0 THEN
9330     IF KD(N)>=1 AND KD(N)<=2 THEN
9340       PROMPT$="E: TAKE THE "+NMS$(N)
9350     ELSE
9360       PROMPT$="E: "+NMS$(N)
9370     END IF
9380   ELSE
9390     S=W3D("USE",70)
9400     FOR I=2 TO 4
9410       IF S=DSEC(I) THEN
9420         IF DOP(I) THEN PROMPT$="E: CLOSE THE DOOR" ELSE PROMPT$="E: OPEN THE DOOR"
9430       END IF
9440     NEXT I
9450   END IF
9460 END PROC
9470 PROC PLAYLEVEL
9480   LOCAL DT,U,UL,BL,B,Y,YL,T0,FR
9490   UL=0:BL=0:YL=0:FR=0
9500   T0=TI
9510   REPEAT
9520     DT=(TI-T0)/60:T0=TI
9530     IF DT>0.1 THEN DT=0.1
9540     CALL W3K_WALK
9550     CALL W3K_JUMP(KEY("SPACE") OR JOY("A"))
9560     U=KEY("E") OR KEY("RETURN") OR JOY("X")
9570     IF U<>0 AND UL=0 THEN CALL USEKEY
9580     UL=U
9590     B=KEY("G") OR JOY("B")
9600     IF B<>0 AND BL=0 THEN CALL DROPLAST
9610     BL=B
9620     IF KEY("ESC") THEN IN_QUIT=1
9630     CALL TICK(DT)
9640     IF FR MOD 5=0 THEN CALL PROMPTUPDATE
9650     W3D RENDER
9660     CALL HUD
9670     GFX LINE 318,131,321,132,FN CI(0,13),BF
9680     CALL W3K_SHOW
9690     FR=FR+1
9700     IF FN IN_SERVICE() THEN
9710       CALL BIGTEXT(110,"PAUSED",FN CI(0,15),3)
9720       CALL W3K_SHOW
9730       CALL IN_PAUSELOOP
9740       T0=TI:W3K_T0=TI
9750     END IF
9760     Y=JOY("Y")
9770     IF IN_KEY=79 OR (Y<>0 AND YL=0) THEN
9780       CALL P3_DIALOG
9790       T0=TI
9800     END IF
9810     YL=Y
9820   UNTIL IN_QUIT OR ENDREQ
9830 END PROC
9840 PROC ENDING
9850   LOCAL I
9860   CALL BANNER("THE SHIP HUMS","ALL EIGHT PARTS ARE BUILT IN. THE LIGHTS OF THE WRECK COME ON, ONE BY ONE.",4)
9870   IF HL THEN
9880     PRINT "# ENDING"
9890   ELSE
9900     FOR I=0 TO 90
9910       W3D THINGZ 32,I*2
9920       W3D RENDER
9930       CALL HUD
9940       CALL W3K_SHOW
9950     NEXT I
9960     CALL BANNER("DEQQ SAYS THANK YOU","'YOU FIXED MY SHIP. I SHALL GO HOME. THE HOUSE IS YOURS. IT BITES, A LITTLE.'",5)
9970     CALL BANNER("THE END","TIME "+STR$(INT(GT\60))+" MIN "+STR$(INT(GT) MOD 60)+" S    CAUGHT "+STR$(CAUGHTN)+" TIMES",5)
9980   END IF
9990   IF EXISTS("local:deqq2.sav") THEN KILL "local:deqq2.sav"
10000 END PROC
10010 ' ------------------------------------------------------------------------------------------------ playback (the headless test)
10020 ' commands (lines of the file named by DEQQ2_PLAY): step n | goto x y angle | walk x y | face x y | use | drop | give n | dial 731 | deqq x y | deqqoff | deqqon | state | say text | continue | new | quit
10030 PROC SPLIT(L$)
10040   LOCAL I,N,C$,CUR$
10050   FOR I=0 TO 7
10060     W$(I)=""
10070   NEXT I
10080   N=0:CUR$=""
10090   FOR I=1 TO LEN(L$)
10100     C$=MID$(L$,I,1)
10110     IF C$=" " THEN
10120       IF CUR$<>"" THEN
10130         IF N<7 THEN
10140           W$(N)=CUR$:N=N+1
10150         END IF
10160         CUR$=""
10170       END IF
10180     ELSE
10190       CUR$=CUR$+C$
10200     END IF
10210   NEXT I
10220   IF CUR$<>"" AND N<7 THEN W$(N)=CUR$
10230 END PROC
10240 PROC WALKTO(X,Y)
10250   LOCAL I,DX,DY,L,A
10260   FOR I=1 TO 1500
10270     DX=X-W3D("X"):DY=Y-W3D("Y"):L=SQR(DX*DX+DY*DY)
10280     IF L<8 THEN EXIT PROC
10290     A=ATAN2(DY,DX)*180/3.141592654
10300     W3D CAMERA W3D("X"),W3D("Y"),A
10310     W3D MOVE MIN(L,3.2),0
10320     W3D RENDER
10330     CALL TICK(1/60)
10340     IF ENDREQ THEN EXIT PROC
10350   NEXT I
10360   PRINT "# walk to ";X;",";Y;" failed at ";INT(W3D("X"));",";INT(W3D("Y"))
10370 END PROC
10380 PROC PLAYBACK
10390   LOCAL L$,C$,I,N
10400   WHILE NOT EOF(4) AND NOT QUITREQ
10410     LINE INPUT #4,L$
10420     CALL SPLIT(L$)
10430     C$=W$(0)
10440     IF C$="step" THEN
10450       FOR I=1 TO VAL(W$(1))
10460         CALL TICK(1/60)
10470       NEXT I
10480     END IF
10490     IF C$="goto" THEN
10500       W3D CAMERA VAL(W$(1)),VAL(W$(2)),VAL(W$(3)),0,0
10510       PX=W3D("X"):PY=W3D("Y")
10520       FOR I=1 TO 12
