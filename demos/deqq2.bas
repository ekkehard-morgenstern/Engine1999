34440 ' where a car is on the ring road: S = the distance driven (0 .. CARLOOP), the outer lanes, anticlockwise: the south road eastbound (y -190), the east road
34450 ' northbound (x 1650), the north road westbound (y 1700), the west road southbound (x -560); sets CX, CY and CH (the heading, in radians, 0 = east)
34460 PROC CARPLACE(S)
34470   IF S<2210 THEN
34480     CX=-560+S:CY=-190:CH=0
34490   ELSE
34500     IF S<4100 THEN
34510       CX=1650:CY=-190+(S-2210):CH=1.5707963
34520     ELSE
34530       IF S<6310 THEN
34540         CX=1650-(S-4100):CY=1700:CH=3.1415927
34550       ELSE
34560         CX=-560:CY=1700-(S-6310):CH=4.712389
34570       END IF
34580     END IF
34590   END IF
34600 END PROC
34610 ' the cars: up to three at a time, a new one every 15 .. 40 seconds, each drives once round the block (51 s) and is gone; one that has you in front of it on the road
34620 ' brakes and honks, then drives on when the way is free; the picture shows the car from the side it is seen from (4 views)
34630 PROC CARS(DT)
34640   LOCAL K,F,L,DX,DY,HX,HY,CR,DT2,R,V,N,BASE,W,H,TX
34650   IF GT>=CARNEXT THEN
34660     CARNEXT=GT+15+RND(1)*25
34670     FOR K=0 TO 2
34680       IF CARON(K)=0 AND CARSP=0 THEN
34690         CARSP=1
34700         CARON(K)=-1:CARD(K)=0:CARV(K)=0:CARCOL(K)=INT(RND(1)*3):CARHON(K)=0:CARSND(K)=0
34710         CALL CARPLACE(0)
34720         W3D THING 130+K,CX,CY,230+CARCOL(K)*4,120,44,W3D("SECTORZ",CX,CY,1)
34730       END IF
34740     NEXT K
34750     CARSP=0
34760   END IF
34770   NCARS=0
34780   FOR K=0 TO 2
34790     IF CARON(K) THEN
34800       NCARS=NCARS+1
34810       CALL CARPLACE(CARD(K))
34820       HX=COS(CH):HY=SIN(CH)
34830       DX=PX-CX:DY=PY-CY
34840       F=DX*HX+DY*HY:L=-DX*HY+DY*HX
34850       V=150
34860       IF F>0 AND F<200 AND ABS(L)<70 AND (PY<-60 OR PY>1580 OR PX<-440 OR PX>1530) THEN
34870         V=0
34880         IF GT>=CARHON(K) THEN
34890           CARHON(K)=GT+4:CALL SOUND_(11)
34900           IF PY<-60 OR PY>1580 OR PX<-440 OR PX>1530 THEN CALL SAY("A CAR HONKS: GET OUT OF THE ROAD!")
34910         END IF
34920       END IF
34930       IF CARV(K)<V THEN CARV(K)=MIN(V,CARV(K)+240*DT)
34940       IF CARV(K)>V THEN CARV(K)=MAX(V,CARV(K)-480*DT)
34950       CARD(K)=CARD(K)+CARV(K)*DT
34960       IF CARD(K)>=8200 THEN
34970         CARON(K)=0:W3D THINGOFF 130+K
34980       ELSE
34990         CALL CARPLACE(CARD(K))
35000         DX=CX-PX:DY=CY-PY
35010         CR=DX*HY-DY*HX
35020         R=ATAN2(CR,DX*HX+DY*HY)
35030         BASE=230+CARCOL(K)*4
35040         W=120:H=44
35050         IF ABS(R)<0.5 THEN
35060           N=BASE+3:W=66:H=48
35070         ELSE
35080           IF ABS(R)>2.64 THEN
35090             N=BASE+2:W=66:H=48
35100           ELSE
35110             IF CR>0 THEN N=BASE+1 ELSE N=BASE
35120           END IF
35130         END IF
35140         W3D THING 130+K,CX,CY,N,W,H
35150         IF SQR(DX*DX+DY*DY)<380 AND GT>=CARSND(K) THEN
35160           CARSND(K)=GT+9:CALL SOUND_(10)
35170         END IF
35180       END IF
35190     END IF
35200   NEXT K
35210 END PROC
