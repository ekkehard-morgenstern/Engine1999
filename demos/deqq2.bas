37450           M3D OBJPOS 4000+N,X,Y,M3D("TZ",N),180
37455           MPX(N)=X:MPY(N)=Y
37460         END IF
37465         IF MCUR(N)=0 THEN M3D OBJSHOW 4000+N,-1:MCUR(N)=1
37470       ELSE
37475         T=TXN(N)
37480         IF T<>MCUR(N) THEN
37485           IF MCUR(N)>0 THEN
37490             IF VOK(MCUR(N)) THEN M3D OBJSHOW 3500+MCUR(N),0
37495           END IF
37500           IF T>0 THEN
37505             IF VOK(T) THEN M3D OBJSHOW 3500+T,-1
37510           END IF
37515           MCUR(N)=T
37520         END IF
37525       END IF
37530     ELSE
37535       IF MBK(I)=1 THEN
37540         IF MCUR(N)=1 THEN M3D OBJSHOW 4000+N,0:MCUR(N)=0
37545       END IF
37550     END IF
37555   NEXT I
37560 END PROC
