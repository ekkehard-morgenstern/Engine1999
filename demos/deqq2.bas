11810 ' ------------------------------------------------------------------------------------------------ playback (the headless test)
11820 ' commands (lines of the file named by DEQQ2_PLAY): step n | goto x y angle | walk x y | face x y | use | drop | give n | dial 731 | deqq x y | deqqoff | deqqon | state | say text | continue | new | quit
11830 PROC SPLIT(L$)
11840   LOCAL I,N,C$,CUR$
11850   FOR I=0 TO 7
11860     W$(I)=""
11870   NEXT I
11880   N=0:CUR$=""
11890   FOR I=1 TO LEN(L$)
11900     C$=MID$(L$,I,1)
11910     IF C$=" " THEN
11920       IF CUR$<>"" THEN
11930         IF N<7 THEN
11940           W$(N)=CUR$:N=N+1
11950         END IF
11960         CUR$=""
11970       END IF
11980     ELSE
11990       CUR$=CUR$+C$
12000     END IF
12010   NEXT I
12020   IF CUR$<>"" AND N<7 THEN W$(N)=CUR$
12030 END PROC
12040 PROC WALKTO(X,Y)
12050   LOCAL I,DX,DY,L,A
12060   FOR I=1 TO 1500
12070     DX=X-M3D("X"):DY=Y-M3D("Y"):L=SQR(DX*DX+DY*DY)
12080     IF L<8 THEN EXIT PROC
12090     A=ATAN2(DY,DX)*180/3.141592654
12100     M3D CAMERA M3D("X"),M3D("Y"),M3D("Z"),A
12110     M3D MOVE MIN(L,3.2),0
12120     M3D RENDER
12130     CALL TICK(1/60)
12140     IF ENDREQ THEN EXIT PROC
12150   NEXT I
12160   PRINT "# walk to ";X;",";Y;" failed at ";INT(M3D("X"));",";INT(M3D("Y"))
12170 END PROC
12180 PROC PLAYBACK
12190   LOCAL L$,C$,I,N
12200   WHILE NOT EOF(4) AND NOT QUITREQ
12210     LINE INPUT #4,L$
12220     CALL SPLIT(L$)
12230     C$=W$(0)
12240     IF C$="step" THEN
12250       FOR I=1 TO VAL(W$(1))
12260         CALL TICK(1/60)
12270       NEXT I
12280     END IF
12290     IF C$="goto" THEN
12300       Z=VAL(W$(4)):IF Z=0 THEN Z=1
12310       M3D CAMERA VAL(W$(1)),VAL(W$(2)),M3D("FLOORAT",VAL(W$(1)),VAL(W$(2)),Z),VAL(W$(3))
12320       PX=M3D("X"):PY=M3D("Y")
12330       FOR I=1 TO 12
12340         M3D RENDER
12350       NEXT I
12360     END IF
12370     IF C$="walk" THEN CALL WALKTO(VAL(W$(1)),VAL(W$(2)))
12375     IF C$="jump" THEN CALL JUMPTO(VAL(W$(1)),VAL(W$(2)))
12380     IF C$="face" THEN M3D CAMERA M3D("X"),M3D("Y"),M3D("Z"),ATAN2(VAL(W$(2))-M3D("Y"),VAL(W$(1))-M3D("X"))*180/3.141592654
12385     IF C$="shot" AND NOT HL THEN CALL W3K_SHOW:SCREENSHOT W$(1)
12390     IF C$="use" THEN CALL USEKEY
12400     IF C$="drop" THEN CALL DROPLAST
12410     IF C$="give" THEN
12420       N=VAL(W$(1))
12430       CALL TAKE(N)
12440     END IF
12450     IF C$="dial" THEN DIALIN$=W$(1)
12460     IF C$="deqq" THEN
12470       AZ=VAL(W$(3)):IF AZ=0 THEN AZ=1
12480       CALL SHOWAT(IDEQQ,VAL(W$(1)),VAL(W$(2)))
12490       DQS=0:DQCD=GT
12500     END IF
12510     IF C$="deqqoff" THEN DQON=0
12520     IF C$="deqqon" THEN
12530       DQON=-1:DQAWAY=0:DQLEAVE=0:DQHT=GT+100000:DQWP=26:AZ=114:DQS=0:DQCD=GT+3
12540       CALL SHOWAT(IDEQQ,WPX(DQWP),WPY(DQWP))
12550     END IF
12560     IF C$="deqqaway" THEN
12570       DQON=-1:DQAWAY=-1:DQLEAVE=0:DQWP=VAL(W$(1)):IF DQWP=0 THEN DQWP=60
12580       AZ=1:CALL SHOWAT(IDEQQ,WPX(DQWP),WPY(DQWP)):DQS=0:DQCD=GT
12590     END IF
12600     IF C$="say" THEN PRINT "# ";MID$(L$,5)
12610     IF C$="deqqleave" THEN DQLEAVE=-1
12620     IF C$="state" THEN
12630       PRINT "# state built=";NBUILT;" caught=";CAUGHTN;" dqs=";DQS;" sector=";FN ZONEP;" inv=";INV(0);INV(1);INV(2);" t=";INT(GT);" away=";DQAWAY;" wp=";DQWP;" gate=";GATET;" cars=";NCARS;" wpxy=";WPX(DQWP);",";WPY(DQWP);" deqq=";INT(M3D("TX",IDEQQ));",";INT(M3D("TY",IDEQQ));" sec ";M3D("ZONE",M3D("TX",IDEQQ),M3D("TY",IDEQQ),M3D("TZ",IDEQQ)+2)
12640     END IF
12650     IF C$="continue" THEN
12660       IF FN LOADSAVE(0) THEN
12670         CALL NEWGAME(-1)
12680         PRINT "# continued with mask ";SAVEDMASK
12690       ELSE
12700         PRINT "# no saved game"
12710       END IF
12720     END IF
12730     IF C$="new" THEN CALL NEWGAME(0)
12740     IF C$="quit" THEN QUITREQ=-1
12750     IF ENDREQ THEN
12760       CALL ENDING
12770       ENDREQ=0
12780     END IF
12790   WEND
12800 END PROC
