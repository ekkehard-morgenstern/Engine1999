11150 PROC PLAYLEVEL
11160   LOCAL DT,U,UL,BL,B,Y,YL,T0,FR
11170   UL=0:BL=0:YL=0:FR=0
11180   T0=TI
11190   REPEAT
11200     DT=(TI-T0)/60:T0=TI
11210     IF DT>0.1 THEN DT=0.1
11220     CALL W3K_WALK
11230     CALL W3K_JUMP(KEY("SPACE") OR JOY("A"))
11240     U=KEY("E") OR KEY("RETURN") OR JOY("X")
11250     IF U<>0 AND UL=0 THEN CALL USEKEY
11260     UL=U
11270     B=KEY("G") OR JOY("B")
11280     IF B<>0 AND BL=0 THEN CALL DROPLAST
11290     BL=B
11300     IF KEY("ESC") THEN IN_QUIT=1
11310     CALL TICK(DT)
11320     IF FR MOD 5=0 THEN CALL PROMPTUPDATE
11330     W3D RENDER
11340     CALL HUD
11350     GFX LINE 318,131,321,132,FN CI(0,13),BF
11360     CALL W3K_SHOW
11370     FR=FR+1
11380     IF FN IN_SERVICE() THEN
11390       CALL BIGTEXT(110,"PAUSED",FN CI(0,15),3)
11400       CALL W3K_SHOW
11410       CALL MU_SILENCE
11420       CALL IN_PAUSELOOP
11430       CALL MU_START
11440       T0=TI:W3K_T0=TI
11450     END IF
11460     IF IN_KEY=77 THEN CALL MU_TOGGLE
11470     Y=JOY("Y")
11480     IF IN_KEY=79 OR (Y<>0 AND YL=0) THEN
11490       CALL P3_DIALOG
11500       T0=TI
11510     END IF
11520     YL=Y
11530   UNTIL IN_QUIT OR ENDREQ
11540 END PROC
