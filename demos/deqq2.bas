4520     END IF
4530     END IF
4540   END IF
4550   IF A=6 THEN
4560     IF FED THEN
4570       CALL SAY("THE GLORP PURRS. IT LOOKS AT YOU WITH ENORMOUS EYES.")
4580     ELSE
4590      IF FN HAS(IJELLY) THEN
4600       CALL USEUP(IJELLY)
4610       FED=-1
