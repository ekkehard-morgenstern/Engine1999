4040 ' ------------------------------------------------------------------------------------------------ doors, the cellar's light, timers
4050 PROC DOORS(DT)
4060   LOCAL I,G
4070   FOR I=1 TO 4
4080     IF DOP(I) THEN G=100 ELSE G=0
4090     IF DCUR(I)<G THEN DCUR(I)=MIN(G,DCUR(I)+90*DT)
4100     IF DCUR(I)>G THEN DCUR(I)=MAX(G,DCUR(I)-90*DT)
4110     W3D HEIGHT DSEC(I),0,DCUR(I)
4120   NEXT I
4130 END PROC
4140 PROC LANTERNLIGHT
4150   LOCAL L,S
4160   L=FN HAS(ILANT)
4170   IF L=LANTON THEN EXIT PROC
4180   LANTON=L
4190   FOR S=34 TO 38
4200     IF L THEN W3D LIGHT S,170 ELSE W3D LIGHT S,90
4210   NEXT S
4220   FOR S=39 TO 45
4230     IF S=39 OR S=45 THEN
4240       IF L THEN W3D LIGHT S,185 ELSE W3D LIGHT S,45
4250     END IF
4260   NEXT S
4270 END PROC
4280 ' things that happen after a while: the oven cools down, the compass comes out of the melting ice
4290 PROC TIMERS
4300   IF OVENT>0 AND OVENCOOL=0 AND GT>=OVENT+30 THEN
4310     OVENCOOL=-1
4320     TXN(OOVEN)=65:CALL SHOWTHING(OOVEN)
4330     CALL SAY("THE OVEN HAS COOLED DOWN. YOU CAN OPEN IT NOW.")
4340     CALL SOUND_(8)
4350   END IF
4360   IF MELTT>0 AND GT>=MELTT THEN
4370     MELTT=0
4380     CALL REVEAL(PCOMPASS)
4390     CALL SAY("THE ICE HAS MELTED: A BRASS STAR COMPASS LIES IN THE SINK!")
4400     CALL SOUND_(8)
4410   END IF
4420 END PROC
4430 ' ------------------------------------------------------------------------------------------------ the puzzles
4440 ' a part or an item is taken (some parts have a condition)
4450 PROC PICKUP(N)
4460   IF N=PCRYSTAL AND W3D("SECTOR")<>CHAIRSEC THEN
4470     CALL SAY("IT IS ON TOP OF THE CUPBOARD, OUT OF REACH. YOU NEED TO STAND ON SOMETHING.")
4480     CALL SOUND_(6)
