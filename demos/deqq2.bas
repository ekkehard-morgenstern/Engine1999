24840 ' where a car is on the ring road: S = the distance driven (0 .. CARLOOP), the outer lanes, anticlockwise: the south road eastbound (y -190), the east road
24850 ' northbound (x 1650), the north road westbound (y 1700), the west road southbound (x -560); sets CX, CY and CH (the heading, in radians, 0 = east)
24860 PROC CARPLACE(S)
24870   IF S<2210 THEN
24880     CX=-560+S:CY=-190:CH=0
24890   ELSE
24900     IF S<4100 THEN
24910       CX=1650:CY=-190+(S-2210):CH=1.5707963
24920     ELSE
24930       IF S<6310 THEN
24940         CX=1650-(S-4100):CY=1700:CH=3.1415927
24950       ELSE
24960         CX=-560:CY=1700-(S-6310):CH=4.712389
24970       END IF
24980     END IF
24990   END IF
25000 END PROC
25010 ' the cars: up to three at a time, a new one every 15 .. 40 seconds, each drives once round the block (51 s) and is gone; one that has you in front of it on the road
25020 ' brakes and honks, then drives on when the way is free; the picture shows the car from the side it is seen from (4 views)
25030 PROC CARS(DT)
25040   LOCAL K,F,L,DX,DY,HX,HY,CR,DT2,R,V,N,BASE,W,H,TX
25050   IF GT>=CARNEXT THEN
25060     CARNEXT=GT+15+RND(1)*25
25070     FOR K=0 TO 2
25080       IF CARON(K)=0 AND CARSP=0 THEN
25090         CARSP=1
25100         CARON(K)=-1:CARD(K)=0:CARV(K)=0:CARCOL(K)=INT(RND(1)*3):CARHON(K)=0:CARSND(K)=0
25110         CALL CARPLACE(0)
25120         W3D THING 130+K,CX,CY,230+CARCOL(K)*4,120,44,W3D("SECTORZ",CX,CY,1)
25130       END IF
25140     NEXT K
25150     CARSP=0
25160   END IF
25170   NCARS=0
25180   FOR K=0 TO 2
25190     IF CARON(K) THEN
25200       NCARS=NCARS+1
25210       CALL CARPLACE(CARD(K))
25220       HX=COS(CH):HY=SIN(CH)
25230       DX=PX-CX:DY=PY-CY
25240       F=DX*HX+DY*HY:L=-DX*HY+DY*HX
25250       V=150
25260       IF F>0 AND F<200 AND ABS(L)<70 AND (PY<-60 OR PY>1580 OR PX<-440 OR PX>1530) THEN
25270         V=0
25280         IF GT>=CARHON(K) THEN
25290           CARHON(K)=GT+4:CALL SOUND_(11)
25300           IF PY<-60 OR PY>1580 OR PX<-440 OR PX>1530 THEN CALL SAY("A CAR HONKS: GET OUT OF THE ROAD!")
25310         END IF
25320       END IF
25330       IF CARV(K)<V THEN CARV(K)=MIN(V,CARV(K)+240*DT)
25340       IF CARV(K)>V THEN CARV(K)=MAX(V,CARV(K)-480*DT)
25350       CARD(K)=CARD(K)+CARV(K)*DT
25360       IF CARD(K)>=8200 THEN
25370         CARON(K)=0:W3D THINGOFF 130+K
25380       ELSE
25390         CALL CARPLACE(CARD(K))
25400         DX=CX-PX:DY=CY-PY
25410         CR=DX*HY-DY*HX
25420         R=ATAN2(CR,DX*HX+DY*HY)
25430         BASE=230+CARCOL(K)*4
25440         W=120:H=44
25450         IF ABS(R)<0.5 THEN
25460           N=BASE+3:W=66:H=48
25470         ELSE
25480           IF ABS(R)>2.64 THEN
25490             N=BASE+2:W=66:H=48
25500           ELSE
25510             IF CR>0 THEN N=BASE+1 ELSE N=BASE
25520           END IF
25530         END IF
25540         W3D THING 130+K,CX,CY,N,W,H
25550         IF SQR(DX*DX+DY*DY)<380 AND GT>=CARSND(K) THEN
25560           CARSND(K)=GT+9:CALL SOUND_(10)
25570         END IF
25580       END IF
25590     END IF
25600   NEXT K
25610 END PROC
