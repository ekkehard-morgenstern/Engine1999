34860 ' where a car is on the ring road: S = the distance driven (0 .. CARLOOP), the outer lanes, anticlockwise: the south road eastbound (y -190), the east road
34870 ' northbound (x 1650), the north road westbound (y 1700), the west road southbound (x -560); sets CX, CY and CH (the heading, in radians, 0 = east)
34880 PROC CARPLACE(S)
34890   IF S<2210 THEN
34900     CX=-560+S:CY=-190:CH=0
34910   ELSE
34920     IF S<4100 THEN
34930       CX=1650:CY=-190+(S-2210):CH=1.5707963
34940     ELSE
34950       IF S<6310 THEN
34960         CX=1650-(S-4100):CY=1700:CH=3.1415927
34970       ELSE
34980         CX=-560:CY=1700-(S-6310):CH=4.712389
34990       END IF
35000     END IF
35010   END IF
35020 END PROC
35030 ' the cars: up to three at a time, a new one every 15 .. 40 seconds, each drives once round the block (51 s) and is gone; one that has you in front of it on the road
35040 ' brakes and honks, then drives on when the way is free; the picture shows the car from the side it is seen from (4 views)
35050 PROC CARS(DT)
35060   LOCAL K,F,L,DX,DY,HX,HY,CR,DT2,R,V,N,BASE,W,H,TX
35070   IF GT>=CARNEXT THEN
35080     CARNEXT=GT+15+RND(1)*25
35090     FOR K=0 TO 2
35100       IF CARON(K)=0 AND CARSP=0 THEN
35110         CARSP=1
35120         CARON(K)=-1:CARD(K)=0:CARV(K)=0:CARCOL(K)=INT(RND(1)*3):CARHON(K)=0:CARSND(K)=0
35130         CALL CARPLACE(0)
35140         W3D THING 130+K,CX,CY,230+CARCOL(K)*4,120,44,W3D("SECTORZ",CX,CY,1)
35150       END IF
35160     NEXT K
35170     CARSP=0
35180   END IF
35190   NCARS=0
35200   FOR K=0 TO 2
35210     IF CARON(K) THEN
35220       NCARS=NCARS+1
35230       CALL CARPLACE(CARD(K))
35240       HX=COS(CH):HY=SIN(CH)
35250       DX=PX-CX:DY=PY-CY
35260       F=DX*HX+DY*HY:L=-DX*HY+DY*HX
35270       V=150
35280       IF F>0 AND F<200 AND ABS(L)<70 AND (PY<-60 OR PY>1580 OR PX<-440 OR PX>1530) THEN
35290         V=0
35300         IF GT>=CARHON(K) THEN
35310           CARHON(K)=GT+4:CALL SOUND_(11)
35320           IF PY<-60 OR PY>1580 OR PX<-440 OR PX>1530 THEN CALL SAY("A CAR HONKS: GET OUT OF THE ROAD!")
35330         END IF
35340       END IF
35350       IF CARV(K)<V THEN CARV(K)=MIN(V,CARV(K)+240*DT)
35360       IF CARV(K)>V THEN CARV(K)=MAX(V,CARV(K)-480*DT)
35370       CARD(K)=CARD(K)+CARV(K)*DT
35380       IF CARD(K)>=8200 THEN
35390         CARON(K)=0:W3D THINGOFF 130+K
35400       ELSE
35410         CALL CARPLACE(CARD(K))
35420         DX=CX-PX:DY=CY-PY
35430         CR=DX*HY-DY*HX
35440         R=ATAN2(CR,DX*HX+DY*HY)
35450         BASE=230+CARCOL(K)*4
35460         W=120:H=44
35470         IF ABS(R)<0.5 THEN
35480           N=BASE+3:W=66:H=48
35490         ELSE
35500           IF ABS(R)>2.64 THEN
35510             N=BASE+2:W=66:H=48
35520           ELSE
35530             IF CR>0 THEN N=BASE+1 ELSE N=BASE
35540           END IF
35550         END IF
35560         W3D THING 130+K,CX,CY,N,W,H
35570         IF SQR(DX*DX+DY*DY)<380 AND GT>=CARSND(K) THEN
35580           CARSND(K)=GT+9:CALL SOUND_(10)
35590         END IF
35600       END IF
35610     END IF
35620   NEXT K
35630 END PROC
