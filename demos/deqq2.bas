11740 ' ------------------------------------------------------------------------------------------------ playback (the headless test)
11750 ' commands (lines of the file named by DEQQ2_PLAY): step n | goto x y angle | walk x y | face x y | use | drop | give n | dial 731 | deqq x y | deqqoff | deqqon | state | say text | continue | new | quit
11760 PROC SPLIT(L$)
11770   LOCAL I,N,C$,CUR$
11780   FOR I=0 TO 7
11790     W$(I)=""
11800   NEXT I
11810   N=0:CUR$=""
11820   FOR I=1 TO LEN(L$)
11830     C$=MID$(L$,I,1)
11840     IF C$=" " THEN
11850       IF CUR$<>"" THEN
11860         IF N<7 THEN
11870           W$(N)=CUR$:N=N+1
11880         END IF
11890         CUR$=""
11900       END IF
11910     ELSE
11920       CUR$=CUR$+C$
11930     END IF
11940   NEXT I
11950   IF CUR$<>"" AND N<7 THEN W$(N)=CUR$
11960 END PROC
11970 PROC WALKTO(X,Y)
11980   LOCAL I,DX,DY,L,A
11990   FOR I=1 TO 1500
12000     DX=X-W3D("X"):DY=Y-W3D("Y"):L=SQR(DX*DX+DY*DY)
12010     IF L<8 THEN EXIT PROC
12020     A=ATAN2(DY,DX)*180/3.141592654
12030     W3D CAMERA W3D("X"),W3D("Y"),A
12040     W3D MOVE MIN(L,3.2),0
12050     W3D RENDER
12060     CALL TICK(1/60)
12070     IF ENDREQ THEN EXIT PROC
12080   NEXT I
12090   PRINT "# walk to ";X;",";Y;" failed at ";INT(W3D("X"));",";INT(W3D("Y"))
12100 END PROC
12110 PROC PLAYBACK
12120   LOCAL L$,C$,I,N
12130   WHILE NOT EOF(4) AND NOT QUITREQ
12140     LINE INPUT #4,L$
12150     CALL SPLIT(L$)
12160     C$=W$(0)
12170     IF C$="step" THEN
12180       FOR I=1 TO VAL(W$(1))
12190         CALL TICK(1/60)
12200       NEXT I
12210     END IF
12220     IF C$="goto" THEN
12230       W3D CAMERA VAL(W$(1)),VAL(W$(2)),VAL(W$(3)),0,0
12240       PX=W3D("X"):PY=W3D("Y")
12250       FOR I=1 TO 12
12260         W3D RENDER
12270       NEXT I
12280     END IF
12290     IF C$="walk" THEN CALL WALKTO(VAL(W$(1)),VAL(W$(2)))
12300     IF C$="face" THEN W3D CAMERA W3D("X"),W3D("Y"),ATAN2(VAL(W$(2))-W3D("Y"),VAL(W$(1))-W3D("X"))*180/3.141592654
12310     IF C$="use" THEN CALL USEKEY
12320     IF C$="drop" THEN CALL DROPLAST
12330     IF C$="give" THEN
12340       N=VAL(W$(1))
12350       CALL TAKE(N)
12360     END IF
12370     IF C$="dial" THEN DIALIN$=W$(1)
12380     IF C$="deqq" THEN
12390       CALL SHOWAT(IDEQQ,VAL(W$(1)),VAL(W$(2)))
12400       DQS=0:DQCD=GT
12410     END IF
12420     IF C$="deqqoff" THEN DQON=0
12430     IF C$="deqqon" THEN DQON=-1
12440     IF C$="say" THEN PRINT "# ";MID$(L$,5)
12450     IF C$="state" THEN
12460       PRINT "# state built=";NBUILT;" caught=";CAUGHTN;" dqs=";DQS;" sector=";W3D("SECTOR");" inv=";INV(0);INV(1);INV(2);" t=";INT(GT);" deqq=";INT(W3D("TX",IDEQQ));",";INT(W3D("TY",IDEQQ));" sec ";W3D("TSECTOR",IDEQQ)
12470     END IF
12480     IF C$="continue" THEN
12490       IF FN LOADSAVE(0) THEN
12500         CALL NEWGAME(-1)
12510         PRINT "# continued with mask ";SAVEDMASK
12520       ELSE
12530         PRINT "# no saved game"
12540       END IF
12550     END IF
12560     IF C$="new" THEN CALL NEWGAME(0)
12570     IF C$="quit" THEN QUITREQ=-1
12580     IF ENDREQ THEN
12590       CALL ENDING
12600       ENDREQ=0
12610     END IF
12620   WEND
12630 END PROC
