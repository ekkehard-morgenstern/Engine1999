270 FUNC CI(H,S)
280   RETURN 16+H*16+S
290 END FUNC
300 FUNC RI(M)
310   RETURN INT(RND(1)*M)
320 END FUNC
330 ' the angle difference of two directions (radians): 0 .. pi
340 FUNC ADIFF(A,B)
350   LOCAL D
360   D=A-B
370   D=D-INT(D/6.283185307)*6.283185307
380   IF D>3.141592654 THEN D=6.283185307-D
390   RETURN D
400 END FUNC
410 ' ------------------------------------------------------------------------------------------------ messages
420 ' SAY shows a line of at most two rows at the top of the picture for a few seconds (the headless test prints them)
430 PROC SAY(T$)
440   LOCAL I,K
450   IF HL THEN
460     PRINT "> ";T$
470     EXIT PROC
480   END IF
490   MSG1$=T$:MSG2$=""
500   IF LEN(T$)>76 THEN
510     K=76
520     FOR I=76 TO 40 STEP -1
530       IF MID$(T$,I,1)=" " AND K=76 THEN K=I
540     NEXT I
550     MSG1$=LEFT$(T$,K-1):MSG2$=MID$(T$,K+1)
560   END IF
570   MSGT=4.5
580 END PROC
590 PROC SOUND_(N)
600   IF NOT HL THEN SFX N
610 END PROC
620 ' ------------------------------------------------------------------------------------------------ things and what you carry
630 PROC PLACEALL
640   LOCAL N,X,Y,T,W,H,ZO,LT,K,SLT,A,R,SH,LV,NA$
650   FOR N=0 TO 199
660     KD(N)=0
670     W3D THINGOFF N
680   NEXT N
690   NIL=0
700   RESTORE OBJDATA
710   READ N
720   WHILE N>=0
730     READ X,Y,T,W,H,ZO,LT,K,SLT,A,R,SH,LV,NA$
740     KD(N)=K:SL(N)=SLT:HX(N)=X:HY(N)=Y:TXN(N)=T:TWD(N)=W:THT(N)=H:TZO(N)=ZO:TLT(N)=LT:ACT(N)=A:RCH(N)=R:NMS$(N)=NA$
750     TLZ(N)=1:IF LV=1 THEN TLZ(N)=120
760     IF LV=2 THEN TLZ(N)=230
770     IF LV=-1 THEN TLZ(N)=-60
780     IF K>0 THEN
790       IL(NIL)=N
800       NIL=NIL+1
810     END IF
820     IF SH THEN CALL SHOWTHING(N)
830     READ N
840   WEND
850 END PROC
860 ' puts thing N in the world at its place (its home place, or X,Y if they are given: CALL SHOWAT)
870 PROC SHOWTHING(N)
880   W3D THING N,HX(N),HY(N),TXN(N),TWD(N),THT(N),W3D("SECTORZ",HX(N),HY(N),TLZ(N))
890   IF TZO(N)<>0 THEN W3D THINGZ N,TZO(N)
900   IF TLT(N)>=0 THEN W3D THINGLIGHT N,TLT(N)
910 END PROC
920 PROC SHOWAT(N,X,Y)
930   W3D THING N,X,Y,TXN(N),TWD(N),THT(N),W3D("SECTORZ",X,Y,AZ)
940   AZ=1
950   IF TZO(N)<>0 THEN W3D THINGZ N,TZO(N)
960   IF TLT(N)>=0 THEN W3D THINGLIGHT N,TLT(N)
970 END PROC
980 ' a thing appears where it lies hidden (it is a new home for it)
990 PROC REVEAL(N)
1000   CALL SHOWTHING(N)
1010 END PROC
1020 FUNC SLOTSUSED(X)
1030   LOCAL I,S
1040   S=0
1050   FOR I=0 TO 2
1060     IF INV(I)>=0 THEN S=S+SL(INV(I))
1070   NEXT I
1080   RETURN S
1090 END FUNC
1100 FUNC HAS(N)
1110   LOCAL I,R
1120   R=0
1130   FOR I=0 TO 2
1140     IF INV(I)=N THEN R=-1
1150   NEXT I
1160   RETURN R
1170 END FUNC
1180 PROC TAKE(N)
1190   LOCAL I,F
1200   IF FN SLOTSUSED(0)+SL(N)>3 THEN
1210     CALL SAY("YOU CAN CARRY THREE PLACES OF THINGS. PUT SOMETHING DOWN FIRST (G).")
1220     CALL SOUND_(6)
1230     EXIT PROC
1240   END IF
1250   F=-1
1260   FOR I=2 TO 0 STEP -1
1270     IF INV(I)<0 THEN F=I
1280   NEXT I
1290   INV(F)=N
1300   W3D THINGOFF N
1310   CALL SAY("YOU TAKE THE "+NMS$(N)+".")
1320   CALL SOUND_(1)
1330 END PROC
1340 ' removes N from what you carry (used up or built in); the thing stays hidden
1350 PROC USEUP(N)
1360   LOCAL I
1370   FOR I=0 TO 2
1380     IF INV(I)=N THEN INV(I)=-1
1390   NEXT I
1400 END PROC
1410 PROC DROPLAST
1420   LOCAL I,N,X,Y,F,A
1430   N=-1
1440   FOR I=0 TO 2
1450     IF INV(I)>=0 THEN N=INV(I):F=I
1460   NEXT I
1470   IF N<0 THEN
1480     CALL SAY("YOU CARRY NOTHING.")
1490     EXIT PROC
1500   END IF
1510   A=W3D("ANGLE")*3.141592654/180
1520   X=PX+COS(A)*34:Y=PY+SIN(A)*34
1530   IF W3D("SECTORAT",X,Y)<0 OR W3D("TAG",W3D("SECTORAT",X,Y))=50 THEN X=PX:Y=PY
1540   IF W3D("SECTORAT",X,Y)<0 THEN EXIT PROC
1550   INV(F)=-1
1560   AZ=W3D("FLOORZ")+1
1570   CALL SHOWAT(N,X,Y)
1580   CALL SAY("YOU PUT DOWN THE "+NMS$(N)+".")
1590 END PROC
1600 ' the nearest thing that you can use in front of you (within its reach, in view); -1 if there is none
1610 FUNC TARGET(X)
1620   LOCAL I,N,B,D,BEST,BD
1630   BEST=-1:BD=1000
1640   FOR I=0 TO NIL-1
1650     N=IL(I)
1660     IF W3D("TON",N) THEN
1670       D=W3D("DIST",N)
1680       IF D<RCH(N) AND D<BD THEN
1690         B=ABS(W3D("BEARING",N))
1700         IF B<40 OR D<30 THEN
1710           IF W3D("SEES",N) THEN
1720             BEST=N:BD=D
1730           END IF
1740         END IF
1750       END IF
1760     END IF
1770   NEXT I
1780   RETURN BEST
1790 END FUNC
1800 ' ------------------------------------------------------------------------------------------------ the safe's dial
1810 FUNC DIAL(X)
1820   LOCAL SEL,OK,CN,LOK,LCN,LU,LD,LL,LR,U,D,L,R,DONE,RES,I,C
1830   IF HL THEN
1840     RES=(DIALIN$="731")
1850     DIALIN$=""
1860     RETURN RES
1870   END IF
1880   DG(0)=0:DG(1)=0:DG(2)=0:SEL=0:DONE=0:RES=0
1890   WHILE INKEY$<>""
1900   WEND
1910   LOK=-1:LCN=-1:LU=-1:LD=-1:LL=-1:LR=-1
1920   REPEAT
1930     W3D RENDER
1940     GFX LINE 200,70,439,190,FN CI(0,1),BF
1950     GFX LINE 200,70,439,190,FN CI(0,9),B
1960     GFX LINE 201,71,438,189,FN CI(0,5),B
1970     CALL CTEXT(78,"THE SAFE",FN CI(3,15))
1980     CALL CTEXT(94,"THREE DIGITS: UP/DOWN CHANGE, LEFT/RIGHT CHOOSE",FN CI(0,10))
1990     FOR I=0 TO 2
2000       IF I=SEL THEN C=FN CI(3,15) ELSE C=FN CI(0,11)
2010       GFX LINE 240+I*60,112,279+I*60,160,FN CI(0,3),BF
2020       GFX LINE 240+I*60,112,279+I*60,160,C,B
2030       GFX TEXT 250+I*60,122,STR$(DG(I)),C,3,3
2040     NEXT I
2050     CALL CTEXT(168,"RETURN: TRY    ESC: LEAVE",FN CI(0,10))
2060     IF DIALMSG>0 THEN
2070       CALL CTEXT(180,"NOTHING HAPPENS.",FN CI(1,13))
2080       DIALMSG=DIALMSG-1
2090     END IF
2100     CALL W3K_SHOW
2110     U=KEY("UP") OR KEY("W") OR JOY("UP"):D=KEY("DOWN") OR KEY("S") OR JOY("DOWN")
2120     L=KEY("LEFT") OR KEY("A") OR JOY("LEFT"):R=KEY("RIGHT") OR KEY("D") OR JOY("RIGHT")
2130     OK=KEY("RETURN") OR KEY("E") OR JOY("A") OR JOY("X"):CN=KEY("ESC") OR JOY("B") OR JOY("BACK")
2140     IF U<>0 AND LU=0 THEN DG(SEL)=(DG(SEL)+1) MOD 10
2150     IF D<>0 AND LD=0 THEN DG(SEL)=(DG(SEL)+9) MOD 10
2160     IF L<>0 AND LL=0 THEN SEL=(SEL+2) MOD 3
2170     IF R<>0 AND LR=0 THEN SEL=(SEL+1) MOD 3
2180     IF OK<>0 AND LOK=0 THEN
2190       IF DG(0)=7 AND DG(1)=3 AND DG(2)=1 THEN
2200         RES=-1:DONE=-1
2210       ELSE
2220         DIALMSG=40
2230         CALL SOUND_(6)
2240       END IF
2250     END IF
2260     IF CN<>0 AND LCN=0 THEN DONE=-1
2270     LU=U:LD=D:LL=L:LR=R:LOK=OK:LCN=CN
2280   UNTIL DONE
2290   WHILE KEY("RETURN") OR KEY("E") OR KEY("ESC")
2300     FRAME
2310   WEND
2320   WHILE INKEY$<>""
2330   WEND
2340   W3K_T0=TI
2350   RETURN RES
2360 END FUNC
2370 FUNC BITS(M)
2380   LOCAL K,N
2390   N=0
2400   FOR K=0 TO 7
2410     IF (M\(2^K)) AND 1 THEN N=N+1
2420   NEXT K
