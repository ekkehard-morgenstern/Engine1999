32520 ' water (textures 201..204, 64 x 64): four phases of a ripple pattern that repeats sideways; texture 205 shows them in turn (W3D ANIM)
32530 PROC MAKEWATER
32540   LOCAL F,X,Y,YY
32550   FOR F=0 TO 3
32560     GFX CLEAR FN W3K_C(9,6)
32570     FOR Y=0 TO 60 STEP 6
32580       FOR X=0 TO 63
32590         YY=(Y+INT(2.5*SIN((X+F*16)*PI/32+Y))+64) MOD 64
32600         GFX PSET X,YY,FN W3K_C(7,9)
32610         GFX PSET X,(YY+1) MOD 64,FN W3K_C(8,8)
32620       NEXT X
32630     NEXT Y
32640     GFX LINE 4+F*12,10,9+F*12,11,FN W3K_C(0,15),BF
32650     CALL W3K_GRAB(201+F,64,64)
32660   NEXT F
32670   W3D ANIM 205,201,4,3
32680 END PROC
32690 ' ------------------------------------------------------------------------------------------------ the town: painted house fronts, asphalt, railing
32700 PROC TOWNWINDOW(X,Y,LIT)
