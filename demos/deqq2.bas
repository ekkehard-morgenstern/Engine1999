3760     CALL REVEAL(PCOMPASS)
3770     CALL SAY("THE ICE HAS MELTED: A BRASS STAR COMPASS LIES IN THE SINK!")
3780     CALL SOUND_(8)
3790   END IF
3800 END PROC
3810 ' ------------------------------------------------------------------------------------------------ the puzzles
3820 ' a part or an item is taken (some parts have a condition)
3830 PROC PICKUP(N)
3840   IF N=PCRYSTAL AND W3D("SECTOR")<>CHAIRSEC THEN
3850     CALL SAY("IT IS ON TOP OF THE CUPBOARD, OUT OF REACH. YOU NEED TO STAND ON SOMETHING.")
