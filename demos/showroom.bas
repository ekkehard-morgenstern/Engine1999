10 ' SHOWROOM - a tour of the newer features of the software 3D sector renderer (W3D ...) of Engine1999.
20 ' The hall and the gallery lie exactly over each other (rooms over rooms); a ramp (a sloped floor) leads from the yard up into the gallery; a lift in the
30 ' yard goes up and down by itself (W3D SECMOVE); the aquarium looks onto the ramp through a pane of glass (translucent, W3D WALLFLAG 16) and its lamp
40 ' flickers (W3D LIGHTFX); the rotunda is round (a polygon sector), its floor is an animated, scrolling water texture (W3D ANIM, W3D SCROLL); a lamp
50 ' circles in the hall and lights the walls it passes (W3D LAMP); the yard ends in a painted horizon (walls that show the sky: WALLFLAG 8).
60 ' Keys: arrows or WASD walk and turn (A and D slide sideways), SHIFT runs, R and F look up and down (HOME looks straight), hold the RIGHT MOUSE BUTTON and
70 ' drag to look around, L calls the lift, T stops the lamp, Q or ESC quits. Game controller: left stick walks, right stick turns and looks.
80 ' How it is made: the map is a text file for the library w3dmap (the lines are DATA here), written by demos/levels/showroom.bas; the pictures are drawn
90 ' with GFX statements. Window only; the headless self-test (SHOWROOM_HEADLESS=1, console host) walks through the map: hall, corridor, yard, ramp, gallery.
100 LOAD LIBRARY "w3dkit"
110 LOAD LIBRARY "w3dmap"
120 BREAK OFF
130 ON ERROR GOTO FAILED
140 DIM NM$(20)
150 GOTO MAIN
160 ' water, 64 x 64: waves that move with the phase (the animation shows four of them)
170 PROC WATER(N,PH)
180   LOCAL X,Y,V,S
190   FOR Y=0 TO 63
200     FOR X=0 TO 63
210       V=SIN((X+PH)*0.19635)+SIN(X*0.09817-(Y+PH)*0.09817)
220       S=8+INT((V+2)*1.9)
230       GFX PSET X,Y,FN W3K_C(8,S)
240     NEXT X
250   NEXT Y
260   CALL W3K_GRAB(N,64,64)
270 END PROC
280 ' a pane of glass, 64 x 128: every pixel is a color (the wall is mixed with what is behind it)
290 PROC GLASS(N)
300   GFX LINE 0,0,63,127,FN W3K_C(7,10),BF
310   GFX LINE 0,0,63,127,FN W3K_C(7,14),B
320   GFX LINE 6,10,20,40,FN W3K_C(7,15)
330   GFX LINE 10,10,28,56,FN W3K_C(7,13)
340   CALL W3K_GRAB(N,64,128)
350 END PROC
360 PROC MAKETEX
370   LOCAL I
380   CALL W3K_BRICK(1,1)
390   CALL W3K_PLASTER(2,13)
400   CALL W3K_STONE(3,0)
410   CALL W3K_PLANKS(4)
420   CALL W3K_TILES(5,0,8)
430   CALL W3K_CARPET(6,1)
440   CALL W3K_METAL(7,0)
450   CALL W3K_GRASS(8)
460   CALL W3K_STONE(9,13)
470   CALL W3K_SKY(11)
480   CALL GLASS(44)
490   FOR I=0 TO 3
500     CALL WATER(40+I,I*8)
510   NEXT I
520   CALL W3K_PLANT(90)
530   CALL W3K_LAMP(91)
540   CALL W3K_TORCH(93)
550   CALL W3K_BARREL(95)
560 END PROC
570 ' the map: DATA lines for WM_LINE, up to "END"
580 PROC LOADMAP
590   LOCAL L$,I
600   CALL WM_CLEAR
610   RESTORE MAPDATA
620   READ L$
630   WHILE L$<>"END"
640     CALL WM_LINE(L$)
650     READ L$
660   WEND
670   FOR I=0 TO W3D("WALLS",3)-1
680     IF W3D("WALLINFO",3,I,7)<0 THEN W3D WALLFLAG 3,I,8
690   NEXT I
700   W3D ANIM 45,40,4,5
710   W3D SCROLL 8,0,6,2
720   W3D LIGHTFX 6,1,80,12
730 END PROC
740 PROC HUD
750   LOCAL T
760   CALL W3K_HUDBAR(264,36)
770   T=W3D("TAG",W3D("SECTOR"))
780   IF T>=10 THEN LASTT=T
790   GFX TEXT 8,270,NM$(LASTT-10),FN W3K_C(3,14)
800   GFX TEXT 8,284,"WASD/ARROWS WALK  SHIFT RUN  R/F LOOK  RIGHT MOUSE BUTTON LOOK  L LIFT  T LAMP  Q QUIT",FN W3K_C(0,10)
810 END PROC
820 PROC CHECK(N$,C)
830   IF C THEN PRINT "ok   ";N$ ELSE PRINT "FAIL ";N$
840 END PROC
850 ' the headless self-test: the map, the sectors over each other, a walk from the hall through the corridor and the yard up the ramp into the gallery
860 PROC SELFTEST
870   LOCAL I
880   W3D PLAYER 14,56,46,24
890   CALL LOADMAP
900   CALL CHECK("nine sectors",W3D("SECTORS")=9)
910   CALL CHECK("hall and gallery overlap",W3D("SECTORZ",300,200,50)=0 AND W3D("SECTORZ",300,200,250)=1)
920   CALL CHECK("ramp floor",ABS(W3D("FLOORAT",800,200)-85)<0.01 AND ABS(W3D("FLOORAT",620,200)-161.5)<0.01)
930   CALL CHECK("the yard is sky",W3D("SECINFO",3,3)=-1)
940   W3D CAMERA 500,60,0
950   CALL CHECK("start in the hall",W3D("SECTOR")=0)
960   FOR I=1 TO 45
970     W3D MOVE 12,0
980   NEXT I
990   CALL CHECK("through the corridor into the yard",W3D("SECTOR")=3)
1000   W3D CAMERA 1100,200,180
1010   FOR I=1 TO 50
1020     W3D MOVE 12,0
1030   NEXT I
1040   CALL CHECK("up the ramp into the gallery",W3D("SECTOR")=1 AND ABS(W3D("FLOORZ")-170)<0.01)
1050   W3D CAMERA 1100,200,180
1060   FOR I=1 TO 12
1070     W3D MOVE 12,0
1080   NEXT I
1090   CALL CHECK("on the ramp",W3D("SECTOR")=2 AND W3D("FLOORZ")>10)
1100   W3D CAMERA 1250,150,90
1110   CALL CHECK("the lift sector",W3D("SECTOR")=7)
1120   W3D SECMOVE 7,50,100
1130   W3D TICK 1
1140   CALL CHECK("the lift rises",ABS(W3D("FLOOR",7)-50)<0.01 AND W3D("MOVING",7))
1150   W3D TICK 1.5
1160   CALL CHECK("the lift is up",W3D("FLOOR",7)=100 AND NOT W3D("MOVING",7))
1170   W3D CAMERA 1100,300,0
1180   W3D MOVE 12,0
1190   W3D CAMERA 640,320,270
1200   CALL CHECK("the aquarium",W3D("SECTOR")=6)
1210   FOR I=1 TO 30
1220     W3D MOVE 12,0
1230   NEXT I
1240   CALL CHECK("the glass stops you",W3D("SECTOR")=6)
1250   W3D CAMERA 1550,200,0
1260   CALL CHECK("the rotunda is round",W3D("SECTOR")=8 AND W3D("SECTORAT",1620,200)=8 AND W3D("SECTORAT",1660,330)=-1)
1270   PRINT "showroom selftest done"
1280 END PROC
1290 LABEL MAIN
1300 NM$(0)="THE HALL":NM$(1)="THE GALLERY":NM$(2)="THE CORRIDOR":NM$(3)="THE RAMP":NM$(4)="THE AQUARIUM":NM$(5)="THE YARD":NM$(6)="THE LIFT":NM$(7)="THE ROTUNDA"
1310 IF ENV$("SHOWROOM_HEADLESS")<>"" THEN
1320   CALL SELFTEST
1330   BYE
1340 END IF
1350 CALL W3K_SETUP
1360 CLS:COLOR 15,0:PRINT "Building the showroom...":GFX LAYER 2,ON
1370 CALL MAKETEX
1380 CALL LOADMAP
1390 GFX LAYER 2,OFF
1400 W3D PLAYER 14,56,46,24
1410 CALL W3K_VIEW(0,0,640,264,2)
1420 W3D FOG 1500
1430 W3D COLORMAP
1440 W3D CAMERA 300,200,0
1450 LASTT=10:TT=0:LAMPON=-1:LL=0:TL=0:LIFTUP=0:LF=0:FIN=0
1460 REPEAT
1470   CALL W3K_WALK
1480   IF KEY("L") AND LF=0 THEN
1490     LIFTUP=NOT LIFTUP
1500     IF LIFTUP THEN W3D SECMOVE 7,50,100 ELSE W3D SECMOVE 7,50,0
1510   END IF
1520   LF=KEY("L")
1530   IF KEY("T") AND TL=0 THEN LAMPON=NOT LAMPON
1540   TL=KEY("T")
1550   IF LAMPON THEN TT=TT+W3K_DT
1560   W3D LAMP 0,300+230*COS(TT*0.8),200+150*SIN(TT*0.8),90,240,230
1570   W3D RENDER
1580   CALL HUD
1590   GFX LINE 318,131,321,132,FN W3K_C(0,13),BF
1600   CALL W3K_SHOW
1610   IF KEY("Q") OR KEY("ESC") THEN FIN=-1
1620 UNTIL FIN
1630 CALL W3K_DONE
1640 END
1650 LABEL FAILED
1660 CALL W3K_DONE
1670 PRINT "Error: ";ERR$;" in line ";ERL
1680 END
