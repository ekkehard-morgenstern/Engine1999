4310     END IF
4320   END IF
4330   ' 13 .. 16 a person on the bank who throws rocks: left bank facing right, right bank facing left; the second picture has the arm up with a rock
4340   IF I>=13 AND I<=16 THEN
4350     SD=(I-13)\2
