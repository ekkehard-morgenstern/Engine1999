1740 ' ====================================================================== the pictures
1750 PROC GRABSPRITE(IM)
1760   GFX GRAB 0,0,15,23,G$
1770   SPRITE DEF IM,MID$(G$,5)
1780 END PROC
1790 PROC GRABTILE(TN)
1800   GFX GRAB 0,0,15,23,G$
1810   TILE DEF TN,MID$(G$,5)
1820 END PROC
1830 PROC CLR
1840   GFX LINE 0,0,15,23,0,BF
1850 END PROC
1860 PROC MAKEART
1870   LOCAL T,I
1880   GFX LAYER 3,OFF
1890   GFX TARGET 3
1900   FOR T=0 TO 20
1910     CALL MKTILE(T)
1920     CALL GRABTILE(T)
1930   NEXT T
1940   FOR I=0 TO 31
1950     CALL MKSPR(I)
1960     CALL GRABSPRITE(I)
1970   NEXT I
1980   GFX CLEAR
1990   GFX LAYER 3,ON
2000 END PROC
2010 ' water 0 1 2, shore left 3 / right 4, grass 5 / with flowers 6, trees 7 8, road 9, house 10..13 (roof, wall: red, blue), dock left 14 / right 18, sand 15, bridge 16, bush 17
2020 PROC MKTILE(T)
2030   LOCAL I,X,Y
2040   IF T<=2 THEN
2050     GFX LINE 0,0,15,23,4,BF
2060     FOR I=1 TO 4
2070       X=FN RN(11):Y=FN RN(22)
2080       GFX LINE X,Y,X+3+FN RN(3),Y,3
2090     NEXT I
2100     FOR I=1 TO 4+T
2110       X=FN RN(11):Y=FN RN(22)
2120       GFX LINE X,Y,X+2+FN RN(3),Y,5
2130     NEXT I
2140     FOR I=1 TO T+1
2150       GFX PSET FN RN(16),FN RN(24),6
2160     NEXT I
2170   END IF
2180   IF T=3 OR T=14 THEN
2190     GFX LINE 0,0,15,23,4,BF
2200     GFX LINE 0,0,6,23,7,BF:GFX LINE 7,0,9,23,10,BF:GFX LINE 10,0,10,23,6
2210     FOR I=1 TO 6
2220       GFX PSET FN RN(7),FN RN(24),8:GFX PSET FN RN(7),FN RN(24),9
2230     NEXT I
2240     FOR I=1 TO 3
2250       GFX PSET 11+FN RN(5),FN RN(24),5
2260     NEXT I
2270   END IF
2280   IF T=4 OR T=18 THEN
2290     GFX LINE 0,0,15,23,4,BF
2300     GFX LINE 9,0,15,23,7,BF:GFX LINE 6,0,8,23,10,BF:GFX LINE 5,0,5,23,6
2310     FOR I=1 TO 6
2320       GFX PSET 9+FN RN(7),FN RN(24),8:GFX PSET 9+FN RN(7),FN RN(24),9
2330     NEXT I
2340     FOR I=1 TO 3
2350       GFX PSET FN RN(5),FN RN(24),5
2360     NEXT I
2370   END IF
2380   IF T=14 THEN
2390     GFX LINE 5,4,15,19,26,BF
2400     FOR Y=5 TO 18 STEP 3
2410       GFX LINE 5,Y,15,Y+1,25,BF
2420     NEXT Y
2430     GFX LINE 5,4,15,4,1:GFX LINE 5,19,15,19,1
2440   END IF
2450   IF T=18 THEN
2460     GFX LINE 0,4,10,19,26,BF
2470     FOR Y=5 TO 18 STEP 3
2480       GFX LINE 0,Y,10,Y+1,25,BF
2490     NEXT Y
2500     GFX LINE 0,4,10,4,1:GFX LINE 0,19,10,19,1
2510   END IF
2520   IF T=5 OR T=6 OR T=7 OR T=8 OR T=10 OR T=11 OR T=12 OR T=13 OR T=17 THEN
2530     GFX LINE 0,0,15,23,7,BF
2540     FOR I=1 TO 10
2550       GFX PSET FN RN(16),FN RN(24),8:GFX PSET FN RN(16),FN RN(24),9
2560     NEXT I
2570   END IF
2580   IF T=6 THEN
2590     FOR I=1 TO 4
2600       X=FN RN(14)+1:Y=FN RN(22)+1
2610       GFX PSET X,Y,27+FN RN(2):GFX PSET X+1,Y,27+FN RN(2)
2620     NEXT I
2630   END IF
2640   IF T=7 THEN
2650     GFX LINE 7,15,8,21,12,BF
2660     GFX CIRCLE 8,9,7,13:GFX PAINT 8,9,13,13
2670     GFX CIRCLE 6,7,3,14:GFX PAINT 6,7,14,14
2680     GFX CIRCLE 8,9,7,8
2690   END IF
2700   IF T=8 THEN
2710     GFX LINE 6,16,9,22,58,BF
2720     GFX CIRCLE 8,10,8,13:GFX PAINT 8,10,13,13
2730     GFX CIRCLE 5,7,3,14:GFX PAINT 5,7,14,14:GFX CIRCLE 11,13,3,14:GFX PAINT 11,13,14,14
2740     GFX CIRCLE 8,10,8,8
2750   END IF
2760   IF T=9 THEN
2770     GFX LINE 0,0,15,23,15,BF
2780     GFX LINE 0,0,1,23,16,BF:GFX LINE 14,0,15,23,16,BF
2790     GFX LINE 7,2,8,9,17,BF:GFX LINE 7,14,8,21,17,BF
2800     FOR I=1 TO 8
2810       GFX PSET 2+FN RN(12),FN RN(24),16
2820     NEXT I
2830   END IF
2840   IF T=19 THEN
2850     GFX LINE 0,0,15,23,15,BF
2860     GFX LINE 0,0,1,23,16,BF
2870     FOR I=1 TO 8
2880       GFX PSET 2+FN RN(14),FN RN(24),16
2890     NEXT I
2900   END IF
2910   IF T=20 THEN
2920     GFX LINE 0,0,15,23,15,BF
2930     GFX LINE 14,0,15,23,16,BF
2940     FOR I=1 TO 8
2950       GFX PSET FN RN(14),FN RN(24),16
2960     NEXT I
2970   END IF
2980   IF T=10 OR T=12 THEN
2990     ' a roof (the house is two tiles high: the roof above the wall)
3000     I=18:IF T=12 THEN I=24
3010     GFX LINE 1,3,14,23,I,BF
3020     GFX LINE 1,3,14,3,19:GFX LINE 1,3,1,23,19:GFX LINE 14,3,14,23,19
3030     FOR Y=7 TO 23 STEP 4
3040       GFX LINE 2,Y,13,Y,19
3050     NEXT Y
3060     GFX LINE 10,5,12,9,30,BF
3070   END IF
3080   IF T=11 OR T=13 THEN
3090     GFX LINE 1,0,14,17,20,BF
3100     GFX LINE 1,0,1,17,21:GFX LINE 14,0,14,17,21
3110     GFX LINE 3,4,6,9,22,BF:GFX LINE 3,4,6,4,1:GFX LINE 3,9,6,9,1:GFX LINE 3,4,3,9,1:GFX LINE 6,4,6,9,1
3120     GFX LINE 9,7,12,17,23,BF:GFX LINE 9,7,12,7,1:GFX PSET 11,12,39
3130     GFX LINE 1,18,14,19,21,BF
3140   END IF
3150   IF T=15 THEN
3160     GFX LINE 0,0,15,23,10,BF
3170     FOR I=1 TO 10
3180       GFX PSET FN RN(16),FN RN(24),11
3190     NEXT I
3200   END IF
3210   IF T=16 THEN
3220     GFX LINE 0,0,15,23,15,BF
3230     GFX LINE 0,0,15,3,29,BF:GFX LINE 0,3,15,3,30
3240     GFX LINE 0,20,15,23,29,BF:GFX LINE 0,20,15,20,30
3250     FOR X=2 TO 14 STEP 6
3260       GFX LINE X,0,X+1,3,52,BF:GFX LINE X,20,X+1,23,52,BF
3270     NEXT X
3280     GFX LINE 2,11,9,12,17,BF
3290     GFX LINE 0,4,15,4,16:GFX LINE 0,19,15,19,16
3300   END IF
3310   IF T=17 THEN
3320     GFX CIRCLE 8,13,6,13:GFX PAINT 8,13,13,13
3330     GFX CIRCLE 6,11,3,14:GFX PAINT 6,11,14,14
3340     GFX CIRCLE 8,13,6,8
3350     GFX PSET 10,15,27:GFX PSET 5,13,28
3360   END IF
3370 END PROC
3380 ' a boat hull seen from above (bow at the top if UP, else at the bottom): outline, rim color CO, inside color CI
3390 PROC HULL(CO,CI,UP)
3400   LOCAL YY,Y,HW
3410   FOR YY=0 TO 21
3420     HW=INT(1+YY*0.75)
3430     IF HW>6 THEN HW=6
3440     IF YY>15 THEN HW=6-INT((YY-15)*0.3)
3450     IF UP THEN Y=1+YY ELSE Y=22-YY
3460     GFX LINE 8-HW,Y,7+HW,Y,1
3470     IF HW>=2 THEN GFX LINE 9-HW,Y,6+HW,Y,CO
3480     IF HW>=3 THEN GFX LINE 10-HW,Y,5+HW,Y,CI
3490   NEXT YY
3500 END PROC
3510 ' a person seen from the front or the back (BK): head, body in the shirt color SC, legs; FR 0 / 1 the two walking frames, 2 standing
3520 PROC PERSON(SC,BK,FR,TOPY)
3530   LOCAL LA,RA
3540   LA=0:RA=0
3550   IF FR=0 THEN LA=2
3560   IF FR=1 THEN RA=2
3570   GFX LINE 5,TOPY,10,TOPY+7,1,BF
3580   GFX LINE 6,TOPY+1,9,TOPY+6,31,BF
3590   IF BK THEN GFX LINE 6,TOPY+1,9,TOPY+4,37,BF ELSE GFX LINE 6,TOPY+1,9,TOPY+2,37,BF:GFX PSET 7,TOPY+4,1:GFX PSET 9,TOPY+4,1
3600   GFX LINE 3,TOPY+8,12,TOPY+15,1,BF
3610   GFX LINE 4,TOPY+9,11,TOPY+14,SC,BF
3620   GFX LINE 1,TOPY+8-LA,2,TOPY+13-LA,1,BF:GFX LINE 13,TOPY+8-RA,14,TOPY+13-RA,1,BF
3630   GFX LINE 1,TOPY+9-LA,1,TOPY+11-LA,SC:GFX LINE 14,TOPY+9-RA,14,TOPY+11-RA,SC
3640   GFX LINE 1,TOPY+12-LA,2,TOPY+13-LA,31,BF:GFX LINE 13,TOPY+12-RA,14,TOPY+13-RA,31,BF
3650   GFX LINE 4,TOPY+16,7,TOPY+20-LA,1,BF:GFX LINE 8,TOPY+16,11,TOPY+20-RA,1,BF
3660   GFX LINE 5,TOPY+16,6,TOPY+19-LA,36,BF:GFX LINE 9,TOPY+16,10,TOPY+19-RA,36,BF
3670   GFX LINE 4,TOPY+20-LA,7,TOPY+21-LA,25,BF:GFX LINE 8,TOPY+20-RA,11,TOPY+21-RA,25,BF
3680 END PROC
3690 ' a swimmer: the head, the arms, ripples; CAP the color of the cap, FR the arm stroke
3700 PROC SWIMMER(CAP,FR)
3710   GFX CIRCLE 8,12,7,6,0,360,0.55
3720   GFX CIRCLE 8,12,5,5,0,360,0.6
3730   GFX LINE 6,14,9,18,CAP,BF
3740   GFX LINE 6,10,9,13,31,BF
3750   GFX LINE 6,9,9,10,CAP,BF
3760   IF FR=0 THEN
3770     GFX LINE 2,12,5,12,31:GFX LINE 10,12,13,12,31
3780   ELSE
3790     GFX LINE 3,9,5,11,31:GFX LINE 10,14,12,16,31
3800     GFX PSET 3,8,6:GFX PSET 12,17,6
3810   END IF
3820 END PROC
3830 PROC MKSPR(I)
3840   LOCAL X,Y,SD,FR
3850   CALL CLR
3860   ' 0 1 the player's boat, 2 an empty boat
3870   IF I<=2 THEN
3880     CALL HULL(40,42,-1)
3890     GFX LINE 4,12,11,12,26
3900     IF I<2 THEN
3910       GFX LINE 5,9,10,14,1,BF:GFX LINE 6,10,9,13,32,BF
3920       GFX LINE 6,6,9,8,1,BF:GFX LINE 7,7,8,8,31:GFX LINE 6,6,9,6,37
3930       GFX LINE 3,10,4,13,31:GFX LINE 11,10,12,13,31
3940     END IF
3950     GFX LINE 6,19,9,22,30,BF
3960     IF I=0 THEN
3970       GFX LINE 4,22,11,23,6:GFX PSET 3,23,6:GFX PSET 12,23,6
3980     ELSE
3990       GFX LINE 5,23,10,23,6:GFX PSET 3,22,6:GFX PSET 12,22,6:GFX PSET 7,21,6
4000     END IF
4010   END IF
4020   ' 3 .. 6 a rowboat and a motorboat, each bow up and bow down
4030   IF I>=3 AND I<=6 THEN
4040     SD=(I-3) MOD 2
4050     IF I<=4 THEN
4060       CALL HULL(26,42,SD=0)
4070       GFX LINE 0,9,4,12,12:GFX LINE 11,12,15,9,12
4080       GFX LINE 6,10,9,15,1,BF:GFX LINE 7,11,8,14,33,BF
4090     ELSE
4100       CALL HULL(41,40,SD=0)
4110       GFX LINE 5,8,10,9,22,BF:GFX LINE 5,8,10,8,1
4120       GFX LINE 6,16,9,19,30,BF
4130     END IF
4140   END IF
4150   IF I=7 OR I=8 THEN CALL SWIMMER(35,I-7)
4160   IF I=9 OR I=10 THEN CALL SWIMMER(32,I-9)
4170   IF I=11 OR I=12 THEN
4180     GFX LINE 5,8,10,20,38,BF:GFX LINE 5,8,10,8,1:GFX LINE 4,9,4,19,1:GFX LINE 11,9,11,19,1
4190     GFX LINE 6,4,9,8,1,BF:GFX LINE 7,5,8,7,31:GFX LINE 6,4,9,5,38
4200     GFX LINE 6,12,9,17,39,BF
4210     GFX LINE 3,20,12,23,38,BF:GFX LINE 3,23,12,23,1
4220     IF I=11 THEN
4230       GFX CIRCLE 7,2,1,49:GFX CIRCLE 10,0,1,49:GFX PSET 5,5,49
4240     ELSE
4250       GFX CIRCLE 9,3,1,49:GFX CIRCLE 6,1,1,49:GFX PSET 11,6,49
4260     END IF
4270   END IF
4280   ' 13 .. 16 a person on the bank who throws rocks: left bank facing right, right bank facing left; the second picture has the arm up with a rock
4290   IF I>=13 AND I<=16 THEN
4300     SD=(I-13)\2
4310     FR=(I-13) MOD 2
4320     CALL PERSON(33,0,2,4)
4330     IF SD=0 THEN
4340       IF FR=1 THEN
4350         GFX LINE 12,12,14,20,0,BF:GFX LINE 12,2,14,12,1,BF:GFX LINE 13,2,13,12,33:GFX CIRCLE 13,0,2,50:GFX PSET 13,-1,6
4360       END IF
4370     ELSE
4380       IF FR=1 THEN
4390         GFX LINE 1,12,3,20,0,BF:GFX LINE 1,2,3,12,1,BF:GFX LINE 2,2,2,12,33:GFX CIRCLE 2,0,2,50
4400       END IF
4410     END IF
4420   END IF
4430   IF I=17 THEN
4440     GFX CIRCLE 8,12,3,51:GFX PAINT 8,12,50,51:GFX PSET 7,11,6
4450   END IF
4460   IF I=18 THEN
4470     GFX CIRCLE 8,12,3,6:GFX CIRCLE 8,12,5,59,0,360,0.7
4480     GFX PSET 8,7,59:GFX PSET 4,10,59:GFX PSET 12,10,59
4490   END IF
4500   IF I=19 THEN
4510     GFX CIRCLE 8,12,6,6:GFX CIRCLE 8,12,8,5,0,360,0.7
4520     GFX PSET 8,3,59:GFX PSET 3,8,59:GFX PSET 13,8,59:GFX PSET 2,14,59:GFX PSET 14,14,59
4530   END IF
4540   ' 20 an apple, 21 a carrot, 22 an ice cream cone
4550   IF I=20 THEN
4560     GFX CIRCLE 8,13,5,44:GFX PAINT 8,13,44,44:GFX PSET 6,11,2:GFX PSET 6,12,2
4570     GFX LINE 8,6,8,8,12:GFX LINE 9,6,11,5,13
4580   END IF
4590   IF I=21 THEN
4600     FOR Y=8 TO 21
4610       X=INT((21-Y)*0.32)+1
4620       GFX LINE 8-X,Y,7+X,Y,45
4630     NEXT Y
4640     GFX LINE 6,4,6,8,13:GFX LINE 8,2,8,8,13:GFX LINE 10,4,10,8,13
4650     GFX LINE 5,11,7,11,2:GFX LINE 9,15,10,15,2
4660   END IF
4670   IF I=22 THEN
4680     FOR Y=12 TO 22
4690       X=INT((22-Y)*0.4)
4700       GFX LINE 8-X,Y,7+X,Y,46
4710     NEXT Y
4720     GFX LINE 6,14,9,15,2
4730     GFX CIRCLE 8,9,4,47:GFX PAINT 8,9,47,47
4740     GFX CIRCLE 8,5,3,48:GFX PAINT 8,5,48,48:GFX PSET 8,2,44
4750   END IF
4760   ' 23 24 25 the player walking away from you (the back), standing; 26 27 a passer-by on the bridge
4770   IF I>=23 AND I<=25 THEN CALL PERSON(32,-1,I-23,2)
4780   IF I=26 OR I=27 THEN CALL PERSON(33,0,I-26,2)
4790   ' 28 29 a car on the bridge driving east / west
4800   IF I=28 OR I=29 THEN
4810     GFX LINE 1,7,14,17,1,BF
4820     IF I=28 THEN GFX LINE 2,8,13,16,54,BF ELSE GFX LINE 2,8,13,16,55,BF
4830     GFX LINE 4,9,11,15,22,BF:GFX LINE 6,9,9,15,0
4840     IF I=28 THEN GFX LINE 6,9,9,15,54,BF:GFX LINE 13,8,14,9,56,BF:GFX LINE 13,15,14,16,56,BF ELSE GFX LINE 6,9,9,15,55,BF:GFX LINE 1,8,2,9,56,BF:GFX LINE 1,15,2,16,56,BF
4850     GFX LINE 3,6,5,6,1:GFX LINE 10,6,12,6,1:GFX LINE 3,17,5,17,1:GFX LINE 10,17,12,17,1
4860   END IF
4870   ' 30 31 a cyclist riding east / west
4880   IF I=30 OR I=31 THEN
4890     GFX CIRCLE 4,15,3,1:GFX CIRCLE 12,15,3,1
4900     GFX LINE 4,15,8,11,57:GFX LINE 8,11,12,15,57:GFX LINE 8,11,7,8,57
4910     IF I=30 THEN X=1 ELSE X=-1
4920     GFX LINE 8,5,8+X,9,35:GFX LINE 7,3,9,5,31,BF:GFX LINE 7,3,9,3,37
4930     GFX LINE 8,9,8+X*3,12,36
4940   END IF
4950 END PROC
4960 ' ====================================================================== the world: rows made up on the way
4970 ' the tiles of the world row N into ROW$ (41 tiles); GCL / GCR are the tile columns of the shores, BRG is -1 if the row is a bridge, DOCK 1 / 2 a jetty on the left / right bank
4980 PROC MKROW(N)
4990   LOCAL X,CL,CR,SL,SR,M,T,TL,TQ,PL,PR,RDL,RDR,PRL,PRR
5000   TL=INT(FN RCEN(N)-FN RHALF(N)):TQ=INT(FN RCEN(N)+FN RHALF(N))
5010   PL=TL:PR=TQ
5020   PRL=-1:PRR=-1
5030   IF N>FIRSTROW THEN
5040     PL=RCLA((N-1) MOD 64):PR=RCRA((N-1) MOD 64)
5050     PRL=RDLA((N-1) MOD 64):PRR=RDRA((N-1) MOD 64)
5060   END IF
5070   ' each shore follows its target by one tile at most every third row: it never jumps and the rows above and below always connect
5080   CL=PL:CR=PR
5090   IF TL<>PL AND SNCL>=2 THEN CL=PL+SGN(TL-PL):SNCL=0 ELSE SNCL=SNCL+1
5100   IF TQ<>PR AND SNCR>=2 THEN CR=PR+SGN(TQ-PR):SNCR=0 ELSE SNCR=SNCR+1
5110   CL=MAX(3,CL):CR=MIN(37,CR)
5120   IF CR-CL<7 THEN CL=CL-1:CR=CR+1
5130   RCLA(N MOD 64)=CL:RCRA(N MOD 64)=CR
5140   GCL=CL:GCR=CR:BRG=0:DOCK=0
5150   ROW$=""
5160   SL=FN STYLE(N\40,1):SR=FN STYLE(N\40,2)
5170   ' the roads follow the banks: 3 to 6 columns from the shore, moving one column at a time (the row where it moves has both columns as road)
5180   RDL=-1:RDR=-1
5190   IF SL=2 THEN
5200     RDL=MAX(0,CL-3)
5210     IF PRL>=0 THEN
5220       RDL=PRL
5230       IF CL-RDL<3 THEN RDL=RDL-1
5240       IF CL-RDL>6 THEN RDL=RDL+1
5250     END IF
5260   END IF
5270   IF SR=2 THEN
5280     RDR=MIN(40,CR+3)
5290     IF PRR>=0 THEN
5300       RDR=PRR
5310       IF RDR-CR<3 THEN RDR=RDR+1
5320       IF RDR-CR>6 THEN RDR=RDR-1
5330     END IF
5340   END IF
5350   IF RDL<0 THEN RDL=-1
5360   IF RDR>40 THEN RDR=-1
5370   RDLA(N MOD 64)=RDL:RDRA(N MOD 64)=RDR
5380   IF N MOD 100=60 THEN
5390     BRG=-1
5400     FOR X=0 TO 40
5410       ROW$=ROW$+CHR$(16)
5420     NEXT X
5430     EXIT PROC
5440   END IF
5450   M=N\2
5460   IF N MOD 5=2 THEN
5470     IF FN HASH(N\5,77)>0.93 THEN DOCK=1
5480     IF FN HASH(N\5,78)>0.93 THEN DOCK=2
5490   END IF
5500   FOR X=0 TO 40
5510     IF X<CL THEN
5520       T=FN BANKT(N,M,X,CL-X,SL,RDL,0)
5530     ELSE
5540       IF X=CL THEN
5550         T=3:IF DOCK=1 THEN T=14
5560       ELSE
5570         IF X<CR THEN
5580           T=INT(FN HASH(N,X)*3)
5590         ELSE
5600           IF X=CR THEN
5610             T=4:IF DOCK=2 THEN T=18
5620           ELSE
5630             T=FN BANKT(N,M,X,X-CR,SR,RDR,1)
5640           END IF
5650         END IF
5660       END IF
5670     END IF
5680     ROW$=ROW$+CHR$(T)
5690   NEXT X
5700   IF RDL>=0 THEN
5710     IF PRL>=0 AND PRL<>RDL THEN
5720       MID$(ROW$,MIN(PRL,RDL)+1,1)=CHR$(19):MID$(ROW$,MAX(PRL,RDL)+1,1)=CHR$(20)
5730     ELSE
5740       MID$(ROW$,RDL+1,1)=CHR$(9)
5750     END IF
5760   END IF
5770   IF RDR>=0 THEN
5780     IF PRR>=0 AND PRR<>RDR THEN
5790       MID$(ROW$,MIN(PRR,RDR)+1,1)=CHR$(19):MID$(ROW$,MAX(PRR,RDR)+1,1)=CHR$(20)
5800     ELSE
5810       MID$(ROW$,RDR+1,1)=CHR$(9)
5820     END IF
5830   END IF
5840 END PROC
5850 ' look for a free object and give it a kind K at the screen column X and the world height Y (SLT = 0 if there is none)
5860 PROC NEWOBJ(K,X,Y)
5870   LOCAL I
5880   SLT=0
5890   FOR I=1 TO NO
5900     IF OK(I)=0 THEN
5910       OK(I)=K:OX(I)=X:OY(I)=Y:OVX(I)=0:OVY(I)=0:OT(I)=0:OF(I)=0:OA(I)=0
5920       SLT=I
5930       EXIT PROC
5940     END IF
5950   NEXT I
5960 END PROC
5970 ' what turns up in the new row N (at the top of the screen): swimmers, divers, boats, throwers, things to collect, a boat at a jetty, traffic on a bridge
5980 PROC SPAWNROW(N)
5990   LOCAL Y,X,H,S
6000   Y=N*24+24+8+FN RN(16)
6010   IF BRG THEN
6020     CALL SPAWNBRIDGE(N)
6030     EXIT PROC
6040   END IF
6050   H=FN HASH(N,3)
6060   IF H<0.03+0.012*LVL THEN
6070     X=(GCL+1)*16+FN RN((GCR-GCL-1)*16-16)
6080     CALL NEWOBJ(1,X,Y)
6090     IF SLT>0 THEN OVX(SLT)=(RND(1)-0.5)*0.4
6100   END IF
6110   H=FN HASH(N,4)
6120   IF H<0.012+0.007*LVL THEN
6130     X=(GCL+1)*16+FN RN((GCR-GCL-1)*16-16)
6140     CALL NEWOBJ(2,X,Y)
6150     IF SLT>0 THEN
6160       OVX(SLT)=(0.5+RND(1)*0.8)*(1-2*FN RN(2))
6170       OT(SLT)=FN RN(60)
6180     END IF
6190   END IF
6200   H=FN HASH(N,5)
6210   IF H<0.016+0.008*LVL AND N MOD 3=0 THEN
6220     X=(GCL+1)*16+FN RN((GCR-GCL-1)*16-16)
6230     CALL NEWOBJ(3,X,Y)
6240     IF SLT>0 THEN
6250       OF(SLT)=FN RN(2)
6260       S=1-2*FN RN(2)
6270       OVY(SLT)=S*(0.35+RND(1)*0.45+LVL*0.04)
6280       IF S>0 THEN OVY(SLT)=OVY(SLT)*0.6
6290     END IF
6300   END IF
6310   H=FN HASH(N,6)
6320   IF H<0.035+0.01*LVL THEN
6330     S=FN RN(2)
6340     IF S=0 THEN X=GCL*16-6 ELSE X=GCR*16+10
6350     IF X>=0 AND X<=624 THEN
6360       CALL NEWOBJ(4,X,Y)
6370       IF SLT>0 THEN OF(SLT)=S:OT(SLT)=40+FN RN(80)
6380     END IF
6390   END IF
6400   H=FN HASH(N,7)
6410   IF H<0.07 THEN
6420     S=FN RN(2)
6430     IF S=0 THEN X=(GCL-2-FN RN(3))*16 ELSE X=(GCR+2+FN RN(3))*16
6440     IF X>=0 AND X<=624 THEN
6450       CALL NEWOBJ(5,X,Y)
6460       IF SLT>0 THEN OF(SLT)=FN RN(3)
6470     END IF
6480   END IF
6490   IF DOCK>0 THEN
6500     IF DOCK=1 THEN X=(GCL+1)*16-2 ELSE X=(GCR-1)*16+2
6510     CALL NEWOBJ(6,X,N*24+24)
6520     IF SLT>0 THEN OA(SLT)=1
6530   END IF
6540 END PROC
6550 ' the traffic on a bridge: a few people, a bicycle, cars; they only decorate it (OF 0 passer-by, 1 cyclist, 2 car; OVX the speed, east or west)
6560 PROC SPAWNBRIDGE(N)
6570   LOCAL I,K,S
6580   FOR I=1 TO 5
6590     K=FN RN(3)
6600     S=1-2*FN RN(2)
6610     CALL NEWOBJ(8,FN RN(620),N*24+24)
6620     IF SLT>0 THEN
6630       OF(SLT)=K
6640       IF K=0 THEN OVX(SLT)=S*(0.3+RND(1)*0.3)
6650       IF K=1 THEN OVX(SLT)=S*(1+RND(1)*0.8)
6660       IF K=2 THEN OVX(SLT)=S*(1.8+RND(1)*1.2)
6670     END IF
6680   NEXT I
6690 END PROC
6700 ' the first rows of a new game: 37 rows, the 13 that are visible and 24 below them for the walker's scrollback (made from the bottom up, each connects to the one below), no objects yet
6710 PROC STARTWORLD
6720   LOCAL J
6730   LVL=1
6740   WF=960:W=960:TR=W\24+12:WPEAK=WF
6750   FIRSTROW=TR-36:TRMAX=FIRSTROW-1:SNCL=0:SNCR=0
6760   FOR J=FIRSTROW TO TR
6770     CALL MKROW(J)
6780     RS$(J MOD 64)=ROW$
6790     TRMAX=J
6800   NEXT J
6810   FOR J=1 TO NO
6820     OK(J)=0:SH(J)=0
6830     SPRITE J,OFF
6840   NEXT J
6850   CALL SHOWTILES
6860 END PROC
6870 PROC SHOWTILES
6880   LOCAL J,N,M$
6890   FOR J=0 TO 12
6900     N=TR-J
6910     IF N>TRMAX OR N<TRMAX-63 OR N<FIRSTROW THEN
6920       M$=M$+STRING$(41,CHR$(5))
6930     ELSE
6940       M$=M$+RS$(N MOD 64)
6950     END IF
6960   NEXT J
6970   TILE FILL M$
6980   TILE SCROLL 0,W MOD 24
6990 END PROC
7000 ' the world moves by SP pixels (forwards: new rows are made at the top; backwards, for a walker: the last rows are still there, up to 24 rows = two screens back)
7010 PROC SCROLL(SP)
7020   LOCAL NT
7030   WF=WF+SP
7040   IF WF<WPEAK-576 THEN WF=WPEAK-576
7050   IF WF<FIRSTROW*24 THEN WF=FIRSTROW*24
7060   IF WF>WPEAK THEN WPEAK=WF
7070   W=INT(WF)
7080   NT=W\24+12
7090   WHILE TRMAX<NT
7100     TRMAX=TRMAX+1
7110     CALL MKROW(TRMAX)
7120     RS$(TRMAX MOD 64)=ROW$
7130     IF SPAWNING THEN CALL SPAWNROW(TRMAX)
7140   WEND
7150   IF NT<>TR THEN
7160     TR=NT
7170     CALL SHOWTILES
7180   ELSE
7190     TILE SCROLL 0,W MOD 24
7200   END IF
7210 END PROC
7220 ' ====================================================================== a game
7230 PROC PLAYGAME
7240   CALL STARTGAME
7250   REPEAT
7260     GFX VSYNC
7270     FRM=FRM+1
7280     CALL CTRL
7290     IF GQ=0 THEN
7300       CALL MOVEPLAYER
7310       CALL OBJECTS
7320       CALL SHOWALL
7330       IF BN>0 THEN
7340         BN=BN-1
7350         IF BN=0 THEN GFX CLEAR
7360       END IF
7370       IF MTM>0 THEN
7380         MTM=MTM-1
7390         IF MTM=0 THEN MSG$=""
7400       END IF
7410       IF FRM MOD 5=0 THEN CALL HUD
7420     END IF
7430   UNTIL GQ=1 OR OV=1
7440   BEST=SCORE
7450   IF OV=1 THEN CALL GAMEOVER
7460   CALL MUSICOFF:CALL SNDRESET
7470   SPAWNING=0
7480   CALL HIDESPRITES
7490   GFX CLEAR
7500   TXT FILL 0,0,79,24,32,0,0
7510 END PROC
7520 PROC STARTGAME
7530   SCORE=0:LIVES=3:LVL=1:DIST=0:BONUS=0:NXL=5000:OV=0:GQ=0:IN_QUIT=0:FRM=0
7540   MSG$="":MTM=0:BN=0:LASTB=0:HF=0:WMV=0:UB=0:OLVL=0:BRN=0
7550   CALL STARTWORLD
7560   SPAWNING=-1
7570   CALL RESPAWN
7580   TX_PAPER=211
7590   TXT FILL 0,0,79,24,32,0,0
7600   TXT FILL 0,0,79,1,32,200,211
7610   MSG$="DOWN THE ETERNAL RIVER - STEER CLEAR OF EVERYTHING!":MTM=300
7620   CALL MUSICON
7630   CALL HUD
7640 END PROC
7650 ' a new boat in the middle of the river; what is near it goes away
7660 PROC RESPAWN
7670   LOCAL N,I,SY
7680   N=INT((W+311-226)/24)
7690   PX=FN MIDRIV(N)*16:PY=226
7700   PM=0:INV=120:SW=0:BT=0:DTM=0
7710   FOR I=1 TO NO
7720     IF OK(I)=1 OR OK(I)=2 OR OK(I)=3 OR OK(I)=7 THEN
7730       SY=W+312-OY(I)
7740       IF SY>150 THEN OK(I)=0
7750     END IF
7760   NEXT I
7770 END PROC
7780 PROC CTRL
7790   CALL IN_POLL
7800   IF FN IN_SERVICE() THEN CALL PAUSE
7810   IF IN_QUIT THEN GQ=1
7820 END PROC
7830 PROC PAUSE
7840   CALL MUSICOFF
7850   CALL BANNER("PAUSED","P or START continues      Q or BACK quits",0)
7860   CALL IN_PAUSELOOP
7870   IF IN_QUIT THEN GQ=1
7880   GFX CLEAR
7890   BN=0
7900   IF GQ=0 THEN CALL MUSICON
7910 END PROC
7920 ' ====================================================================== the player
7930 ' the room the boat has at its height on the screen: BXL .. BXR (the pixel columns of the left edge of its picture)
7940 PROC BOUNDS
7950   LOCAL N1,N2,L1,R1,L2,R2
7960   N1=INT((W+311-PY)/24):N2=INT((W+311-PY-23)/24)
7970   L1=FN LSHORE(N1):R1=FN RSHORE(N1)
7980   L2=FN LSHORE(N2):R2=FN RSHORE(N2)
7990   BXL=MAX(L1,L2)*16+8:BXR=MIN(R1,R2)*16-8
8000   IF BXR<BXL THEN BXL=(BXL+BXR)/2:BXR=BXL
8010 END PROC
8020 PROC MOVEPLAYER
8030   LOCAL SP,C,NX,NN,I
8040   IF INV>0 THEN INV=INV-1
8050   IF BT>0 THEN BT=BT-1
8060   SP=0
8070   WMV=0
8080   IF PM=0 THEN
8090     SP=MIN(2.6,1.3+LVL*0.12)
8100     IF IN_DY<0 THEN SP=SP*1.8
8110     IF IN_DY>0 THEN SP=SP*0.45
8120     PX=PX+IN_DX*2.4
8130     CALL BOUNDS
8140     PX=FN CLAMP(PX,BXL,BXR)
8150     ' under a bridge?
8160     UB=0
8170     FOR I=1 TO 2
8180       NN=INT((W+311-PY-4-(I-1)*16)/24)
8190       IF NN MOD 100=60 THEN UB=-1:BRN=NN
8200     NEXT I
8210     IF UB AND LASTB<>BRN THEN
8220       LASTB=BRN:BONUS=BONUS+100:SFX 7
8230       MSG$="UNDER THE BRIDGE! +100":MTM=120
8240     END IF
8250   END IF
8260   IF PM=1 THEN
8270     UB=0
8280     SP=1.2
8290     PX=FN CLAMP(PX+IN_DX*1.8,0,624)
8300     PY=FN CLAMP(PY+IN_DY*1.8,40,270)
8310     SW=SW-1
8320     IF SW<=0 THEN CALL DIE("YOU DROWNED")
8330     IF PM=1 THEN
8340       C=FN TCL(FN TILEAT(PX+8,PY+14),PX+8,1)
8350       IF C>0 THEN
8360         PM=2
8370         SFX 5
8380         MSG$="SAFE ON THE BANK! WALK UP / DOWN AND LOOK FOR A BOAT":MTM=300
8390       END IF
8400     END IF
8410   END IF
8420   IF PM=2 THEN
8430     UB=0
8440     NX=PX+IN_DX*1.3
8450     NX=FN CLAMP(NX,0,624)
8460     IF IN_DX<>0 THEN
8470       C=FN TCL(FN TILEAT(NX+8,PY+20),NX+8,0)
8480       IF C=1 THEN PX=NX:WMV=-1
8490       IF C=0 AND IN_BTN THEN
8500         PM=1:SW=600:PX=NX:SFX 1
8510         CALL NEWOBJ(9,PX,W+312-PY-6)
8520         IF SLT>0 THEN OT(SLT)=16
8530         MSG$="SWIM!":MTM=90
8540       END IF
8550     END IF
8560     IF PM=2 AND IN_DY<0 THEN
8570       C=FN TCL(FN TILEAT(PX+8,PY+15),PX+8,0)
8580       IF C=1 THEN SP=1.3:WMV=-1
8590     END IF
8600     IF PM=2 AND IN_DY>0 THEN
8610       C=FN TCL(FN TILEAT(PX+8,PY+22),PX+8,0)
8620       IF C=1 AND WF>WPEAK-570 AND WF>FIRSTROW*24+2 THEN SP=-1.3:WMV=-1
8630     END IF
8640     IF PM=2 THEN
8650       C=FN TCL(FN TILEAT(PX+8,PY+20),PX+8,0)
8660       IF C=0 THEN
8670         PM=1:SW=600:SFX 1
8680         MSG$="YOU FELL INTO THE WATER!":MTM=120
8690       END IF
8700     END IF
8710   END IF
8720   IF PM=3 THEN
8730     UB=0
8740     SP=0.8
8750     DTM=DTM-1
8760     IF DTM<=0 THEN
8770       IF LIVES<=0 THEN OV=1 ELSE CALL RESPAWN
8780     END IF
8790   END IF
8800   SPD2=SP
8810   SCORE=INT(DIST/10)+BONUS
8820   LVL=1+INT(DIST/4000)
8830   IF LVL<>OLVL THEN
8840     IF OLVL>0 THEN MSG$="RIVER LEVEL "+STR$(LVL)+" - NARROWER AND BUSIER":MTM=240:SFX 8
8850     OLVL=LVL
8860   END IF
8870   IF SCORE>=NXL THEN
8880     NXL=NXL+5000
8890     IF LIVES<9 THEN LIVES=LIVES+1
8900     SFX 8:MSG$="EXTRA LIFE!":MTM=180
8910   END IF
8920   CALL SCROLL(SP)
8930   DIST=WPEAK-960
8940 END PROC
8950 ' you are out of the boat: the boat is lost, the swimmer is in the water (a luck roll decides in CRASH)
8960 PROC DIE(R$)
8970   IF PM=3 THEN EXIT PROC
8980   PM=3:DTM=140:LIVES=LIVES-1
8990   SFX 6
9000   CALL NEWOBJ(9,PX,W+312-PY-6)
9010   IF SLT>0 THEN OT(SLT)=30
9020   MSG$=R$+"!":MTM=150
9030   HF=-1
9040 END PROC
9050 ' a hit in the boat (I the object): often the end, but sometimes you are only thrown into the water
9060 PROC CRASH(I)
9070   LOCAL R,S
9080   SFX 3
9090   R=FN RN(100)
9100   IF R<45 THEN
9110     CALL DIE("CRASH! THE BOAT IS WRECKED")
9120   ELSE
9130     S=1-2*FN RN(2)
9140     CALL NEWOBJ(6,FN CLAMP(PX+S*20,0,624),W+312-PY)
9150     IF SLT>0 THEN OVX(SLT)=S*0.25:OVY(SLT)=0.6
9160     PM=1:SW=900:BT=45:INV=60
9170     MSG$="THROWN INTO THE WATER! SWIM TO A BANK OR TO A BOAT":MTM=300
9180     CALL NEWOBJ(9,PX,W+312-PY-6)
9190     IF SLT>0 THEN OT(SLT)=16
9200   END IF
9210   HF=-1
9220 END PROC
9230 PROC BOARD(I)
9240   OK(I)=0:SPRITE I,OFF:SH(I)=0
9250   PX=FN CLAMP(OX(I),0,624):PY=226
9260   CALL BOUNDS
9270   PX=FN CLAMP(PX,BXL,BXR)
9280   PM=0:INV=100:SW=0
9290   BONUS=BONUS+50
9300   SFX 5
9310   MSG$="A BOAT! GO ON DOWN THE RIVER (+50)":MTM=200
9320 END PROC
9330 ' ====================================================================== the objects
9340 ' keeps the object I inside the river (a swimmer, a diver, a boat): OA(I) bounce
9350 PROC KEEPIN(I)
9360   LOCAL N,L,R
9370   N=INT(OY(I)/24)
9380   L=FN LSHORE(N)*16+12:R=FN RSHORE(N)*16-12
9390   IF OX(I)<L THEN OX(I)=L:OVX(I)=ABS(OVX(I))
9400   IF OX(I)>R THEN OX(I)=R:OVX(I)=-ABS(OVX(I))
9410 END PROC
9420 PROC OBJECTS
9430   LOCAL LIM,I,K,SX,SY,TX,PWY,DX,DY,TT,D,PR,PRX,PRY,PRW,PRH,OW,OH,OXX,OYY,HZ
9440   IF PM=3 THEN EXIT PROC
9450   ' the player's rectangle
9460   PRX=PX+3:PRY=PY+4:PRW=10:PRH=16
9470   IF PM=1 THEN PRX=PX+4:PRY=PY+6:PRW=8:PRH=10
9480   IF PM=2 THEN PRX=PX+4:PRY=PY+6:PRW=8:PRH=16
9490   PWY=W+312-(PY+12)
9500   FOR I=1 TO NO
9510     K=OK(I)
9520     IF K>0 THEN
9530       OX(I)=OX(I)+OVX(I):OY(I)=OY(I)+OVY(I)
9540       SX=OX(I):SY=W+312-OY(I)
9550       LIM=330
9560       IF K=4 OR K=5 OR K=6 THEN LIM=950
9570       IF SY>LIM OR SY<-800 OR SX<-40 OR SX>680 THEN
9580         OK(I)=0
9590         ITERATE
9600       END IF
9610       IF K=1 THEN
9620         IF (FRM+I*7) MOD 70=0 THEN OVX(I)=(RND(1)-0.5)*0.5
9630         CALL KEEPIN(I)
9640       END IF
9650       IF K=2 THEN
9660         OT(I)=OT(I)+1
9670         IF OT(I)=90 THEN SFX 9
9680         CALL KEEPIN(I)
9690       END IF
9700       IF K=3 THEN
9710         TT=INT(OY(I)/24)
9720         TX=FN MIDRIV(TT)*16-8
9730         D=((I MOD 5)-2)*14
9740         OVX(I)=FN CLAMP((TX+D-OX(I))*0.05,-1.3,1.3)
9750       END IF
9760       IF K=4 THEN
9770         IF OA(I)>0 THEN OA(I)=OA(I)-1
9780         OT(I)=OT(I)-1
9790         IF OT(I)<=0 AND SY>40 AND SY<230 AND ABS(OX(I)-PX)<300 AND PM<>3 THEN
9800           OT(I)=MAX(45,100+FN RN(90)-LVL*8)
9810           OA(I)=14
9820           CALL THROWROCK(I)
9830         END IF
9840       END IF
9850       IF K=7 THEN
9860         OT(I)=OT(I)-1
9870         IF OT(I)<=0 THEN
9880           IF FN TCL(FN TILEAT(SX+8,SY+12),SX+8,0)=0 THEN
9890             OK(I)=9:OT(I)=16:SFX 1
9900           ELSE
9910             OK(I)=0
9920           END IF
9930         END IF
9940       END IF
9950       IF K=9 THEN
9960         OT(I)=OT(I)-1
9970         IF OT(I)<=0 THEN OK(I)=0
9980       END IF
9990       ' what hits the player
10000       K=OK(I)
10010       IF K>0 THEN
10020         OXX=SX:OYY=SY:OW=12:OH=16
10030         IF K=1 THEN OXX=SX+4:OYY=SY+7:OW=8:OH=9
10040         IF K=2 THEN OXX=SX+3:OYY=SY+4:OW=10:OH=14
10050         IF K=3 OR K=6 THEN OXX=SX+2:OYY=SY+1:OW=12:OH=22
10060         IF K=6 AND OA(I)=1 THEN OXX=SX-8:OW=28
10070         IF K=5 THEN OXX=SX+2:OYY=SY+4:OW=12:OH=16
10080         IF K=7 THEN OXX=SX+5:OYY=SY+9:OW=6:OH=6
10090         HZ=0
10100         IF FN HIT(PRX,PRY,PRW,PRH,OXX,OYY,OW,OH) THEN
10110           IF PM=0 AND INV<=0 AND NOT UB THEN
10120             IF K=1 OR K=2 OR K=3 OR K=7 THEN CALL CRASH(I)
10130           END IF
10140           IF PM=1 AND INV<=0 THEN
10150             IF K=2 OR K=3 OR K=7 THEN CALL DIE("HIT WHILE SWIMMING")
10160           END IF
10170           IF PM=2 AND K=7 THEN CALL DIE("HIT BY A ROCK")
10180           IF (PM=1 OR PM=2) AND K=6 AND BT<=0 THEN CALL BOARD(I)
10190           IF PM=2 AND K=5 THEN
10200             OK(I)=0:SPRITE I,OFF:SH(I)=0
10210             BONUS=BONUS+25+25*OF(I)
10220             SFX 4
10230             MSG$=MID$("APPLE +25    CARROT +50   ICE CREAM +75",1+OF(I)*13,13):MTM=100
10240           END IF
10250         END IF
10260         IF PM=3 THEN EXIT PROC
10270       END IF
10280     END IF
10290   NEXT I
10300 END PROC
10310 ' the thrower I throws a rock at where the player will be in 70 frames (the world moves on meanwhile), and not quite exactly
10320 PROC THROWROCK(I)
10330   LOCAL TWY,S,SYI
10340   S=OF(I)
10350   CALL NEWOBJ(7,OX(I)+4,OY(I)-6)
10360   IF SLT=0 THEN EXIT PROC
10370   OT(SLT)=70
10380   TWY=W+312-(PY+12)+SPD2*70
10390   OVX(SLT)=(PX+4-OX(SLT))/70+(RND(1)-0.5)*0.35
10400   OVY(SLT)=(TWY-OY(SLT))/70+(RND(1)-0.5)*0.3
10410   SFX 2
10420 END PROC
10430 ' ====================================================================== showing it all
10440 PROC HIDESPRITES
10450   LOCAL I
10460   FOR I=0 TO NO
10470     SPRITE I,OFF
10480     SH(I)=0
10490   NEXT I
10500 END PROC
10510 PROC SHOWALL
10520   LOCAL I,K,SX,SY,IM,PRI
10530   ' the player: the boat, the swimmer, the walker
10540   IM=-1
10550   IF PM=0 AND NOT UB THEN IM=(FRM\6) MOD 2
10560   IF PM=1 THEN IM=9+(FRM\10) MOD 2
10570   IF PM=2 THEN
10580     IM=25
10590     IF WMV THEN IM=23+(FRM\6) MOD 2
10600   END IF
10610   IF IM>=0 AND INV>0 AND PM=0 AND (FRM\3) MOD 2=0 THEN IM=-1
10620   IF IM<0 THEN
10630     IF SH(0) THEN SPRITE 0,OFF:SH(0)=0
10640   ELSE
10650     SPRITE 0,INT(PX),INT(PY),IM
10660     IF SH(0)=0 THEN SPRITE 0,ON:SH(0)=1
10670   END IF
10680   FOR I=1 TO NO
10690     K=OK(I)
10700     IF K=0 THEN
10710       IF SH(I) THEN SPRITE I,OFF:SH(I)=0
10720     ELSE
10730       SX=INT(OX(I)):SY=INT(W+312-OY(I))
10740       IF SY<-30 OR SY>310 THEN
10750         IF SH(I) THEN SPRITE I,OFF:SH(I)=0
10760       ELSE
10770         IM=0
10780         IF K=1 THEN IM=7+(FRM\12) MOD 2
10790         IF K=2 THEN IM=11+(FRM\8) MOD 2
10800         IF K=3 THEN
10810           IM=3+OF(I)*2
10820           IF OVY(I)<0 THEN IM=IM+1
10830         END IF
10840         IF K=4 THEN
10850           IM=13+OF(I)*2
10860           IF OA(I)>0 AND OA(I)<9 THEN IM=IM+1
10870         END IF
10880         IF K=5 THEN IM=20+OF(I)
10890         IF K=6 THEN IM=2
10900         IF K=7 THEN IM=17
10910         IF K=8 THEN
10920           IF OF(I)=0 THEN IM=26+(FRM\10) MOD 2
10930           IF OF(I)=1 THEN
10940             IM=30:IF OVX(I)<0 THEN IM=31
10950           END IF
10960           IF OF(I)=2 THEN
10970             IM=28:IF OVX(I)<0 THEN IM=29
10980           END IF
10990         END IF
11000         IF K=9 THEN IM=18+(OT(I)\4) MOD 2
11010         IF K=1 AND SH(I)=0 THEN SPRITE I,PRIORITY 5
11020         IF K=8 AND SH(I)=0 THEN SPRITE I,PRIORITY 7
11030         SPRITE I,SX,SY,IM
11040         IF SH(I)=0 THEN SPRITE I,ON:SH(I)=1
11050       END IF
11060     END IF
11070   NEXT I
11080 END PROC
11090 ' ====================================================================== the status lines (the top two lines of the screen)
11100 PROC HUD
11110   LOCAL L1$,L2$,I
11120   L1$=" SCORE "+FN PAD$(SCORE,6)+"   LIVES "+STR$(LIVES)+"   LEVEL "+STR$(LVL)+"   BEST "+FN PAD$(HI,6)+"   "+STR$(INT(DIST/10))+" m"
11130   L2$=" "+MSG$
11140   IF MSG$="" THEN
11150     IF PM=0 THEN L2$=" IN THE BOAT"
11160     IF PM=1 THEN L2$=" SWIMMING: "+STR$(INT(SW/60))+" s left - to the bank or to a boat!"
11170     IF PM=2 THEN L2$=" WALKING: UP / DOWN walk, SPACE jumps into the water - find a boat or fruit"
11180     IF PM=3 THEN L2$=" ..."
11190   END IF
11200   L1$=LEFT$(L1$+SPACE$(80),80)
11210   L2$=LEFT$(L2$+SPACE$(80),80)
11220   LOCATE 0,0:COLOR 201,211:PRINT L1$;
11230   LOCATE 0,1:COLOR 202,211:PRINT L2$;
11240   HF=0
11250 END PROC
11260 ' a message on the graphics layer, N frames (0 = until it is cleared)
11270 PROC BANNER(T1$,T2$,N)
11280   GFX CLEAR
11290   GFX LINE 90,96,549,194,250,BF
11300   GFX LINE 90,96,549,194,2,B
11310   CALL BIGTEXT(112,T1$,2,3)
11320   CALL BIGTEXT(164,T2$,2,1)
11330   BN=N
11340 END PROC
11350 ' ====================================================================== start screen and the end of a game
11360 PROC TITLE
11370   LOCAL K$,K,N,N1
11380   SPAWNING=0
11390   CALL HIDESPRITES
11400   CALL STARTWORLD
11410   TX_PAPER=210
11420   GFX CLEAR
11430   TXT FILL 0,0,79,24,32,0,0
11440   CALL BIGTEXT(24,"ETERNAL RIVER",2,3)
11450   CALL TXTAT(20,9,"  Steer your boat down the endless river!                ",200)
11460   CALL TXTAT(20,10,"  Avoid swimmers, divers and other boats, and the         ",200)
11470   CALL TXTAT(20,11,"  rocks that people on the banks throw at you.            ",200)
11480   CALL TXTAT(20,12,"  Hit? Maybe you are only thrown into the water: swim     ",200)
11490   CALL TXTAT(20,13,"  to the bank, walk on, find a boat, pick up fruit.       ",200)
11500   CALL TXTAT(20,15,"  LEFT / RIGHT steer    UP faster    DOWN slower          ",202)
11510   CALL TXTAT(20,16,"  P pause    Q quit    (a game controller works, too)     ",202)
11520   CALL TXTAT(20,18,"  BEST "+FN PAD$(HI,6)+"      Press SPACE or A to start    ",201)
11530   PX=300:PY=226:PM=0:INV=0:UB=0:FRM=0
11540   SPRITE 0,ON:SH(0)=1
11550   DONE=0
11560   REPEAT
11570     GFX VSYNC
11580     FRM=FRM+1
11590     CALL SCROLL(1.2)
11600     N1=INT((W+311-PY)/24)
11610     PX=PX+(FN MIDRIV(N1)*16-PX)*0.05
11620     SPRITE 0,INT(PX),INT(PY),(FRM\6) MOD 2
11630     K$=INKEY$
11640     K=0:IF K$<>"" THEN K=ASC(K$)
11650     IF K>=97 AND K<=122 THEN K=K-32
11660     IF K=32 OR K=13 OR FN IN_ANYA(0) OR FN IN_ANYSTART(0) THEN DONE=-1
11670     IF K=81 OR FN IN_ANYBACK(0) THEN QT=1:DONE=-1
11680   UNTIL DONE
11690   WHILE FN IN_ANYSTART(0) OR FN IN_ANYBACK(0) OR FN IN_ANYA(0)
11700     GFX VSYNC
11710   WEND
11720   IN_PSK=0
11730   GFX CLEAR
11740   TXT FILL 0,0,79,24,32,0,0
11750   TX_PAPER=211
11760 END PROC
11770 PROC GAMEOVER
11780   LOCAL I
11790   CALL MUSICOFF
11800   CALL BANNER("GAME OVER","Your score "+FN PAD$(SCORE,6),0)
11810   PLAY "T110 W2 V0.3 O4 G4 E4 C4 <G2","T110 W0 V0.2 O3 C4 <G4 E4 C2"
11820   FOR I=1 TO 240
11830     GFX VSYNC
11840     CALL SCROLL(0.7)
11850   NEXT I
11860   WHILE FN IN_ANYSTART(0) OR FN IN_ANYBACK(0)
11870     GFX VSYNC
11880   WEND
11890 END PROC
11900 ' ====================================================================== sound and music
11910 ' All channels back to their plain state
11920 PROC SNDRESET
11930   LOCAL C
11940   SOUND OFF
11950   FOR C=1 TO 8
11960     ENVELOPE C:VIBRATO C,0,0:TREMOLO C,0,0:WAVE C,0
11970   NEXT C
11980 END PROC
11990 ' The music: a gentle flowing tune made one bar (2 seconds) at a time by the EVERY handler (the label MUSICTIMER in the main program): a bass note, an arpeggio of the chord,
12000 ' and a melody that wanders through a pentatonic scale with rests; four chords go round (C, A minor, F, G). The channels 4 to 6 (the sound effects use 8 and 7).
12010 PROC MUSICON
12020   RT(0)=130.81:RT(1)=110:RT(2)=87.31:RT(3)=98
12030   PT(0)=392:PT(1)=440:PT(2)=523.25:PT(3)=587.33:PT(4)=659.26:PT(5)=784:PT(6)=880:PT(7)=1046.5
12040   MI=3:BR=0
12050   WAVE 4,2:ENVELOPE 4,0.04,0.1,0.7,0.2:VIBRATO 4,5,0.25
12060   WAVE 5,0:ENVELOPE 5,0.01,0.2,0.4,0.2
12070   WAVE 6,2:ENVELOPE 6,0.3,0,1,0.6
12080   CALL MBAR
12090   EVERY 120,0 GOSUB MUSICTIMER
12100   MUSON=-1
12110 END PROC
12120 PROC MUSICOFF
12130   EVERY OFF 0
12140   SOUND OFF 4:SOUND OFF 5:SOUND OFF 6
12150   MUSON=0
12160 END PROC
12170 PROC MBAR
12180   LOCAL I,J,F,L,RF,CH
12190   CH=BR MOD 4
12200   RF=RT(CH)
12210   SOUND 6,RF,4,0.15
12220   AR(0)=1:AR(1)=1.25:AR(2)=1.5:AR(3)=2
12230   IF CH=1 THEN AR(1)=1.2
12240   FOR I=0 TO 7
12250     J=I:IF I>=4 THEN J=7-I
12260     F=RF*2*AR(J)
12270     SOUND 5,F,0.5,0.07
12280   NEXT I
12290   I=0
12300   WHILE I<8
12310     L=1+FN RN(3)
12320     IF I+L>8 THEN L=8-I
12330     IF FN RN(4)=0 THEN
12340       SOUND 4,0,L*0.5
12350     ELSE
12360       MI=FN CLAMP(MI+FN RN(5)-2,0,7)
12370       SOUND 4,PT(MI),L*0.5,0.13
12380     END IF
12390     I=I+L
12400   WEND
12410   BR=BR+1
12420 END PROC
