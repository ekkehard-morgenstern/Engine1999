13500 PROC INITENT
13510 LOCAL I,C,R,K
13520 RESTORE MONDATA
13530 FOR I=0 TO 7
13540 READ K,C,R
13550 MK(I)=K:MHX(I)=C*16:MHY(I)=R*24-24
13560 MX(I)=MHX(I):MY(I)=MHY(I):MD(I)=1:MS(I)=0:MT(I)=0:MV(I)=0:MC(I)=0:MH(I)=-1
13570 NEXT I
13580 FOR I=0 TO 3
13590 CAT(I)=I MOD 2
13600 CAV(I)=(1.2+I*0.5)*(1-2*(I MOD 2))
13610 CAX(I)=340+I*330
13620 NEXT I
13630 FOR I=0 TO 4
13640 BRX(I)=I*380
13650 BRY(I)=(31-I*5+(I MOD 2))*24-30
13660 BRV(I)=(0.8+I*0.2)*(1-2*(I MOD 2))
13670 BRP(I)=I*1.7
13680 NEXT I
13690 FOR I=0 TO 11
13700 HT(I)=0
13710 NEXT I
13720 FOR I=0 TO 15
13730 PL(I)=0
13740 NEXT I
13750 FOR I=0 TO 63
13760 SH(I)=0
13770 NEXT I
13780 END PROC
13790 ' the monsters: kind (0 rust ball that chases and climbs, 1 slime that patrols), column and platform row
13800 LABEL MONDATA
13810 DATA 0,36,31, 1,66,31, 0,48,26, 1,80,26, 0,33,21, 1,66,21, 0,56,16, 1,85,16
13820 ' ====================================================================== the camera and the map
13830 ' The tile layer is a window of 41 x 13 cells; TILE SCROLL moves it by up to 15 / 23 pixels, and what is pushed in at the left or top comes from the
13840 ' last column / row. So that the world tile in column W is at x = W*16 - CX exactly, the cell I holds the world column OCOL+1+I (I = 0..39), the last
13850 ' cell (it is off the screen at the right) holds OCOL for the strip that is pushed in at the left, and the rows work the same way (the strip at the top is
13860 ' hidden behind the two text lines of the score bar). PEEK$ cuts the 13 rows out of the RAM, TILE FILL shows them.
13870 PROC DRAWMAP
13880 LOCAL J,M$,A
13890 FOR J=0 TO 12
13900 A=(OROW+1+J)*WW+OCOL
13910 M$=M$+PEEK$(A+1,40)+PEEK$(A,1)
13920 NEXT J
13930 TILE FILL M$
13940 END PROC
13950 PROC CAMERA
13960 LOCAL TX,TY
13970 TX=FN CLAMP(PX+8-320,1,(WW-41)*16)
13980 TY=FN CLAMP(PY+12-170,1,648)
13990 CX=FN CLAMP(CX+(TX-CX)\5,1,(WW-41)*16)
14000 CY=FN CLAMP(CY+(TY-CY)\5,1,648)
14010 CALL SHOWCAM
14020 END PROC
14030 PROC SHOWCAM
14040 LOCAL NC,NR
14050 NC=(CX-1)\16:NR=(CY-1)\24
14060 IF NC<>OCOL OR NR<>OROW THEN
14070 OCOL=NC:OROW=NR
14080 CALL DRAWMAP
14090 END IF
14100 TILE SCROLL 15-(CX-1) MOD 16,23-(CY-1) MOD 24
14110 END PROC
14120 ' the camera jumps to a place at once
14130 PROC CAMSNAP(X,Y)
14140 CX=FN CLAMP(X,1,(WW-41)*16)
14150 CY=FN CLAMP(Y,1,648)
14160 OCOL=-99
14170 CALL SHOWCAM
14180 END PROC
14190 ' a sprite at a place of the world: it is hidden if that is not on the screen
14200 PROC PLACE(N,X,Y,IMG)
14210 LOCAL SX,SY
14220 SX=INT(X-CX):SY=INT(Y-CY)
14230 IF SX<-40 OR SX>650 OR SY<-40 OR SY>330 THEN
14240 IF SH(N)=1 THEN
14250 SPRITE N,OFF
14260 SH(N)=0
14270 END IF
14280 EXIT PROC
14290 END IF
14300 SPRITE N,SX,SY,IMG
14310 IF SH(N)=0 THEN
14320 SPRITE N,ON
14330 SH(N)=1
14340 END IF
14350 END PROC
14360 ' ====================================================================== text helpers
