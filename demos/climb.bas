15100 REPEAT
15110 GFX VSYNC
15120 K$=INKEY$
15130 UNTIL K$="p" OR K$="P" OR K$="q" OR K$="Q"
15140 IF K$="q" OR K$="Q" THEN QT=1
15150 TXT FILL 33,10,42,10,32
15160 END PROC
15170 ' ====================================================================== the player
15180 PROC MOVEPLAYER
15190 LOCAL NX,NYI,R,CXT
15200 IF PS=3 THEN EXIT PROC
15210 IF PS=2 THEN
15220 DT=DT-1
15230 IF DT<=0 THEN CALL FINISHDRILL
15240 EXIT PROC
15250 END IF
15260 IF PS=1 THEN
15270 CALL CLIMB
15280 EXIT PROC
15290 END IF
15300 ' a ladder: W goes up if there is a ladder where the feet are, S goes down if there is one below the feet
15310 IF CLM<>0 THEN
15320 CXT=(PX+8)\16
15330 IF CLM<0 AND FN LADPX(PX+8,PY+23) OR CLM>0 AND FN LADPX(PX+8,PY+24) AND GRND THEN
15340 PS=1:PX=CXT*16:VY=0:DIRX=0:GRND=0
15350 IF CLM>0 THEN PYF=PYF+2:PY=INT(PYF)
15360 EXIT PROC
15370 END IF
15380 ' no ladder here: you keep walking and the ladder is taken if there is one within the next 24 frames
15390 CLMT=CLMT-1
15400 IF CLMT<=0 THEN CLM=0
15410 END IF
15420 IF DREQ<>0 THEN CALL STARTDRILL
15430 IF PS=2 THEN EXIT PROC
15440 ' walking left and right in steps of 2 pixels
15450 IF DIRX<>0 THEN
15460 NX=PX+DIRX*2
15470 IF FN BLOCKED(NX,PY)=0 THEN PX=NX
15480 END IF
15490 ' falling and jumping
15500 GRND=FN BLOCKED(PX,PY+1)
15510 IF GRND=1 AND DIRX<>0 AND PF MOD 14=0 THEN SFX 12
15520 IF GRND=1 AND JREQ=1 THEN
15530 VY=-5.3:GRND=0:SFX 1
15540 END IF
15550 JREQ=0
15560 IF GRND=0 OR VY<0 THEN
15570 VY=FN CLAMP(VY+0.35,-8,7)
15580 PYF=PYF+VY
15590 NYI=INT(PYF)
15600 IF FN BLOCKED(PX,NYI) THEN
15610 IF VY>0 THEN
15620 R=(NYI+23)\24
15630 PYF=R*24-24
15640 IF VY>3.5 THEN SFX 2
15650 ELSE
15660 PYF=PY
15670 END IF
15680 VY=0
15690 END IF
15700 PY=INT(PYF)
15710 ELSE
15720 VY=0
15730 END IF
15740 GRND=FN BLOCKED(PX,PY+1)
15750 END PROC
15760 ' going up and down a ladder
15770 PROC CLIMB
15780 LOCAL CXT,FR
15790 CXT=(PX+8)\16
15800 IF DIRX<>0 THEN
15810 IF FN BLOCKED(PX+DIRX*2,PY)=0 THEN
15820 PS=0:CLM=0:VY=0
15830 EXIT PROC
15840 END IF
15850 END IF
15860 IF CLM=0 THEN EXIT PROC
15870 PYF=PYF+CLM*2
15880 PY=INT(PYF)
15890 IF PF MOD 10=0 THEN SFX 8
15900 FR=(PY+23)\24
15910 IF CLM<0 THEN
15920 IF FN LADPX(PX+8,PY+23)=0 THEN
15930 ' the feet have left the top of the ladder: stand on the girder
15940 PYF=(FR+1)*24-24:PY=INT(PYF)
15950 PS=0:CLM=0:VY=0:GRND=1
15960 END IF
15970 ELSE
15980 IF FN SOLIDPX(PX+8,PY+23) AND FN LADPX(PX+8,PY+23)=0 THEN
15990 PYF=FR*24-24:PY=INT(PYF)
16000 PS=0:CLM=0:VY=0:GRND=1
16010 END IF
16020 END IF
16030 END PROC
16040 ' Z and C: drill a hole in the girder next to the one you stand on (the tile below and next to the feet, with nothing above it)
16050 PROC STARTDRILL
16060 LOCAL TC,TR
16070 IF PS=0 AND GRND=1 THEN
16080 TC=(PX+8)\16+DREQ
16090 TR=(PY+24)\24
16100 IF FN TL(TC,TR)=61 AND FN SOLIDPX(TC*16+8,TR*24-12)=0 THEN
16110 PS=2:DT=22:DC=TC:DR=TR:FACE=DREQ
16120 SFX 3
16130 END IF
16140 END IF
16150 DREQ=0
16160 END PROC
16170 PROC FINISHDRILL
16180 LOCAL I
16190 PS=0
16200 IF FN TL(DC,DR)=61 THEN
16210 POKE DR*WW+DC,46
16220 CALL SETTILE(DC,DR)
16230 FOR I=0 TO 11
16240 IF HT(I)=0 THEN
16250 HC(I)=DC:HR(I)=DR:HT(I)=540
16260 EXIT
16270 END IF
16280 NEXT I
16290 FOR I=1 TO 4
16300 CALL PUFF(DC*16+8,DR*24+6,0)
16310 NEXT I
16320 END IF
16330 END PROC
16340 ' a tile changed: draw it if it is on the screen
16350 PROC SETTILE(TC,TR)
16360 IF TC=OCOL THEN CALL DRAWMAP
16370 IF TC>OCOL AND TC<=OCOL+40 AND TR>OROW AND TR<=OROW+13 THEN TILE SET TC-OCOL-1,TR-OROW-1,PEEK(TR*WW+TC)
16380 END PROC
16390 ' ====================================================================== the holes: they close again after 9 seconds
16400 PROC HOLES
16410 LOCAL K,V,I
16420 FOR EACH K,V IN HT()
16430 IF V=0 THEN ITERATE
16440 HT(K)=V-1
16450 IF V=60 THEN
16460 POKE HR(K)*WW+HC(K),44
16470 CALL SETTILE(HC(K),HR(K))
16480 SFX 4
16490 END IF
16500 IF V=1 THEN
16510 ' the hole closes: what is inside is crushed
16520 POKE HR(K)*WW+HC(K),61
16530 CALL SETTILE(HC(K),HR(K))
16540 FOR I=0 TO 7
16550 IF MS(I)=2 AND MH(I)=K THEN
16560 MS(I)=3:MT(I)=300:MH(I)=-1
16570 SC=SC+200:HF=1
16580 CALL PUFF(MX(I)+8,MY(I)+12,1)
16590 SFX 6
16600 END IF
16610 NEXT I
16620 IF PX+12>HC(K)*16 AND PX+3<HC(K)*16+16 AND PY+23>HR(K)*24 AND PY<HR(K)*24+24 THEN CALL HURT
16630 END IF
16640 NEXT
16650 END PROC
16660 ' ====================================================================== the monsters
16670 PROC MOVEMONS
16680 LOCAL I
16690 FOR I=0 TO 7
16700 CALL MOVEMON(I)
16710 NEXT I
16720 END PROC
16730 PROC MOVEMON(I)
16740 LOCAL NX,AH,CXM,S,SLOT,Z
16750 MV(I)=MV(I)+1
16760 IF MS(I)=3 THEN
16770 MT(I)=MT(I)-1
16780 IF MT(I)<=0 THEN
16790 MX(I)=MHX(I):MY(I)=MHY(I):MS(I)=0:MD(I)=1
16800 END IF
16810 EXIT PROC
16820 END IF
16830 IF MS(I)=2 THEN EXIT PROC
16840 CXM=MX(I)+8
16850 ' falling
16860 IF MS(I)=1 THEN
16870 MY(I)=MY(I)+3
16880 IF FN SOLIDPX(CXM,MY(I)+24) THEN
16890 MY(I)=((MY(I)+24)\24)*24-24
16900 MS(I)=0
16910 AH=FN TL(CXM\16,(MY(I)+12)\24)
16920 IF AH=46 OR AH=44 THEN
16930 ' it landed in a hole: trapped until the hole closes
16940 FOR Z=0 TO 11
16950 IF HT(Z)>0 AND HC(Z)=CXM\16 AND HR(Z)=(MY(I)+12)\24 THEN
16960 MS(I)=2:MH(I)=Z
16970 MY(I)=HR(Z)*24
16980 SFX 5
16990 END IF
17000 NEXT Z
17010 END IF
17020 END IF
17030 EXIT PROC
17040 END IF
17050 ' climbing a ladder
17060 IF MS(I)=4 THEN
17070 MY(I)=MY(I)+MC(I)
17080 IF MC(I)<0 THEN
17090 IF FN LADPX(CXM,MY(I)+23)=0 THEN
17100 MY(I)=((MY(I)+23)\24+1)*24-24
17110 MS(I)=0
17120 END IF
17130 ELSE
17140 IF FN SOLIDPX(CXM,MY(I)+23) AND FN LADPX(CXM,MY(I)+23)=0 THEN
17150 MY(I)=((MY(I)+23)\24)*24-24
17160 MS(I)=0
17170 END IF
17180 END IF
17190 EXIT PROC
17200 END IF
17210 ' walking: no floor under the feet means falling (into a hole, say)
17220 IF FN SOLIDPX(CXM,MY(I)+24)=0 THEN
17230 MS(I)=1
17240 EXIT PROC
17250 END IF
17260 ' every half second the rust balls look for the player: they follow on the same level, and climb a ladder towards the player
17270 IF MK(I)=0 AND MV(I) MOD 30=0 THEN
17280 IF ABS(PY-MY(I))<30 THEN
17290 IF PX<>MX(I) THEN MD(I)=SGN(PX-MX(I))
17300 ELSE
17310 IF FN LADPX(CXM,MY(I)+23) AND PY<MY(I)-30 AND FN RN(2)=0 THEN
17320 MS(I)=4:MC(I)=-1:MX(I)=(CXM\16)*16
17330 EXIT PROC
17340 END IF
17350 IF FN LADPX(CXM,MY(I)+24) AND PY>MY(I)+30 AND FN RN(2)=0 THEN
17360 MS(I)=4:MC(I)=1:MX(I)=(CXM\16)*16
17370 MY(I)=MY(I)+2
17380 EXIT PROC
17390 END IF
17400 END IF
17410 END IF
17420 IF MK(I)=1 AND MV(I) MOD 2=0 THEN EXIT PROC
17430 NX=MX(I)+MD(I)
17440 AH=FN TL((NX+8+MD(I)*7)\16,(MY(I)+24)\24)
17450 IF FN SOLIDPX(NX+8+MD(I)*7,MY(I)+12) THEN
17460 MD(I)=-MD(I)
17470 ELSE
17480 IF SOL(AH) OR AH=46 OR AH=44 THEN
17490 MX(I)=NX
17500 ELSE
17510 MD(I)=-MD(I)
17520 END IF
17530 END IF
17540 END PROC
17550 ' ====================================================================== cars on the road and birds in the air
17560 PROC MOVECARS
17570 LOCAL I
17580 FOR I=0 TO 3
17590 CAX(I)=CAX(I)+CAV(I)
17600 IF CAX(I)>1560 THEN CAX(I)=330
17610 IF CAX(I)<320 THEN CAX(I)=1550
17620 NEXT I
17630 IF HONK=1 THEN
17640 HONK=0
17650 FOR I=0 TO 3
17660 IF ABS(CAX(I)-PX)<400 THEN SFX 10
17670 NEXT I
17680 AFTER 400+FN RN(600),1 GOSUB HONKTIMER
17690 END IF
17700 END PROC
17710 PROC MOVEBIRDS
17720 LOCAL I
17730 FOR I=0 TO 4
17740 BRX(I)=BRX(I)+BRV(I)
17750 IF BRX(I)>WW*16 THEN BRX(I)=-20
17760 IF BRX(I)<-20 THEN BRX(I)=WW*16
17770 BRP(I)=BRP(I)+0.04
17780 NEXT I
17790 END PROC
17800 PROC PLACEALL
17810 LOCAL I,D,IMG,T,YB
17820 ' the player
17830 IMG=0
17840 IF DIRX<>0 THEN IMG=1+(PF\6) MOD 2
17850 IF GRND=0 THEN IMG=3
17860 IF PS=1 THEN IMG=5+(PF\6) MOD 2
17870 IF PS=2 THEN IMG=4
17880 IF PS=3 THEN IMG=7
17890 IF FACE<0 AND IMG<>5 AND IMG<>6 AND IMG<>7 THEN IMG=IMG+8
17900 CALL PLACE(0,PX,PY,IMG)
17910 ' the monsters (a dead one is not shown)
17920 FOR I=0 TO 7
17930 IF MS(I)=3 THEN
17940 IF SH(1+I)=1 THEN
17950 SPRITE 1+I,OFF
17960 SH(1+I)=0
17970 END IF
17980 ITERATE
17990 END IF
18000 T=13+MK(I)*3
18010 IMG=T+(MV(I)\8) MOD 2
18020 IF MS(I)=2 THEN IMG=T+2
18030 CALL PLACE(1+I,MX(I),MY(I),IMG)
18040 NEXT I
18050 ' the cars: two sprites each, the picture depends on the type and the direction
18060 FOR I=0 TO 3
18070 D=0
18080 IF CAV(I)<0 THEN D=1
18090 IMG=19+CAT(I)*4+D*2
18100 CALL PLACE(16+I*2,CAX(I),840,IMG)
18110 CALL PLACE(17+I*2,CAX(I)+16,840,IMG+1)
18120 NEXT I
18130 ' the birds
18140 FOR I=0 TO 4
18150 D=0
18160 IF BRV(I)<0 THEN D=1
18170 YB=BRY(I)+16*SIN(BRP(I))
18180 CALL PLACE(24+I,BRX(I),YB,27+D*2+(FRM\8) MOD 2)
18190 NEXT I
18200 END PROC
18210 ' ====================================================================== collisions
18220 PROC CHECKS
18230 LOCAL I,BX,BY
18240 IF PS=3 THEN EXIT PROC
18250 ' the monsters (a trapped or dead one is harmless)
18260 FOR I=0 TO 7
18270 IF MS(I)=2 OR MS(I)=3 THEN ITERATE
18280 IF ABS(PX-MX(I))<11 AND ABS(PY-MY(I))<18 THEN
18290 CALL HURT
18300 EXIT PROC
18310 END IF
18320 NEXT I
18330 ' the cars: they are 32 pixels long and 14 high, you have to be above them
18340 FOR I=0 TO 3
18350 IF PX+12>CAX(I) AND PX+3<CAX(I)+32 AND PY+23>850 THEN
18360 CALL HURT
18370 EXIT PROC
18380 END IF
18390 NEXT I
18400 ' the birds
18410 FOR I=0 TO 4
18420 BX=BRX(I)+8:BY=BRY(I)+16*SIN(BRP(I))+12
18430 IF ABS(PX+8-BX)<10 AND ABS(PY+12-BY)<14 THEN
18440 SFX 9
18450 CALL HURT
18460 EXIT PROC
18470 END IF
18480 NEXT I
18490 ' progress: every new platform is a place to start from again
18500 IF PS=0 AND GRND=1 AND PY<CHKY-100 THEN
18510 CHKY=PY:CHKX=PX
18520 SC=SC+100:HF=1
18530 SFX 11
18540 CALL PUFF(PX+8,PY+12,2)
18550 IF (860-PY)\24>HI THEN HI=(860-PY)\24
18560 END IF
18570 ' the ice cream stand
18580 IF PY<6*24 AND PX>58*16-8 AND PX<62*16 THEN CALL WIN
18590 END PROC
18600 PROC HURT
18610 PS=3:DEADT=60
18620 VY=0:CLM=0:DIRX=0
18630 SFX 7
18640 CALL PUFF(PX+8,PY+8,2)
18650 CALL PUFF(PX+8,PY+14,2)
18660 END PROC
18670 ' the hurt player: it falls for a second, then it is back at the last platform it reached
18680 PROC DEAD
18690 DEADT=DEADT-1
18700 PYF=PYF+(DEADT-45)/10:PY=INT(PYF)
18710 IF DEADT>0 THEN EXIT PROC
18720 LV=LV-1
18730 HF=1
18740 IF LV<=0 THEN
18750 OV=1
18760 EXIT PROC
18770 END IF
18780 PX=CHKX:PY=CHKY:PYF=PY
18790 PS=0:VY=0:GRND=0:JREQ=0:DREQ=0
18800 CALL CAMSNAP(PX-320,PY-170)
18810 END PROC
18820 ' ====================================================================== sparks
18830 ' a puff of 8 bits at (X,Y): K 0 dust, 1 stars, 2 sparks; they fly away by themselves (MOVETO) and are hidden when they are over
18840 PROC PUFF(X,Y,K)
18850 LOCAL I,A,D,S
18860 FOR I=0 TO 7
18870 S=NP
18880 NP=(NP+1) MOD 16
18890 A=I*0.785+FN RN(100)/200
18900 D=10+FN RN(16)
18910 PL(S)=24
18920 CALL SPARK(S,X-8,Y-12,INT(X-8+COS(A)*D),INT(Y-12+SIN(A)*D-6),33+K)
18930 NEXT I
18940 END PROC
18950 PROC SPARK(S,X1,Y1,X2,Y2,IMG)
18960 LOCAL SX,SY
18970 SX=X1-CX:SY=Y1-CY
18980 SPRITE 32+S,SX,SY,IMG
18990 SPRITE 32+S,ON
19000 SPRITE 32+S,MOVETO X2-CX,Y2-CY,20
19010 END PROC
19020 PROC EFFECTS
19030 LOCAL K,V
19040 FOR EACH K,V IN PL()
19050 IF V=0 THEN ITERATE
19060 PL(K)=V-1
19070 IF V=1 THEN SPRITE 32+K,OFF
19080 NEXT
19090 END PROC
19100 ' ====================================================================== the music: a melody and a bass on the channels 3 and 4, a drum on 5
19110 ' the notes of the array NT(), N of them one after the other on channel CH, BT beats each (a note is a MIDI number, 0 a rest), volume VL
19120 PROC PLAYSEQ(NT(),N,CH,BT,VL)
19130 LOCAL I
19140 FOR I=0 TO N-1
19150 SOUND CH,FN FREQ(NT(I)),BT,VL
19160 NEXT I
19170 END PROC
19180 ' one bar of the song (4 beats): its 8 melody notes (a LOCAL array that is passed on to PLAYSEQ), 2 bass notes and 8 drum beats
19190 PROC BAR
19200 LOCAL I,TA(8),TB(2),TC(8)
19210 FOR I=0 TO 7
19220 TA(I)=MELN(BI*8+I)
19230 TC(I)=PERC(I)*120
19240 NEXT I
19250 TB(0)=BASSN(BI*2):TB(1)=BASSN(BI*2+1)
19260 CALL PLAYSEQ(TA(),8,3,0.5,0.06)
19270 CALL PLAYSEQ(TB(),2,4,2,0.16)
19280 CALL PLAYSEQ(TC(),8,5,0.5,0.05)
19290 BI=(BI+1) MOD 4
19300 END PROC
19310 PROC STARTMUSIC
19320 LOCAL TP
19330 EVERY OFF 0
19340 IF MUS=0 THEN EXIT PROC
19350 TP=132
19360 TEMPO TP
19370 WAVE 3,1:WAVE 4,2:WAVE 5,3
19380 BI=0
19390 CALL BAR
19400 EVERY INT(14400/TP)+2,0 GOSUB BARTIMER
19410 END PROC
19420 PROC MUSICSWITCH
19430 MUS=1-MUS
19440 IF MUS=1 THEN
19450 CALL STARTMUSIC
19460 ELSE
19470 EVERY OFF 0
19480 SOUND OFF 3:SOUND OFF 4:SOUND OFF 5
19490 END IF
19500 END PROC
19510 ' ====================================================================== the screens
19520 PROC CLEARALL
19530 LOCAL I
19540 EVERY OFF
19550 AFTER OFF
19560 SOUND OFF
19570 CLS
19580 GFX CLEAR
19590 FOR I=0 TO 63
19600 SPRITE I,OFF
19610 SH(I)=0
19620 NEXT I
19630 END PROC
19640 PROC TITLE
19650 LOCAL I,T,K$
19660 CALL CLEARALL
19670 CALL LOADWORLD
19680 CALL INITENT
19690 ' the summit as a backdrop: the stand, the clouds, the birds
19700 CALL CAMSNAP(58*16+32-320,1)
19710 CALL BIGTEXT(4,"THE LONG CLIMB",3,4)
19720 CALL TXTAT(11,15,"  A / D walk   W / S climb   SPACE jump   Z / C drill a hole  ",200)
19730 CALL TXTAT(11,16,"  X stop   P pause   M music on / off   Q quit              ",200)
19740 CALL TXTAT(11,18,"  Reach the ice cream stand on top of the tower!             ",202)
19750 CALL TXTAT(11,20,"  BEST HEIGHT "+FN PAD$(HI,3)+" meters      Press SPACE to start  ",203)
19760 FOR I=24 TO 29
19770 SPRITE I,ON
19780 NEXT I
19790 PLAY "T140 W1 V0.3 O4 C8 E8 G8 >C8 E4 D8 C8 <B8 >C4","T140 W2 V0.25 O3 C4 G4 C4 G4","T140 W3 V0.1 O5 C16 R16 C16 R16 C16 R16 C16 R16"
19800 QT=0
19810 REPEAT
19820 GFX VSYNC
19830 T=T+1
19840 FOR I=0 TO 4
19850 BRX(I)=BRX(I)+BRV(I)
19860 IF BRX(I)>WW*16 THEN BRX(I)=-20
19870 IF BRX(I)<-20 THEN BRX(I)=WW*16
19880 BRP(I)=BRP(I)+0.04
19890 NEXT I
19900 ' the birds fly by, high up, the cone over the stand wobbles
19910 FOR I=0 TO 4
19920 SPRITE 24+I,(BRX(I)\3+I*90) MOD 700-30,60+I*30+INT(14*SIN(BRP(I))),27+((BRV(I)<0)*-2)+(T\8) MOD 2
19930 NEXT I
19940 SPRITE 29,312,44+INT(5*SIN(T/12)),31+(T\20) MOD 2
19950 K$=INKEY$
19960 UNTIL K$=" " OR K$="q" OR K$="Q"
19970 IF K$="q" OR K$="Q" THEN QT=1
19980 SPRITE 29,OFF
19990 END PROC
20000 PROC PLAYGAME
20010 SC=0:LV=3:LEVL=1:OV=0:QT=0
20020 NP=0:BI=0
20030 MUS=1
20040 CALL STARTLEVEL
20050 WHILE OV=0
20060 FRM=FRM+1
20070 PF=PF+1
20080 CALL KEYS
20090 IF QT=1 THEN OV=1
20100 IF PS=3 THEN
20110 CALL DEAD
20120 ELSE
20130 CALL MOVEPLAYER
20140 END IF
20150 CALL MOVEMONS
20160 CALL MOVECARS
20170 CALL MOVEBIRDS
20180 CALL HOLES
20190 CALL CHECKS
20200 CALL CAMERA
20210 CALL PLACEALL
20220 CALL EFFECTS
20230 IF HF=1 OR FRM MOD 30=0 THEN CALL HUD
20240 GFX VSYNC
20250 WEND
20260 EVERY OFF
20270 AFTER OFF
20280 SOUND OFF
20290 CALL OVER
20300 END PROC
20310 ' a new climb: the tower is built again, everybody is back at the start, and the monsters, the birds and the cars are a little faster
20320 PROC STARTLEVEL
20330 LOCAL I
20340 CALL CLEARALL
20350 CALL LOADWORLD
20360 CALL INITENT
20370 FOR I=0 TO 7
20380 IF MK(I)=0 THEN MV(I)=I*7
20390 NEXT I
20400 FOR I=0 TO 4
20410 BRV(I)=BRV(I)*(1+LEVL*0.15)
20420 NEXT I
20430 FOR I=0 TO 3
20440 CAV(I)=CAV(I)*(1+LEVL*0.1)
20450 NEXT I
20460 PX=3*16:PY=36*24-24:PYF=PY:VY=0:PS=0:DIRX=0:CLM=0:FACE=1:GRND=1:JREQ=0:DREQ=0
20470 CHKX=PX:CHKY=PY
20480 FRM=0:PF=0:HONK=1
20490 CALL CAMSNAP(PX-320,PY-170)
20500 CALL CAMERA
20510 CALL HUD
20520 CALL BIGTEXT(110,"CLIMB "+STR$(LEVL),3,5)
20530 CALL STARTMUSIC
20540 FOR I=1 TO 70
20550 GFX VSYNC
20560 NEXT I
20570 GFX LINE 60,100,580,180,0,BF
20580 END PROC
20590 PROC WIN
20600 LOCAL I,B,T
20610 EVERY OFF
20620 SOUND OFF
20630 T=FRM\60
20640 B=FN CLAMP(3000-T*10,0,3000)
20650 SC=SC+B+500
20660 PLAY "T170 W1 V0.35 O5 C8 E8 G8 >C4 <G8 >C8 E8 G4","T170 W2 V0.3 O4 C8 E8 G8 >C4 <G8 >C8 E8 G4","T170 W1 V0.15 O3 C4 G4 C4 G4"
20670 CALL BIGTEXT(24,"YOU DID IT!",3,4)
20680 CALL BIGTEXT(196,"ICE CREAM!",4,5)
20690 CALL TXTAT(24,23,"Time bonus "+STR$(B)+"   Stand bonus 500",200)
20700 FOR I=1 TO 180
20710 GFX VSYNC
20720 IF I MOD 6=0 THEN CALL PUFF(PX+8+FN RN(100)-50,PY-FN RN(40),2)
20730 CALL EFFECTS
20740 NEXT I
20750 LEVL=LEVL+1
20760 CALL STARTLEVEL
20770 END PROC
20780 PROC OVER
20790 LOCAL I,Z,K$
20800 IF QT=1 THEN EXIT PROC
20810 FOR I=0 TO 63
20820 SPRITE I,OFF
20830 NEXT I
20840 CALL BIGTEXT(90,"GAME OVER",3,6)
20850 CALL TXTAT(30,17,"You climbed "+STR$((860-CHKY)\24)+" meters",200)
20860 CALL TXTAT(30,19,"Score "+STR$(SC),201)
20870 PLAY "T100 W2 V0.5 O4 C4 <B4 A4 G2","T100 W1 V0.2 O3 C4 G4 E4 C2"
20880 FOR Z=1 TO 170
20890 GFX VSYNC
20900 K$=INKEY$
20910 NEXT Z
20920 END PROC
20930 PROC SHUTDOWN
20940 SOUND OFF
20950 GFX RESET
20960 CLS
20970 PRINT "Thanks for playing THE LONG CLIMB!"
20980 END PROC
