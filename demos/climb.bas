10 ' THE LONG CLIMB - a jump and run game for Engine1999.
20 ' You are a construction worker and the ice cream stand is on the roof of the unfinished steel tower, 960 pixels above the street. Climb the ladders,
30 ' jump the gaps, hurdles, cars and birds, and use your drill to make holes in the girders: a rust ball or slime that walks into a hole is trapped,
40 ' and when the hole closes again, it is gone for a while. You have no weapon of any kind.
50 ' Keys: A / D walk left / right (you keep walking), W / S climb up / down a ladder (you keep climbing), X stop, SPACE jump,
60 '       Z / C drill a hole in the girder to your left / right, P pause, M music on / off, Q quit.
70 ' The world is 120 x 40 tiles (1920 x 960 pixels, three screens wide and three and a half high) and scrolls smoothly. It lives in the
80 ' RAM of the machine (POKE and PEEK), one byte per tile; PEEK$ cuts a row of the visible part out of it, TILE FILL puts it on the screen.
90 ' What this program shows of the language:
100 '   * PROC / FUNC / CALL / LOCAL, recursion (the distant trees), a LOCAL array and an array parameter (the music), FOR EACH, EXIT, ITERATE, DOWNTO
110 '   * PEEK, POKE and PEEK$ for the world, DATA for the level and the colors, RESTORE with labels
120 '   * the tile layer scrolling by tiles and pixels, 36 sprites (SPRITE SEQ is not needed: the frames are chosen by the program), MOVETO for the sparks
130 '   * EVERY (the music), AFTER (a car honks now and then), ON ERROR and RESUME <label> with a file (the best height), SIN, COS, EXP, LOG, SQR
140 ' (a FUNC has to be defined before the lines that call it, so the functions come first, then the main program, then the procedures)
150 ' --- global variables ----------------------------------------------------------------------------------------------------------------
160 ' PX,PY the player (top left, in world pixels), PYF its exact y, VY its speed down, PS its state: 0 walk / fall, 1 climb, 2 drill, 3 hurt
170 ' DIRX walking direction, CLM climbing direction, FACE the way it looks, GRND stands on something, JREQ / DREQ jump / drill requested
180 ' CX,CY the camera (the world position of the top left corner of the screen), MX().. the monsters, HC().. the holes in the girders
190 ' CAX().. the cars, BRX().. the birds, SC the score, HI the best height, LV lives, LEVL the number of the climb
200 ' ----------------------------------------------------------------------------------------------------------------------------------------
210 ' the tables of the tiles (an array that a function uses has to exist before the function is read): solid, can be climbed
220 DIM SOL(256),LAD(256)
230 FUNC RN(M)
240 RETURN INT(RND(1)*M)
250 END FUNC
260 FUNC CLAMP(V,LO,HI2)
270 IF V<LO THEN RETURN LO
280 IF V>HI2 THEN RETURN HI2
290 RETURN V
300 END FUNC
310 FUNC PAD$(N,W)
320 RETURN RIGHT$("00000000"+STR$(N),W)
330 END FUNC
340 ' the frequency of a MIDI note number (69 = the A of 440 Hz), 0 = a rest
350 FUNC FREQ(M)
360 IF M<=0 THEN RETURN 0
370 RETURN 440*EXP(LOG(2)*(M-69)/12)
380 END FUNC
390 ' the tile code at a place of the tower: the world is in the RAM, one byte per tile; outside of it are walls
400 FUNC TL(TX,TY)
410 IF TX<0 OR TX>=WW THEN RETURN 66
420 IF TY<0 THEN RETURN 32
430 IF TY>=WH THEN RETURN 67
440 RETURN PEEK(TY*WW+TX)
450 END FUNC
460 ' 1 if there is something solid at a pixel of the world
470 FUNC SOLIDPX(X,Y)
480 RETURN SOL(FN TL(X\16,Y\24))
490 END FUNC
500 FUNC LADPX(X,Y)
510 RETURN LAD(FN TL(X\16,Y\24))
520 END FUNC
530 ' 1 if the body of something at (X,Y) (top left of its 16 x 24 sprite) touches something solid
540 FUNC BLOCKED(X,Y)
550 IF FN SOLIDPX(X+3,Y+2) OR FN SOLIDPX(X+12,Y+2) THEN RETURN 1
560 IF FN SOLIDPX(X+3,Y+12) OR FN SOLIDPX(X+12,Y+12) THEN RETURN 1
570 IF FN SOLIDPX(X+3,Y+23) OR FN SOLIDPX(X+12,Y+23) THEN RETURN 1
580 RETURN 0
590 END FUNC
600 ' how many of the states in S() are V: FOR EACH goes over the whole array
610 FUNC COUNTOF(S(),V)
620 LOCAL N,E
630 FOR EACH E IN S()
640 IF E=V THEN N=N+1
650 NEXT
660 RETURN N
670 END FUNC
680 ' ====================================================================== main program
690 CALL INIT
700 HI=0
710 ON ERROR GOTO HIERR
720 OPEN "climb.hi" FOR INPUT AS #1
730 INPUT #1,HI
740 CLOSE #1
750 LABEL HIDONE
760 ON ERROR OFF
770 QT=0
780 REPEAT
790 CALL TITLE
800 IF QT=0 THEN CALL PLAYGAME
810 IF HI>HI0 THEN
820 ON ERROR GOTO HIERR2
830 OPEN "climb.hi" FOR OUTPUT AS #1
840 PRINT #1,HI
850 CLOSE #1
860 LABEL HIDONE2
870 ON ERROR OFF
880 END IF
890 HI0=HI
900 UNTIL QT=1
910 CALL SHUTDOWN
920 END
930 ' no file with the best height (yet): start with 0; a file that can't be written is ignored
940 LABEL HIERR
950 HI=0
960 RESUME HIDONE
970 LABEL HIERR2
980 RESUME HIDONE2
990 ' the EVERY and AFTER handlers only call a procedure or set a flag
1000 LABEL BARTIMER
1010 CALL BAR
1020 RETURN
1030 LABEL HONKTIMER
1040 HONK=1
1050 RETURN
1060 ' ====================================================================== set up (once)
1070 PROC INIT
1080 LOCAL I,C
1090 RANDOMIZE
1100 GFX RESET ALL
1110 WW=120:WH=40
1120 ' (DIM n makes n elements, 0 to n-1)
1130 DIM SH(64)
1140 DIM MX(8),MY(8),MD(8),MS(8),MT(8),MK(8),MH(8),MHX(8),MHY(8),MV(8),MC(8)
1150 DIM CAX(4),CAV(4),CAT(4),BRX(5),BRY(5),BRV(5),BRP(5),HC(12),HR(12),HT(12),PL(16)
1160 DIM BASSN(8),MELN(32),PERC(8)
1170 ' which tiles are solid and which can be climbed (the tile code is the ASCII code of its letter)
1180 FOR I=0 TO 8
1190 READ C
1200 SOL(C)=1
1210 NEXT I
1220 READ C
1230 LAD(C)=1
1240 READ C
1250 LAD(C)=1
1260 FOR I=0 TO 7
1270 READ BASSN(I)
1280 NEXT I
1290 FOR I=0 TO 31
1300 READ MELN(I)
1310 NEXT I
1320 FOR I=0 TO 7
1330 READ PERC(I)
1340 NEXT I
1350 CALL SOUNDS
1360 CALL PALETTES
1370 CALL DEFSPRITES
1380 CALL DEFTILES
1390 CALL BACKGROUND
1400 CALL LOADWORLD
1410 END PROC
1420 ' the solid tiles: = b T B C D G R r; the ladders: H T
1430 ' the notes of the music: 8 bass notes (2 per bar), 32 melody notes (8 per bar), 8 percussion hits (2 per bar) as MIDI numbers
1440 DATA 61,98,84,66,67,68,71,82,114, 72,84
1450 DATA 48,48,45,45,41,41,43,43
1460 DATA 76,0,79,76,72,76,79,76, 76,0,81,76,72,76,81,76, 77,0,81,77,72,77,81,77, 74,79,83,79,74,79,83,86
1470 DATA 1,0,1,0,1,0,1,1
1480 PROC SOUNDS
1490 SFX 1,"W1 V0.25 ML X0,0.01,0.3,0.05 S300,900,10"
1500 SFX 2,"W3 V0.15 ML X0,0.005,0.1,0.03 S300,100,24"
1510 SFX 3,"W3 V0.3 ML H300,24 H250,24 H300,24 H250,24 H300,24 H250,24 H300,24 H250,24"
1520 SFX 4,"W3 V0.25 ML X0,0.01,0.2,0.1 S200,60,6"
1530 SFX 5,"W1 V0.3 ML S900,200,8"
1540 SFX 6,"W3 V0.5 ML X0,0.01,0.3,0.1 S800,60,6"
1550 SFX 7,"W1 V0.4 ML S900,100,4 S300,60,4"
1560 SFX 8,"W2 V0.12 ML H700,32"
1570 SFX 9,"W1 V0.15 ML S2400,1800,12 S1800,2400,12"
1580 SFX 10,"W1 V0.2 ML H330,6 R16 H330,6"
1590 SFX 11,"W1 V0.3 ML H784,16 H1047,8"
1600 SFX 12,"W3 V0.08 ML X0,0.005,0.05,0.02 H150,32"
1610 END PROC
1620 ' ====================================================================== colors
1630 ' the sprite colors are in windows of 16 palette entries (the pictures use the digits 1..9 and A..F, DESIGN adds the window's base)
1640 PROC LOADPAL(LY)
1650 LOCAL B,I,R,GG,BL,N
1660 READ B,N
1670 FOR I=1 TO N
1680 READ R,GG,BL
1690 GFX PALETTE LY,B+I,RGB(R,GG,BL)
1700 NEXT I
1710 END PROC
1720 PROC PALETTES
1730 LOCAL I
1740 RESTORE SPRPALDATA
1750 FOR I=1 TO 8
1760 CALL LOADPAL(4)
1770 NEXT I
1780 RESTORE TILPALDATA
1790 FOR I=1 TO 8
1800 CALL LOADPAL(1)
1810 NEXT I
1820 GFX PALETTE 3,1,RGB(255,255,255):GFX PALETTE 3,2,RGB(20,20,40):GFX PALETTE 3,3,RGB(255,200,30):GFX PALETTE 3,4,RGB(255,90,60)
1830 GFX PALETTE 2,200,RGB(255,255,255):GFX PALETTE 2,201,RGB(255,210,50):GFX PALETTE 2,202,RGB(120,220,255):GFX PALETTE 2,203,RGB(255,100,90)
1840 GFX PALETTE 2,204,RGB(140,255,140):GFX PALETTE 2,205,RGB(180,190,230):GFX PALETTE 2,206,RGB(255,150,210):GFX PALETTE 2,207,RGB(255,170,40)
1850 GFX PALETTE 2,210,RGB(35,45,70)
1860 GFX BACKDROP RGB(120,170,230)
1870 END PROC
1880 ' ====================================================================== the background layer: sky, sun, hills, factories, trees
1890 PROC DISK(CX2,CY2,R,C)
1900 LOCAL Y,W
1910 FOR Y=-R TO R
1920 W=INT(SQR(R*R-Y*Y))
1930 GFX LINE CX2-W,CY2+Y,CX2+W,CY2+Y,C
1940 NEXT Y
1950 END PROC
1960 ' a tree from branches that split in two: the procedure calls itself (every call has its own X, Y, LEN, ANG and DEP, LOCAL keeps them apart)
1970 PROC TREE(X,Y,LEN2,ANG,DEP)
1980 LOCAL X2,Y2
1990 X2=X+COS(ANG)*LEN2
2000 Y2=Y-SIN(ANG)*LEN2
2010 GFX LINE X,Y,X2,Y2,61
2020 IF DEP>0 THEN
2030 CALL TREE(X2,Y2,LEN2*0.72,ANG+0.45,DEP-1)
2040 CALL TREE(X2,Y2,LEN2*0.72,ANG-0.45,DEP-1)
2050 ELSE
2060 GFX LINE X2-2,Y2-2,X2+2,Y2+2,62,BF
2070 END IF
2080 END PROC
2090 PROC BACKGROUND
2100 LOCAL I,X,H,K,BW,BH
2110 GFX TARGET 0
2120 GFX CLEAR
2130 ' the sky: 30 bands from blue at the top to a pale warm color at the horizon
2140 FOR I=1 TO 30
2150 GFX PALETTE 0,I,RGB(60+I*6,130+I*3,230+I\6)
2160 GFX LINE 0,(I-1)*10,639,(I-1)*10+9,I,BF
2170 NEXT I
2180 ' the sun with a halo
2190 GFX PALETTE 0,40,RGB(255,250,200):GFX PALETTE 0,41,RGB(255,235,140):GFX PALETTE 0,42,RGB(255,220,100)
2200 CALL DISK(540,70,38,42):CALL DISK(540,70,30,41):CALL DISK(540,70,22,40)
2210 ' far hills and factories
2220 GFX PALETTE 0,50,RGB(140,170,210):GFX PALETTE 0,51,RGB(110,140,185):GFX PALETTE 0,52,RGB(80,105,150)
2230 FOR X=0 TO 638 STEP 2
2240 H=INT(40+20*SIN(X/53)+10*SIN(X/17+1))
2250 GFX LINE X,299-H,X+1,299,50,BF
2260 NEXT X
2270 FOR K=0 TO 9
2280 BW=24+FN RN(24):BH=30+FN RN(50)
2290 X=K*66+FN RN(30)
2300 GFX LINE X,299-BH-30,X+BW,299,51,BF
2310 GFX LINE X+BW\3,299-BH-60,X+BW\3+5,299-BH-30,51,BF
2320 NEXT K
2330 FOR X=0 TO 638 STEP 2
2340 H=INT(14+10*SIN(X/31+2)+5*SIN(X/11))
2350 GFX LINE X,299-H,X+1,299,52,BF
2360 NEXT X
2370 ' trees on the near hills
2380 GFX PALETTE 0,61,RGB(40,60,50):GFX PALETTE 0,62,RGB(60,110,70)
2390 CALL TREE(90,296,22,1.57,6)
2400 CALL TREE(330,296,18,1.7,6)
2410 CALL TREE(560,296,24,1.45,6)
2420 GFX TARGET 3
2430 END PROC
