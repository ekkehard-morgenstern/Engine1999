1 ' License: free for everybody to use, copy, change and build into executables (BUILD).
2 ' An executable made with BUILD contains the Engine1999 runtime: the Engine1999 Runtime Exception
3 ' (file LICENSE-EXCEPTION of Engine1999) applies if the runtime is unmodified and its notice stays
4 ' in the executable (it shows with the command line option --engine1999-about).
10 ' w3dkit - helpers for programs that use the 3D sector renderer (W3D ...): a library, LOAD LIBRARY "w3dkit".
20 ' It sets up a palette of 15 hues with 16 shades each (palette entries 16..255; entries 1..15 stay as they are), draws textures and sprites
30 ' with GFX statements and hands them to W3D TEXTURE, and reads the keyboard and game controller for walking around.
40 ' The palette index of hue H (0..14) and shade S (0 dark .. 15 bright) is FN W3K_C(H,S). Hues: 0 gray, 1 red, 2 orange, 3 yellow, 4 lime, 5 green,
50 ' 6 teal, 7 cyan, 8 azure, 9 blue, 10 purple, 11 magenta, 12 brown, 13 sand, 14 pink.
60 ' CALL W3K_INIT                 palette on the graphics layers 0 and 3, the tile and text layers hidden (the graphics layers are the picture), drawing layer 3, W3D RESET
70 ' CALL W3K_BRICK(N,H) W3K_STONE(N,H) W3K_PLASTER(N,H) W3K_METAL(N,H) W3K_CARPET(N,H) W3K_TILES(N,H1,H2) W3K_PLANKS(N) W3K_GRASS(N) W3K_DOORTEX(N,H)
80 '   W3K_SKY(N) (256 x 64) make a texture N (64 x 64, plaster and doors 64 x 128); W3K_WINDOW(N) and W3K_GRATE(N) have see-through parts (for masked walls)
90 ' CALL W3K_PLANT(N) W3K_LAMP(N) W3K_BARREL(N) W3K_TORCH(N) (two frames N, N+1) W3K_MEDKIT(N) W3K_AMMOBOX(N) W3K_KEYCARD(N,H)   sprites (index 0 is see-through)
100 ' CALL W3K_WALK                 one frame of walking: arrow keys / WASD / R F look / SHIFT run, or a game controller (left stick walk and strafe,
110 '                               right stick turn and look, LT run); applies W3D MOVE and W3D TURN scaled by the time since the last call
120 ' CALL W3K_SHOW                 shows the layer that was drawn on and makes the other one the drawing layer (flicker free), then waits for the frame
130 ' CALL W3K_DONE                 the end of a program: all layers back as they were (GFX RESET), a clear screen
140 ' CALL W3K_HUDBAR(Y,H)          clears the strip Y .. Y+H-1 of the drawing layer to a dark color
150 LIBRARY "w3dkit","W3K_"
160 FUNC W3K_C(H,S)
170   RETURN 16+H*16+S
180 END FUNC
190 FUNC W3K_R(M)
200   RETURN INT(RND(1)*M)
210 END FUNC
220 PROC W3K_PALETTE
230   LOCAL L,H,S,R,G,B,F
240   FOR L=0 TO 3 STEP 3
250     RESTORE W3K_HUES
260     FOR H=0 TO 14
270       READ R,G,B
280       FOR S=0 TO 15
290         F=0.06+0.94*S/15
300         GFX PALETTE L,16+H*16+S,RGB(INT(R*F),INT(G*F),INT(B*F))
310       NEXT S
320     NEXT H
330   NEXT L
340 END PROC
350 LABEL W3K_HUES
360 DATA 255,255,255, 255,70,60, 255,150,40, 255,230,70, 160,230,60, 60,200,80, 50,200,170, 80,220,255
370 DATA 90,160,255, 70,80,240, 150,80,220, 230,80,200, 170,110,60, 225,200,150, 255,175,150
380 PROC W3K_INIT
390   W3K_VY=0:W3K_VH=264:W3K_B=0:W3K_T0=TI
400   GFX LAYER 0,OFF:GFX LAYER 3,OFF:GFX LAYER 1,OFF:GFX LAYER 2,OFF
410   GFX BACKDROP RGB(0,0,0)
420   CALL W3K_PALETTE
430   GFX TARGET 3
440   W3D RESET
450 END PROC
460 ' grabs the picture at 0,0 of the drawing layer as texture N
470 PROC W3K_GRAB(N,W,H)
480   LOCAL A$
490   GFX GRAB 0,0,W-1,H-1,A$
500   W3D TEXTURE N,A$
510 END PROC
520 PROC W3K_BRICK(N,H)
530   LOCAL R,B,X,S,I
540   GFX CLEAR FN W3K_C(0,3)
550   FOR R=0 TO 7
560     FOR B=-1 TO 4
570       X=B*16+(R AND 1)*8
580       S=7+FN W3K_R(4)
590       GFX LINE X+1,R*8+1,X+15,R*8+7,FN W3K_C(H,S),BF
600     NEXT B
610   NEXT R
620   FOR I=1 TO 160
630     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H,5+FN W3K_R(6))
640   NEXT I
650   CALL W3K_GRAB(N,64,64)
660 END PROC
670 PROC W3K_STONE(N,H)
680   LOCAL R,B,X,S,I
690   GFX CLEAR FN W3K_C(H,4)
700   FOR R=0 TO 3
710     FOR B=-1 TO 2
720       X=B*32+(R AND 1)*16
730       S=8+FN W3K_R(3)
740       GFX LINE X+1,R*16+1,X+31,R*16+15,FN W3K_C(H,S),BF
750       GFX LINE X+1,R*16+1,X+31,R*16+1,FN W3K_C(H,S+3)
760     NEXT B
770   NEXT R
780   FOR I=1 TO 300
790     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H,5+FN W3K_R(7))
800   NEXT I
810   CALL W3K_GRAB(N,64,64)
820 END PROC
830 ' plaster with a wainscot: 64 x 128, the bottom 28 rows are paneled
840 PROC W3K_PLASTER(N,H)
850   LOCAL I,X
860   GFX CLEAR FN W3K_C(H,11)
870   FOR I=1 TO 220
880     GFX PSET FN W3K_R(64),FN W3K_R(100),FN W3K_C(H,9+FN W3K_R(4))
890   NEXT I
900   GFX LINE 0,100,63,127,FN W3K_C(12,6),BF
910   FOR X=0 TO 63 STEP 16
920     GFX LINE X+2,104,X+13,124,FN W3K_C(12,8),BF
930     GFX LINE X+2,104,X+13,104,FN W3K_C(12,10)
940     GFX LINE X+2,124,X+13,124,FN W3K_C(12,4)
950   NEXT X
960   GFX LINE 0,97,63,99,FN W3K_C(12,10),BF
970   GFX LINE 0,99,63,99,FN W3K_C(12,4)
980   CALL W3K_GRAB(N,64,128)
990 END PROC
1000 PROC W3K_METAL(N,H)
1010   LOCAL I,X,Y
1020   GFX CLEAR FN W3K_C(H,7)
1030   GFX LINE 0,0,63,63,FN W3K_C(H,11),B
1040   GFX LINE 1,1,62,62,FN W3K_C(H,5),B
1050   GFX LINE 0,31,63,31,FN W3K_C(H,4)
1060   GFX LINE 31,0,31,63,FN W3K_C(H,4)
1070   FOR X=6 TO 57 STEP 51
1080     FOR Y=6 TO 57 STEP 51
1090       GFX CIRCLE X,Y,2,FN W3K_C(H,12)
1100       GFX PSET X+1,Y+1,FN W3K_C(H,3)
1110     NEXT Y
1120   NEXT X
1130   FOR I=1 TO 140
1140     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H,5+FN W3K_R(5))
1150   NEXT I
1160   CALL W3K_GRAB(N,64,64)
1170 END PROC
1180 PROC W3K_CARPET(N,H)
1190   LOCAL I,X
1200   GFX CLEAR FN W3K_C(H,6)
1210   FOR X=0 TO 63 STEP 16
1220     GFX LINE X,0,X+16,16,FN W3K_C(H,9)
1230     GFX LINE X+16,0,X,16,FN W3K_C(H,9)
1240     GFX LINE X,16,X+16,32,FN W3K_C(H,9)
1250     GFX LINE X+16,16,X,32,FN W3K_C(H,9)
1260     GFX LINE X,32,X+16,48,FN W3K_C(H,9)
1270     GFX LINE X+16,32,X,48,FN W3K_C(H,9)
1280     GFX LINE X,48,X+16,64,FN W3K_C(H,9)
1290     GFX LINE X+16,48,X,64,FN W3K_C(H,9)
1300   NEXT X
1310   FOR I=1 TO 260
1320     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H,4+FN W3K_R(5))
1330   NEXT I
1340   CALL W3K_GRAB(N,64,64)
1350 END PROC
1360 PROC W3K_TILES(N,H1,H2)
1370   LOCAL X,Y,I
1380   GFX CLEAR FN W3K_C(0,5)
1390   FOR X=0 TO 3
1400     FOR Y=0 TO 3
1410       IF (X+Y) AND 1 THEN I=H1 ELSE I=H2
1420       GFX LINE X*16+1,Y*16+1,X*16+15,Y*16+15,FN W3K_C(I,10),BF
1430       GFX LINE X*16+1,Y*16+1,X*16+15,Y*16+1,FN W3K_C(I,13)
1440     NEXT Y
1450   NEXT X
1460   FOR I=1 TO 120
1470     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H1,8+FN W3K_R(4))
1480   NEXT I
1490   CALL W3K_GRAB(N,64,64)
1500 END PROC
1510 PROC W3K_PLANKS(N)
1520   LOCAL Y,I,X
1530   GFX CLEAR FN W3K_C(12,3)
1540   FOR Y=0 TO 7
1550     GFX LINE 0,Y*8+1,63,Y*8+7,FN W3K_C(12,6+FN W3K_R(4)),BF
1560     X=FN W3K_R(60)
1570     GFX LINE X,Y*8,X,Y*8+7,FN W3K_C(12,3)
1580   NEXT Y
1590   FOR I=1 TO 90
1600     X=FN W3K_R(64):Y=FN W3K_R(64)
1610     GFX LINE X,Y,X+3,Y,FN W3K_C(12,4+FN W3K_R(5))
1620   NEXT I
1630   CALL W3K_GRAB(N,64,64)
1640 END PROC
1650 PROC W3K_GRASS(N)
1660   LOCAL I,X,Y
1670   GFX CLEAR FN W3K_C(5,5)
1680   FOR I=1 TO 500
1690     X=FN W3K_R(64):Y=FN W3K_R(64)
1700     GFX LINE X,Y,X+FN W3K_R(3)-1,Y-1-FN W3K_R(3),FN W3K_C(4+FN W3K_R(2),3+FN W3K_R(8))
1710   NEXT I
1720   CALL W3K_GRAB(N,64,64)
1730 END PROC
1740 ' a door: 64 x 128, vertical boards, a frame and a handle
1750 PROC W3K_DOORTEX(N,H)
1760   LOCAL X,I
1770   GFX CLEAR FN W3K_C(H,4)
1780   FOR X=4 TO 56 STEP 8
1790     GFX LINE X,4,X+7,123,FN W3K_C(H,7+FN W3K_R(3)),BF
1800     GFX LINE X,4,X,123,FN W3K_C(H,4)
1810   NEXT X
1820   GFX LINE 0,0,63,127,FN W3K_C(0,6),B
1830   GFX LINE 1,1,62,126,FN W3K_C(0,11),B
1840   GFX LINE 4,20,59,26,FN W3K_C(H,10),BF
1850   GFX LINE 4,96,59,102,FN W3K_C(H,10),BF
1860   GFX CIRCLE 52,64,3,FN W3K_C(3,13)
1870   GFX PAINT 52,64,FN W3K_C(3,13),FN W3K_C(3,13)
1880   CALL W3K_GRAB(N,64,128)
1890 END PROC
1900 ' a window: 64 x 96, a wooden frame with a cross, the panes are see-through (index 0), with a few shining dots
1910 PROC W3K_WINDOW(N)
1920   LOCAL I
1930   GFX CLEAR 0
1940   GFX LINE 0,0,63,95,FN W3K_C(12,8),B
1950   GFX LINE 1,1,62,94,FN W3K_C(12,6),B
1960   GFX LINE 2,2,61,93,FN W3K_C(12,9),B
1970   GFX LINE 3,3,60,92,FN W3K_C(12,5),B
1980   GFX LINE 29,3,34,92,FN W3K_C(12,7),BF
1990   GFX LINE 3,44,60,49,FN W3K_C(12,7),BF
2000   FOR I=0 TO 3
2010     GFX LINE 8+I*2,12+I*2,12+I*2,16+I*2,FN W3K_C(7,14)
2020   NEXT I
2030   CALL W3K_GRAB(N,64,96)
2040 END PROC
2050 ' a grate: 64 x 64, bars with gaps
2060 PROC W3K_GRATE(N)
2070   LOCAL X
2080   GFX CLEAR 0
2090   FOR X=3 TO 60 STEP 8
2100     GFX LINE X,0,X+1,63,FN W3K_C(0,9),BF
2110     GFX LINE X,0,X,63,FN W3K_C(0,13)
2120   NEXT X
2130   GFX LINE 0,0,63,3,FN W3K_C(0,7),BF
2140   GFX LINE 0,60,63,63,FN W3K_C(0,7),BF
2150   GFX LINE 0,30,63,32,FN W3K_C(0,7),BF
2160   CALL W3K_GRAB(N,64,64)
2170 END PROC
2180 ' a sky: 256 x 64, the color gets lighter toward the bottom (the horizon), with clouds that wrap around the edge
2190 PROC W3K_SKY(N)
2200   LOCAL Y,I,X,CY,RX
2210   FOR Y=0 TO 63
2220     GFX LINE 0,Y,255,Y,FN W3K_C(8,6+Y\8),BF
2230   NEXT Y
2240   FOR I=1 TO 9
2250     X=FN W3K_R(256):CY=6+FN W3K_R(36):RX=10+FN W3K_R(14)
2260     GFX CIRCLE X,CY,RX,FN W3K_C(0,13),-1,-1,0.35
2270     GFX CIRCLE X-256,CY,RX,FN W3K_C(0,13),-1,-1,0.35
2280     GFX PAINT X,CY,FN W3K_C(0,15),FN W3K_C(0,13)
2290     GFX PAINT X-256,CY,FN W3K_C(0,15),FN W3K_C(0,13)
2300   NEXT I
2310   CALL W3K_GRAB(N,256,64)
2320 END PROC
2330 PROC W3K_PLANT(N)
2340   LOCAL I
2350   GFX CLEAR 0
2360   GFX LINE 9,36,22,47,FN W3K_C(12,7),BF
2370   GFX LINE 8,34,23,36,FN W3K_C(12,10),BF
2380   GFX LINE 15,20,16,34,FN W3K_C(5,5)
2390   FOR I=0 TO 6
2400     GFX CIRCLE 16+(I-3)*3,12+ABS(I-3)*3,6,FN W3K_C(5,6+I),-1,-1,0.6
2410     GFX PAINT 16+(I-3)*3,12+ABS(I-3)*3,FN W3K_C(5,6+I),FN W3K_C(5,6+I)
2420   NEXT I
2430   CALL W3K_GRAB(N,32,48)
2440 END PROC
2450 PROC W3K_LAMP(N)
2460   GFX CLEAR 0
2470   GFX LINE 11,18,12,52,FN W3K_C(0,8),BF
2480   GFX LINE 6,52,17,55,FN W3K_C(0,6),BF
2490   GFX LINE 5,8,18,18,FN W3K_C(3,13),BF
2500   GFX LINE 7,4,16,8,FN W3K_C(3,14),BF
2510   GFX LINE 5,18,18,18,FN W3K_C(3,8)
2520   CALL W3K_GRAB(N,24,56)
2530 END PROC
2540 PROC W3K_BARREL(N)
2550   GFX CLEAR 0
2560   GFX LINE 4,2,27,37,FN W3K_C(12,8),BF
2570   GFX LINE 3,8,28,31,FN W3K_C(12,9),BF
2580   GFX LINE 3,10,28,12,FN W3K_C(0,6),BF
2590   GFX LINE 3,26,28,28,FN W3K_C(0,6),BF
2600   GFX LINE 8,3,9,36,FN W3K_C(12,11)
2610   GFX LINE 22,3,23,36,FN W3K_C(12,5)
2620   CALL W3K_GRAB(N,32,40)
2630 END PROC
2640 PROC W3K_TORCH(N)
2650   LOCAL F
2660   FOR F=0 TO 1
2670     GFX CLEAR 0
2680     GFX LINE 7,16,9,31,FN W3K_C(12,7),BF
2690     GFX CIRCLE 8,9,4+F,FN W3K_C(2,12),-1,-1,1.4
2700     GFX PAINT 8,9,FN W3K_C(3,14),FN W3K_C(2,12)
2710     GFX PSET 8,6-F,FN W3K_C(3,15)
2720     CALL W3K_GRAB(N+F,16,32)
2730   NEXT F
2740 END PROC
2750 PROC W3K_MEDKIT(N)
2760   GFX CLEAR 0
2770   GFX LINE 1,1,18,13,FN W3K_C(0,14),BF
2780   GFX LINE 1,1,18,13,FN W3K_C(0,8),B
2790   GFX LINE 9,3,10,11,FN W3K_C(1,12),BF
2800   GFX LINE 6,6,13,8,FN W3K_C(1,12),BF
2810   CALL W3K_GRAB(N,20,14)
2820 END PROC
2830 PROC W3K_AMMOBOX(N)
2840   GFX CLEAR 0
2850   GFX LINE 1,1,18,11,FN W3K_C(3,10),BF
2860   GFX LINE 1,1,18,11,FN W3K_C(12,6),B
2870   GFX LINE 4,4,15,8,FN W3K_C(12,5),BF
2880   GFX LINE 6,5,7,7,FN W3K_C(3,15),BF
2890   GFX LINE 10,5,11,7,FN W3K_C(3,15),BF
2900   CALL W3K_GRAB(N,20,12)
2910 END PROC
2920 PROC W3K_KEYCARD(N,H)
2930   GFX CLEAR 0
2940   GFX LINE 1,1,12,12,FN W3K_C(H,11),BF
2950   GFX LINE 1,1,12,12,FN W3K_C(0,13),B
2960   GFX LINE 3,3,8,4,FN W3K_C(0,3),BF
2970   GFX LINE 3,8,10,9,FN W3K_C(0,3),BF
2980   CALL W3K_GRAB(N,14,14)
2990 END PROC
3000 ' reads the keys and the first game controller, moves and turns the player (W3D CAMERA must have been called once)
3010 PROC W3K_WALK
3020   LOCAL DT,F,S,T,L,V,SP
3030   DT=(TI-W3K_T0)/60
3040   W3K_T0=TI
3050   IF DT>0.1 THEN DT=0.1
3060   F=0:S=0:T=0:L=0
3070   IF KEY("UP") OR KEY("W") THEN F=F+1
3080   IF KEY("DOWN") OR KEY("S") THEN F=F-1
3090   IF KEY("D") THEN S=S+1
3100   IF KEY("A") THEN S=S-1
3110   IF KEY("LEFT") THEN T=T+1
3120   IF KEY("RIGHT") THEN T=T-1
3130   IF KEY("R") OR KEY("PGUP") THEN L=L+1
3140   IF KEY("F") OR KEY("PGDN") THEN L=L-1
3150   F=F-JOY("LY"):S=S+JOY("LX"):T=T-JOY("RX"):L=L-JOY("RY")
3160   IF KEY("HOME") OR JOY("RS") THEN W3D TURN 0,-W3D("PITCH")
3170   SP=190
3180   IF KEY("SHIFT") OR JOY("LT")>0.4 THEN SP=300
3190   V=SQR(F*F+S*S)
3200   IF V>1 THEN F=F/V:S=S/V
3210   IF F<>0 OR S<>0 THEN W3D MOVE F*SP*DT,S*SP*DT
3220   IF T<>0 OR L<>0 THEN W3D TURN T*115*DT,L*60*DT
3230 END PROC
3240 PROC W3K_SHOW
3250   GFX LAYER W3K_B,OFF
3260   W3K_B=3-W3K_B
3270   GFX LAYER W3K_B,ON
3280   FRAME
3290   GFX TARGET 3-W3K_B
3300 END PROC
3310 PROC W3K_DONE
3320   GFX RESET
3330   CLS
3340 END PROC
3350 PROC W3K_HUDBAR(Y,H)
3360   GFX LINE 0,Y,639,Y+H-1,FN W3K_C(0,1),BF
3370   GFX LINE 0,Y,639,Y,FN W3K_C(0,6)
3380 END PROC
