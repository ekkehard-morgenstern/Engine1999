1 ' License: free for everybody to use, copy, change and build into executables (BUILD).
2 ' An executable made with BUILD contains the Engine1999 runtime: the Engine1999 Runtime Exception
3 ' (file LICENSE-EXCEPTION of Engine1999) applies if the runtime is unmodified and its notice stays
4 ' in the executable (it shows with the command line option --engine1999-about).
10 ' w3dkit - helpers for programs that use the 3D sector renderer (W3D ...): a library, LOAD LIBRARY "w3dkit".
20 ' It sets up a palette of 15 hues with 16 shades each (palette entries 16..255; entries 1..15 stay as they are), draws textures and sprites
30 ' with GFX statements and hands them to W3D TEXTURE, and reads the keyboard and game controller for walking around.
40 ' The palette index of hue H (0..14) and shade S (0 dark .. 15 bright) is FN W3K_C(H,S). Hues: 0 gray, 1 red, 2 orange, 3 yellow, 4 lime, 5 green,
50 ' 6 teal, 7 cyan, 8 azure, 9 blue, 10 purple, 11 magenta, 12 brown, 13 sand, 14 pink.
60 ' User settings (the library prefs3d edits and stores them; a program without it gets the defaults):
70 '   W3K_INVX, W3K_INVY (0 / 1) turn the right stick's turning and looking around the other way, W3K_TURN (percent, 100) the turning speed,
80 '   W3K_GAMMA (1) brightens (above 1) or darkens (below 1) the palette's middle shades, W3K_FOV (90) the field of view in degrees.
90 '   CALL W3K_VIEW(X,Y,W,H,S) is W3D VIEW with the field of view W3K_FOV (use it instead of W3D VIEW); CALL W3K_REAPPLY makes the palette, the
100 '   color map and the view again after one of the settings changed.
110 ' CALL W3K_INIT                 palette on the graphics layers 0 and 3, the tile and text layers hidden (the graphics layers are the picture), drawing layer 3, W3D RESET
120 ' CALL W3K_BRICK(N,H) W3K_STONE(N,H) W3K_PLASTER(N,H) W3K_METAL(N,H) W3K_CARPET(N,H) W3K_TILES(N,H1,H2) W3K_PLANKS(N) W3K_GRASS(N) W3K_DOORTEX(N,H)
130 '   W3K_SKY(N) (256 x 64) make a texture N (64 x 64, plaster and doors 64 x 128); W3K_WINDOW(N) and W3K_GRATE(N) have see-through parts (for masked walls)
140 ' CALL W3K_PLANT(N) W3K_LAMP(N) W3K_BARREL(N) W3K_TORCH(N) (two frames N, N+1) W3K_MEDKIT(N) W3K_AMMOBOX(N) W3K_KEYCARD(N,H)   sprites (index 0 is see-through)
150 ' CALL W3K_WALK                 one frame of walking: arrow keys / WASD / R F look / SHIFT run, or a game controller (left stick walk and strafe,
160 '                               right stick turn and look, LT run); applies W3D MOVE and W3D TURN scaled by the time since the last call
170 ' CALL W3K_JUMP(J)              a jump: J = -1 while the jump button is held (the height is W3D LIFT); call it each frame after W3K_WALK
180 ' CALL W3K_SHOW                 shows the layer that was drawn on and makes the other one the drawing layer (flicker free), then waits for the frame
190 ' CALL W3K_DONE                 the end of a program: all layers back as they were (GFX RESET), a clear screen
200 ' CALL W3K_HUDBAR(Y,H)          clears the strip Y .. Y+H-1 of the drawing layer to a dark color
210 LIBRARY "w3dkit","W3K_"
220 FUNC W3K_C(H,S)
230   RETURN 16+H*16+S
240 END FUNC
250 FUNC W3K_R(M)
260   RETURN INT(RND(1)*M)
270 END FUNC
280 PROC W3K_PALETTE
290   LOCAL L,H,S,R,G,B,F
300   FOR L=0 TO 3 STEP 3
310     RESTORE W3K_HUES
320     FOR H=0 TO 14
330       READ R,G,B
340       FOR S=0 TO 15
350         F=(0.06+0.94*S/15)^(1/W3K_GAMMA)
360         GFX PALETTE L,16+H*16+S,RGB(INT(R*F),INT(G*F),INT(B*F))
370       NEXT S
380     NEXT H
390   NEXT L
400 END PROC
410 LABEL W3K_HUES
420 DATA 255,255,255, 255,70,60, 255,150,40, 255,230,70, 160,230,60, 60,200,80, 50,200,170, 80,220,255
430 DATA 90,160,255, 70,80,240, 150,80,220, 230,80,200, 170,110,60, 225,200,150, 255,175,150
440 PROC W3K_INIT
450   W3K_VX=0:W3K_VY=0:W3K_VW=640:W3K_VH=264:W3K_VS=2:W3K_B=0:W3K_T0=TI
460   W3K_INVX=0:W3K_INVY=0:W3K_TURN=100:W3K_GAMMA=1:W3K_FOV=90:W3K_VZ=0:W3K_JL=0:W3K_DT=0.016
470   GFX LAYER 0,OFF:GFX LAYER 3,OFF:GFX LAYER 1,OFF:GFX LAYER 2,OFF
480   GFX BACKDROP RGB(0,0,0)
490   CALL W3K_PALETTE
500   GFX TARGET 3
510   W3D RESET
520 END PROC
530 PROC W3K_SETPREFS(IX,IY,G,F,T)
540   W3K_INVX=IX:W3K_INVY=IY:W3K_GAMMA=G:W3K_FOV=F:W3K_TURN=T
550 END PROC
560 PROC W3K_RESETCLOCK
570   W3K_T0=TI
580 END PROC
590 PROC W3K_VIEW(X,Y,W,H,S)
600   W3K_VX=X:W3K_VY=Y:W3K_VW=W:W3K_VH=H:W3K_VS=S
610   W3D VIEW X,Y,W,H,S,W3K_FOV
620 END PROC
630 PROC W3K_REAPPLY
640   CALL W3K_PALETTE
650   W3D COLORMAP
660   W3D VIEW W3K_VX,W3K_VY,W3K_VW,W3K_VH,W3K_VS,W3K_FOV
670 END PROC
680 ' grabs the picture at 0,0 of the drawing layer as texture N
690 PROC W3K_GRAB(N,W,H)
700   LOCAL A$
710   GFX GRAB 0,0,W-1,H-1,A$
720   W3D TEXTURE N,A$
730 END PROC
740 PROC W3K_BRICK(N,H)
750   LOCAL R,B,X,S,I
760   GFX CLEAR FN W3K_C(0,3)
770   FOR R=0 TO 7
780     FOR B=-1 TO 4
790       X=B*16+(R AND 1)*8
800       S=7+FN W3K_R(4)
810       GFX LINE X+1,R*8+1,X+15,R*8+7,FN W3K_C(H,S),BF
820     NEXT B
830   NEXT R
840   FOR I=1 TO 160
850     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H,5+FN W3K_R(6))
860   NEXT I
870   CALL W3K_GRAB(N,64,64)
880 END PROC
890 PROC W3K_STONE(N,H)
900   LOCAL R,B,X,S,I
910   GFX CLEAR FN W3K_C(H,4)
920   FOR R=0 TO 3
930     FOR B=-1 TO 2
940       X=B*32+(R AND 1)*16
950       S=8+FN W3K_R(3)
960       GFX LINE X+1,R*16+1,X+31,R*16+15,FN W3K_C(H,S),BF
970       GFX LINE X+1,R*16+1,X+31,R*16+1,FN W3K_C(H,S+3)
980     NEXT B
990   NEXT R
1000   FOR I=1 TO 300
1010     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H,5+FN W3K_R(7))
1020   NEXT I
1030   CALL W3K_GRAB(N,64,64)
1040 END PROC
1050 ' plaster with a wainscot: 64 x 128, the bottom 28 rows are paneled
1060 PROC W3K_PLASTER(N,H)
1070   LOCAL I,X
1080   GFX CLEAR FN W3K_C(H,11)
1090   FOR I=1 TO 220
1100     GFX PSET FN W3K_R(64),FN W3K_R(100),FN W3K_C(H,9+FN W3K_R(4))
1110   NEXT I
1120   GFX LINE 0,100,63,127,FN W3K_C(12,6),BF
1130   FOR X=0 TO 63 STEP 16
1140     GFX LINE X+2,104,X+13,124,FN W3K_C(12,8),BF
1150     GFX LINE X+2,104,X+13,104,FN W3K_C(12,10)
1160     GFX LINE X+2,124,X+13,124,FN W3K_C(12,4)
1170   NEXT X
1180   GFX LINE 0,97,63,99,FN W3K_C(12,10),BF
1190   GFX LINE 0,99,63,99,FN W3K_C(12,4)
1200   CALL W3K_GRAB(N,64,128)
1210 END PROC
1220 PROC W3K_METAL(N,H)
1230   LOCAL I,X,Y
1240   GFX CLEAR FN W3K_C(H,7)
1250   GFX LINE 0,0,63,63,FN W3K_C(H,11),B
1260   GFX LINE 1,1,62,62,FN W3K_C(H,5),B
1270   GFX LINE 0,31,63,31,FN W3K_C(H,4)
1280   GFX LINE 31,0,31,63,FN W3K_C(H,4)
1290   FOR X=6 TO 57 STEP 51
1300     FOR Y=6 TO 57 STEP 51
1310       GFX CIRCLE X,Y,2,FN W3K_C(H,12)
1320       GFX PSET X+1,Y+1,FN W3K_C(H,3)
1330     NEXT Y
1340   NEXT X
1350   FOR I=1 TO 140
1360     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H,5+FN W3K_R(5))
1370   NEXT I
1380   CALL W3K_GRAB(N,64,64)
1390 END PROC
1400 PROC W3K_CARPET(N,H)
1410   LOCAL I,X
1420   GFX CLEAR FN W3K_C(H,6)
1430   FOR X=0 TO 63 STEP 16
1440     GFX LINE X,0,X+16,16,FN W3K_C(H,9)
1450     GFX LINE X+16,0,X,16,FN W3K_C(H,9)
1460     GFX LINE X,16,X+16,32,FN W3K_C(H,9)
1470     GFX LINE X+16,16,X,32,FN W3K_C(H,9)
1480     GFX LINE X,32,X+16,48,FN W3K_C(H,9)
1490     GFX LINE X+16,32,X,48,FN W3K_C(H,9)
1500     GFX LINE X,48,X+16,64,FN W3K_C(H,9)
1510     GFX LINE X+16,48,X,64,FN W3K_C(H,9)
1520   NEXT X
1530   FOR I=1 TO 260
1540     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H,4+FN W3K_R(5))
1550   NEXT I
1560   CALL W3K_GRAB(N,64,64)
1570 END PROC
1580 PROC W3K_TILES(N,H1,H2)
1590   LOCAL X,Y,I
1600   GFX CLEAR FN W3K_C(0,5)
1610   FOR X=0 TO 3
1620     FOR Y=0 TO 3
1630       IF (X+Y) AND 1 THEN I=H1 ELSE I=H2
1640       GFX LINE X*16+1,Y*16+1,X*16+15,Y*16+15,FN W3K_C(I,10),BF
1650       GFX LINE X*16+1,Y*16+1,X*16+15,Y*16+1,FN W3K_C(I,13)
1660     NEXT Y
1670   NEXT X
1680   FOR I=1 TO 120
1690     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H1,8+FN W3K_R(4))
1700   NEXT I
1710   CALL W3K_GRAB(N,64,64)
1720 END PROC
1730 PROC W3K_PLANKS(N)
1740   LOCAL Y,I,X
1750   GFX CLEAR FN W3K_C(12,3)
1760   FOR Y=0 TO 7
1770     GFX LINE 0,Y*8+1,63,Y*8+7,FN W3K_C(12,6+FN W3K_R(4)),BF
1780     X=FN W3K_R(60)
1790     GFX LINE X,Y*8,X,Y*8+7,FN W3K_C(12,3)
1800   NEXT Y
1810   FOR I=1 TO 90
1820     X=FN W3K_R(64):Y=FN W3K_R(64)
1830     GFX LINE X,Y,X+3,Y,FN W3K_C(12,4+FN W3K_R(5))
1840   NEXT I
1850   CALL W3K_GRAB(N,64,64)
1860 END PROC
1870 PROC W3K_GRASS(N)
1880   LOCAL I,X,Y
1890   GFX CLEAR FN W3K_C(5,5)
1900   FOR I=1 TO 500
1910     X=FN W3K_R(64):Y=FN W3K_R(64)
1920     GFX LINE X,Y,X+FN W3K_R(3)-1,Y-1-FN W3K_R(3),FN W3K_C(4+FN W3K_R(2),3+FN W3K_R(8))
1930   NEXT I
1940   CALL W3K_GRAB(N,64,64)
1950 END PROC
1960 ' a door: 64 x 128, vertical boards, a frame and a handle
1970 PROC W3K_DOORTEX(N,H)
1980   LOCAL X,I
1990   GFX CLEAR FN W3K_C(H,4)
2000   FOR X=4 TO 56 STEP 8
2010     GFX LINE X,4,X+7,123,FN W3K_C(H,7+FN W3K_R(3)),BF
2020     GFX LINE X,4,X,123,FN W3K_C(H,4)
2030   NEXT X
2040   GFX LINE 0,0,63,127,FN W3K_C(0,6),B
2050   GFX LINE 1,1,62,126,FN W3K_C(0,11),B
2060   GFX LINE 4,20,59,26,FN W3K_C(H,10),BF
2070   GFX LINE 4,96,59,102,FN W3K_C(H,10),BF
2080   GFX CIRCLE 52,64,3,FN W3K_C(3,13)
2090   GFX PAINT 52,64,FN W3K_C(3,13),FN W3K_C(3,13)
2100   CALL W3K_GRAB(N,64,128)
2110 END PROC
2120 ' a window: 64 x 96, a wooden frame with a cross, the panes are see-through (index 0), with a few shining dots
2130 PROC W3K_WINDOW(N)
2140   LOCAL I
2150   GFX CLEAR 0
2160   GFX LINE 0,0,63,95,FN W3K_C(12,8),B
2170   GFX LINE 1,1,62,94,FN W3K_C(12,6),B
2180   GFX LINE 2,2,61,93,FN W3K_C(12,9),B
2190   GFX LINE 3,3,60,92,FN W3K_C(12,5),B
2200   GFX LINE 29,3,34,92,FN W3K_C(12,7),BF
2210   GFX LINE 3,44,60,49,FN W3K_C(12,7),BF
2220   FOR I=0 TO 3
2230     GFX LINE 8+I*2,12+I*2,12+I*2,16+I*2,FN W3K_C(7,14)
2240   NEXT I
2250   CALL W3K_GRAB(N,64,96)
2260 END PROC
2270 ' a grate: 64 x 64, bars with gaps
2280 PROC W3K_GRATE(N)
2290   LOCAL X
2300   GFX CLEAR 0
2310   FOR X=3 TO 60 STEP 8
2320     GFX LINE X,0,X+1,63,FN W3K_C(0,9),BF
2330     GFX LINE X,0,X,63,FN W3K_C(0,13)
2340   NEXT X
2350   GFX LINE 0,0,63,3,FN W3K_C(0,7),BF
2360   GFX LINE 0,60,63,63,FN W3K_C(0,7),BF
2370   GFX LINE 0,30,63,32,FN W3K_C(0,7),BF
2380   CALL W3K_GRAB(N,64,64)
2390 END PROC
2400 ' a sky: 256 x 64, the color gets lighter toward the bottom (the horizon), with clouds that wrap around the edge
2410 PROC W3K_SKY(N)
2420   LOCAL Y,I,X,CY,RX
2430   FOR Y=0 TO 63
2440     GFX LINE 0,Y,255,Y,FN W3K_C(8,6+Y\8),BF
2450   NEXT Y
2460   FOR I=1 TO 9
2470     X=FN W3K_R(256):CY=6+FN W3K_R(36):RX=10+FN W3K_R(14)
2480     GFX CIRCLE X,CY,RX,FN W3K_C(0,13),-1,-1,0.35
2490     GFX CIRCLE X-256,CY,RX,FN W3K_C(0,13),-1,-1,0.35
2500     GFX PAINT X,CY,FN W3K_C(0,15),FN W3K_C(0,13)
2510     GFX PAINT X-256,CY,FN W3K_C(0,15),FN W3K_C(0,13)
2520   NEXT I
2530   CALL W3K_GRAB(N,256,64)
2540 END PROC
2550 PROC W3K_PLANT(N)
2560   LOCAL I
2570   GFX CLEAR 0
2580   GFX LINE 9,36,22,47,FN W3K_C(12,7),BF
2590   GFX LINE 8,34,23,36,FN W3K_C(12,10),BF
2600   GFX LINE 15,20,16,34,FN W3K_C(5,5)
2610   FOR I=0 TO 6
2620     GFX CIRCLE 16+(I-3)*3,12+ABS(I-3)*3,6,FN W3K_C(5,6+I),-1,-1,0.6
2630     GFX PAINT 16+(I-3)*3,12+ABS(I-3)*3,FN W3K_C(5,6+I),FN W3K_C(5,6+I)
2640   NEXT I
2650   CALL W3K_GRAB(N,32,48)
2660 END PROC
2670 PROC W3K_LAMP(N)
2680   GFX CLEAR 0
2690   GFX LINE 11,18,12,52,FN W3K_C(0,8),BF
2700   GFX LINE 6,52,17,55,FN W3K_C(0,6),BF
2710   GFX LINE 5,8,18,18,FN W3K_C(3,13),BF
2720   GFX LINE 7,4,16,8,FN W3K_C(3,14),BF
2730   GFX LINE 5,18,18,18,FN W3K_C(3,8)
2740   CALL W3K_GRAB(N,24,56)
2750 END PROC
2760 PROC W3K_BARREL(N)
2770   GFX CLEAR 0
2780   GFX LINE 4,2,27,37,FN W3K_C(12,8),BF
2790   GFX LINE 3,8,28,31,FN W3K_C(12,9),BF
2800   GFX LINE 3,10,28,12,FN W3K_C(0,6),BF
2810   GFX LINE 3,26,28,28,FN W3K_C(0,6),BF
2820   GFX LINE 8,3,9,36,FN W3K_C(12,11)
2830   GFX LINE 22,3,23,36,FN W3K_C(12,5)
2840   CALL W3K_GRAB(N,32,40)
2850 END PROC
2860 PROC W3K_TORCH(N)
2870   LOCAL F
2880   FOR F=0 TO 1
2890     GFX CLEAR 0
2900     GFX LINE 7,16,9,31,FN W3K_C(12,7),BF
2910     GFX CIRCLE 8,9,4+F,FN W3K_C(2,12),-1,-1,1.4
2920     GFX PAINT 8,9,FN W3K_C(3,14),FN W3K_C(2,12)
2930     GFX PSET 8,6-F,FN W3K_C(3,15)
2940     CALL W3K_GRAB(N+F,16,32)
2950   NEXT F
2960 END PROC
2970 PROC W3K_MEDKIT(N)
2980   GFX CLEAR 0
2990   GFX LINE 1,1,18,13,FN W3K_C(0,14),BF
3000   GFX LINE 1,1,18,13,FN W3K_C(0,8),B
3010   GFX LINE 9,3,10,11,FN W3K_C(1,12),BF
3020   GFX LINE 6,6,13,8,FN W3K_C(1,12),BF
3030   CALL W3K_GRAB(N,20,14)
3040 END PROC
3050 PROC W3K_AMMOBOX(N)
3060   GFX CLEAR 0
3070   GFX LINE 1,1,18,11,FN W3K_C(3,10),BF
3080   GFX LINE 1,1,18,11,FN W3K_C(12,6),B
3090   GFX LINE 4,4,15,8,FN W3K_C(12,5),BF
3100   GFX LINE 6,5,7,7,FN W3K_C(3,15),BF
3110   GFX LINE 10,5,11,7,FN W3K_C(3,15),BF
3120   CALL W3K_GRAB(N,20,12)
3130 END PROC
3140 PROC W3K_KEYCARD(N,H)
3150   GFX CLEAR 0
3160   GFX LINE 1,1,12,12,FN W3K_C(H,11),BF
3170   GFX LINE 1,1,12,12,FN W3K_C(0,13),B
3180   GFX LINE 3,3,8,4,FN W3K_C(0,3),BF
3190   GFX LINE 3,8,10,9,FN W3K_C(0,3),BF
3200   CALL W3K_GRAB(N,14,14)
3210 END PROC
3220 ' reads the keys and the first game controller, moves and turns the player (W3D CAMERA must have been called once)
3230 PROC W3K_WALK
3240   LOCAL DT,F,S,T,L,V,SP
3250   DT=(TI-W3K_T0)/60
3260   W3K_T0=TI
3270   IF DT>0.1 THEN DT=0.1
3280   W3K_DT=DT
3290   F=0:S=0:T=0:L=0
3300   IF KEY("UP") OR KEY("W") THEN F=F+1
3310   IF KEY("DOWN") OR KEY("S") THEN F=F-1
3320   IF KEY("D") THEN S=S+1
3330   IF KEY("A") THEN S=S-1
3340   IF KEY("LEFT") THEN T=T+1
3350   IF KEY("RIGHT") THEN T=T-1
3360   IF KEY("R") OR KEY("PGUP") THEN L=L+1
3370   IF KEY("F") OR KEY("PGDN") THEN L=L-1
3380   F=F-JOY("LY"):S=S+JOY("LX")
3390   IF W3K_INVX THEN T=T+JOY("RX") ELSE T=T-JOY("RX")
3400   IF W3K_INVY THEN L=L+JOY("RY") ELSE L=L-JOY("RY")
3410   IF KEY("HOME") OR JOY("RS") THEN W3D TURN 0,-W3D("PITCH")
3420   SP=190
3430   IF KEY("SHIFT") OR JOY("LT")>0.4 THEN SP=300
3440   V=SQR(F*F+S*S)
3450   IF V>1 THEN F=F/V:S=S/V
3460   IF F<>0 OR S<>0 THEN W3D MOVE F*SP*DT,S*SP*DT
3470   IF T<>0 OR L<>0 THEN W3D TURN T*115*W3K_TURN/100*DT,L*60*DT
3480 END PROC
3490 ' a jump: call it every frame with -1 while the jump button is held (a new press jumps, if the feet are on the ground): the height above the floor goes
3500 ' up and down like a thrown stone (W3D LIFT), up to about 40 units; steps up to 24 + that height can be taken while it lasts (out of a pool)
3510 PROC W3K_JUMP(J)
3520   IF J<>0 AND W3K_JL=0 AND W3K_VZ=0 AND W3D("LIFT")<=0 THEN W3K_VZ=240
3530   W3K_JL=J
3540   IF W3K_VZ<>0 OR W3D("LIFT")>0 THEN
3550     W3K_VZ=W3K_VZ-720*W3K_DT
3560     W3K_H=W3D("LIFT")+W3K_VZ*W3K_DT
3570     IF W3K_H<=0 THEN
3580       W3K_H=0
3590       W3K_VZ=0
3600     END IF
3610     W3D LIFT W3K_H
3620   END IF
3630 END PROC
3640 PROC W3K_SHOW
3650   GFX LAYER W3K_B,OFF
3660   W3K_B=3-W3K_B
3670   GFX LAYER W3K_B,ON
3680   FRAME
3690   GFX TARGET 3-W3K_B
3700 END PROC
3710 PROC W3K_DONE
3720   GFX RESET
3730   CLS
3740 END PROC
3750 PROC W3K_HUDBAR(Y,H)
3760   GFX LINE 0,Y,639,Y+H-1,FN W3K_C(0,1),BF
3770   GFX LINE 0,Y,639,Y,FN W3K_C(0,6)
3780 END PROC
