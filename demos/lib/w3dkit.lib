1 ' License: free for everybody to use, copy, change and build into executables (BUILD).
2 ' An executable made with BUILD contains the Engine1999 runtime: the Engine1999 Runtime Exception
3 ' (file LICENSE-EXCEPTION of Engine1999) applies if the runtime is unmodified and its notice stays
4 ' in the executable (it shows with the command line option --engine1999-about).
10 ' w3dkit - helpers for programs that use the 3D sector renderer (W3D ...): a library, LOAD LIBRARY "w3dkit".
20 ' It sets up a palette of 15 hues with 16 shades each (palette entries 16..255; entries 1..15 stay as they are), draws textures and sprites
30 ' with GFX statements and hands them to W3D TEXTURE, and reads the keyboard and game controller for walking around.
40 ' The palette index of hue H (0..14) and shade S (0 dark .. 15 bright) is FN W3K_C(H,S). Hues: 0 gray, 1 red, 2 orange, 3 yellow, 4 lime, 5 green,
50 ' 6 teal, 7 cyan, 8 azure, 9 blue, 10 purple, 11 magenta, 12 brown, 13 sand, 14 pink.
60 ' User settings (the library prefs3d edits and stores them; a program without it gets the defaults):
70 '   W3K_INVX, W3K_INVY (0 / 1) turn the right stick's turning and looking around the other way, W3K_TURN (percent, 100) the turning speed,
80 '   W3K_GAMMA (1) brightens (above 1) or darkens (below 1) the palette's middle shades, W3K_FOV (90) the field of view in degrees.
90 '   CALL W3K_VIEW(X,Y,W,H,S) is W3D VIEW with the field of view W3K_FOV (use it instead of W3D VIEW); CALL W3K_REAPPLY makes the palette, the
100 '   color map and the view again after one of the settings changed.
110 ' CALL W3K_INIT                 palette on the graphics layers 0 and 3, the tile and text layers hidden (the graphics layers are the picture), drawing layer 3, W3D RESET
120 ' CALL W3K_BRICK(N,H) W3K_STONE(N,H) W3K_PLASTER(N,H) W3K_METAL(N,H) W3K_CARPET(N,H) W3K_TILES(N,H1,H2) W3K_PLANKS(N) W3K_GRASS(N) W3K_DOORTEX(N,H)
130 '   W3K_SKY(N) (256 x 64) make a texture N (64 x 64, plaster and doors 64 x 128); W3K_WINDOW(N) and W3K_GRATE(N) have see-through parts (for masked walls)
140 ' CALL W3K_PLANT(N) W3K_LAMP(N) W3K_BARREL(N) W3K_TORCH(N) (two frames N, N+1) W3K_MEDKIT(N) W3K_AMMOBOX(N) W3K_KEYCARD(N,H)   sprites (index 0 is see-through)
150 ' CALL W3K_WALK                 one frame of walking: arrow keys / WASD / R F look / SHIFT run, or a game controller (left stick walk and strafe,
160 '                               right stick turn and look, LT run); applies W3D MOVE and W3D TURN scaled by the time since the last call
170 ' CALL W3K_SHOW                 shows the layer that was drawn on and makes the other one the drawing layer (flicker free), then waits for the frame
180 ' CALL W3K_DONE                 the end of a program: all layers back as they were (GFX RESET), a clear screen
190 ' CALL W3K_HUDBAR(Y,H)          clears the strip Y .. Y+H-1 of the drawing layer to a dark color
200 LIBRARY "w3dkit","W3K_"
210 FUNC W3K_C(H,S)
220   RETURN 16+H*16+S
230 END FUNC
240 FUNC W3K_R(M)
250   RETURN INT(RND(1)*M)
260 END FUNC
270 PROC W3K_PALETTE
280   LOCAL L,H,S,R,G,B,F
290   FOR L=0 TO 3 STEP 3
300     RESTORE W3K_HUES
310     FOR H=0 TO 14
320       READ R,G,B
330       FOR S=0 TO 15
340         F=(0.06+0.94*S/15)^(1/W3K_GAMMA)
350         GFX PALETTE L,16+H*16+S,RGB(INT(R*F),INT(G*F),INT(B*F))
360       NEXT S
370     NEXT H
380   NEXT L
390 END PROC
400 LABEL W3K_HUES
410 DATA 255,255,255, 255,70,60, 255,150,40, 255,230,70, 160,230,60, 60,200,80, 50,200,170, 80,220,255
420 DATA 90,160,255, 70,80,240, 150,80,220, 230,80,200, 170,110,60, 225,200,150, 255,175,150
430 PROC W3K_INIT
440   W3K_VX=0:W3K_VY=0:W3K_VW=640:W3K_VH=264:W3K_VS=2:W3K_B=0:W3K_T0=TI
450   W3K_INVX=0:W3K_INVY=0:W3K_TURN=100:W3K_GAMMA=1:W3K_FOV=90
460   GFX LAYER 0,OFF:GFX LAYER 3,OFF:GFX LAYER 1,OFF:GFX LAYER 2,OFF
470   GFX BACKDROP RGB(0,0,0)
480   CALL W3K_PALETTE
490   GFX TARGET 3
500   W3D RESET
510 END PROC
520 PROC W3K_SETPREFS(IX,IY,G,F,T)
530   W3K_INVX=IX:W3K_INVY=IY:W3K_GAMMA=G:W3K_FOV=F:W3K_TURN=T
540 END PROC
550 PROC W3K_RESETCLOCK
560   W3K_T0=TI
570 END PROC
580 PROC W3K_VIEW(X,Y,W,H,S)
590   W3K_VX=X:W3K_VY=Y:W3K_VW=W:W3K_VH=H:W3K_VS=S
600   W3D VIEW X,Y,W,H,S,W3K_FOV
610 END PROC
620 PROC W3K_REAPPLY
630   CALL W3K_PALETTE
640   W3D COLORMAP
650   W3D VIEW W3K_VX,W3K_VY,W3K_VW,W3K_VH,W3K_VS,W3K_FOV
660 END PROC
670 ' grabs the picture at 0,0 of the drawing layer as texture N
680 PROC W3K_GRAB(N,W,H)
690   LOCAL A$
700   GFX GRAB 0,0,W-1,H-1,A$
710   W3D TEXTURE N,A$
720 END PROC
730 PROC W3K_BRICK(N,H)
740   LOCAL R,B,X,S,I
750   GFX CLEAR FN W3K_C(0,3)
760   FOR R=0 TO 7
770     FOR B=-1 TO 4
780       X=B*16+(R AND 1)*8
790       S=7+FN W3K_R(4)
800       GFX LINE X+1,R*8+1,X+15,R*8+7,FN W3K_C(H,S),BF
810     NEXT B
820   NEXT R
830   FOR I=1 TO 160
840     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H,5+FN W3K_R(6))
850   NEXT I
860   CALL W3K_GRAB(N,64,64)
870 END PROC
880 PROC W3K_STONE(N,H)
890   LOCAL R,B,X,S,I
900   GFX CLEAR FN W3K_C(H,4)
910   FOR R=0 TO 3
920     FOR B=-1 TO 2
930       X=B*32+(R AND 1)*16
940       S=8+FN W3K_R(3)
950       GFX LINE X+1,R*16+1,X+31,R*16+15,FN W3K_C(H,S),BF
960       GFX LINE X+1,R*16+1,X+31,R*16+1,FN W3K_C(H,S+3)
970     NEXT B
980   NEXT R
990   FOR I=1 TO 300
1000     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H,5+FN W3K_R(7))
1010   NEXT I
1020   CALL W3K_GRAB(N,64,64)
1030 END PROC
1040 ' plaster with a wainscot: 64 x 128, the bottom 28 rows are paneled
1050 PROC W3K_PLASTER(N,H)
1060   LOCAL I,X
1070   GFX CLEAR FN W3K_C(H,11)
1080   FOR I=1 TO 220
1090     GFX PSET FN W3K_R(64),FN W3K_R(100),FN W3K_C(H,9+FN W3K_R(4))
1100   NEXT I
1110   GFX LINE 0,100,63,127,FN W3K_C(12,6),BF
1120   FOR X=0 TO 63 STEP 16
1130     GFX LINE X+2,104,X+13,124,FN W3K_C(12,8),BF
1140     GFX LINE X+2,104,X+13,104,FN W3K_C(12,10)
1150     GFX LINE X+2,124,X+13,124,FN W3K_C(12,4)
1160   NEXT X
1170   GFX LINE 0,97,63,99,FN W3K_C(12,10),BF
1180   GFX LINE 0,99,63,99,FN W3K_C(12,4)
1190   CALL W3K_GRAB(N,64,128)
1200 END PROC
1210 PROC W3K_METAL(N,H)
1220   LOCAL I,X,Y
1230   GFX CLEAR FN W3K_C(H,7)
1240   GFX LINE 0,0,63,63,FN W3K_C(H,11),B
1250   GFX LINE 1,1,62,62,FN W3K_C(H,5),B
1260   GFX LINE 0,31,63,31,FN W3K_C(H,4)
1270   GFX LINE 31,0,31,63,FN W3K_C(H,4)
1280   FOR X=6 TO 57 STEP 51
1290     FOR Y=6 TO 57 STEP 51
1300       GFX CIRCLE X,Y,2,FN W3K_C(H,12)
1310       GFX PSET X+1,Y+1,FN W3K_C(H,3)
1320     NEXT Y
1330   NEXT X
1340   FOR I=1 TO 140
1350     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H,5+FN W3K_R(5))
1360   NEXT I
1370   CALL W3K_GRAB(N,64,64)
1380 END PROC
1390 PROC W3K_CARPET(N,H)
1400   LOCAL I,X
1410   GFX CLEAR FN W3K_C(H,6)
1420   FOR X=0 TO 63 STEP 16
1430     GFX LINE X,0,X+16,16,FN W3K_C(H,9)
1440     GFX LINE X+16,0,X,16,FN W3K_C(H,9)
1450     GFX LINE X,16,X+16,32,FN W3K_C(H,9)
1460     GFX LINE X+16,16,X,32,FN W3K_C(H,9)
1470     GFX LINE X,32,X+16,48,FN W3K_C(H,9)
1480     GFX LINE X+16,32,X,48,FN W3K_C(H,9)
1490     GFX LINE X,48,X+16,64,FN W3K_C(H,9)
1500     GFX LINE X+16,48,X,64,FN W3K_C(H,9)
1510   NEXT X
1520   FOR I=1 TO 260
1530     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H,4+FN W3K_R(5))
1540   NEXT I
1550   CALL W3K_GRAB(N,64,64)
1560 END PROC
1570 PROC W3K_TILES(N,H1,H2)
1580   LOCAL X,Y,I
1590   GFX CLEAR FN W3K_C(0,5)
1600   FOR X=0 TO 3
1610     FOR Y=0 TO 3
1620       IF (X+Y) AND 1 THEN I=H1 ELSE I=H2
1630       GFX LINE X*16+1,Y*16+1,X*16+15,Y*16+15,FN W3K_C(I,10),BF
1640       GFX LINE X*16+1,Y*16+1,X*16+15,Y*16+1,FN W3K_C(I,13)
1650     NEXT Y
1660   NEXT X
1670   FOR I=1 TO 120
1680     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H1,8+FN W3K_R(4))
1690   NEXT I
1700   CALL W3K_GRAB(N,64,64)
1710 END PROC
1720 PROC W3K_PLANKS(N)
1730   LOCAL Y,I,X
1740   GFX CLEAR FN W3K_C(12,3)
1750   FOR Y=0 TO 7
1760     GFX LINE 0,Y*8+1,63,Y*8+7,FN W3K_C(12,6+FN W3K_R(4)),BF
1770     X=FN W3K_R(60)
1780     GFX LINE X,Y*8,X,Y*8+7,FN W3K_C(12,3)
1790   NEXT Y
1800   FOR I=1 TO 90
1810     X=FN W3K_R(64):Y=FN W3K_R(64)
1820     GFX LINE X,Y,X+3,Y,FN W3K_C(12,4+FN W3K_R(5))
1830   NEXT I
1840   CALL W3K_GRAB(N,64,64)
1850 END PROC
1860 PROC W3K_GRASS(N)
1870   LOCAL I,X,Y
1880   GFX CLEAR FN W3K_C(5,5)
1890   FOR I=1 TO 500
1900     X=FN W3K_R(64):Y=FN W3K_R(64)
1910     GFX LINE X,Y,X+FN W3K_R(3)-1,Y-1-FN W3K_R(3),FN W3K_C(4+FN W3K_R(2),3+FN W3K_R(8))
1920   NEXT I
1930   CALL W3K_GRAB(N,64,64)
1940 END PROC
1950 ' a door: 64 x 128, vertical boards, a frame and a handle
1960 PROC W3K_DOORTEX(N,H)
1970   LOCAL X,I
1980   GFX CLEAR FN W3K_C(H,4)
1990   FOR X=4 TO 56 STEP 8
2000     GFX LINE X,4,X+7,123,FN W3K_C(H,7+FN W3K_R(3)),BF
2010     GFX LINE X,4,X,123,FN W3K_C(H,4)
2020   NEXT X
2030   GFX LINE 0,0,63,127,FN W3K_C(0,6),B
2040   GFX LINE 1,1,62,126,FN W3K_C(0,11),B
2050   GFX LINE 4,20,59,26,FN W3K_C(H,10),BF
2060   GFX LINE 4,96,59,102,FN W3K_C(H,10),BF
2070   GFX CIRCLE 52,64,3,FN W3K_C(3,13)
2080   GFX PAINT 52,64,FN W3K_C(3,13),FN W3K_C(3,13)
2090   CALL W3K_GRAB(N,64,128)
2100 END PROC
2110 ' a window: 64 x 96, a wooden frame with a cross, the panes are see-through (index 0), with a few shining dots
2120 PROC W3K_WINDOW(N)
2130   LOCAL I
2140   GFX CLEAR 0
2150   GFX LINE 0,0,63,95,FN W3K_C(12,8),B
2160   GFX LINE 1,1,62,94,FN W3K_C(12,6),B
2170   GFX LINE 2,2,61,93,FN W3K_C(12,9),B
2180   GFX LINE 3,3,60,92,FN W3K_C(12,5),B
2190   GFX LINE 29,3,34,92,FN W3K_C(12,7),BF
2200   GFX LINE 3,44,60,49,FN W3K_C(12,7),BF
2210   FOR I=0 TO 3
2220     GFX LINE 8+I*2,12+I*2,12+I*2,16+I*2,FN W3K_C(7,14)
2230   NEXT I
2240   CALL W3K_GRAB(N,64,96)
2250 END PROC
2260 ' a grate: 64 x 64, bars with gaps
2270 PROC W3K_GRATE(N)
2280   LOCAL X
2290   GFX CLEAR 0
2300   FOR X=3 TO 60 STEP 8
2310     GFX LINE X,0,X+1,63,FN W3K_C(0,9),BF
2320     GFX LINE X,0,X,63,FN W3K_C(0,13)
2330   NEXT X
2340   GFX LINE 0,0,63,3,FN W3K_C(0,7),BF
2350   GFX LINE 0,60,63,63,FN W3K_C(0,7),BF
2360   GFX LINE 0,30,63,32,FN W3K_C(0,7),BF
2370   CALL W3K_GRAB(N,64,64)
2380 END PROC
2390 ' a sky: 256 x 64, the color gets lighter toward the bottom (the horizon), with clouds that wrap around the edge
2400 PROC W3K_SKY(N)
2410   LOCAL Y,I,X,CY,RX
2420   FOR Y=0 TO 63
2430     GFX LINE 0,Y,255,Y,FN W3K_C(8,6+Y\8),BF
2440   NEXT Y
2450   FOR I=1 TO 9
2460     X=FN W3K_R(256):CY=6+FN W3K_R(36):RX=10+FN W3K_R(14)
2470     GFX CIRCLE X,CY,RX,FN W3K_C(0,13),-1,-1,0.35
2480     GFX CIRCLE X-256,CY,RX,FN W3K_C(0,13),-1,-1,0.35
2490     GFX PAINT X,CY,FN W3K_C(0,15),FN W3K_C(0,13)
2500     GFX PAINT X-256,CY,FN W3K_C(0,15),FN W3K_C(0,13)
2510   NEXT I
2520   CALL W3K_GRAB(N,256,64)
2530 END PROC
2540 PROC W3K_PLANT(N)
2550   LOCAL I
2560   GFX CLEAR 0
2570   GFX LINE 9,36,22,47,FN W3K_C(12,7),BF
2580   GFX LINE 8,34,23,36,FN W3K_C(12,10),BF
2590   GFX LINE 15,20,16,34,FN W3K_C(5,5)
2600   FOR I=0 TO 6
2610     GFX CIRCLE 16+(I-3)*3,12+ABS(I-3)*3,6,FN W3K_C(5,6+I),-1,-1,0.6
2620     GFX PAINT 16+(I-3)*3,12+ABS(I-3)*3,FN W3K_C(5,6+I),FN W3K_C(5,6+I)
2630   NEXT I
2640   CALL W3K_GRAB(N,32,48)
2650 END PROC
2660 PROC W3K_LAMP(N)
2670   GFX CLEAR 0
2680   GFX LINE 11,18,12,52,FN W3K_C(0,8),BF
2690   GFX LINE 6,52,17,55,FN W3K_C(0,6),BF
2700   GFX LINE 5,8,18,18,FN W3K_C(3,13),BF
2710   GFX LINE 7,4,16,8,FN W3K_C(3,14),BF
2720   GFX LINE 5,18,18,18,FN W3K_C(3,8)
2730   CALL W3K_GRAB(N,24,56)
2740 END PROC
2750 PROC W3K_BARREL(N)
2760   GFX CLEAR 0
2770   GFX LINE 4,2,27,37,FN W3K_C(12,8),BF
2780   GFX LINE 3,8,28,31,FN W3K_C(12,9),BF
2790   GFX LINE 3,10,28,12,FN W3K_C(0,6),BF
2800   GFX LINE 3,26,28,28,FN W3K_C(0,6),BF
2810   GFX LINE 8,3,9,36,FN W3K_C(12,11)
2820   GFX LINE 22,3,23,36,FN W3K_C(12,5)
2830   CALL W3K_GRAB(N,32,40)
2840 END PROC
2850 PROC W3K_TORCH(N)
2860   LOCAL F
2870   FOR F=0 TO 1
2880     GFX CLEAR 0
2890     GFX LINE 7,16,9,31,FN W3K_C(12,7),BF
2900     GFX CIRCLE 8,9,4+F,FN W3K_C(2,12),-1,-1,1.4
2910     GFX PAINT 8,9,FN W3K_C(3,14),FN W3K_C(2,12)
2920     GFX PSET 8,6-F,FN W3K_C(3,15)
2930     CALL W3K_GRAB(N+F,16,32)
2940   NEXT F
2950 END PROC
2960 PROC W3K_MEDKIT(N)
2970   GFX CLEAR 0
2980   GFX LINE 1,1,18,13,FN W3K_C(0,14),BF
2990   GFX LINE 1,1,18,13,FN W3K_C(0,8),B
3000   GFX LINE 9,3,10,11,FN W3K_C(1,12),BF
3010   GFX LINE 6,6,13,8,FN W3K_C(1,12),BF
3020   CALL W3K_GRAB(N,20,14)
3030 END PROC
3040 PROC W3K_AMMOBOX(N)
3050   GFX CLEAR 0
3060   GFX LINE 1,1,18,11,FN W3K_C(3,10),BF
3070   GFX LINE 1,1,18,11,FN W3K_C(12,6),B
3080   GFX LINE 4,4,15,8,FN W3K_C(12,5),BF
3090   GFX LINE 6,5,7,7,FN W3K_C(3,15),BF
3100   GFX LINE 10,5,11,7,FN W3K_C(3,15),BF
3110   CALL W3K_GRAB(N,20,12)
3120 END PROC
3130 PROC W3K_KEYCARD(N,H)
3140   GFX CLEAR 0
3150   GFX LINE 1,1,12,12,FN W3K_C(H,11),BF
3160   GFX LINE 1,1,12,12,FN W3K_C(0,13),B
3170   GFX LINE 3,3,8,4,FN W3K_C(0,3),BF
3180   GFX LINE 3,8,10,9,FN W3K_C(0,3),BF
3190   CALL W3K_GRAB(N,14,14)
3200 END PROC
3210 ' reads the keys and the first game controller, moves and turns the player (W3D CAMERA must have been called once)
3220 PROC W3K_WALK
3230   LOCAL DT,F,S,T,L,V,SP
3240   DT=(TI-W3K_T0)/60
3250   W3K_T0=TI
3260   IF DT>0.1 THEN DT=0.1
3270   F=0:S=0:T=0:L=0
3280   IF KEY("UP") OR KEY("W") THEN F=F+1
3290   IF KEY("DOWN") OR KEY("S") THEN F=F-1
3300   IF KEY("D") THEN S=S+1
3310   IF KEY("A") THEN S=S-1
3320   IF KEY("LEFT") THEN T=T+1
3330   IF KEY("RIGHT") THEN T=T-1
3340   IF KEY("R") OR KEY("PGUP") THEN L=L+1
3350   IF KEY("F") OR KEY("PGDN") THEN L=L-1
3360   F=F-JOY("LY"):S=S+JOY("LX")
3370   IF W3K_INVX THEN T=T+JOY("RX") ELSE T=T-JOY("RX")
3380   IF W3K_INVY THEN L=L+JOY("RY") ELSE L=L-JOY("RY")
3390   IF KEY("HOME") OR JOY("RS") THEN W3D TURN 0,-W3D("PITCH")
3400   SP=190
3410   IF KEY("SHIFT") OR JOY("LT")>0.4 THEN SP=300
3420   V=SQR(F*F+S*S)
3430   IF V>1 THEN F=F/V:S=S/V
3440   IF F<>0 OR S<>0 THEN W3D MOVE F*SP*DT,S*SP*DT
3450   IF T<>0 OR L<>0 THEN W3D TURN T*115*W3K_TURN/100*DT,L*60*DT
3460 END PROC
3470 PROC W3K_SHOW
3480   GFX LAYER W3K_B,OFF
3490   W3K_B=3-W3K_B
3500   GFX LAYER W3K_B,ON
3510   FRAME
3520   GFX TARGET 3-W3K_B
3530 END PROC
3540 PROC W3K_DONE
3550   GFX RESET
3560   CLS
3570 END PROC
3580 PROC W3K_HUDBAR(Y,H)
3590   GFX LINE 0,Y,639,Y+H-1,FN W3K_C(0,1),BF
3600   GFX LINE 0,Y,639,Y,FN W3K_C(0,6)
3610 END PROC
