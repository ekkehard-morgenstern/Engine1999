1 ' License: free for everybody to use, copy, change and build into executables (BUILD).
2 ' An executable made with BUILD contains the Engine1999 runtime: the Engine1999 Runtime Exception
3 ' (file LICENSE-EXCEPTION of Engine1999) applies if the runtime is unmodified and its notice stays
4 ' in the executable (it shows with the command line option --engine1999-about).
10 ' w3dkit - helpers for programs that use the 3D sector renderer (W3D ...): a library, LOAD LIBRARY "w3dkit".
20 ' It sets up a palette of 15 hues with 16 shades each (palette entries 16..255; entries 1..15 stay as they are), draws textures and sprites
30 ' with GFX statements and hands them to W3D TEXTURE, and reads the keyboard and game controller for walking around.
40 ' The palette index of hue H (0..14) and shade S (0 dark .. 15 bright) is FN W3K_C(H,S). Hues: 0 gray, 1 red, 2 orange, 3 yellow, 4 lime, 5 green,
50 ' 6 teal, 7 cyan, 8 azure, 9 blue, 10 purple, 11 magenta, 12 brown, 13 sand, 14 pink.
60 ' User settings (the library prefs3d edits and stores them; a program without it gets the defaults):
70 '   W3K_INVX, W3K_INVY (0 / 1) turn the right stick's turning and looking around the other way, W3K_TURN (percent, 100) the turning speed,
80 '   W3K_GAMMA (1) brightens (above 1) or darkens (below 1) the palette's middle shades, W3K_FOV (90) the field of view in degrees.
90 '   CALL W3K_VIEW(X,Y,W,H,S) is W3D VIEW with the field of view W3K_FOV (use it instead of W3D VIEW); CALL W3K_REAPPLY makes the palette, the
100 '   color map and the view again after one of the settings changed.
110 ' (The name is not INIT on purpose: a library's PROC <prefix>INIT would run by itself when the program starts, before it can decide whether it has a screen.)
120 ' CALL W3K_SETUP                 palette on the graphics layers 0 and 3, the tile and text layers hidden (the graphics layers are the picture), drawing layer 3, W3D RESET
130 ' CALL W3K_BRICK(N,H) W3K_STONE(N,H) W3K_PLASTER(N,H) W3K_METAL(N,H) W3K_CARPET(N,H) W3K_TILES(N,H1,H2) W3K_PLANKS(N) W3K_GRASS(N) W3K_DOORTEX(N,H)
140 '   W3K_SKY(N) (256 x 64) make a texture N (64 x 64, plaster and doors 64 x 128); W3K_WINDOW(N) and W3K_GRATE(N) have see-through parts (for masked walls)
150 ' CALL W3K_PLANT(N) W3K_LAMP(N) W3K_BARREL(N) W3K_TORCH(N) (two frames N, N+1) W3K_MEDKIT(N) W3K_AMMOBOX(N) W3K_KEYCARD(N,H)   sprites (index 0 is see-through)
160 ' CALL W3K_WALK                 one frame of walking: arrow keys / WASD / R F look / SHIFT run, or a game controller (left stick walk and strafe,
170 '                               right stick turn and look, LT run); applies W3D MOVE and W3D TURN scaled by the time since the last call
180 ' CALL W3K_JUMP(J)              a jump: J = -1 while the jump button is held (the height is W3D LIFT); call it each frame after W3K_WALK
190 ' CALL W3K_SHOW                 shows the layer that was drawn on and makes the other one the drawing layer (flicker free), then waits for the frame
200 ' CALL W3K_DONE                 the end of a program: all layers back as they were (GFX RESET), a clear screen
210 ' CALL W3K_HUDBAR(Y,H)          clears the strip Y .. Y+H-1 of the drawing layer to a dark color
220 LIBRARY "w3dkit","W3K_"
230 FUNC W3K_C(H,S)
240   RETURN 16+H*16+S
250 END FUNC
260 FUNC W3K_R(M)
270   RETURN INT(RND(1)*M)
280 END FUNC
290 PROC W3K_PALETTE
300   LOCAL L,H,S,R,G,B,F
310   FOR L=0 TO 3 STEP 3
320     RESTORE W3K_HUES
330     FOR H=0 TO 14
340       READ R,G,B
350       FOR S=0 TO 15
360         F=(0.06+0.94*S/15)^(1/W3K_GAMMA)
370         GFX PALETTE L,16+H*16+S,RGB(INT(R*F),INT(G*F),INT(B*F))
380       NEXT S
390     NEXT H
400   NEXT L
410 END PROC
420 LABEL W3K_HUES
430 DATA 255,255,255, 255,70,60, 255,150,40, 255,230,70, 160,230,60, 60,200,80, 50,200,170, 80,220,255
440 DATA 90,160,255, 70,80,240, 150,80,220, 230,80,200, 170,110,60, 225,200,150, 255,175,150
450 PROC W3K_SETUP
460   W3K_VX=0:W3K_VY=0:W3K_VW=640:W3K_VH=264:W3K_VS=2:W3K_B=0:W3K_T0=TI
470   W3K_INVX=0:W3K_INVY=0:W3K_TURN=100:W3K_GAMMA=1:W3K_FOV=90:W3K_VZ=0:W3K_JL=0:W3K_DT=0.016
480   GFX LAYER 0,OFF:GFX LAYER 3,OFF:GFX LAYER 1,OFF:GFX LAYER 2,OFF
490   GFX BACKDROP RGB(0,0,0)
500   CALL W3K_PALETTE
510   GFX TARGET 3
520   W3D RESET
530 END PROC
540 PROC W3K_SETPREFS(IX,IY,G,F,T)
550   W3K_INVX=IX:W3K_INVY=IY:W3K_GAMMA=G:W3K_FOV=F:W3K_TURN=T
560 END PROC
570 PROC W3K_RESETCLOCK
580   W3K_T0=TI
590 END PROC
600 PROC W3K_VIEW(X,Y,W,H,S)
610   W3K_VX=X:W3K_VY=Y:W3K_VW=W:W3K_VH=H:W3K_VS=S
620   W3D VIEW X,Y,W,H,S,W3K_FOV
630 END PROC
640 PROC W3K_REAPPLY
650   CALL W3K_PALETTE
660   W3D COLORMAP
670   W3D VIEW W3K_VX,W3K_VY,W3K_VW,W3K_VH,W3K_VS,W3K_FOV
680 END PROC
690 ' grabs the picture at 0,0 of the drawing layer as texture N
700 PROC W3K_GRAB(N,W,H)
710   LOCAL A$
720   GFX GRAB 0,0,W-1,H-1,A$
730   W3D TEXTURE N,A$
740 END PROC
750 PROC W3K_BRICK(N,H)
760   LOCAL R,B,X,S,I
770   GFX CLEAR FN W3K_C(0,3)
780   FOR R=0 TO 7
790     FOR B=-1 TO 4
800       X=B*16+(R AND 1)*8
810       S=7+FN W3K_R(4)
820       GFX LINE X+1,R*8+1,X+15,R*8+7,FN W3K_C(H,S),BF
830     NEXT B
840   NEXT R
850   FOR I=1 TO 160
860     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H,5+FN W3K_R(6))
870   NEXT I
880   CALL W3K_GRAB(N,64,64)
890 END PROC
900 PROC W3K_STONE(N,H)
910   LOCAL R,B,X,S,I
920   GFX CLEAR FN W3K_C(H,4)
930   FOR R=0 TO 3
940     FOR B=-1 TO 2
950       X=B*32+(R AND 1)*16
960       S=8+FN W3K_R(3)
970       GFX LINE X+1,R*16+1,X+31,R*16+15,FN W3K_C(H,S),BF
980       GFX LINE X+1,R*16+1,X+31,R*16+1,FN W3K_C(H,S+3)
990     NEXT B
1000   NEXT R
1010   FOR I=1 TO 300
1020     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H,5+FN W3K_R(7))
1030   NEXT I
1040   CALL W3K_GRAB(N,64,64)
1050 END PROC
1060 ' plaster with a wainscot: 64 x 128, the bottom 28 rows are paneled
1070 PROC W3K_PLASTER(N,H)
1080   LOCAL I,X
1090   GFX CLEAR FN W3K_C(H,11)
1100   FOR I=1 TO 220
1110     GFX PSET FN W3K_R(64),FN W3K_R(100),FN W3K_C(H,9+FN W3K_R(4))
1120   NEXT I
1130   GFX LINE 0,100,63,127,FN W3K_C(12,6),BF
1140   FOR X=0 TO 63 STEP 16
1150     GFX LINE X+2,104,X+13,124,FN W3K_C(12,8),BF
1160     GFX LINE X+2,104,X+13,104,FN W3K_C(12,10)
1170     GFX LINE X+2,124,X+13,124,FN W3K_C(12,4)
1180   NEXT X
1190   GFX LINE 0,97,63,99,FN W3K_C(12,10),BF
1200   GFX LINE 0,99,63,99,FN W3K_C(12,4)
1210   CALL W3K_GRAB(N,64,128)
1220 END PROC
1230 PROC W3K_METAL(N,H)
1240   LOCAL I,X,Y
1250   GFX CLEAR FN W3K_C(H,7)
1260   GFX LINE 0,0,63,63,FN W3K_C(H,11),B
1270   GFX LINE 1,1,62,62,FN W3K_C(H,5),B
1280   GFX LINE 0,31,63,31,FN W3K_C(H,4)
1290   GFX LINE 31,0,31,63,FN W3K_C(H,4)
1300   FOR X=6 TO 57 STEP 51
1310     FOR Y=6 TO 57 STEP 51
1320       GFX CIRCLE X,Y,2,FN W3K_C(H,12)
1330       GFX PSET X+1,Y+1,FN W3K_C(H,3)
1340     NEXT Y
1350   NEXT X
1360   FOR I=1 TO 140
1370     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H,5+FN W3K_R(5))
1380   NEXT I
1390   CALL W3K_GRAB(N,64,64)
1400 END PROC
1410 PROC W3K_CARPET(N,H)
1420   LOCAL I,X
1430   GFX CLEAR FN W3K_C(H,6)
1440   FOR X=0 TO 63 STEP 16
1450     GFX LINE X,0,X+16,16,FN W3K_C(H,9)
1460     GFX LINE X+16,0,X,16,FN W3K_C(H,9)
1470     GFX LINE X,16,X+16,32,FN W3K_C(H,9)
1480     GFX LINE X+16,16,X,32,FN W3K_C(H,9)
1490     GFX LINE X,32,X+16,48,FN W3K_C(H,9)
1500     GFX LINE X+16,32,X,48,FN W3K_C(H,9)
1510     GFX LINE X,48,X+16,64,FN W3K_C(H,9)
1520     GFX LINE X+16,48,X,64,FN W3K_C(H,9)
1530   NEXT X
1540   FOR I=1 TO 260
1550     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H,4+FN W3K_R(5))
1560   NEXT I
1570   CALL W3K_GRAB(N,64,64)
1580 END PROC
1590 PROC W3K_TILES(N,H1,H2)
1600   LOCAL X,Y,I
1610   GFX CLEAR FN W3K_C(0,5)
1620   FOR X=0 TO 3
1630     FOR Y=0 TO 3
1640       IF (X+Y) AND 1 THEN I=H1 ELSE I=H2
1650       GFX LINE X*16+1,Y*16+1,X*16+15,Y*16+15,FN W3K_C(I,10),BF
1660       GFX LINE X*16+1,Y*16+1,X*16+15,Y*16+1,FN W3K_C(I,13)
1670     NEXT Y
1680   NEXT X
1690   FOR I=1 TO 120
1700     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H1,8+FN W3K_R(4))
1710   NEXT I
1720   CALL W3K_GRAB(N,64,64)
1730 END PROC
1740 PROC W3K_PLANKS(N)
1750   LOCAL Y,I,X
1760   GFX CLEAR FN W3K_C(12,3)
1770   FOR Y=0 TO 7
1780     GFX LINE 0,Y*8+1,63,Y*8+7,FN W3K_C(12,6+FN W3K_R(4)),BF
1790     X=FN W3K_R(60)
1800     GFX LINE X,Y*8,X,Y*8+7,FN W3K_C(12,3)
1810   NEXT Y
1820   FOR I=1 TO 90
1830     X=FN W3K_R(64):Y=FN W3K_R(64)
1840     GFX LINE X,Y,X+3,Y,FN W3K_C(12,4+FN W3K_R(5))
1850   NEXT I
1860   CALL W3K_GRAB(N,64,64)
1870 END PROC
1880 PROC W3K_GRASS(N)
1890   LOCAL I,X,Y
1900   GFX CLEAR FN W3K_C(5,5)
1910   FOR I=1 TO 500
1920     X=FN W3K_R(64):Y=FN W3K_R(64)
1930     GFX LINE X,Y,X+FN W3K_R(3)-1,Y-1-FN W3K_R(3),FN W3K_C(4+FN W3K_R(2),3+FN W3K_R(8))
1940   NEXT I
1950   CALL W3K_GRAB(N,64,64)
1960 END PROC
1970 ' a door: 64 x 128, vertical boards, a frame and a handle
1980 PROC W3K_DOORTEX(N,H)
1990   LOCAL X,I
2000   GFX CLEAR FN W3K_C(H,4)
2010   FOR X=4 TO 56 STEP 8
2020     GFX LINE X,4,X+7,123,FN W3K_C(H,7+FN W3K_R(3)),BF
2030     GFX LINE X,4,X,123,FN W3K_C(H,4)
2040   NEXT X
2050   GFX LINE 0,0,63,127,FN W3K_C(0,6),B
2060   GFX LINE 1,1,62,126,FN W3K_C(0,11),B
2070   GFX LINE 4,20,59,26,FN W3K_C(H,10),BF
2080   GFX LINE 4,96,59,102,FN W3K_C(H,10),BF
2090   GFX CIRCLE 52,64,3,FN W3K_C(3,13)
2100   GFX PAINT 52,64,FN W3K_C(3,13),FN W3K_C(3,13)
2110   CALL W3K_GRAB(N,64,128)
2120 END PROC
2130 ' a window: 64 x 96, a wooden frame with a cross, the panes are see-through (index 0), with a few shining dots
2140 PROC W3K_WINDOW(N)
2150   LOCAL I
2160   GFX CLEAR 0
2170   GFX LINE 0,0,63,95,FN W3K_C(12,8),B
2180   GFX LINE 1,1,62,94,FN W3K_C(12,6),B
2190   GFX LINE 2,2,61,93,FN W3K_C(12,9),B
2200   GFX LINE 3,3,60,92,FN W3K_C(12,5),B
2210   GFX LINE 29,3,34,92,FN W3K_C(12,7),BF
2220   GFX LINE 3,44,60,49,FN W3K_C(12,7),BF
2230   FOR I=0 TO 3
2240     GFX LINE 8+I*2,12+I*2,12+I*2,16+I*2,FN W3K_C(7,14)
2250   NEXT I
2260   CALL W3K_GRAB(N,64,96)
2270 END PROC
2280 ' a grate: 64 x 64, bars with gaps
2290 PROC W3K_GRATE(N)
2300   LOCAL X
2310   GFX CLEAR 0
2320   FOR X=3 TO 60 STEP 8
2330     GFX LINE X,0,X+1,63,FN W3K_C(0,9),BF
2340     GFX LINE X,0,X,63,FN W3K_C(0,13)
2350   NEXT X
2360   GFX LINE 0,0,63,3,FN W3K_C(0,7),BF
2370   GFX LINE 0,60,63,63,FN W3K_C(0,7),BF
2380   GFX LINE 0,30,63,32,FN W3K_C(0,7),BF
2390   CALL W3K_GRAB(N,64,64)
2400 END PROC
2410 ' a sky: 256 x 64, the color gets lighter toward the bottom (the horizon), with clouds that wrap around the edge
2420 PROC W3K_SKY(N)
2430   LOCAL Y,I,X,CY,RX
2440   FOR Y=0 TO 63
2450     GFX LINE 0,Y,255,Y,FN W3K_C(8,6+Y\8),BF
2460   NEXT Y
2470   FOR I=1 TO 9
2480     X=FN W3K_R(256):CY=6+FN W3K_R(36):RX=10+FN W3K_R(14)
2490     GFX CIRCLE X,CY,RX,FN W3K_C(0,13),-1,-1,0.35
2500     GFX CIRCLE X-256,CY,RX,FN W3K_C(0,13),-1,-1,0.35
2510     GFX PAINT X,CY,FN W3K_C(0,15),FN W3K_C(0,13)
2520     GFX PAINT X-256,CY,FN W3K_C(0,15),FN W3K_C(0,13)
2530   NEXT I
2540   CALL W3K_GRAB(N,256,64)
2550 END PROC
2560 PROC W3K_PLANT(N)
2570   LOCAL I
2580   GFX CLEAR 0
2590   GFX LINE 9,36,22,47,FN W3K_C(12,7),BF
2600   GFX LINE 8,34,23,36,FN W3K_C(12,10),BF
2610   GFX LINE 15,20,16,34,FN W3K_C(5,5)
2620   FOR I=0 TO 6
2630     GFX CIRCLE 16+(I-3)*3,12+ABS(I-3)*3,6,FN W3K_C(5,6+I),-1,-1,0.6
2640     GFX PAINT 16+(I-3)*3,12+ABS(I-3)*3,FN W3K_C(5,6+I),FN W3K_C(5,6+I)
2650   NEXT I
2660   CALL W3K_GRAB(N,32,48)
2670 END PROC
2680 PROC W3K_LAMP(N)
2690   GFX CLEAR 0
2700   GFX LINE 11,18,12,52,FN W3K_C(0,8),BF
2710   GFX LINE 6,52,17,55,FN W3K_C(0,6),BF
2720   GFX LINE 5,8,18,18,FN W3K_C(3,13),BF
2730   GFX LINE 7,4,16,8,FN W3K_C(3,14),BF
2740   GFX LINE 5,18,18,18,FN W3K_C(3,8)
2750   CALL W3K_GRAB(N,24,56)
2760 END PROC
2770 PROC W3K_BARREL(N)
2780   GFX CLEAR 0
2790   GFX LINE 4,2,27,37,FN W3K_C(12,8),BF
2800   GFX LINE 3,8,28,31,FN W3K_C(12,9),BF
2810   GFX LINE 3,10,28,12,FN W3K_C(0,6),BF
2820   GFX LINE 3,26,28,28,FN W3K_C(0,6),BF
2830   GFX LINE 8,3,9,36,FN W3K_C(12,11)
2840   GFX LINE 22,3,23,36,FN W3K_C(12,5)
2850   CALL W3K_GRAB(N,32,40)
2860 END PROC
2870 PROC W3K_TORCH(N)
2880   LOCAL F
2890   FOR F=0 TO 1
2900     GFX CLEAR 0
2910     GFX LINE 7,16,9,31,FN W3K_C(12,7),BF
2920     GFX CIRCLE 8,9,4+F,FN W3K_C(2,12),-1,-1,1.4
2930     GFX PAINT 8,9,FN W3K_C(3,14),FN W3K_C(2,12)
2940     GFX PSET 8,6-F,FN W3K_C(3,15)
2950     CALL W3K_GRAB(N+F,16,32)
2960   NEXT F
2970 END PROC
2980 PROC W3K_MEDKIT(N)
2990   GFX CLEAR 0
3000   GFX LINE 1,1,18,13,FN W3K_C(0,14),BF
3010   GFX LINE 1,1,18,13,FN W3K_C(0,8),B
3020   GFX LINE 9,3,10,11,FN W3K_C(1,12),BF
3030   GFX LINE 6,6,13,8,FN W3K_C(1,12),BF
3040   CALL W3K_GRAB(N,20,14)
3050 END PROC
3060 PROC W3K_AMMOBOX(N)
3070   GFX CLEAR 0
3080   GFX LINE 1,1,18,11,FN W3K_C(3,10),BF
3090   GFX LINE 1,1,18,11,FN W3K_C(12,6),B
3100   GFX LINE 4,4,15,8,FN W3K_C(12,5),BF
3110   GFX LINE 6,5,7,7,FN W3K_C(3,15),BF
3120   GFX LINE 10,5,11,7,FN W3K_C(3,15),BF
3130   CALL W3K_GRAB(N,20,12)
3140 END PROC
3150 PROC W3K_KEYCARD(N,H)
3160   GFX CLEAR 0
3170   GFX LINE 1,1,12,12,FN W3K_C(H,11),BF
3180   GFX LINE 1,1,12,12,FN W3K_C(0,13),B
3190   GFX LINE 3,3,8,4,FN W3K_C(0,3),BF
3200   GFX LINE 3,8,10,9,FN W3K_C(0,3),BF
3210   CALL W3K_GRAB(N,14,14)
3220 END PROC
3230 ' reads the keys and the first game controller, moves and turns the player (W3D CAMERA must have been called once)
3240 PROC W3K_WALK
3250   LOCAL DT,F,S,T,L,V,SP
3260   DT=(TI-W3K_T0)/60
3270   W3K_T0=TI
3280   IF DT>0.1 THEN DT=0.1
3290   W3K_DT=DT
3300   F=0:S=0:T=0:L=0
3310   IF KEY("UP") OR KEY("W") THEN F=F+1
3320   IF KEY("DOWN") OR KEY("S") THEN F=F-1
3330   IF KEY("D") THEN S=S+1
3340   IF KEY("A") THEN S=S-1
3350   IF KEY("LEFT") THEN T=T+1
3360   IF KEY("RIGHT") THEN T=T-1
3370   IF KEY("R") OR KEY("PGUP") THEN L=L+1
3380   IF KEY("F") OR KEY("PGDN") THEN L=L-1
3390   F=F-JOY("LY"):S=S+JOY("LX")
3400   IF W3K_INVX THEN T=T+JOY("RX") ELSE T=T-JOY("RX")
3410   IF W3K_INVY THEN L=L+JOY("RY") ELSE L=L-JOY("RY")
3420   IF KEY("HOME") OR JOY("RS") THEN W3D TURN 0,-W3D("PITCH")
3430   SP=190
3440   IF KEY("SHIFT") OR JOY("LT")>0.4 THEN SP=300
3450   V=SQR(F*F+S*S)
3460   IF V>1 THEN F=F/V:S=S/V
3470   IF F<>0 OR S<>0 THEN W3D MOVE F*SP*DT,S*SP*DT
3480   IF T<>0 OR L<>0 THEN W3D TURN T*115*W3K_TURN/100*DT,L*60*DT
3490 END PROC
3500 ' a jump: call it every frame with -1 while the jump button is held (a new press jumps, if the feet are on the ground): the height above the floor goes
3510 ' up and down like a thrown stone (W3D LIFT), up to about 40 units; steps up to 24 + that height can be taken while it lasts (out of a pool)
3520 PROC W3K_JUMP(J)
3530   IF J<>0 AND W3K_JL=0 AND W3K_VZ=0 AND W3D("LIFT")<=0 THEN W3K_VZ=240
3540   W3K_JL=J
3550   IF W3K_VZ<>0 OR W3D("LIFT")>0 THEN
3560     W3K_VZ=W3K_VZ-720*W3K_DT
3570     W3K_H=W3D("LIFT")+W3K_VZ*W3K_DT
3580     IF W3K_H<=0 THEN
3590       W3K_H=0
3600       W3K_VZ=0
3610     END IF
3620     W3D LIFT W3K_H
3630   END IF
3640 END PROC
3650 PROC W3K_SHOW
3660   GFX LAYER W3K_B,OFF
3670   W3K_B=3-W3K_B
3680   GFX LAYER W3K_B,ON
3690   FRAME
3700   GFX TARGET 3-W3K_B
3710 END PROC
3720 PROC W3K_DONE
3730   GFX RESET
3740   CLS
3750 END PROC
3760 PROC W3K_HUDBAR(Y,H)
3770   GFX LINE 0,Y,639,Y+H-1,FN W3K_C(0,1),BF
3780   GFX LINE 0,Y,639,Y,FN W3K_C(0,6)
3790 END PROC
