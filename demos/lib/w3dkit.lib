1 ' License: free for everybody to use, copy, change and build into executables (BUILD).
2 ' An executable made with BUILD contains the Engine1999 runtime: the Engine1999 Runtime Exception
3 ' (file LICENSE-EXCEPTION of Engine1999) applies if the runtime is unmodified and its notice stays
4 ' in the executable (it shows with the command line option --engine1999-about).
10 ' w3dkit - helpers for programs that use the 3D sector renderer (W3D ...): a library, LOAD LIBRARY "w3dkit".
20 ' It sets up a palette of 15 hues with 16 shades each (palette entries 16..255; entries 1..15 stay as they are), draws textures and sprites
30 ' with GFX statements and hands them to W3D TEXTURE, and reads the keyboard and game controller for walking around.
40 ' The palette index of hue H (0..14) and shade S (0 dark .. 15 bright) is FN W3K_C(H,S). Hues: 0 gray, 1 red, 2 orange, 3 yellow, 4 lime, 5 green,
50 ' 6 teal, 7 cyan, 8 azure, 9 blue, 10 purple, 11 magenta, 12 brown, 13 sand, 14 pink.
60 ' User settings (the library prefs3d edits and stores them; a program without it gets the defaults):
70 '   W3K_INVX, W3K_INVY (0 / 1) turn the right stick's turning and looking around the other way, W3K_TURN (percent, 100) the turning speed,
80 '   W3K_GAMMA (1) brightens (above 1) or darkens (below 1) the palette's middle shades, W3K_FOV (90) the field of view in degrees.
90 '   CALL W3K_VIEW(X,Y,W,H,S) is W3D VIEW with the field of view W3K_FOV (use it instead of W3D VIEW); CALL W3K_REAPPLY makes the palette, the
100 '   color map and the view again after one of the settings changed.
110 ' (The name is not INIT on purpose: a library's PROC <prefix>INIT would run by itself when the program starts, before it can decide whether it has a screen.)
120 ' CALL W3K_SETUP                 palette on the graphics layers 0 and 3, the tile and text layers hidden (the graphics layers are the picture), drawing layer 3, W3D RESET
130 ' CALL W3K_BRICK(N,H) W3K_STONE(N,H) W3K_PLASTER(N,H) W3K_METAL(N,H) W3K_CARPET(N,H) W3K_TILES(N,H1,H2) W3K_PLANKS(N) W3K_GRASS(N) W3K_DOORTEX(N,H)
140 '   W3K_SKY(N) (256 x 64) make a texture N (64 x 64, plaster and doors 64 x 128); W3K_WINDOW(N) and W3K_GRATE(N) have see-through parts (for masked walls)
150 ' CALL W3K_PLANT(N) W3K_LAMP(N) W3K_BARREL(N) W3K_TORCH(N) (two frames N, N+1) W3K_MEDKIT(N) W3K_AMMOBOX(N) W3K_KEYCARD(N,H)   sprites (index 0 is see-through)
155 ' Each W3K_WALK also advances the world's clock (W3D TICK) by the time since the last call: movers, scrolling, animated textures and light effects run by themselves.
156 ' Mouse look: hold the right mouse button and drag (turns and looks up / down); W3K_MSENS = the speed in percent (100), -1 switches it off.
160 ' CALL W3K_WALK                 one frame of walking: arrow keys / WASD / R F look / SHIFT run, or a game controller (left stick walk and strafe,
170 '                               right stick turn and look, LT run); applies W3D MOVE and W3D TURN scaled by the time since the last call
180 ' CALL W3K_JUMP(J)              a jump: J = -1 while the jump button is held (the height is W3D LIFT); call it each frame after W3K_WALK
190 ' (W3K_SHOW also calls MU_TICK of the library music3d, which keeps the music of a game going in every screen that shows pictures.)
200 ' CALL W3K_SHOW                 shows the layer that was drawn on and makes the other one the drawing layer (flicker free), then waits for the frame
210 ' CALL W3K_DONE                 the end of a program: all layers back as they were (GFX RESET), a clear screen
220 ' CALL W3K_HUDBAR(Y,H)          clears the strip Y .. Y+H-1 of the drawing layer to a dark color
230 LIBRARY "w3dkit","W3K_"
240 LOAD LIBRARY "music3d"
250 FUNC W3K_C(H,S)
260   RETURN 16+H*16+S
270 END FUNC
280 FUNC W3K_R(M)
290   RETURN INT(RND(1)*M)
300 END FUNC
310 PROC W3K_PALETTE
320   LOCAL L,H,S,R,G,B,F
330   FOR L=0 TO 3 STEP 3
340     RESTORE W3K_HUES
350     FOR H=0 TO 14
360       READ R,G,B
370       FOR S=0 TO 15
380         F=(0.06+0.94*S/15)^(1/W3K_GAMMA)
390         GFX PALETTE L,16+H*16+S,RGB(INT(R*F),INT(G*F),INT(B*F))
400       NEXT S
410     NEXT H
420   NEXT L
430 END PROC
440 LABEL W3K_HUES
450 DATA 255,255,255, 255,70,60, 255,150,40, 255,230,70, 160,230,60, 60,200,80, 50,200,170, 80,220,255
460 DATA 90,160,255, 70,80,240, 150,80,220, 230,80,200, 170,110,60, 225,200,150, 255,175,150
470 PROC W3K_SETUP
480   W3K_VX=0:W3K_VY=0:W3K_VW=640:W3K_VH=264:W3K_VS=2:W3K_B=0:W3K_T0=TI
490   W3K_INVX=0:W3K_INVY=0:W3K_TURN=100:W3K_GAMMA=1:W3K_FOV=90:W3K_VZ=0:W3K_JL=0:W3K_DT=0.016
500   GFX LAYER 0,OFF:GFX LAYER 3,OFF:GFX LAYER 1,OFF:GFX LAYER 2,OFF
510   GFX BACKDROP RGB(0,0,0)
520   CALL W3K_PALETTE
530   GFX TARGET 3
540   W3D RESET
550 END PROC
560 PROC W3K_SETPREFS(IX,IY,G,F,T)
570   W3K_INVX=IX:W3K_INVY=IY:W3K_GAMMA=G:W3K_FOV=F:W3K_TURN=T
580 END PROC
590 PROC W3K_RESETCLOCK
600   W3K_T0=TI
610 END PROC
620 PROC W3K_VIEW(X,Y,W,H,S)
630   W3K_VX=X:W3K_VY=Y:W3K_VW=W:W3K_VH=H:W3K_VS=S
640   W3D VIEW X,Y,W,H,S,W3K_FOV
650 END PROC
660 PROC W3K_REAPPLY
670   CALL W3K_PALETTE
680   W3D COLORMAP
690   W3D VIEW W3K_VX,W3K_VY,W3K_VW,W3K_VH,W3K_VS,W3K_FOV
700 END PROC
710 ' grabs the picture at 0,0 of the drawing layer as texture N
720 PROC W3K_GRAB(N,W,H)
730   LOCAL A$
740   GFX GRAB 0,0,W-1,H-1,A$
750   W3D TEXTURE N,A$
760 END PROC
770 PROC W3K_BRICK(N,H)
780   LOCAL R,B,X,S,I
790   GFX CLEAR FN W3K_C(0,3)
800   FOR R=0 TO 7
810     FOR B=-1 TO 4
820       X=B*16+(R AND 1)*8
830       S=7+FN W3K_R(4)
840       GFX LINE X+1,R*8+1,X+15,R*8+7,FN W3K_C(H,S),BF
850     NEXT B
860   NEXT R
870   FOR I=1 TO 160
880     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H,5+FN W3K_R(6))
890   NEXT I
900   CALL W3K_GRAB(N,64,64)
910 END PROC
920 PROC W3K_STONE(N,H)
930   LOCAL R,B,X,S,I
940   GFX CLEAR FN W3K_C(H,4)
950   FOR R=0 TO 3
960     FOR B=-1 TO 2
970       X=B*32+(R AND 1)*16
980       S=8+FN W3K_R(3)
990       GFX LINE X+1,R*16+1,X+31,R*16+15,FN W3K_C(H,S),BF
1000       GFX LINE X+1,R*16+1,X+31,R*16+1,FN W3K_C(H,S+3)
1010     NEXT B
1020   NEXT R
1030   FOR I=1 TO 300
1040     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H,5+FN W3K_R(7))
1050   NEXT I
1060   CALL W3K_GRAB(N,64,64)
1070 END PROC
1080 ' plaster with a wainscot: 64 x 128, the bottom 28 rows are paneled
1090 PROC W3K_PLASTER(N,H)
1100   LOCAL I,X
1110   GFX CLEAR FN W3K_C(H,11)
1120   FOR I=1 TO 220
1130     GFX PSET FN W3K_R(64),FN W3K_R(100),FN W3K_C(H,9+FN W3K_R(4))
1140   NEXT I
1150   GFX LINE 0,100,63,127,FN W3K_C(12,6),BF
1160   FOR X=0 TO 63 STEP 16
1170     GFX LINE X+2,104,X+13,124,FN W3K_C(12,8),BF
1180     GFX LINE X+2,104,X+13,104,FN W3K_C(12,10)
1190     GFX LINE X+2,124,X+13,124,FN W3K_C(12,4)
1200   NEXT X
1210   GFX LINE 0,97,63,99,FN W3K_C(12,10),BF
1220   GFX LINE 0,99,63,99,FN W3K_C(12,4)
1230   CALL W3K_GRAB(N,64,128)
1240 END PROC
1250 PROC W3K_METAL(N,H)
1260   LOCAL I,X,Y
1270   GFX CLEAR FN W3K_C(H,7)
1280   GFX LINE 0,0,63,63,FN W3K_C(H,11),B
1290   GFX LINE 1,1,62,62,FN W3K_C(H,5),B
1300   GFX LINE 0,31,63,31,FN W3K_C(H,4)
1310   GFX LINE 31,0,31,63,FN W3K_C(H,4)
1320   FOR X=6 TO 57 STEP 51
1330     FOR Y=6 TO 57 STEP 51
1340       GFX CIRCLE X,Y,2,FN W3K_C(H,12)
1350       GFX PSET X+1,Y+1,FN W3K_C(H,3)
1360     NEXT Y
1370   NEXT X
1380   FOR I=1 TO 140
1390     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H,5+FN W3K_R(5))
1400   NEXT I
1410   CALL W3K_GRAB(N,64,64)
1420 END PROC
1430 PROC W3K_CARPET(N,H)
1440   LOCAL I,X
1450   GFX CLEAR FN W3K_C(H,6)
1460   FOR X=0 TO 63 STEP 16
1470     GFX LINE X,0,X+16,16,FN W3K_C(H,9)
1480     GFX LINE X+16,0,X,16,FN W3K_C(H,9)
1490     GFX LINE X,16,X+16,32,FN W3K_C(H,9)
1500     GFX LINE X+16,16,X,32,FN W3K_C(H,9)
1510     GFX LINE X,32,X+16,48,FN W3K_C(H,9)
1520     GFX LINE X+16,32,X,48,FN W3K_C(H,9)
1530     GFX LINE X,48,X+16,64,FN W3K_C(H,9)
1540     GFX LINE X+16,48,X,64,FN W3K_C(H,9)
1550   NEXT X
1560   FOR I=1 TO 260
1570     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H,4+FN W3K_R(5))
1580   NEXT I
1590   CALL W3K_GRAB(N,64,64)
1600 END PROC
1610 PROC W3K_TILES(N,H1,H2)
1620   LOCAL X,Y,I
1630   GFX CLEAR FN W3K_C(0,5)
1640   FOR X=0 TO 3
1650     FOR Y=0 TO 3
1660       IF (X+Y) AND 1 THEN I=H1 ELSE I=H2
1670       GFX LINE X*16+1,Y*16+1,X*16+15,Y*16+15,FN W3K_C(I,10),BF
1680       GFX LINE X*16+1,Y*16+1,X*16+15,Y*16+1,FN W3K_C(I,13)
1690     NEXT Y
1700   NEXT X
1710   FOR I=1 TO 120
1720     GFX PSET FN W3K_R(64),FN W3K_R(64),FN W3K_C(H1,8+FN W3K_R(4))
1730   NEXT I
1740   CALL W3K_GRAB(N,64,64)
1750 END PROC
1760 PROC W3K_PLANKS(N)
1770   LOCAL Y,I,X
1780   GFX CLEAR FN W3K_C(12,3)
1790   FOR Y=0 TO 7
1800     GFX LINE 0,Y*8+1,63,Y*8+7,FN W3K_C(12,6+FN W3K_R(4)),BF
1810     X=FN W3K_R(60)
1820     GFX LINE X,Y*8,X,Y*8+7,FN W3K_C(12,3)
1830   NEXT Y
1840   FOR I=1 TO 90
1850     X=FN W3K_R(64):Y=FN W3K_R(64)
1860     GFX LINE X,Y,X+3,Y,FN W3K_C(12,4+FN W3K_R(5))
1870   NEXT I
1880   CALL W3K_GRAB(N,64,64)
1890 END PROC
1900 PROC W3K_GRASS(N)
1910   LOCAL I,X,Y
1920   GFX CLEAR FN W3K_C(5,5)
1930   FOR I=1 TO 500
1940     X=FN W3K_R(64):Y=FN W3K_R(64)
1950     GFX LINE X,Y,X+FN W3K_R(3)-1,Y-1-FN W3K_R(3),FN W3K_C(4+FN W3K_R(2),3+FN W3K_R(8))
1960   NEXT I
1970   CALL W3K_GRAB(N,64,64)
1980 END PROC
1990 ' a door: 64 x 128, vertical boards, a frame and a handle
2000 PROC W3K_DOORTEX(N,H)
2010   LOCAL X,I
2020   GFX CLEAR FN W3K_C(H,4)
2030   FOR X=4 TO 56 STEP 8
2040     GFX LINE X,4,X+7,123,FN W3K_C(H,7+FN W3K_R(3)),BF
2050     GFX LINE X,4,X,123,FN W3K_C(H,4)
2060   NEXT X
2070   GFX LINE 0,0,63,127,FN W3K_C(0,6),B
2080   GFX LINE 1,1,62,126,FN W3K_C(0,11),B
2090   GFX LINE 4,20,59,26,FN W3K_C(H,10),BF
2100   GFX LINE 4,96,59,102,FN W3K_C(H,10),BF
2110   GFX CIRCLE 52,64,3,FN W3K_C(3,13)
2120   GFX PAINT 52,64,FN W3K_C(3,13),FN W3K_C(3,13)
2130   CALL W3K_GRAB(N,64,128)
2140 END PROC
2150 ' a window: 64 x 96, a wooden frame with a cross, the panes are see-through (index 0), with a few shining dots
2160 PROC W3K_WINDOW(N)
2170   LOCAL I
2180   GFX CLEAR 0
2190   GFX LINE 0,0,63,95,FN W3K_C(12,8),B
2200   GFX LINE 1,1,62,94,FN W3K_C(12,6),B
2210   GFX LINE 2,2,61,93,FN W3K_C(12,9),B
2220   GFX LINE 3,3,60,92,FN W3K_C(12,5),B
2230   GFX LINE 29,3,34,92,FN W3K_C(12,7),BF
2240   GFX LINE 3,44,60,49,FN W3K_C(12,7),BF
2250   FOR I=0 TO 3
2260     GFX LINE 8+I*2,12+I*2,12+I*2,16+I*2,FN W3K_C(7,14)
2270   NEXT I
2280   CALL W3K_GRAB(N,64,96)
2290 END PROC
2300 ' a grate: 64 x 64, bars with gaps
2310 PROC W3K_GRATE(N)
2320   LOCAL X
2330   GFX CLEAR 0
2340   FOR X=3 TO 60 STEP 8
2350     GFX LINE X,0,X+1,63,FN W3K_C(0,9),BF
2360     GFX LINE X,0,X,63,FN W3K_C(0,13)
2370   NEXT X
2380   GFX LINE 0,0,63,3,FN W3K_C(0,7),BF
2390   GFX LINE 0,60,63,63,FN W3K_C(0,7),BF
2400   GFX LINE 0,30,63,32,FN W3K_C(0,7),BF
2410   CALL W3K_GRAB(N,64,64)
2420 END PROC
2430 ' a sky: 256 x 64, the color gets lighter toward the bottom (the horizon), with clouds that wrap around the edge
2437 ' the sky picture (N, 256 x 64): a gradient and 9 clouds; the clouds stay below row 10, because the renderer stretches the top row when you look up (a cloud touching it would become a streak)
2440 PROC W3K_SKY(N)
2450   LOCAL Y,I,X,CY,RX
2460   FOR Y=0 TO 63
2470     GFX LINE 0,Y,255,Y,FN W3K_C(8,6+Y\8),BF
2480   NEXT Y
2490   FOR I=1 TO 9
2500     X=FN W3K_R(256):CY=18+FN W3K_R(30):RX=10+FN W3K_R(14)
2510     GFX CIRCLE X,CY,RX,FN W3K_C(0,13),-1,-1,0.35
2520     GFX CIRCLE X-256,CY,RX,FN W3K_C(0,13),-1,-1,0.35
2530     GFX PAINT X,CY,FN W3K_C(0,15),FN W3K_C(0,13)
2540     GFX PAINT X-256,CY,FN W3K_C(0,15),FN W3K_C(0,13)
2550   NEXT I
2560   CALL W3K_GRAB(N,256,64)
2570 END PROC
2580 PROC W3K_PLANT(N)
2590   LOCAL I
2600   GFX CLEAR 0
2610   GFX LINE 9,36,22,47,FN W3K_C(12,7),BF
2620   GFX LINE 8,34,23,36,FN W3K_C(12,10),BF
2630   GFX LINE 15,20,16,34,FN W3K_C(5,5)
2640   FOR I=0 TO 6
2650     GFX CIRCLE 16+(I-3)*3,12+ABS(I-3)*3,6,FN W3K_C(5,6+I),-1,-1,0.6
2660     GFX PAINT 16+(I-3)*3,12+ABS(I-3)*3,FN W3K_C(5,6+I),FN W3K_C(5,6+I)
2670   NEXT I
2680   CALL W3K_GRAB(N,32,48)
2690 END PROC
2700 PROC W3K_LAMP(N)
2710   GFX CLEAR 0
2720   GFX LINE 11,18,12,52,FN W3K_C(0,8),BF
2730   GFX LINE 6,52,17,55,FN W3K_C(0,6),BF
2740   GFX LINE 5,8,18,18,FN W3K_C(3,13),BF
2750   GFX LINE 7,4,16,8,FN W3K_C(3,14),BF
2760   GFX LINE 5,18,18,18,FN W3K_C(3,8)
2770   CALL W3K_GRAB(N,24,56)
2780 END PROC
2790 PROC W3K_BARREL(N)
2800   GFX CLEAR 0
2810   GFX LINE 4,2,27,37,FN W3K_C(12,8),BF
2820   GFX LINE 3,8,28,31,FN W3K_C(12,9),BF
2830   GFX LINE 3,10,28,12,FN W3K_C(0,6),BF
2840   GFX LINE 3,26,28,28,FN W3K_C(0,6),BF
2850   GFX LINE 8,3,9,36,FN W3K_C(12,11)
2860   GFX LINE 22,3,23,36,FN W3K_C(12,5)
2870   CALL W3K_GRAB(N,32,40)
2880 END PROC
2890 PROC W3K_TORCH(N)
2900   LOCAL F
2910   FOR F=0 TO 1
2920     GFX CLEAR 0
2930     GFX LINE 7,16,9,31,FN W3K_C(12,7),BF
2940     GFX CIRCLE 8,9,4+F,FN W3K_C(2,12),-1,-1,1.4
2950     GFX PAINT 8,9,FN W3K_C(3,14),FN W3K_C(2,12)
2960     GFX PSET 8,6-F,FN W3K_C(3,15)
2970     CALL W3K_GRAB(N+F,16,32)
2980   NEXT F
2990 END PROC
3000 PROC W3K_MEDKIT(N)
3010   GFX CLEAR 0
3020   GFX LINE 1,1,18,13,FN W3K_C(0,14),BF
3030   GFX LINE 1,1,18,13,FN W3K_C(0,8),B
3040   GFX LINE 9,3,10,11,FN W3K_C(1,12),BF
3050   GFX LINE 6,6,13,8,FN W3K_C(1,12),BF
3060   CALL W3K_GRAB(N,20,14)
3070 END PROC
3080 PROC W3K_AMMOBOX(N)
3090   GFX CLEAR 0
3100   GFX LINE 1,1,18,11,FN W3K_C(3,10),BF
3110   GFX LINE 1,1,18,11,FN W3K_C(12,6),B
3120   GFX LINE 4,4,15,8,FN W3K_C(12,5),BF
3130   GFX LINE 6,5,7,7,FN W3K_C(3,15),BF
3140   GFX LINE 10,5,11,7,FN W3K_C(3,15),BF
3150   CALL W3K_GRAB(N,20,12)
3160 END PROC
3170 PROC W3K_KEYCARD(N,H)
3180   GFX CLEAR 0
3190   GFX LINE 1,1,12,12,FN W3K_C(H,11),BF
3200   GFX LINE 1,1,12,12,FN W3K_C(0,13),B
3210   GFX LINE 3,3,8,4,FN W3K_C(0,3),BF
3220   GFX LINE 3,8,10,9,FN W3K_C(0,3),BF
3230   CALL W3K_GRAB(N,14,14)
3240 END PROC
3250 ' reads the keys and the first game controller, moves and turns the player (W3D CAMERA must have been called once)
3260 PROC W3K_WALK
3270   LOCAL DT,F,S,T,L,V,SP
3280   DT=(TI-W3K_T0)/60
3290   W3K_T0=TI
3300   IF DT>0.1 THEN DT=0.1
3310   W3K_DT=DT
3320   F=0:S=0:T=0:L=0
3330   IF KEY("UP") OR KEY("W") THEN F=F+1
3340   IF KEY("DOWN") OR KEY("S") THEN F=F-1
3350   IF KEY("D") THEN S=S+1
3360   IF KEY("A") THEN S=S-1
3370   IF KEY("LEFT") THEN T=T+1
3380   IF KEY("RIGHT") THEN T=T-1
3390   IF KEY("R") OR KEY("PGUP") THEN L=L+1
3400   IF KEY("F") OR KEY("PGDN") THEN L=L-1
3410   F=F-JOY("LY"):S=S+JOY("LX")
3420   IF W3K_INVX THEN T=T+JOY("RX") ELSE T=T-JOY("RX")
3430   IF W3K_INVY THEN L=L+JOY("RY") ELSE L=L-JOY("RY")
3440   IF KEY("HOME") OR JOY("RS") THEN W3D TURN 0,-W3D("PITCH")
3450   SP=190
3460   IF KEY("SHIFT") OR JOY("LT")>0.4 THEN SP=300
3470   V=SQR(F*F+S*S)
3480   IF V>1 THEN F=F/V:S=S/V
3490   IF F<>0 OR S<>0 THEN W3D MOVE F*SP*DT,S*SP*DT
3500   IF T<>0 OR L<>0 THEN W3D TURN T*115*W3K_TURN/100*DT,L*60*DT
3502   W3D TICK DT
3504   CALL W3K_MOUSELOOK
3510 END PROC
3520 ' a jump: call it every frame with -1 while the jump button is held (a new press jumps, if the feet are on the ground): the height above the floor goes
3530 ' up and down like a thrown stone (W3D LIFT), up to about 40 units; steps up to 24 + that height can be taken while it lasts (out of a pool)
3540 PROC W3K_JUMP(J)
3550   IF J<>0 AND W3K_JL=0 AND W3K_VZ=0 AND W3D("LIFT")<=0 THEN W3K_VZ=240
3560   W3K_JL=J
3570   IF W3K_VZ<>0 OR W3D("LIFT")>0 THEN
3580     W3K_VZ=W3K_VZ-720*W3K_DT
3590     W3K_H=W3D("LIFT")+W3K_VZ*W3K_DT
3600     IF W3K_H<=0 THEN
3610       W3K_H=0
3620       W3K_VZ=0
3630     END IF
3640     W3D LIFT W3K_H
3650   END IF
3660 END PROC
3670 PROC W3K_SHOW
3680   GFX LAYER W3K_B,OFF
3690   W3K_B=3-W3K_B
3700   GFX LAYER W3K_B,ON
3710   FRAME
3720   GFX TARGET 3-W3K_B
3730   CALL MU_TICK
3740 END PROC
3750 PROC W3K_DONE
3760   GFX RESET
3770   CLS
3780 END PROC
3790 PROC W3K_HUDBAR(Y,H)
3800   GFX LINE 0,Y,639,Y+H-1,FN W3K_C(0,1),BF
3810   GFX LINE 0,Y,639,Y,FN W3K_C(0,6)
3820 END PROC
3830 ' mouse look: while the right button is held, dragging the mouse turns and looks up / down (W3K_MSENS: percent of the default speed, 100; 0 = off)
3840 PROC W3K_MOUSELOOK
3850   LOCAL X,Y,B
3860   IF W3K_MSENS=0 AND W3K_MSET=0 THEN W3K_MSENS=100:W3K_MSET=-1
3870   IF W3K_MSENS<=0 THEN EXIT PROC
3880   B=MOUSE("B")
3890   X=MOUSE("X"):Y=MOUSE("Y")
3900   IF (B AND 2)<>0 THEN
3910     IF W3K_MB<>0 THEN W3D TURN -(X-W3K_MX)*0.25*W3K_MSENS/100,-(Y-W3K_MY)*0.2*W3K_MSENS/100
3920     W3K_MB=-1
3930   ELSE
3940     W3K_MB=0
3950   END IF
3960   W3K_MX=X:W3K_MY=Y
3970 END PROC
