1 ' License: free for everybody to use, copy, change and build into executables (BUILD).
2 ' An executable made with BUILD contains the Engine1999 runtime: the Engine1999 Runtime Exception
3 ' (file LICENSE-EXCEPTION of Engine1999) applies if the runtime is unmodified and its notice stays
4 ' in the executable (it shows with the command line option --engine1999-about).
10 ' music3d - the music of the 3D demo games (a library: LOAD LIBRARY "music3d", prefix MU_). Loops of music strings for PLAY on the music channels 1..4 (the sound effects
20 ' use 9..16), in moods that a game switches between; w3dkit's W3K_SHOW calls MU_TICK in every frame, so the loops are queued without a gap in all the screens of a game.
30 ' CALL MU_USE(S)       the set of tunes: 1 = Bug Hunt (A minor: a bunker), 2 = Deqq's House II (D minor: slow and mysterious)
40 ' CALL MU_MODE(M)      the mood changes to M (nothing happens if it is the same one, or while a one-shot mood still plays); M = 0 is silence
50 '                        1 title / intro (loops)    2 calm: a slow, ponderous tune (loops)     3 uneasy: the calm tune with a heartbeat (loops)
60 '                        4 danger: fast and driving (loops)    5 game over / caught: a short sting (once)    6 victory / the ending: a fanfare (once)
70 '                      After a one-shot mood the mood MU_AF follows (0 = silence; set it before: MU_AF=2). MU_MODE with the new mood starts it at once.
80 ' CALL MU_FORCE(M)     the same, but it also breaks off a one-shot mood (a new game, the title screen)
90 ' CALL MU_TOGGLE       the music on / off (MU_ON is -1 while it is on); MU_OFF silences it for good (until MU_FORCE / MU_MODE after MU_ON=-1)
100 ' CALL MU_TICK         once per frame (W3K_SHOW does it): queues the next loop of the tune shortly before the last one ends
110 ' The loop lengths are exact (the PLAY strings keep their tempo), the next loop is queued behind the current one, so there is no gap; after a long pause (nothing calls
120 ' MU_TICK) it starts again at once. In the console host the PLAY statements only check their strings (so a headless test finds a mistake in them).
130 LIBRARY "music3d","MU_"
140 PROC MU_PLAY
150   IF MU_SET=1 AND MU_CUR=1 THEN PLAY "T84 I4 V0.37 MN O2 L4 A A A A A A A A F F F F E E E E A A A A A A A A F F F F E E E E","T84 I6 V0.26 ML O3 L1 C C A G# C C A G#","T84 I5 V0.29 O4 L4 A2 C E B2 A G# A2 C F E2 G# B A2 C E D2 C B C2 A F E1"
160   IF MU_SET=1 AND MU_CUR=2 THEN PLAY "T66 I4 V0.62 MN O2 L1 A A F E A A F E","T66 I6 V0.18 ML O3 L1 C C A G# C C A G#","T66 I12 V0.11 MN O5 L8 R2 E4 R4 R4 C4 R2 R2 C4 R4 R4 B4 R2 R2 E4 R4 R4 C4 R2 R2 A4 R4 R4 G#4 R2"
170   IF MU_SET=1 AND MU_CUR=3 THEN PLAY "T66 I4 V0.62 MN O2 L1 A A F E A A F E","T66 I6 V0.18 ML O3 L1 C C A G# C C A G#","T66 I12 V0.11 MN O5 L8 R2 E4 R4 R4 C4 R2 R2 C4 R4 R4 B4 R2 R2 E4 R4 R4 C4 R2 R2 A4 R4 R4 G#4 R2","T66 I13 V0.16 ML O1 L16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16"
180   IF MU_SET=1 AND MU_CUR=4 THEN PLAY "T160 I4 V0.31 MN O2 L8 AAAAAAAA AAAAAAAA FFFFFFFF EEEEEEEE AAAAAAAA AAAAAAAA FFFFFFFF EEEEEEEE","T160 I7 V0.09 ML L16 O4 A O5 C E A O4 A O5 C E A O4 A O5 C E A O4 A O5 C E A O4 A O5 C E A O4 A O5 C E A O4 A O5 C E A O4 A O5 C E A O4 F A O5 C F O4 F A O5 C F O4 F A O5 C F O4 F A O5 C F O4 E G# B E O4 E G# B E O4 E G# B E O4 E G# B E O4 A O5 C E A O4 A O5 C E A O4 A O5 C E A O4 A O5 C E A O4 A O5 C E A O4 A O5 C E A O4 A O5 C E A O4 A O5 C E A O4 F A O5 C F O4 F A O5 C F O4 F A O5 C F O4 F A O5 C F O4 E G# B E O4 E G# B E O4 E G# B E O4 E G# B E","T160 I14 V0.19 ML O3 L8 R4 C R R4 C R R4 C R R4 C R R4 C R R4 C R R4 C R R4 C R R4 C R R4 C R R4 C R R4 C R R4 C R R4 C R R4 C R R4 C R","T160 I5 V0.27 O5 L8 A A C A E4 D4 C B A G# A4 R4 F F A F C4 B-4 E E G# E B4 G#4 A A C A E4 D4 C B A G# A4 E4 F F A F C4 B-4 E E G# E B4 R4"
190   IF MU_SET=1 AND MU_CUR=5 THEN PLAY "T60 I9 V0.38 O4 L2 A F E1 D1 R1","T60 I4 V0.62 O2 L1 A D E1 R1"
200   IF MU_SET=1 AND MU_CUR=6 THEN PLAY "T120 I10 V0.38 O4 L8 C E G O5 C4 O4 G E C4 R4 F A O5 C F4 C O4 A4 R4 G B O5 D G4 R4 C1","T120 I4 V0.62 O2 L2 C G F C G C1 R1"
210   IF MU_SET=2 AND MU_CUR=1 THEN PLAY "T54 I4 V0.44 MN O2 L2 D A D A B- F A E D A G D A E D D","T54 I6 V0.12 ML O3 L1 F F D C# F B- C# A","T54 I19 V0.38 O4 L4 A2 G F E2. R4 F2 D F E2 C#2 D F A2 G2 B- A C#2. E D1","T54 I12 V0.06 ML O5 L8 D F A F D F A F D F A F D F A F B- D F D B- D F D A C# E C# A C# E C# D F A F D F A F G B- D B- G B- D B- A C# E C# A C# E C# D F A F D F A F"
220   IF MU_SET=2 AND MU_CUR=2 THEN PLAY "T54 I4 V0.44 MN O2 L2 D A D A B- F A E D A G D A E D D","T54 I6 V0.12 ML O3 L1 F F D C# F B- C# A","T54 I19 V0.38 O4 L4 A2 G F E2. R4 F2 D F E2 C#2 D F A2 G2 B- A C#2. E D1"
230   IF MU_SET=2 AND MU_CUR=3 THEN PLAY "T54 I4 V0.44 MN O2 L2 D A D A B- F A E D A G D A E D D","T54 I6 V0.12 ML O3 L1 F F D C# F B- C# A","T54 I19 V0.38 O4 L4 A2 G F E2. R4 F2 D F E2 C#2 D F A2 G2 B- A C#2. E D1","T54 I13 V0.12 ML O1 L16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16 C16 R16"
240   IF MU_SET=2 AND MU_CUR=4 THEN PLAY "T150 I4 V0.31 MN O2 L8 DDDDDDDD DDDDDDDD B-B-B-B-B-B-B-B- AAAAAAAA DDDDDDDD DDDDDDDD B-B-B-B-B-B-B-B- AAAAAAAA","T150 I7 V0.09 ML L16 O4 D F A O5 D O4 D F A O5 D O4 D F A O5 D O4 D F A O5 D O4 D F A O5 D O4 D F A O5 D O4 D F A O5 D O4 D F A O5 D O4 B- O5 D F B- O4 B- O5 D F B- O4 B- O5 D F B- O4 B- O5 D F B- O4 A O5 C# E A O4 A O5 C# E A O4 A O5 C# E A O4 A O5 C# E A O4 D F A O5 D O4 D F A O5 D O4 D F A O5 D O4 D F A O5 D O4 D F A O5 D O4 D F A O5 D O4 D F A O5 D O4 D F A O5 D O4 B- O5 D F B- O4 B- O5 D F B- O4 B- O5 D F B- O4 B- O5 D F B- O4 A O5 C# E A O4 A O5 C# E A O4 A O5 C# E A O4 A O5 C# E A","T150 I14 V0.19 ML O3 L8 R4 C R R4 C R R4 C R R4 C R R4 C R R4 C R R4 C R R4 C R R4 C R R4 C R R4 C R R4 C R R4 C R R4 C R R4 C R R4 C R","T150 I5 V0.27 O5 L8 D D F D A4 G4 F E D C# D4 R4 D D F D B-4 A4 E E A E C#4 E4 D D F D A4 G4 F E D C# D4 A4 D D F D B-4 A4 E E A E C#4 R4"
250   IF MU_SET=2 AND MU_CUR=5 THEN PLAY "T100 I9 V0.34 O4 L4 E D C# O3 A2 R2 R4","T100 I4 V0.66 O2 L2 A A A R2"
260   IF MU_SET=2 AND MU_CUR=6 THEN PLAY "T72 I4 V0.46 MN O2 L2 D A A E G D D A G D A E D A D D","T72 I6 V0.14 ML O3 L1 F# C# B F# B C# F# A","T72 I10 V0.40 O4 L4 F#2 A B C#2 E2 G2 B A F#2. E G2 B2 A2 C#2 F#2 A2 D1"
270 END PROC
280 FUNC MU_LEN(M)
290   IF MU_SET=1 AND M=1 THEN RETURN 22.857
300   IF MU_SET=1 AND M=2 THEN RETURN 29.091
310   IF MU_SET=1 AND M=3 THEN RETURN 29.091
320   IF MU_SET=1 AND M=4 THEN RETURN 12.000
330   IF MU_SET=1 AND M=5 THEN RETURN 16.000
340   IF MU_SET=1 AND M=6 THEN RETURN 9.000
350   IF MU_SET=2 AND M=1 THEN RETURN 35.556
360   IF MU_SET=2 AND M=2 THEN RETURN 35.556
370   IF MU_SET=2 AND M=3 THEN RETURN 35.556
380   IF MU_SET=2 AND M=4 THEN RETURN 12.800
390   IF MU_SET=2 AND M=5 THEN RETURN 4.800
400   IF MU_SET=2 AND M=6 THEN RETURN 26.667
410   RETURN 10
420 END FUNC
430 PROC MU_INIT
440   MU_ON=-1:MU_CUR=0:MU_AF=0:MU_SET=1:MU_NEXT=0:MU_SEC=0
450 END PROC
460 PROC MU_USE(S)
470   MU_SET=S
480 END PROC
490 PROC MU_SILENCE
500   SOUND OFF 1
510   SOUND OFF 2
520   SOUND OFF 3
530   SOUND OFF 4
540 END PROC
550 ' starts the tune of the current mood now
560 PROC MU_START
570   CALL MU_SILENCE
580   IF NOT MU_ON OR MU_CUR=0 THEN EXIT PROC
590   CALL MU_PLAY
600   MU_SEC=FN MU_LEN(MU_CUR)
610   MU_NEXT=TI+INT(MU_SEC*60)
620 END PROC
630 PROC MU_FORCE(M)
640   MU_CUR=M
650   IF M<>5 AND M<>6 THEN MU_AF=0
660   CALL MU_START
670 END PROC
680 PROC MU_MODE(M)
690   IF M=MU_CUR THEN EXIT PROC
700   IF MU_CUR>=5 AND TI<MU_NEXT THEN EXIT PROC
710   MU_CUR=M
720   CALL MU_START
730 END PROC
740 PROC MU_OFF
750   MU_ON=0
760   CALL MU_SILENCE
770 END PROC
780 PROC MU_TOGGLE
790   IF MU_ON THEN
800     CALL MU_OFF
810   ELSE
820     MU_ON=-1
830     CALL MU_START
840   END IF
850 END PROC
860 PROC MU_TICK
870   IF NOT MU_ON OR MU_CUR=0 THEN EXIT PROC
880   IF MU_CUR>=5 THEN
890     IF TI>=MU_NEXT THEN
900       MU_CUR=MU_AF:MU_AF=0
910       IF MU_CUR>0 THEN CALL MU_START
920     END IF
930     EXIT PROC
940   END IF
950   IF TI>=MU_NEXT-40 THEN
960     IF TI>MU_NEXT+60 THEN
970       CALL MU_START
980     ELSE
990       CALL MU_PLAY
1000       MU_NEXT=MU_NEXT+INT(MU_SEC*60)
1010     END IF
1020   END IF
1030 END PROC
