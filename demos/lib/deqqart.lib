1 ' License: free for everybody to use, copy, change and build into executables (BUILD).
2 ' An executable made with BUILD contains the Engine1999 runtime: the Engine1999 Runtime Exception
3 ' (file LICENSE-EXCEPTION of Engine1999) applies if the runtime is unmodified and its notice stays
4 ' in the executable (it shows with the command line option --engine1999-about).
10 ' deqqart - the pictures of Deqq's House II (demos/deqq2.bas) and Deqq's House I (demos/deqq.bas) as DATA lines: a library, LOAD LIBRARY "deqqart".
20 ' CALL DA_SPRITES draws every sprite of the table ARTDATA with GFX statements (a tiny command language, see demos/levels/deqq2art.bas, which writes the table)
30 ' and hands it to W3D TEXTURE (W3K_GRAB), so the texture numbers are those of the table (40.. for things, 90.. for plants and lamps).
35 ' CALL DA_FACADE makes textures 27 (a house front, 128 x 300: roof, belt courses, two floors of bricks) and 28 (the same with a door, 64 x 300),
36 ' CALL DA_FENCEBACK texture 29 (128 x 300: a brick fence, a line of trees and a night sky above it, the backdrop behind garden fences).
40 ' It needs the palette of w3dkit (hue H, shade S = FN W3K_C(H,S)) and the layer that W3K_SETUP selected as the drawing layer.
50 LIBRARY "deqqart","DA_"
60 LOAD LIBRARY "w3dkit"
100 ' the front of the house: a roof of tiles (the top 44 rows), an upper floor and a ground floor of gray bricks with windows (W wide, 300 high: the wall is 300 high)
110 PROC DA_FACADEBG(W)
120   LOCAL R,B,X,S,I
130   GFX CLEAR FN W3K_C(0,3)
140   FOR R=0 TO 31
150     FOR B=-1 TO W\16
160       X=B*16+(R AND 1)*8
170       S=7+FN W3K_R(4)
180       GFX LINE X+1,48+R*8+1,X+15,48+R*8+7,FN W3K_C(0,S),BF
190     NEXT B
200   NEXT R
210   FOR I=1 TO 140
220     GFX PSET FN W3K_R(W),48+FN W3K_R(252),FN W3K_C(0,5+FN W3K_R(6))
230   NEXT I
240   FOR R=0 TO 5
250     FOR B=-1 TO W\12
260       X=B*12+(R AND 1)*6
270       GFX LINE X+1,R*8+1,X+11,R*8+7,FN W3K_C(1,4+FN W3K_R(3)),BF
280       GFX LINE X+1,R*8+1,X+11,R*8+1,FN W3K_C(1,8)
290     NEXT B
300   NEXT R
310   GFX LINE 0,44,W-1,47,FN W3K_C(12,4),BF
320   GFX LINE 0,44,W-1,44,FN W3K_C(12,8)
330   GFX LINE 0,187,W-1,190,FN W3K_C(0,12),BF
340   GFX LINE 0,75,W-1,78,FN W3K_C(0,12),BF
350   GFX LINE 0,291,W-1,299,FN W3K_C(0,5),BF
360 END PROC
370 PROC DA_FACADE
380   CALL DA_FACADEBG(128)
390   CALL W3K_GRAB(27,128,300)
400   CALL DA_FACADEBG(64)
410   GFX LINE 6,184,57,299,FN W3K_C(12,6),BF
420   GFX LINE 10,188,53,299,FN W3K_C(12,8),BF
430   GFX LINE 31,188,32,299,FN W3K_C(12,5),BF
440   GFX LINE 10,214,53,218,FN W3K_C(12,11),BF
450   GFX LINE 10,260,53,264,FN W3K_C(12,11),BF
460   GFX CIRCLE 46,244,3,FN W3K_C(3,13)
470   GFX PAINT 46,244,FN W3K_C(3,13),FN W3K_C(3,13)
480   CALL W3K_GRAB(28,64,300)
490 END PROC
500 ' the backdrop behind every garden fence (128 x 300): a brick fence 100 high, above it a night sky and a dark tree line, so nobody can look out of the world
510 PROC DA_FENCEBACK
520   LOCAL X,Y,T,R,B
530   FOR Y=0 TO 199
540     GFX LINE 0,Y,127,Y,FN W3K_C(9,1+Y\40),BF
550   NEXT Y
560   FOR X=1 TO 28
570     GFX PSET FN W3K_R(128),FN W3K_R(110),FN W3K_C(0,10+FN W3K_R(5))
580   NEXT X
590   FOR X=0 TO 127
600     T=118+ABS((X MOD 16)-8)*3+ABS((X MOD 64)-32)\2+ABS((X MOD 128)-64)\4
610     GFX LINE X,T,X,199,FN W3K_C(5,2+((X*7) MOD 3)),BF
620     GFX LINE X,T+30,X,199,FN W3K_C(5,1),BF
630   NEXT X
640   GFX LINE 0,200,127,299,FN W3K_C(0,3),BF
650   FOR R=0 TO 11
660     FOR B=-1 TO 8
670       X=B*16+(R AND 1)*8
680       GFX LINE X+1,200+R*8+1,X+15,200+R*8+7,FN W3K_C(0,7+FN W3K_R(4)),BF
690     NEXT B
700   NEXT R
710   GFX LINE 0,200,127,203,FN W3K_C(0,12),BF
720   GFX LINE 0,291,127,299,FN W3K_C(0,5),BF
730   CALL W3K_GRAB(29,128,300)
740 END PROC
750 ' the sprites: DATA n,w,h then commands t,a,b,c,d,hue,shade (see demos/levels/deqq2art.bas) up to a 0; the table ends with -1
760 PROC DA_SPRITES
770   LOCAL N,W,H,T,A,B,C,D,HU,SH,K
780   RESTORE ARTDATA
790   READ N
800   WHILE N>=0
810     READ W,H
820     GFX CLEAR 0
830     READ T
840     WHILE T>0
850       READ A,B,C,D,HU,SH
860       K=FN W3K_C(HU,SH)
870       IF T=1 THEN GFX LINE A,B,C,D,K,BF
880       IF T=2 THEN GFX LINE A,B,C,D,K,B
890       IF T=3 THEN GFX LINE A,B,C,D,K
900       IF T=4 THEN
910         GFX CIRCLE A,B,C,K,-1,-1,D/10
920         GFX PAINT A,B,K,K
930       END IF
940       IF T=5 THEN GFX PSET A,B,K
950       READ T
960     WEND
970     CALL W3K_GRAB(N,W,H)
980     READ N
990   WEND
1000   GFX CLEAR 0
1010   CALL W3K_GRAB(99,4,4)
1020 END PROC
