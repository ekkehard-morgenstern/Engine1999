1120 ' ------------------------------------------------------------------------------------------------ the level
1130 PROC LOADLEVEL
1140   LOCAL NS,I,S,F,C,FT,CT,L,TG,NW,J,X1,Y1,X2,Y2,T,NX,FL,UP,LO,XO,YO
1150   RESTORE LEVELDATA
1160   READ NS
1170   FOR I=1 TO NS
1180     READ S,F,C,FT,CT,L,TG,NW
1190     W3D SECTOR S,F,C,FT,CT,L
1200     W3D TAG S,TG
1210     FOR J=0 TO NW-1
1220       READ X1,Y1,X2,Y2,T,NX,FL,UP,LO,XO,YO
1230       W3D WALL S,X1,Y1,X2,Y2,T,NX
1240       IF UP>=0 OR LO>=0 THEN W3D WALLTEX S,J,-1,UP,LO
1250       IF FL<>0 THEN W3D WALLFLAG S,J,FL
1260     NEXT J
1270   NEXT I
1280 END PROC
1290 ' things: 0..39 the bugs, 40..55 globs, 60..119 pick-ups, 120.. decoration
1300 PROC PLACE
1310   LOCAL T,X,Y,K
1320   FOR K=0 TO 55
1330     W3D THINGOFF K
1340   NEXT K
1350   RESTORE BUGDATA
1360   NM=0
1370   READ T
1380   WHILE T>0
1390     READ X,Y
1400     MT(NM)=T:MS(NM)=0:MC(NM)=30+FN RI(40):ML(NM)=0:MA(NM)=0
1410     IF T=1 THEN
1420       MH(NM)=40
1430       W3D THING NM,X,Y,40,48,44
1440     ELSE
1450       MH(NM)=20
1460       W3D THING NM,X,Y,43,34,34
1470       W3D THINGZ NM,12
1480     END IF
1490     NM=NM+1
1500     READ T
1510   WEND
1520   RESTORE ITEMDATA
1530   NP=0
1540   READ T
1550   WHILE T>0
1560     READ X,Y
1570     PK(NP)=T:PA(NP)=-1:PT(NP)=60+NP
1580     W3D THING PT(NP),X,Y,21+T,18,16
1590     NP=NP+1
1600     READ T
1610   WEND
1620   RESTORE DECORDATA
1630   K=120
1640   READ T
1650   WHILE T>0
1660     READ X,Y,PW,PH
1670     W3D THING K,X,Y,T,PW,PH
1680     K=K+1
1690     READ T
1700   WEND
1710   FOR K=0 TO 15
1720     QA(K)=0
1730   NEXT K
1740 END PROC
1750 ' ------------------------------------------------------------------------------------------------ the player
1760 PROC MSG(T$)
1770   MSG$=T$:MSGT=150
1780 END PROC
1790 PROC HURT(N)
1800   IF DEAD THEN EXIT PROC
1810   HEALTH=HEALTH-N
1820   HURTT=8
1830   SFX 4
1840   IF HEALTH<=0 THEN
1850     HEALTH=0:DEAD=-1:SFX 3
1860     MU_AF=0
1870     CALL MU_FORCE(5)
1880   END IF
1890 END PROC
1900 PROC WAKE(I)
1910   IF MS(I)=0 THEN MS(I)=1
1920 END PROC
1930 PROC FIRE
1940   LOCAL T
1950   IF AMMO<=0 THEN
1960     CALL MSG("OUT OF AMMO")
1970     EXIT PROC
1980   END IF
1990   AMMO=AMMO-1:FLASH=4
2000   SFX 1
2010   T=W3D("SHOOT",1500)
2020   IF T>=0 AND T<NM THEN
2030     IF MS(T)<2 THEN
2040       MH(T)=MH(T)-20
2050       CALL WAKE(T)
2060       IF MH(T)<=0 THEN
2070         MS(T)=2:KILLS=KILLS+1
2080         IF MT(T)=1 THEN
2090           W3D THING T,W3D("TX",T),W3D("TY",T),42,48,10
2100         ELSE
2110           W3D THING T,W3D("TX",T),W3D("TY",T),45,34,12
2120           W3D THINGZ T,0
2130         END IF
2140         W3D THINGLIGHT T,-1
2150         SFX 3
2160       ELSE
2170         ML(T)=3
2180         W3D THINGLIGHT T,255
2190         SFX 2
2200       END IF
2210     END IF
2220   END IF
2230 END PROC
2240 PROC PICKUPS
2250   LOCAL I,D
2260   FOR I=0 TO NP-1
2270     IF PA(I) THEN
2280       IF W3D("DIST",PT(I))<26 THEN
2290         D=0
2300         IF PK(I)=1 THEN
2310           IF HEALTH<100 THEN HEALTH=MIN(100,HEALTH+25):D=-1:CALL MSG("MEDKIT +25")
2320         END IF
2330         IF PK(I)=2 THEN AMMO=AMMO+15:D=-1:CALL MSG("AMMO +15")
2340         IF PK(I)=3 THEN KEYS=KEYS OR 1:D=-1:CALL MSG("YOU HAVE THE RED KEY")
2350         IF PK(I)=4 THEN KEYS=KEYS OR 2:D=-1:CALL MSG("YOU HAVE THE BLUE KEY")
2360         IF D THEN
2370           PA(I)=0:W3D THINGOFF PT(I):SFX 5
2380         END IF
2390       END IF
2400     END IF
2410   NEXT I
2420 END PROC
2430 ' ------------------------------------------------------------------------------------------------ doors and the lift
2440 PROC USEKEY
2450   LOCAL S
2460   S=W3D("USE",70)
2470   IF S<0 THEN EXIT PROC
2480   IF S=4 THEN
2490     IF KEYS AND 1 THEN
2500       DOP(1)=-1:SFX 6
2510     ELSE
2520       CALL MSG("THIS DOOR NEEDS THE RED KEY")
2530     END IF
2540   END IF
2550   IF S=10 THEN
2560     IF KEYS AND 2 THEN
2570       DOP(2)=-1:SFX 6
2580     ELSE
2590       CALL MSG("THIS DOOR NEEDS THE BLUE KEY")
2600     END IF
2610   END IF
2620 END PROC
2630 PROC DOORS
2640   LOCAL I,G,B
2650   FOR I=1 TO 2
2660     IF I=1 THEN B=0 ELSE B=96
2670     IF DOP(I) THEN G=B+100 ELSE G=B
2680     IF DCUR(I)<G THEN DCUR(I)=MIN(G,DCUR(I)+3)
2690     W3D HEIGHT DSEC(I),B,DCUR(I)
2700   NEXT I
2710   ' the lift: it carries you up (or down again) when you have stood on it for a moment
2720   IF W3D("SECTOR")=8 THEN
2730     LWAIT=LWAIT+1
2740     IF LWAIT=40 THEN
2750       IF LTGT=0 THEN LTGT=96 ELSE LTGT=0
2760       SFX 8
2770     END IF
2780   ELSE
2790     LWAIT=0
2800   END IF
2810   IF LPOS<LTGT THEN LPOS=MIN(LTGT,LPOS+1.2)
2820   IF LPOS>LTGT THEN LPOS=MAX(LTGT,LPOS-1.2)
2830   W3D HEIGHT 8,LPOS,200
2840 END PROC
2850 ' ------------------------------------------------------------------------------------------------ the bugs
2860 PROC SPIT(I)
2870   LOCAL K,X,Y,D,DX,DY
2880   FOR K=0 TO 15
2890     IF QA(K)=0 THEN
2900       X=W3D("TX",I):Y=W3D("TY",I)
2910       DX=PX-X:DY=PY-Y:D=SQR(DX*DX+DY*DY)
2920       IF D<1 THEN EXIT PROC
2930       QA(K)=-1:QX(K)=DX/D*170:QY(K)=DY/D*170:QL(K)=300
2940       W3D THING 40+K,X,Y,46,14,14
2950       W3D THINGZ 40+K,22
2960       W3D THINGLIGHT 40+K,255
2970       SFX 7
2980       EXIT PROC
2990     END IF
3000   NEXT K
3010 END PROC
3020 PROC BUGS(DT)
3030   LOCAL I,D,DX,DY,SP,F
3040   DANGER=0
3050   FOR I=0 TO NM-1
3060     IF MS(I)<2 THEN
3070       IF ML(I)>0 THEN
3080         ML(I)=ML(I)-1
3090         IF ML(I)=0 THEN W3D THINGLIGHT I,-1
3100       END IF
3110       D=W3D("DIST",I)
3120       IF MS(I)=0 THEN
3130         IF D<420 THEN
3140           IF W3D("SEES",I) THEN MS(I)=1
3150         END IF
3160       ELSE
3170         DX=PX-W3D("TX",I):DY=PY-W3D("TY",I)
3180         IF D<520 THEN DANGER=-1
3190         IF D>1 THEN DX=DX/D:DY=DY/D
3200         F=((FR\8)+I) AND 1
3210         IF MT(I)=1 THEN
3220           W3D THINGTEX I,40+F
3230           IF D>34 THEN
3240             W3D THINGMOVE I,DX*85*DT,DY*85*DT
3250             IF (W3D("HIT") AND 1) AND D>60 THEN W3D THINGMOVE I,-DY*60*DT*(1-2*(I AND 1)),DX*60*DT*(1-2*(I AND 1))
3260           END IF
3270           MC(I)=MC(I)-1
3280           IF D<46 AND MC(I)<=0 THEN
3290             CALL HURT(6+FN RI(5)):MC(I)=36
3300           END IF
3310         ELSE
3320           W3D THINGTEX I,43+F
3330           IF D>240 THEN W3D THINGMOVE I,DX*60*DT,DY*60*DT
3340           IF D<150 THEN W3D THINGMOVE I,-DX*50*DT,-DY*50*DT
3350           W3D THINGMOVE I,-DY*35*DT*(1-2*(I AND 1)),DX*35*DT*(1-2*(I AND 1))
3360           MC(I)=MC(I)-1
3370           IF MC(I)<=0 THEN
3380             IF D<650 THEN
3390               IF W3D("SEES",I) THEN CALL SPIT(I)
3400             END IF
3410             MC(I)=70+FN RI(60)
3420           END IF
3430         END IF
3440       END IF
3450     END IF
3460   NEXT I
3470 END PROC
3480 PROC GLOBS(DT)
3490   LOCAL K,X,Y,D
3500   FOR K=0 TO 15
3510     IF QA(K) THEN
3520       DANGER=-1
3530       W3D THINGMOVE 40+K,QX(K)*DT,QY(K)*DT
3540       QL(K)=QL(K)-1
3550       X=W3D("TX",40+K):Y=W3D("TY",40+K)
3560       D=SQR((X-PX)^2+(Y-PY)^2)
3570       IF D<20 THEN
3580         CALL HURT(9)
3590         QA(K)=0:W3D THINGOFF 40+K
3600       ELSE
3610         IF (W3D("HIT") AND 3) OR QL(K)<=0 THEN
3620           QA(K)=0:W3D THINGOFF 40+K
3630         END IF
3640       END IF
3650     END IF
3660   NEXT K
3670 END PROC
3680 ' ------------------------------------------------------------------------------------------------ the screen
3690 PROC GUN
3700   LOCAL X,Y
3710   X=320:Y=264
3720   IF HURTT>0 THEN
3730     GFX LINE 0,0,639,5,FN CI(1,12),BF
3740     GFX LINE 0,258,639,263,FN CI(1,12),BF
3750     GFX LINE 0,0,5,263,FN CI(1,12),BF
3760     GFX LINE 634,0,639,263,FN CI(1,12),BF
3770   END IF
3780   IF FLASH>0 THEN
3790     GFX CIRCLE X,Y-66,14,FN CI(3,13)
3800     GFX PAINT X,Y-66,FN CI(3,15),FN CI(3,13)
3810     GFX CIRCLE X,Y-66,6,FN CI(0,15)
3820     GFX PAINT X,Y-66,FN CI(0,15),FN CI(0,15)
3830   END IF
3840   GFX LINE X-26,Y-30,X+26,Y,FN CI(0,5),BF
3850   GFX LINE X-26,Y-30,X+26,Y-28,FN CI(0,11),BF
3860   GFX LINE X-8,Y-58,X+8,Y-30,FN CI(0,8),BF
3870   GFX LINE X-8,Y-58,X-5,Y-30,FN CI(0,12),BF
3880   GFX LINE X-12,Y-62,X+12,Y-56,FN CI(0,10),BF
3890   GFX LINE X-14,Y-20,X+14,Y-12,FN CI(7,9),BF
3900   GFX LINE X-2,Y-130,X+2,Y-126,FN CI(1,13),BF
3910 END PROC
3920 PROC HUD
3930   LOCAL I,C
3940   CALL W3K_HUDBAR(264,36)
3950   GFX TEXT 8,268,"HEALTH",FN CI(0,11)
3960   GFX LINE 8,282,108,293,FN CI(0,3),BF
3970   IF HEALTH>0 THEN
3980     IF HEALTH>40 THEN C=FN CI(5,12) ELSE C=FN CI(1,13)
3990     GFX LINE 8,282,8+HEALTH-1,293,C,BF
4000   END IF
4010   GFX LINE 8,282,108,293,FN CI(0,9),B
4020   GFX TEXT 130,268,"AMMO",FN CI(0,11)
4030   GFX TEXT 130,282,STR$(AMMO),FN CI(3,14),2,1
4040   GFX TEXT 210,268,"KEYS",FN CI(0,11)
4050   IF KEYS AND 1 THEN GFX LINE 210,282,226,293,FN CI(1,13),BF
4060   IF KEYS AND 2 THEN GFX LINE 232,282,248,293,FN CI(9,13),BF
4070   GFX TEXT 290,268,"BUGS",FN CI(0,11)
4080   GFX TEXT 290,282,STR$(KILLS)+"/"+STR$(NM),FN CI(4,13)
4090   IF MSGT>0 THEN
4100     GFX TEXT 380,276,MSG$,FN CI(3,15)
4110     MSGT=MSGT-1
4120   END IF
4130 END PROC
4140 PROC CTEXT(Y,T$,C)
4150   GFX TEXT (640-8*LEN(T$))\2,Y,T$,C
4160 END PROC
4170 ' the music: danger (a bug that has noticed you is near, a glob flies) is a fast tune that goes on for five seconds, else a slow one
4180 PROC MUSICMOOD
4190   LOCAL W
4200   IF DANGER THEN MUT=TI+300
4210   IF TI<MUT THEN W=4 ELSE W=2
4220   CALL MU_MODE(W)
4230 END PROC
4240 PROC BIGMSG(Y,T$,C)
4250   CALL BIGTEXT(Y,T$,C,3)
4260 END PROC
4270 PROC WAITKEY
4280   LOCAL K$
4290   CALL IN_WAITRELEASE
4300   K$=INKEY$
4310   WHILE K$<>""
4320     K$=INKEY$
4330   WEND
4340   REPEAT
4350     FRAME
4360     CALL MU_TICK
4370     K$=INKEY$
4380     IF FN IN_ANYA(0) OR FN IN_ANYSTART(0) THEN K$=" "
4390     IF FN IN_ANYBACK(0) THEN K$="Q"
4400   UNTIL K$<>""
4410   IF K$="Q" OR K$="q" OR K$=CHR$(27) THEN IN_QUIT=1
4420 END PROC
4430 PROC TITLE
4440   LOCAL I
4450   CALL MU_FORCE(1)
4460   FOR I=0 TO 1
4470     GFX CLEAR FN CI(0,1)
4480     GFX LINE 60,40,579,250,FN CI(4,3),B
4490     CALL BIGTEXT(60,"BUG HUNT",FN CI(4,14),5)
4500     CALL CTEXT(130,"GIANT ROBOT BUGS HAVE TAKEN THE BUNKER.",FN CI(0,13))
4510     CALL CTEXT(148,"TAKE THE RED KEY, THE LIFT AND THE BLUE KEY AND GET OUT.",FN CI(0,11))
4520     CALL CTEXT(176,"WASD/ARROWS WALK   SPACE/CTRL FIRE   E OPEN DOORS   SHIFT RUN",FN CI(3,13))
4530     CALL CTEXT(192,"PAD: STICKS WALK AND TURN   A/RT FIRE   X OPEN DOORS",FN CI(3,13))
4540     CALL CTEXT(208,"O (PAD: Y) OPENS THE 3D SETTINGS: INVERT AXES, GAMMA, FIELD OF VIEW",FN CI(0,10))
4550     CALL CTEXT(238,"M TURNS THE MUSIC ON AND OFF",FN CI(0,8))
4560     CALL CTEXT(226,"PRESS FIRE TO START",FN CI(1,13))
4570     CALL W3K_SHOW
4580   NEXT I
4590   CALL WAITKEY
4600 END PROC
4610 PROC NEWGAME
4620   CALL PLACE
4630   HEALTH=100:AMMO=40:KEYS=0:KILLS=0:DEAD=0:FLASH=0:HURTT=0:MSGT=0:FR=0:LWAIT=0
4640   DOP(1)=0:DOP(2)=0:DCUR(1)=0:DCUR(2)=96
4650   W3D HEIGHT 4,0,0
4660   W3D HEIGHT 10,96,96
4670   LPOS=0:LTGT=0
4680   W3D HEIGHT 8,0,200
4690   W3D CAMERA 128,60,90,0,0
4700   GT0=TI
4710 END PROC
4720 PROC PLAYLEVEL
4730   LOCAL DT,F,U,UL,FL,Y,YL
4740   CALL NEWGAME
4750   CALL MU_FORCE(2)
4760   MUT=0
4770   UL=0:FL=0:YL=0
4780   WON=0
4790   REPEAT
4800     DT=(TI-GT0)/60:GT0=TI
4810     IF DT>0.1 THEN DT=0.1
4820     IF NOT DEAD THEN
4830       CALL W3K_WALK
4840       F=KEY("SPACE") OR KEY("CTRL") OR JOY("A") OR JOY("RT")>0.5
4850       IF F<>0 AND FL=0 THEN CALL FIRE
4860       IF F<>0 AND FL<>0 THEN
4870         FC=FC+1
4880         IF FC>=14 THEN CALL FIRE:FC=0
4890       ELSE
4900         FC=0
4910       END IF
4920       FL=F
4930       U=KEY("E") OR KEY("RETURN") OR JOY("X")
4940       IF U<>0 AND UL=0 THEN CALL USEKEY
4950       UL=U
4960       IF KEY("ESC") THEN IN_QUIT=1
4970     END IF
4980     PX=W3D("X"):PY=W3D("Y")
4990     CALL DOORS
5000     CALL BUGS(DT)
5010     CALL GLOBS(DT)
5020     IF NOT DEAD THEN CALL MUSICMOOD
5030     CALL PICKUPS
5040     IF W3D("TAG",W3D("SECTOR"))=99 THEN WON=-1
5050     W3D RENDER
5060     CALL GUN
5070     CALL HUD
5080     IF FLASH>0 THEN FLASH=FLASH-1
5090     IF HURTT>0 THEN HURTT=HURTT-1
5100     IF DEAD THEN
5110       CALL BIGMSG(100,"YOU WERE EATEN",FN CI(1,14))
