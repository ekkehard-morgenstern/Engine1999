280 PROC SPLAT(N,H)
290   GFX CIRCLE 16,12,8,FN CI(H,9),-1,-1,0.4
300   GFX PAINT 16,12,FN CI(H,9),FN CI(H,9)
310 END PROC
320 PROC MAKECRAWLER
330   LOCAL F,I
340   FOR F=0 TO 1
350     GFX CLEAR 0
360     FOR I=0 TO 2
370       GFX LINE 11+I*7,22,7+I*8+F*4,38,FN CI(4,5)
380       GFX LINE 12+I*7,22,17+I*8-F*4,38,FN CI(4,5)
390       GFX LINE 7+I*8+F*4,38,4+I*8+F*4,39,FN CI(4,4)
400     NEXT I
410     GFX CIRCLE 20,22,15,FN CI(4,9),-1,-1,0.7
420     GFX PAINT 20,22,FN CI(4,9),FN CI(4,9)
430     GFX CIRCLE 20,16,9,FN CI(4,12),-1,-1,0.5
440     GFX PAINT 20,16,FN CI(4,12),FN CI(4,12)
450     GFX CIRCLE 34,18,6,FN CI(4,11)
460     GFX PAINT 34,18,FN CI(4,11),FN CI(4,11)
470     GFX LINE 38,17,39,19,FN CI(1,13),BF
480     GFX LINE 36,23,39,26,FN CI(0,12)
490     GFX LINE 33,24,36,28,FN CI(0,12)
500     CALL W3K_GRAB(40+F,40,40)
510   NEXT F
520   GFX CLEAR 0
530   GFX CIRCLE 20,32,16,FN CI(4,5),-1,-1,0.25
540   GFX PAINT 20,32,FN CI(4,5),FN CI(4,5)
550   FOR I=0 TO 5
560     GFX LINE 8+I*5,30,6+I*5,24,FN CI(4,4)
570   NEXT I
580   GFX CIRCLE 20,31,8,FN CI(3,10),-1,-1,0.3
590   CALL W3K_GRAB(42,40,40)
600 END PROC
610 PROC MAKESPITTER
620   LOCAL F
630   FOR F=0 TO 1
640     GFX CLEAR 0
650     GFX LINE 14,14,2,2+F*14,FN CI(7,11)
660     GFX LINE 14,14,26,2+F*14,FN CI(7,11)
670     GFX LINE 14,15,3,5+F*12,FN CI(7,13)
680     GFX LINE 14,15,25,5+F*12,FN CI(7,13)
690     GFX CIRCLE 14,18,7,FN CI(2,11),-1,-1,1.2
700     GFX PAINT 14,18,FN CI(2,11),FN CI(2,11)
710     GFX CIRCLE 14,10,5,FN CI(2,13)
720     GFX PAINT 14,10,FN CI(2,13),FN CI(2,13)
730     GFX PSET 12,9,FN CI(1,13)
740     GFX PSET 16,9,FN CI(1,13)
750     GFX LINE 13,27,14,31,FN CI(3,12)
760     GFX LINE 11,19,17,19,FN CI(2,6)
770     CALL W3K_GRAB(43+F,28,32)
780   NEXT F
790   GFX CLEAR 0
800   GFX LINE 6,18,22,26,FN CI(2,6),BF
810   GFX CIRCLE 14,22,7,FN CI(2,8),-1,-1,0.4
820   GFX LINE 2,14,12,22,FN CI(7,6)
830   GFX LINE 26,14,16,22,FN CI(7,6)
840   CALL W3K_GRAB(45,28,32)
850   GFX CLEAR 0
860   GFX CIRCLE 6,6,5,FN CI(4,10)
870   GFX PAINT 6,6,FN CI(3,15),FN CI(4,10)
880   CALL W3K_GRAB(46,12,12)
890 END PROC
