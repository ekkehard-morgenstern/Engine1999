290 PROC SPLAT(N,H)
300   GFX CIRCLE 16,12,8,FN CI(H,9),-1,-1,0.4
310   GFX PAINT 16,12,FN CI(H,9),FN CI(H,9)
320 END PROC
330 PROC MAKECRAWLER
340   LOCAL F,I
350   FOR F=0 TO 1
360     GFX CLEAR 0
370     FOR I=0 TO 2
380       GFX LINE 11+I*7,22,7+I*8+F*4,38,FN CI(4,5)
390       GFX LINE 12+I*7,22,17+I*8-F*4,38,FN CI(4,5)
400       GFX LINE 7+I*8+F*4,38,4+I*8+F*4,39,FN CI(4,4)
410     NEXT I
420     GFX CIRCLE 20,22,15,FN CI(4,9),-1,-1,0.7
430     GFX PAINT 20,22,FN CI(4,9),FN CI(4,9)
440     GFX CIRCLE 20,16,9,FN CI(4,12),-1,-1,0.5
450     GFX PAINT 20,16,FN CI(4,12),FN CI(4,12)
460     GFX CIRCLE 34,18,6,FN CI(4,11)
470     GFX PAINT 34,18,FN CI(4,11),FN CI(4,11)
480     GFX LINE 38,17,39,19,FN CI(1,13),BF
490     GFX LINE 36,23,39,26,FN CI(0,12)
500     GFX LINE 33,24,36,28,FN CI(0,12)
510     CALL W3K_GRAB(40+F,40,40)
520   NEXT F
530   GFX CLEAR 0
540   GFX CIRCLE 20,32,16,FN CI(4,5),-1,-1,0.25
550   GFX PAINT 20,32,FN CI(4,5),FN CI(4,5)
560   FOR I=0 TO 5
570     GFX LINE 8+I*5,30,6+I*5,24,FN CI(4,4)
580   NEXT I
590   GFX CIRCLE 20,31,8,FN CI(3,10),-1,-1,0.3
600   CALL W3K_GRAB(42,40,40)
610 END PROC
620 PROC MAKESPITTER
630   LOCAL F
640   FOR F=0 TO 1
650     GFX CLEAR 0
660     GFX LINE 14,14,2,2+F*14,FN CI(7,11)
670     GFX LINE 14,14,26,2+F*14,FN CI(7,11)
680     GFX LINE 14,15,3,5+F*12,FN CI(7,13)
690     GFX LINE 14,15,25,5+F*12,FN CI(7,13)
700     GFX CIRCLE 14,18,7,FN CI(2,11),-1,-1,1.2
710     GFX PAINT 14,18,FN CI(2,11),FN CI(2,11)
720     GFX CIRCLE 14,10,5,FN CI(2,13)
730     GFX PAINT 14,10,FN CI(2,13),FN CI(2,13)
740     GFX PSET 12,9,FN CI(1,13)
750     GFX PSET 16,9,FN CI(1,13)
760     GFX LINE 13,27,14,31,FN CI(3,12)
770     GFX LINE 11,19,17,19,FN CI(2,6)
780     CALL W3K_GRAB(43+F,28,32)
790   NEXT F
800   GFX CLEAR 0
810   GFX LINE 6,18,22,26,FN CI(2,6),BF
820   GFX CIRCLE 14,22,7,FN CI(2,8),-1,-1,0.4
830   GFX LINE 2,14,12,22,FN CI(7,6)
840   GFX LINE 26,14,16,22,FN CI(7,6)
850   CALL W3K_GRAB(45,28,32)
860   GFX CLEAR 0
870   GFX CIRCLE 6,6,5,FN CI(4,10)
880   GFX PAINT 6,6,FN CI(3,15),FN CI(4,10)
890   CALL W3K_GRAB(46,12,12)
900 END PROC
