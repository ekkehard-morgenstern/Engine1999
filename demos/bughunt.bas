1110 ' ------------------------------------------------------------------------------------------------ the level
1120 PROC LOADLEVEL
1130   LOCAL NS,I,S,F,C,FT,CT,L,TG,NW,J,X1,Y1,X2,Y2,T,NX,FL,UP,LO,XO,YO
1140   RESTORE LEVELDATA
1150   READ NS
1160   FOR I=1 TO NS
1170     READ S,F,C,FT,CT,L,TG,NW
1180     W3D SECTOR S,F,C,FT,CT,L
1190     W3D TAG S,TG
1200     FOR J=0 TO NW-1
1210       READ X1,Y1,X2,Y2,T,NX,FL,UP,LO,XO,YO
1220       W3D WALL S,X1,Y1,X2,Y2,T,NX
1230       IF UP>=0 OR LO>=0 THEN W3D WALLTEX S,J,-1,UP,LO
1240       IF FL<>0 THEN W3D WALLFLAG S,J,FL
1250     NEXT J
1260   NEXT I
1270 END PROC
1280 ' things: 0..39 the bugs, 40..55 globs, 60..119 pick-ups, 120.. decoration
1290 PROC PLACE
1300   LOCAL T,X,Y,K
1310   FOR K=0 TO 55
1320     W3D THINGOFF K
1330   NEXT K
1340   RESTORE BUGDATA
1350   NM=0
1360   READ T
1370   WHILE T>0
1380     READ X,Y
1390     MT(NM)=T:MS(NM)=0:MC(NM)=30+FN RI(40):ML(NM)=0:MA(NM)=0
1400     IF T=1 THEN
1410       MH(NM)=40
1420       W3D THING NM,X,Y,40,48,44
1430     ELSE
1440       MH(NM)=20
1450       W3D THING NM,X,Y,43,34,34
1460       W3D THINGZ NM,12
1470     END IF
1480     NM=NM+1
1490     READ T
1500   WEND
1510   RESTORE ITEMDATA
1520   NP=0
1530   READ T
1540   WHILE T>0
1550     READ X,Y
1560     PK(NP)=T:PA(NP)=-1:PT(NP)=60+NP
1570     W3D THING PT(NP),X,Y,21+T,18,16
1580     NP=NP+1
1590     READ T
1600   WEND
1610   RESTORE DECORDATA
1620   K=120
1630   READ T
1640   WHILE T>0
1650     READ X,Y,PW,PH
1660     W3D THING K,X,Y,T,PW,PH
1670     K=K+1
1680     READ T
1690   WEND
1700   FOR K=0 TO 15
1710     QA(K)=0
1720   NEXT K
1730 END PROC
1740 ' ------------------------------------------------------------------------------------------------ the player
1750 PROC MSG(T$)
1760   MSG$=T$:MSGT=150
1770 END PROC
1780 PROC HURT(N)
1790   IF DEAD THEN EXIT PROC
1800   HEALTH=HEALTH-N
1810   HURTT=8
1820   SFX 4
1830   IF HEALTH<=0 THEN
1840     HEALTH=0:DEAD=-1:SFX 3
1850   END IF
1860 END PROC
1870 PROC WAKE(I)
1880   IF MS(I)=0 THEN MS(I)=1
1890 END PROC
1900 PROC FIRE
1910   LOCAL T
1920   IF AMMO<=0 THEN
1930     CALL MSG("OUT OF AMMO")
1940     EXIT PROC
1950   END IF
1960   AMMO=AMMO-1:FLASH=4
1970   SFX 1
1980   T=W3D("SHOOT",1500)
1990   IF T>=0 AND T<NM THEN
2000     IF MS(T)<2 THEN
2010       MH(T)=MH(T)-20
2020       CALL WAKE(T)
2030       IF MH(T)<=0 THEN
2040         MS(T)=2:KILLS=KILLS+1
2050         IF MT(T)=1 THEN
2060           W3D THING T,W3D("TX",T),W3D("TY",T),42,48,10
2070         ELSE
2080           W3D THING T,W3D("TX",T),W3D("TY",T),45,34,12
2090           W3D THINGZ T,0
2100         END IF
2110         W3D THINGLIGHT T,-1
2120         SFX 3
2130       ELSE
2140         ML(T)=3
2150         W3D THINGLIGHT T,255
2160         SFX 2
2170       END IF
2180     END IF
2190   END IF
2200 END PROC
2210 PROC PICKUPS
2220   LOCAL I,D
2230   FOR I=0 TO NP-1
2240     IF PA(I) THEN
2250       IF W3D("DIST",PT(I))<26 THEN
2260         D=0
2270         IF PK(I)=1 THEN
2280           IF HEALTH<100 THEN HEALTH=MIN(100,HEALTH+25):D=-1:CALL MSG("MEDKIT +25")
2290         END IF
2300         IF PK(I)=2 THEN AMMO=AMMO+15:D=-1:CALL MSG("AMMO +15")
2310         IF PK(I)=3 THEN KEYS=KEYS OR 1:D=-1:CALL MSG("YOU HAVE THE RED KEY")
2320         IF PK(I)=4 THEN KEYS=KEYS OR 2:D=-1:CALL MSG("YOU HAVE THE BLUE KEY")
2330         IF D THEN
2340           PA(I)=0:W3D THINGOFF PT(I):SFX 5
2350         END IF
2360       END IF
2370     END IF
2380   NEXT I
2390 END PROC
2400 ' ------------------------------------------------------------------------------------------------ doors and the lift
2410 PROC USEKEY
2420   LOCAL S
2430   S=W3D("USE",70)
2440   IF S<0 THEN EXIT PROC
2450   IF S=4 THEN
2460     IF KEYS AND 1 THEN
2470       DOP(1)=-1:SFX 6
2480     ELSE
2490       CALL MSG("THIS DOOR NEEDS THE RED KEY")
2500     END IF
2510   END IF
2520   IF S=10 THEN
2530     IF KEYS AND 2 THEN
2540       DOP(2)=-1:SFX 6
2550     ELSE
2560       CALL MSG("THIS DOOR NEEDS THE BLUE KEY")
2570     END IF
2580   END IF
2590 END PROC
2600 PROC DOORS
2610   LOCAL I,G,B
2620   FOR I=1 TO 2
2630     IF I=1 THEN B=0 ELSE B=96
2640     IF DOP(I) THEN G=B+100 ELSE G=B
2650     IF DCUR(I)<G THEN DCUR(I)=MIN(G,DCUR(I)+3)
2660     W3D HEIGHT DSEC(I),B,DCUR(I)
2670   NEXT I
2680   ' the lift: it carries you up (or down again) when you have stood on it for a moment
2690   IF W3D("SECTOR")=8 THEN
2700     LWAIT=LWAIT+1
2710     IF LWAIT=40 THEN
2720       IF LTGT=0 THEN LTGT=96 ELSE LTGT=0
2730       SFX 8
2740     END IF
2750   ELSE
2760     LWAIT=0
2770   END IF
2780   IF LPOS<LTGT THEN LPOS=MIN(LTGT,LPOS+1.2)
2790   IF LPOS>LTGT THEN LPOS=MAX(LTGT,LPOS-1.2)
2800   W3D HEIGHT 8,LPOS,200
2810 END PROC
2820 ' ------------------------------------------------------------------------------------------------ the bugs
2830 PROC SPIT(I)
2840   LOCAL K,X,Y,D,DX,DY
2850   FOR K=0 TO 15
2860     IF QA(K)=0 THEN
2870       X=W3D("TX",I):Y=W3D("TY",I)
2880       DX=PX-X:DY=PY-Y:D=SQR(DX*DX+DY*DY)
2890       IF D<1 THEN EXIT PROC
2900       QA(K)=-1:QX(K)=DX/D*170:QY(K)=DY/D*170:QL(K)=300
2910       W3D THING 40+K,X,Y,46,14,14
2920       W3D THINGZ 40+K,22
2930       W3D THINGLIGHT 40+K,255
2940       SFX 7
2950       EXIT PROC
2960     END IF
2970   NEXT K
2980 END PROC
2990 PROC BUGS(DT)
3000   LOCAL I,D,DX,DY,SP,F
3010   FOR I=0 TO NM-1
3020     IF MS(I)<2 THEN
3030       IF ML(I)>0 THEN
3040         ML(I)=ML(I)-1
3050         IF ML(I)=0 THEN W3D THINGLIGHT I,-1
3060       END IF
3070       D=W3D("DIST",I)
3080       IF MS(I)=0 THEN
3090         IF D<420 THEN
3100           IF W3D("SEES",I) THEN MS(I)=1
3110         END IF
3120       ELSE
3130         DX=PX-W3D("TX",I):DY=PY-W3D("TY",I)
3140         IF D>1 THEN DX=DX/D:DY=DY/D
3150         F=((FR\8)+I) AND 1
3160         IF MT(I)=1 THEN
3170           W3D THINGTEX I,40+F
3180           IF D>34 THEN
3190             W3D THINGMOVE I,DX*85*DT,DY*85*DT
3200             IF (W3D("HIT") AND 1) AND D>60 THEN W3D THINGMOVE I,-DY*60*DT*(1-2*(I AND 1)),DX*60*DT*(1-2*(I AND 1))
3210           END IF
3220           MC(I)=MC(I)-1
3230           IF D<46 AND MC(I)<=0 THEN
3240             CALL HURT(6+FN RI(5)):MC(I)=36
3250           END IF
3260         ELSE
3270           W3D THINGTEX I,43+F
3280           IF D>240 THEN W3D THINGMOVE I,DX*60*DT,DY*60*DT
3290           IF D<150 THEN W3D THINGMOVE I,-DX*50*DT,-DY*50*DT
3300           W3D THINGMOVE I,-DY*35*DT*(1-2*(I AND 1)),DX*35*DT*(1-2*(I AND 1))
3310           MC(I)=MC(I)-1
3320           IF MC(I)<=0 THEN
3330             IF D<650 THEN
3340               IF W3D("SEES",I) THEN CALL SPIT(I)
3350             END IF
3360             MC(I)=70+FN RI(60)
3370           END IF
3380         END IF
3390       END IF
3400     END IF
3410   NEXT I
3420 END PROC
3430 PROC GLOBS(DT)
3440   LOCAL K,X,Y,D
3450   FOR K=0 TO 15
3460     IF QA(K) THEN
3470       W3D THINGMOVE 40+K,QX(K)*DT,QY(K)*DT
3480       QL(K)=QL(K)-1
3490       X=W3D("TX",40+K):Y=W3D("TY",40+K)
3500       D=SQR((X-PX)^2+(Y-PY)^2)
3510       IF D<20 THEN
3520         CALL HURT(9)
3530         QA(K)=0:W3D THINGOFF 40+K
3540       ELSE
3550         IF (W3D("HIT") AND 3) OR QL(K)<=0 THEN
3560           QA(K)=0:W3D THINGOFF 40+K
3570         END IF
3580       END IF
3590     END IF
3600   NEXT K
3610 END PROC
3620 ' ------------------------------------------------------------------------------------------------ the screen
3630 PROC GUN
3640   LOCAL X,Y
3650   X=320:Y=264
3660   IF HURTT>0 THEN
3670     GFX LINE 0,0,639,5,FN CI(1,12),BF
3680     GFX LINE 0,258,639,263,FN CI(1,12),BF
3690     GFX LINE 0,0,5,263,FN CI(1,12),BF
3700     GFX LINE 634,0,639,263,FN CI(1,12),BF
3710   END IF
3720   IF FLASH>0 THEN
3730     GFX CIRCLE X,Y-66,14,FN CI(3,13)
3740     GFX PAINT X,Y-66,FN CI(3,15),FN CI(3,13)
3750     GFX CIRCLE X,Y-66,6,FN CI(0,15)
3760     GFX PAINT X,Y-66,FN CI(0,15),FN CI(0,15)
3770   END IF
3780   GFX LINE X-26,Y-30,X+26,Y,FN CI(0,5),BF
3790   GFX LINE X-26,Y-30,X+26,Y-28,FN CI(0,11),BF
3800   GFX LINE X-8,Y-58,X+8,Y-30,FN CI(0,8),BF
3810   GFX LINE X-8,Y-58,X-5,Y-30,FN CI(0,12),BF
3820   GFX LINE X-12,Y-62,X+12,Y-56,FN CI(0,10),BF
3830   GFX LINE X-14,Y-20,X+14,Y-12,FN CI(7,9),BF
3840   GFX LINE X-2,Y-130,X+2,Y-126,FN CI(1,13),BF
3850 END PROC
3860 PROC HUD
3870   LOCAL I,C
3880   CALL W3K_HUDBAR(264,36)
3890   GFX TEXT 8,268,"HEALTH",FN CI(0,11)
3900   GFX LINE 8,282,108,293,FN CI(0,3),BF
3910   IF HEALTH>0 THEN
3920     IF HEALTH>40 THEN C=FN CI(5,12) ELSE C=FN CI(1,13)
3930     GFX LINE 8,282,8+HEALTH-1,293,C,BF
3940   END IF
3950   GFX LINE 8,282,108,293,FN CI(0,9),B
3960   GFX TEXT 130,268,"AMMO",FN CI(0,11)
3970   GFX TEXT 130,282,STR$(AMMO),FN CI(3,14),2,1
3980   GFX TEXT 210,268,"KEYS",FN CI(0,11)
3990   IF KEYS AND 1 THEN GFX LINE 210,282,226,293,FN CI(1,13),BF
4000   IF KEYS AND 2 THEN GFX LINE 232,282,248,293,FN CI(9,13),BF
4010   GFX TEXT 290,268,"BUGS",FN CI(0,11)
4020   GFX TEXT 290,282,STR$(KILLS)+"/"+STR$(NM),FN CI(4,13)
4030   IF MSGT>0 THEN
4040     GFX TEXT 380,276,MSG$,FN CI(3,15)
4050     MSGT=MSGT-1
4060   END IF
4070 END PROC
4080 PROC CTEXT(Y,T$,C)
4090   GFX TEXT (640-8*LEN(T$))\2,Y,T$,C
4100 END PROC
4110 PROC BIGMSG(Y,T$,C)
4120   CALL BIGTEXT(Y,T$,C,3)
4130 END PROC
4140 PROC WAITKEY
4150   LOCAL K$
4160   CALL IN_WAITRELEASE
4170   K$=INKEY$
4180   WHILE K$<>""
4190     K$=INKEY$
4200   WEND
4210   REPEAT
4220     FRAME
4230     K$=INKEY$
4240     IF FN IN_ANYA(0) OR FN IN_ANYSTART(0) THEN K$=" "
4250     IF FN IN_ANYBACK(0) THEN K$="Q"
4260   UNTIL K$<>""
4270   IF K$="Q" OR K$="q" OR K$=CHR$(27) THEN IN_QUIT=1
4280 END PROC
4290 PROC TITLE
4300   LOCAL I
4310   FOR I=0 TO 1
4320     GFX CLEAR FN CI(0,1)
4330     GFX LINE 60,40,579,250,FN CI(4,3),B
4340     CALL BIGTEXT(60,"BUG HUNT",FN CI(4,14),5)
4350     CALL CTEXT(130,"GIANT ROBOT BUGS HAVE TAKEN THE BUNKER.",FN CI(0,13))
4360     CALL CTEXT(148,"TAKE THE RED KEY, THE LIFT AND THE BLUE KEY AND GET OUT.",FN CI(0,11))
4370     CALL CTEXT(176,"WASD/ARROWS WALK   SPACE/CTRL FIRE   E OPEN DOORS   SHIFT RUN",FN CI(3,13))
4380     CALL CTEXT(192,"PAD: STICKS WALK AND TURN   A/RT FIRE   X OPEN DOORS",FN CI(3,13))
4390     CALL CTEXT(208,"O (PAD: Y) OPENS THE 3D SETTINGS: INVERT AXES, GAMMA, FIELD OF VIEW",FN CI(0,10))
4400     CALL CTEXT(226,"PRESS FIRE TO START",FN CI(1,13))
4410     CALL W3K_SHOW
4420   NEXT I
4430   CALL WAITKEY
4440 END PROC
4450 PROC NEWGAME
4460   CALL PLACE
4470   HEALTH=100:AMMO=40:KEYS=0:KILLS=0:DEAD=0:FLASH=0:HURTT=0:MSGT=0:FR=0:LWAIT=0
4480   DOP(1)=0:DOP(2)=0:DCUR(1)=0:DCUR(2)=96
4490   W3D HEIGHT 4,0,0
4500   W3D HEIGHT 10,96,96
4510   LPOS=0:LTGT=0
4520   W3D HEIGHT 8,0,200
4530   W3D CAMERA 128,60,90,0,0
4540   GT0=TI
4550 END PROC
4560 PROC PLAYLEVEL
4570   LOCAL DT,F,U,UL,FL,Y,YL
4580   CALL NEWGAME
4590   UL=0:FL=0:YL=0
4600   WON=0
4610   REPEAT
4620     DT=(TI-GT0)/60:GT0=TI
4630     IF DT>0.1 THEN DT=0.1
4640     IF NOT DEAD THEN
4650       CALL W3K_WALK
4660       F=KEY("SPACE") OR KEY("CTRL") OR JOY("A") OR JOY("RT")>0.5
4670       IF F<>0 AND FL=0 THEN CALL FIRE
4680       IF F<>0 AND FL<>0 THEN
4690         FC=FC+1
4700         IF FC>=14 THEN CALL FIRE:FC=0
4710       ELSE
4720         FC=0
4730       END IF
4740       FL=F
4750       U=KEY("E") OR KEY("RETURN") OR JOY("X")
4760       IF U<>0 AND UL=0 THEN CALL USEKEY
4770       UL=U
4780       IF KEY("ESC") THEN IN_QUIT=1
4790     END IF
4800     PX=W3D("X"):PY=W3D("Y")
4810     CALL DOORS
4820     CALL BUGS(DT)
4830     CALL GLOBS(DT)
4840     CALL PICKUPS
4850     IF W3D("TAG",W3D("SECTOR"))=99 THEN WON=-1
4860     W3D RENDER
4870     CALL GUN
4880     CALL HUD
4890     IF FLASH>0 THEN FLASH=FLASH-1
4900     IF HURTT>0 THEN HURTT=HURTT-1
4910     IF DEAD THEN
4920       CALL BIGMSG(100,"YOU WERE EATEN",FN CI(1,14))
4930       CALL CTEXT(150,"PRESS FIRE TO TRY AGAIN",FN CI(0,13))
4940     END IF
4950     CALL W3K_SHOW
4960     FR=FR+1
4970     IF FN IN_SERVICE() THEN
4980       CALL BIGMSG(110,"PAUSED",FN CI(0,15))
4990       CALL W3K_SHOW
5000       CALL IN_PAUSELOOP
5010       GT0=TI:W3K_T0=TI
5020     END IF
5030     Y=JOY("Y")
5040     IF IN_KEY=79 OR (Y<>0 AND YL=0) THEN
5050       CALL P3_DIALOG
5060       GT0=TI
5070     END IF
5080     YL=Y
5090   UNTIL IN_QUIT OR WON OR (DEAD AND FN IN_ANYA(0)) OR (DEAD AND KEY("SPACE"))
5100 END PROC
5110 PROC WINSCREEN
5120   LOCAL I
