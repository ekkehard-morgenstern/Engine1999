10 ' BUG HUNT - a first person shooter made with the software 3D sector renderer (W3D ...) of Engine1999.
20 ' A research bunker has been overrun by giant robot bugs. Fight your way from the start room through the arena, take the red key from the west
30 ' room, open the red door in the east, ride the lift up, take the blue key and leave through the blue door. Crawlers bite when they are close,
40 ' spitters stay away and shoot green globs at you. Medkits and ammo boxes lie around.
50 ' Keys: arrows or WASD walk and turn (A and D slide sideways), SHIFT runs, SPACE or CTRL fires, E or RETURN opens doors, R and F look up and down,
60 ' P pauses, Q or ESC quits. Game controller: left stick walks, right stick turns and looks, A or the right trigger fires, X opens doors, LT runs,
70 ' START pauses, BACK quits.
80 ' How it is made: the level is DATA (rectangular sectors with floor and ceiling heights, light, tags and walls, some of them portals), read into
90 ' W3D SECTOR / W3D WALL. Doors and the lift are sectors whose heights change (W3D HEIGHT). The bugs, pick-ups, globs and decorations are things
100 ' (W3D THING): a bug walks with W3D THINGMOVE (which also keeps it out of walls), notices you with W3D("SEES", n), and your shot is
110 ' W3D("SHOOT", range). The textures and sprites are drawn with GFX statements (library w3dkit) and grabbed. Window only.
120 LOAD LIBRARY "w3dkit"
130 LOAD LIBRARY "input"
140 LOAD LIBRARY "text"
150 BREAK OFF
160 DIM MT(40),MS(40),MH(40),MC(40),ML(40),MA(40),PK(60),PT(60),PA(60),QA(16),QX(16),QY(16),QL(16),DSEC(3),DOP(3),DCUR(3)
170 GOTO MAIN
180 FUNC CI(H,S)
190   RETURN 16+H*16+S
200 END FUNC
210 FUNC RI(M)
220   RETURN INT(RND(1)*M)
230 END FUNC
240 ' ------------------------------------------------------------------------------------------------ pictures
250 PROC SPLAT(N,H)
260   GFX CIRCLE 16,12,8,FN CI(H,9),-1,-1,0.4
270   GFX PAINT 16,12,FN CI(H,9),FN CI(H,9)
280 END PROC
290 PROC MAKECRAWLER
300   LOCAL F,I
310   FOR F=0 TO 1
320     GFX CLEAR 0
330     FOR I=0 TO 2
340       GFX LINE 11+I*7,22,7+I*8+F*4,38,FN CI(4,5)
350       GFX LINE 12+I*7,22,17+I*8-F*4,38,FN CI(4,5)
360       GFX LINE 7+I*8+F*4,38,4+I*8+F*4,39,FN CI(4,4)
370     NEXT I
380     GFX CIRCLE 20,22,15,FN CI(4,9),-1,-1,0.7
390     GFX PAINT 20,22,FN CI(4,9),FN CI(4,9)
400     GFX CIRCLE 20,16,9,FN CI(4,12),-1,-1,0.5
410     GFX PAINT 20,16,FN CI(4,12),FN CI(4,12)
420     GFX CIRCLE 34,18,6,FN CI(4,11)
430     GFX PAINT 34,18,FN CI(4,11),FN CI(4,11)
440     GFX LINE 38,17,39,19,FN CI(1,13),BF
450     GFX LINE 36,23,39,26,FN CI(0,12)
460     GFX LINE 33,24,36,28,FN CI(0,12)
470     CALL W3K_GRAB(40+F,40,40)
480   NEXT F
490   GFX CLEAR 0
500   GFX CIRCLE 20,32,16,FN CI(4,5),-1,-1,0.25
510   GFX PAINT 20,32,FN CI(4,5),FN CI(4,5)
520   FOR I=0 TO 5
530     GFX LINE 8+I*5,30,6+I*5,24,FN CI(4,4)
540   NEXT I
550   GFX CIRCLE 20,31,8,FN CI(3,10),-1,-1,0.3
560   CALL W3K_GRAB(42,40,40)
570 END PROC
580 PROC MAKESPITTER
590   LOCAL F
600   FOR F=0 TO 1
610     GFX CLEAR 0
620     GFX LINE 14,14,2,2+F*14,FN CI(7,11)
630     GFX LINE 14,14,26,2+F*14,FN CI(7,11)
640     GFX LINE 14,15,3,5+F*12,FN CI(7,13)
650     GFX LINE 14,15,25,5+F*12,FN CI(7,13)
660     GFX CIRCLE 14,18,7,FN CI(2,11),-1,-1,1.2
670     GFX PAINT 14,18,FN CI(2,11),FN CI(2,11)
680     GFX CIRCLE 14,10,5,FN CI(2,13)
690     GFX PAINT 14,10,FN CI(2,13),FN CI(2,13)
700     GFX PSET 12,9,FN CI(1,13)
710     GFX PSET 16,9,FN CI(1,13)
720     GFX LINE 13,27,14,31,FN CI(3,12)
730     GFX LINE 11,19,17,19,FN CI(2,6)
740     CALL W3K_GRAB(43+F,28,32)
750   NEXT F
760   GFX CLEAR 0
770   GFX LINE 6,18,22,26,FN CI(2,6),BF
780   GFX CIRCLE 14,22,7,FN CI(2,8),-1,-1,0.4
790   GFX LINE 2,14,12,22,FN CI(7,6)
800   GFX LINE 26,14,16,22,FN CI(7,6)
810   CALL W3K_GRAB(45,28,32)
820   GFX CLEAR 0
830   GFX CIRCLE 6,6,5,FN CI(4,10)
840   GFX PAINT 6,6,FN CI(3,15),FN CI(4,10)
850   CALL W3K_GRAB(46,12,12)
860 END PROC
870 PROC MAKETEX
880   CALL W3K_METAL(1,0)
890   CALL W3K_METAL(2,8)
900   CALL W3K_BRICK(3,0)
910   CALL W3K_TILES(4,0,8)
920   CALL W3K_CARPET(5,9)
930   CALL W3K_METAL(6,1)
940   CALL W3K_STONE(7,0)
950   CALL W3K_DOORTEX(8,1)
960   CALL W3K_DOORTEX(9,9)
970   CALL W3K_METAL(12,3)
980   CALL W3K_STONE(13,13)
990   CALL W3K_BARREL(20)
1000   CALL W3K_LAMP(21)
1010   CALL W3K_MEDKIT(22)
1020   CALL W3K_AMMOBOX(23)
1030   CALL W3K_KEYCARD(24,1)
1040   CALL W3K_KEYCARD(25,9)
1050   CALL MAKECRAWLER
1060   CALL MAKESPITTER
1070 END PROC
1080 ' ------------------------------------------------------------------------------------------------ the level
1090 PROC LOADLEVEL
1100   LOCAL NS,I,S,F,C,FT,CT,L,TG,NW,J,X1,Y1,X2,Y2,T,NX,FL,UP,LO,XO,YO
1110   RESTORE LEVELDATA
1120   READ NS
1130   FOR I=1 TO NS
1140     READ S,F,C,FT,CT,L,TG,NW
1150     W3D SECTOR S,F,C,FT,CT,L
1160     W3D TAG S,TG
1170     FOR J=0 TO NW-1
1180       READ X1,Y1,X2,Y2,T,NX,FL,UP,LO,XO,YO
1190       W3D WALL S,X1,Y1,X2,Y2,T,NX
1200       IF UP>=0 OR LO>=0 THEN W3D WALLTEX S,J,-1,UP,LO
1210       IF FL<>0 THEN W3D WALLFLAG S,J,FL
1220     NEXT J
1230   NEXT I
1240 END PROC
1250 ' things: 0..39 the bugs, 40..55 globs, 60..119 pick-ups, 120.. decoration
1260 PROC PLACE
1270   LOCAL T,X,Y,K
1280   FOR K=0 TO 55
1290     W3D THINGOFF K
1300   NEXT K
1310   RESTORE BUGDATA
1320   NM=0
1330   READ T
1340   WHILE T>0
1350     READ X,Y
1360     MT(NM)=T:MS(NM)=0:MC(NM)=30+FN RI(40):ML(NM)=0:MA(NM)=0
1370     IF T=1 THEN
1380       MH(NM)=40
1390       W3D THING NM,X,Y,40,48,44
1400     ELSE
1410       MH(NM)=20
1420       W3D THING NM,X,Y,43,34,34
1430       W3D THINGZ NM,12
1440     END IF
1450     NM=NM+1
1460     READ T
1470   WEND
1480   RESTORE ITEMDATA
1490   NP=0
1500   READ T
1510   WHILE T>0
1520     READ X,Y
1530     PK(NP)=T:PA(NP)=-1:PT(NP)=60+NP
1540     W3D THING PT(NP),X,Y,21+T,18,16
1550     NP=NP+1
1560     READ T
1570   WEND
1580   RESTORE DECORDATA
1590   K=120
1600   READ T
1610   WHILE T>0
1620     READ X,Y,PW,PH
1630     W3D THING K,X,Y,T,PW,PH
1640     K=K+1
1650     READ T
1660   WEND
1670   FOR K=0 TO 15
1680     QA(K)=0
1690   NEXT K
1700 END PROC
1710 ' ------------------------------------------------------------------------------------------------ the player
1720 PROC MSG(T$)
1730   MSG$=T$:MSGT=150
1740 END PROC
1750 PROC HURT(N)
1760   IF DEAD THEN RETURN
1770   HEALTH=HEALTH-N
1780   HURTT=8
1790   SFX 4
1800   IF HEALTH<=0 THEN
1810     HEALTH=0:DEAD=-1:SFX 3
1820   END IF
1830 END PROC
1840 PROC WAKE(I)
1850   IF MS(I)=0 THEN MS(I)=1
1860 END PROC
1870 PROC FIRE
1880   LOCAL T
1890   IF AMMO<=0 THEN
1900     CALL MSG("OUT OF AMMO")
1910     RETURN
1920   END IF
1930   AMMO=AMMO-1:FLASH=4
1940   SFX 1
1950   T=W3D("SHOOT",1500)
1960   IF T>=0 AND T<NM THEN
1970     IF MS(T)<2 THEN
1980       MH(T)=MH(T)-20
1990       CALL WAKE(T)
2000       IF MH(T)<=0 THEN
2010         MS(T)=2:KILLS=KILLS+1
2020         IF MT(T)=1 THEN
2030           W3D THING T,W3D("TX",T),W3D("TY",T),42,48,10
2040         ELSE
2050           W3D THING T,W3D("TX",T),W3D("TY",T),45,34,12
2060           W3D THINGZ T,0
2070         END IF
2080         W3D THINGLIGHT T,-1
2090         SFX 3
2100       ELSE
2110         ML(T)=3
2120         W3D THINGLIGHT T,255
2130         SFX 2
2140       END IF
2150     END IF
2160   END IF
2170 END PROC
2180 PROC PICKUPS
2190   LOCAL I,D
2200   FOR I=0 TO NP-1
2210     IF PA(I) THEN
2220       IF W3D("DIST",PT(I))<26 THEN
2230         D=0
2240         IF PK(I)=1 THEN
2250           IF HEALTH<100 THEN HEALTH=MIN(100,HEALTH+25):D=-1:CALL MSG("MEDKIT +25")
2260         END IF
2270         IF PK(I)=2 THEN AMMO=AMMO+15:D=-1:CALL MSG("AMMO +15")
2280         IF PK(I)=3 THEN KEYS=KEYS OR 1:D=-1:CALL MSG("YOU HAVE THE RED KEY")
2290         IF PK(I)=4 THEN KEYS=KEYS OR 2:D=-1:CALL MSG("YOU HAVE THE BLUE KEY")
2300         IF D THEN
2310           PA(I)=0:W3D THINGOFF PT(I):SFX 5
2320         END IF
2330       END IF
2340     END IF
2350   NEXT I
2360 END PROC
2370 ' ------------------------------------------------------------------------------------------------ doors and the lift
2380 PROC USEKEY
2390   LOCAL S
2400   S=W3D("USE",70)
2410   IF S<0 THEN RETURN
2420   IF S=4 THEN
2430     IF KEYS AND 1 THEN
2440       DOP(1)=-1:SFX 6
2450     ELSE
2460       CALL MSG("THIS DOOR NEEDS THE RED KEY")
2470     END IF
2480   END IF
2490   IF S=10 THEN
2500     IF KEYS AND 2 THEN
2510       DOP(2)=-1:SFX 6
2520     ELSE
2530       CALL MSG("THIS DOOR NEEDS THE BLUE KEY")
2540     END IF
2550   END IF
2560 END PROC
2570 PROC DOORS
2580   LOCAL I,G,B
2590   FOR I=1 TO 2
2600     IF I=1 THEN B=0 ELSE B=96
2610     IF DOP(I) THEN G=B+100 ELSE G=B
2620     IF DCUR(I)<G THEN DCUR(I)=MIN(G,DCUR(I)+3)
2630     W3D HEIGHT DSEC(I),B,DCUR(I)
2640   NEXT I
2650   ' the lift: it carries you up (or down again) when you have stood on it for a moment
2660   IF W3D("SECTOR")=8 THEN
2670     LWAIT=LWAIT+1
2680     IF LWAIT=40 THEN
2690       IF LTGT=0 THEN LTGT=96 ELSE LTGT=0
2700       SFX 8
2710     END IF
2720   ELSE
2730     LWAIT=0
2740   END IF
2750   IF LPOS<LTGT THEN LPOS=MIN(LTGT,LPOS+1.2)
2760   IF LPOS>LTGT THEN LPOS=MAX(LTGT,LPOS-1.2)
2770   W3D HEIGHT 8,LPOS,200
2780 END PROC
2790 ' ------------------------------------------------------------------------------------------------ the bugs
2800 PROC SPIT(I)
2810   LOCAL K,X,Y,D,DX,DY
2820   FOR K=0 TO 15
2830     IF QA(K)=0 THEN
2840       X=W3D("TX",I):Y=W3D("TY",I)
2850       DX=PX-X:DY=PY-Y:D=SQR(DX*DX+DY*DY)
2860       IF D<1 THEN RETURN
2870       QA(K)=-1:QX(K)=DX/D*170:QY(K)=DY/D*170:QL(K)=300
2880       W3D THING 40+K,X,Y,46,14,14
2890       W3D THINGZ 40+K,22
2900       W3D THINGLIGHT 40+K,255
2910       SFX 7
2920       RETURN
2930     END IF
2940   NEXT K
2950 END PROC
2960 PROC BUGS(DT)
2970   LOCAL I,D,DX,DY,SP,F
2980   FOR I=0 TO NM-1
2990     IF MS(I)<2 THEN
3000       IF ML(I)>0 THEN
3010         ML(I)=ML(I)-1
3020         IF ML(I)=0 THEN W3D THINGLIGHT I,-1
3030       END IF
3040       D=W3D("DIST",I)
3050       IF MS(I)=0 THEN
3060         IF D<420 THEN
3070           IF W3D("SEES",I) THEN MS(I)=1
3080         END IF
3090       ELSE
3100         DX=PX-W3D("TX",I):DY=PY-W3D("TY",I)
3110         IF D>1 THEN DX=DX/D:DY=DY/D
3120         F=((FR\8)+I) AND 1
3130         IF MT(I)=1 THEN
3140           W3D THINGTEX I,40+F
3150           IF D>34 THEN
3160             W3D THINGMOVE I,DX*85*DT,DY*85*DT
3170             IF (W3D("HIT") AND 1) AND D>60 THEN W3D THINGMOVE I,-DY*60*DT*(1-2*(I AND 1)),DX*60*DT*(1-2*(I AND 1))
3180           END IF
3190           MC(I)=MC(I)-1
3200           IF D<46 AND MC(I)<=0 THEN
3210             CALL HURT(6+FN RI(5)):MC(I)=36
3220           END IF
3230         ELSE
3240           W3D THINGTEX I,43+F
3250           IF D>240 THEN W3D THINGMOVE I,DX*60*DT,DY*60*DT
3260           IF D<150 THEN W3D THINGMOVE I,-DX*50*DT,-DY*50*DT
3270           W3D THINGMOVE I,-DY*35*DT*(1-2*(I AND 1)),DX*35*DT*(1-2*(I AND 1))
3280           MC(I)=MC(I)-1
3290           IF MC(I)<=0 THEN
3300             IF D<650 THEN
3310               IF W3D("SEES",I) THEN CALL SPIT(I)
3320             END IF
3330             MC(I)=70+FN RI(60)
3340           END IF
3350         END IF
3360       END IF
3370     END IF
3380   NEXT I
3390 END PROC
3400 PROC GLOBS(DT)
3410   LOCAL K,X,Y,D
3420   FOR K=0 TO 15
3430     IF QA(K) THEN
3440       W3D THINGMOVE 40+K,QX(K)*DT,QY(K)*DT
3450       QL(K)=QL(K)-1
3460       X=W3D("TX",40+K):Y=W3D("TY",40+K)
3470       D=SQR((X-PX)^2+(Y-PY)^2)
3480       IF D<20 THEN
3490         CALL HURT(9)
3500         QA(K)=0:W3D THINGOFF 40+K
3510       ELSE
3520         IF (W3D("HIT") AND 3) OR QL(K)<=0 THEN
3530           QA(K)=0:W3D THINGOFF 40+K
3540         END IF
3550       END IF
3560     END IF
3570   NEXT K
3580 END PROC
3590 ' ------------------------------------------------------------------------------------------------ the screen
3600 PROC GUN
3610   LOCAL X,Y
3620   X=320:Y=264
3630   IF HURTT>0 THEN
3640     GFX LINE 0,0,639,5,FN CI(1,12),BF
3650     GFX LINE 0,258,639,263,FN CI(1,12),BF
3660     GFX LINE 0,0,5,263,FN CI(1,12),BF
3670     GFX LINE 634,0,639,263,FN CI(1,12),BF
3680   END IF
3690   IF FLASH>0 THEN
3700     GFX CIRCLE X,Y-66,14,FN CI(3,13)
3710     GFX PAINT X,Y-66,FN CI(3,15),FN CI(3,13)
3720     GFX CIRCLE X,Y-66,6,FN CI(0,15)
3730     GFX PAINT X,Y-66,FN CI(0,15),FN CI(0,15)
3740   END IF
3750   GFX LINE X-26,Y-30,X+26,Y,FN CI(0,5),BF
3760   GFX LINE X-26,Y-30,X+26,Y-28,FN CI(0,11),BF
3770   GFX LINE X-8,Y-58,X+8,Y-30,FN CI(0,8),BF
3780   GFX LINE X-8,Y-58,X-5,Y-30,FN CI(0,12),BF
3790   GFX LINE X-12,Y-62,X+12,Y-56,FN CI(0,10),BF
3800   GFX LINE X-14,Y-20,X+14,Y-12,FN CI(7,9),BF
3810   GFX LINE X-2,Y-130,X+2,Y-126,FN CI(1,13),BF
3820 END PROC
3830 PROC HUD
3840   LOCAL I,C
3850   CALL W3K_HUDBAR(264,36)
3860   GFX TEXT 8,268,"HEALTH",FN CI(0,11)
3870   GFX LINE 8,282,108,293,FN CI(0,3),BF
3880   IF HEALTH>0 THEN
3890     IF HEALTH>40 THEN C=FN CI(5,12) ELSE C=FN CI(1,13)
3900     GFX LINE 8,282,8+HEALTH-1,293,C,BF
3910   END IF
3920   GFX LINE 8,282,108,293,FN CI(0,9),B
3930   GFX TEXT 130,268,"AMMO",FN CI(0,11)
3940   GFX TEXT 130,282,STR$(AMMO),FN CI(3,14),2,1
3950   GFX TEXT 210,268,"KEYS",FN CI(0,11)
3960   IF KEYS AND 1 THEN GFX LINE 210,282,226,293,FN CI(1,13),BF
3970   IF KEYS AND 2 THEN GFX LINE 232,282,248,293,FN CI(9,13),BF
3980   GFX TEXT 290,268,"BUGS",FN CI(0,11)
3990   GFX TEXT 290,282,STR$(KILLS)+"/"+STR$(NM),FN CI(4,13)
4000   IF MSGT>0 THEN
4010     GFX TEXT 380,276,MSG$,FN CI(3,15)
4020     MSGT=MSGT-1
4030   END IF
4040 END PROC
4050 PROC CTEXT(Y,T$,C)
4060   GFX TEXT (640-8*LEN(T$))\2,Y,T$,C
4070 END PROC
4080 PROC BIGMSG(Y,T$,C)
4090   CALL BIGTEXT(Y,T$,C,3)
4100 END PROC
4110 PROC WAITKEY
4120   LOCAL K$
4130   CALL IN_WAITRELEASE
4140   K$=INKEY$
4150   WHILE K$<>""
4160     K$=INKEY$
4170   WEND
4180   REPEAT
4190     FRAME
4200     K$=INKEY$
4210     IF FN IN_ANYA(0) OR FN IN_ANYSTART(0) THEN K$=" "
4220     IF FN IN_ANYBACK(0) THEN K$="Q"
4230   UNTIL K$<>""
4240   IF K$="Q" OR K$="q" OR K$=CHR$(27) THEN IN_QUIT=1
4250 END PROC
4260 PROC TITLE
4270   LOCAL I
4280   FOR I=0 TO 1
4290     GFX CLEAR FN CI(0,1)
4300     GFX LINE 60,40,579,250,FN CI(4,3),B
4310     CALL BIGTEXT(60,"BUG HUNT",FN CI(4,14),5)
4320     CALL CTEXT(130,"GIANT ROBOT BUGS HAVE TAKEN THE BUNKER.",FN CI(0,13))
4330     CALL CTEXT(148,"TAKE THE RED KEY, THE LIFT AND THE BLUE KEY AND GET OUT.",FN CI(0,11))
4340     CALL CTEXT(176,"WASD/ARROWS WALK   SPACE/CTRL FIRE   E OPEN DOORS   SHIFT RUN",FN CI(3,13))
4350     CALL CTEXT(192,"PAD: STICKS WALK AND TURN   A/RT FIRE   X OPEN DOORS",FN CI(3,13))
4360     CALL CTEXT(226,"PRESS FIRE TO START",FN CI(1,13))
4370     CALL W3K_SHOW
4380   NEXT I
4390   CALL WAITKEY
4400 END PROC
4410 PROC NEWGAME
4420   CALL PLACE
4430   HEALTH=100:AMMO=40:KEYS=0:KILLS=0:DEAD=0:FLASH=0:HURTT=0:MSGT=0:FR=0:LWAIT=0
4440   DOP(1)=0:DOP(2)=0:DCUR(1)=0:DCUR(2)=96
4450   W3D HEIGHT 4,0,0
4460   W3D HEIGHT 10,96,96
4470   LPOS=0:LTGT=0
4480   W3D HEIGHT 8,0,200
4490   W3D CAMERA 128,60,90,0,0
4500   GT0=TI
4510 END PROC
4520 PROC PLAYLEVEL
4530   LOCAL DT,F,U,UL,FL
4540   CALL NEWGAME
4550   UL=0:FL=0
4560   WON=0
4570   REPEAT
4580     DT=(TI-GT0)/60:GT0=TI
4590     IF DT>0.1 THEN DT=0.1
4600     IF NOT DEAD THEN
4610       CALL W3K_WALK
4620       F=KEY("SPACE") OR KEY("CTRL") OR JOY("A") OR JOY("RT")>0.5
4630       IF F<>0 AND FL=0 THEN CALL FIRE
4640       IF F<>0 AND FL<>0 THEN
4650         FC=FC+1
4660         IF FC>=14 THEN CALL FIRE:FC=0
4670       ELSE
4680         FC=0
4690       END IF
4700       FL=F
4710       U=KEY("E") OR KEY("RETURN") OR JOY("X")
4720       IF U<>0 AND UL=0 THEN CALL USEKEY
4730       UL=U
4740       IF KEY("ESC") THEN IN_QUIT=1
4750     END IF
4760     PX=W3D("X"):PY=W3D("Y")
4770     CALL DOORS
4780     CALL BUGS(DT)
4790     CALL GLOBS(DT)
4800     CALL PICKUPS
4810     IF W3D("TAG",W3D("SECTOR"))=99 THEN WON=-1
4820     W3D RENDER
4830     CALL GUN
4840     CALL HUD
4850     IF FLASH>0 THEN FLASH=FLASH-1
4860     IF HURTT>0 THEN HURTT=HURTT-1
4870     IF DEAD THEN
4880       CALL BIGMSG(100,"YOU WERE EATEN",FN CI(1,14))
4890       CALL CTEXT(150,"PRESS FIRE TO TRY AGAIN",FN CI(0,13))
4900     END IF
4910     CALL W3K_SHOW
4920     FR=FR+1
4930     IF FN IN_SERVICE() THEN
4940       CALL BIGMSG(110,"PAUSED",FN CI(0,15))
4950       CALL W3K_SHOW
4960       CALL IN_PAUSELOOP
4970       GT0=TI:W3K_T0=TI
4980     END IF
4990   UNTIL IN_QUIT OR WON OR (DEAD AND FN IN_ANYA(0)) OR (DEAD AND KEY("SPACE"))
5000 END PROC
5010 PROC WINSCREEN
5020   LOCAL I
5030   FOR I=0 TO 1
5040     GFX CLEAR FN CI(0,1)
5050     GFX LINE 60,40,579,250,FN CI(5,6),B
5060     CALL BIGTEXT(60,"LEVEL COMPLETE",FN CI(5,14),4)
5070     CALL CTEXT(140,"BUGS SQUASHED: "+STR$(KILLS)+" OF "+STR$(NM),FN CI(0,13))
5080     CALL CTEXT(158,"TIME: "+STR$(INT(FR/60))+" SECONDS",FN CI(0,13))
5090     CALL CTEXT(176,"HEALTH LEFT: "+STR$(HEALTH),FN CI(0,13))
5100     CALL CTEXT(226,"PRESS FIRE TO PLAY AGAIN",FN CI(1,13))
5110     CALL W3K_SHOW
