# Engine1999 menu entry. @BINDIR@ / @GAMESBINDIR@ are filled in by "make install" (see the makefile, target install).
[Desktop Entry]
Type=Application
Version=1.0
Name=Y2K Countdown
GenericName=Demo
Comment=A silly demo in the style of 1999: copper bars, plasma, vector balls, a sine scroller and the millennium bug
Exec=@GAMESBINDIR@/engine1999-y2k
Icon=engine1999-y2k
Terminal=false
Categories=AudioVideo;Video;
Keywords=demo;demoscene;retro;music;
StartupNotify=false
