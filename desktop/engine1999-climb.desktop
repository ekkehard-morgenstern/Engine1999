# Engine1999 menu entry. @BINDIR@ / @GAMESBINDIR@ are filled in by "make install" (see the makefile, target install).
[Desktop Entry]
Type=Application
Version=1.0
Name=The Long Climb
GenericName=Game
Comment=Climb a steel tower to the ice cream stand on the roof
Exec=@GAMESBINDIR@/engine1999-climb
Icon=engine1999-climb
Terminal=false
Categories=Game;ArcadeGame;
Keywords=platform;jump and run;tower;
StartupNotify=false
